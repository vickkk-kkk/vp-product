+    /// Preserve the caller's exact ordered ALPN list. This does not infer a
+    /// carrier or silently replace an unsupported application protocol.
+    pub fn from_pem_with_alpn(cert_pem: &[u8], key_pem: &[u8], alpn: Vec<Vec<u8>>) -> Result<Self> {
+        validate_alpn(&alpn)?;
+        let mut identity = Self::from_pem(cert_pem, key_pem)?;
+        identity.config.alpn_protocols = alpn;
+        Ok(identity)
+    }
+}
+
+fn validate_alpn(alpn: &[Vec<u8>]) -> Result<()> {
+    let mut seen = std::collections::HashSet::new();
+    if alpn.len() > 16
+        || alpn.iter().any(|value| {
+            value.is_empty()
+                || value.len() > 255
+                || value.iter().any(|b| !b.is_ascii_graphic())
+                || !seen.insert(value)
+        })
+    {
+        return Err(Error::Config(
+            "invalid, duplicate or oversized TLS ALPN list".into(),
+        ));
+    }
+    Ok(())
 }
 
