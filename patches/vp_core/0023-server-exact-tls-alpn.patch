 #[cfg(test)]
 mod tests;
+
+#[cfg(test)]
+mod exact_alpn_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    fn certificate() -> rcgen::CertifiedKey {
+        // Test-only ephemeral key, never written to disk or logs.
+        rcgen::generate_simple_self_signed(vec!["localhost".into()]).unwrap()
+    }
+    fn identity(cert: &rcgen::CertifiedKey, alpn: &[&str]) -> ServerTlsIdentity {
+        ServerTlsIdentity::from_pem_with_alpn(
+            cert.cert.pem().as_bytes(),
+            cert.key_pair.serialize_pem().as_bytes(),
+            alpn.iter().map(|s| s.as_bytes().to_vec()).collect(),
+        )
+        .unwrap()
+    }
+    fn connector(cert: &rcgen::CertifiedKey, alpn: &[&str]) -> tokio_rustls::TlsConnector {
+        let mut roots = rustls::RootCertStore::empty();
+        roots.add(cert.cert.der().clone()).unwrap();
+        let mut cfg = rustls::ClientConfig::builder_with_provider(Arc::new(
+            rustls::crypto::ring::default_provider(),
+        ))
+        .with_safe_default_protocol_versions()
+        .unwrap()
+        .with_root_certificates(roots)
+        .with_no_client_auth();
+        cfg.alpn_protocols = alpn.iter().map(|s| s.as_bytes().to_vec()).collect();
+        tokio_rustls::TlsConnector::from(Arc::new(cfg))
+    }
+    #[test]
+    fn explicit_order_survives_and_incompatible_carriers_fail() {
+        let cert = certificate();
+        let id = identity(&cert, &["protocol-b", "protocol-a"]);
+        assert_eq!(
+            id.config.alpn_protocols,
+            [b"protocol-b".to_vec(), b"protocol-a".to_vec()]
+        );
+        let transport =
+            ServerTransport::new_exact_alpn(ServerNetwork::Tcp, Some(id), ServerLimits::default())
+                .unwrap();
+        assert_eq!(
+            transport.required_alpn.unwrap(),
+            [b"protocol-b".to_vec(), b"protocol-a".to_vec()]
+        );
+        for network in [
+            ServerNetwork::Http2(HttpRoute::new("/", vec![]).unwrap()),
+            ServerNetwork::WebSocket(HttpRoute::new("/", vec![]).unwrap()),
+            ServerNetwork::HttpUpgrade(HttpRoute::new("/", vec![]).unwrap()),
+        ] {
+            assert!(
+                ServerTransport::new_exact_alpn(
+                    network,
+                    Some(identity(&cert, &["not-http"])),
+                    ServerLimits::default()
+                )
+                .is_err()
+            );
+        }
+    }
+    #[test]
+    fn malformed_alpn_and_mismatched_private_key_are_rejected() {
+        for alpn in [
+            vec![vec![]],
+            vec![b"h2".to_vec(), b"h2".to_vec()],
+            vec![b"bad\n".to_vec()],
+            vec![vec![b'x'; 256]],
+            vec![b"a".to_vec(); 17],
+        ] {
+            assert!(validate_alpn(&alpn).is_err());
+        }
+        let first = certificate();
+        let second = certificate();
+        assert!(
+            ServerTlsIdentity::from_pem_with_alpn(
+                first.cert.pem().as_bytes(),
+                second.key_pair.serialize_pem().as_bytes(),
+                vec![]
+            )
+            .is_err()
+        );
+        assert!(
+            ServerTlsIdentity::from_pem_with_alpn(first.cert.pem().as_bytes(), b"", vec![])
+                .is_err()
+        );
+    }
+    #[tokio::test]
+    async fn real_tls_preserves_negotiated_alpn_and_rejects_missing_or_wrong_offer() {
+        for offered in [vec!["protocol-a"], vec!["wrong"], vec![]] {
+            let cert = certificate();
+            let server = ServerTransport::new_exact_alpn(
+                ServerNetwork::Tcp,
+                Some(identity(&cert, &["protocol-b", "protocol-a"])),
+                ServerLimits::default(),
+            )
+            .unwrap();
+            let (server_io, client_io) = tokio::io::duplex(16384);
+            let called = Arc::new(AtomicUsize::new(0));
+            let observed = called.clone();
+            let client = connector(&cert, &offered);
+            let (served, connected) =
+                tokio::time::timeout(std::time::Duration::from_secs(2), async {
+                    tokio::join!(
+                        server.serve(Box::new(server_io), move |_| {
+                            observed.fetch_add(1, Ordering::SeqCst);
+                            async { Ok(()) }
+                        }),
+                        client.connect(
+                            rustls::pki_types::ServerName::try_from("localhost").unwrap(),
+                            client_io
+                        )
+                    )
+                })
+                .await
+                .unwrap();
+            if offered == ["protocol-a"] {
+                assert!(served.is_ok());
+                assert_eq!(
+                    connected.unwrap().get_ref().1.alpn_protocol(),
+                    Some(b"protocol-a".as_slice())
+                );
+                assert_eq!(called.load(Ordering::SeqCst), 1);
+            } else {
+                assert!(served.is_err());
+                assert_eq!(called.load(Ordering::SeqCst), 0);
+            }
+        }
+    }
+}
