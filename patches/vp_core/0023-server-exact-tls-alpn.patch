+    /// Exact-policy constructor: never replaces identity ALPN. An explicit
+    /// nonempty list also requires the client to negotiate one of those values.
+    pub fn new_exact_alpn(
+        network: ServerNetwork,
+        tls: Option<ServerTlsIdentity>,
+        limits: ServerLimits,
+    ) -> Result<Self> {
+        limits.validate()?;
+        if matches!(&network, ServerNetwork::WebSocket(r) | ServerNetwork::HttpUpgrade(r) if r.method.is_some())
+        {
+            return Err(Error::Config(
+                "upgrade method must be GET (do not set a method override)".into(),
+            ));
+        }
+        let mut required_alpn = None;
+        let tls = if let Some(identity) = tls {
+            let alpn = &identity.config.alpn_protocols;
+            validate_alpn(alpn)?;
+            let compatible = match &network {
+                ServerNetwork::Tcp => true,
+                ServerNetwork::Http2(_) => alpn == &[b"h2".to_vec()],
+                ServerNetwork::WebSocket(_) | ServerNetwork::HttpUpgrade(_) => {
+                    alpn.is_empty() || alpn == &[b"http/1.1".to_vec()]
+                }
+            };
+            if !compatible {
+                return Err(Error::Config(
+                    "TLS ALPN incompatible with server transport".into(),
+                ));
+            }
+            if !alpn.is_empty() {
+                required_alpn = Some(alpn.clone());
+            }
+            Some(tokio_rustls::TlsAcceptor::from(Arc::new(identity.config)))
+        } else {
+            None
+        };
+        Ok(Self {
+            network,
+            tls,
+            required_alpn,
             limits,
         })
     }
