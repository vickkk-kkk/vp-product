+async fn send_packet(
+    conn: &quinn::Connection,
+    native: bool,
+    assoc: u16,
+    id: u16,
+    dst: &DstAddr,
+    payload: &[u8],
+) -> Result<()> {
+    if payload.len() > 65507 {
+        return Err(Error::Proto("tuic: oversized UDP"));
+    }
+    let mut addr = Vec::new();
+    encode_addr(dst, &mut addr);
+    let chunk = if native {
+        conn.max_datagram_size()
+            .ok_or(Error::Proto("tuic: datagrams disabled"))?
+            .checked_sub(10 + addr.len())
+            .filter(|n| *n > 0)
+            .ok_or(Error::Proto("tuic: datagram too small"))?
+    } else {
+        65507
+    };
+    let total = payload.len().max(1).div_ceil(chunk);
+    if total > 255 {
+        return Err(Error::Proto("tuic: too many fragments"));
+    }
+    for index in 0..total {
+        let part =
+            &payload[(index * chunk).min(payload.len())..((index + 1) * chunk).min(payload.len())];
+        let mut msg = vec![VER, T_PACKET];
+        msg.extend_from_slice(&assoc.to_be_bytes());
+        msg.extend_from_slice(&id.to_be_bytes());
+        msg.extend_from_slice(&[total as u8, index as u8]);
+        msg.extend_from_slice(&(part.len() as u16).to_be_bytes());
+        if index == 0 {
+            msg.extend_from_slice(&addr);
+        } else {
+            msg.push(0xff);
+        }
+        msg.extend_from_slice(part);
+        if native {
+            conn.send_datagram(msg.into()).map_err(quic_error)?;
+        } else {
+            let mut uni = conn.open_uni().await.map_err(quic_error)?;
+            uni.write_all(&msg).await.map_err(quic_error)?;
+            uni.finish().map_err(quic_error)?;
+        }
+    }
+    Ok(())
+}
