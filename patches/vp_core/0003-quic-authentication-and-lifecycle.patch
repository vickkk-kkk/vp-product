+async fn open_server_h3_streams(conn: &quinn::Connection) -> Result<Vec<quinn::SendStream>> {
+    let mut streams = Vec::new();
+    for kind in [0u64, 2, 3] {
+        let mut stream = conn.open_uni().await.map_err(hy_error)?;
+        let mut header = Vec::new();
+        write_varint(&mut header, kind);
+        if kind == 0 {
+            header.extend_from_slice(&[4, 0]);
+        } // empty SETTINGS
+        stream.write_all(&header).await.map_err(hy_error)?;
+        streams.push(stream);
+    }
+    Ok(streams)
+}
+
+enum HyCommand {
+    Auth(Vec<(String, String)>, quinn::SendStream),
+    Tcp(DstAddr, quinn::SendStream, quinn::RecvStream),
+}
+
+async fn read_bounded(recv: &mut quinn::RecvStream, limit: usize) -> Result<Vec<u8>> {
+    let (len, _) = read_varint_async(recv).await?;
+    if len > limit as u64 {
+        return Err(Error::Proto("hy2: field too large"));
+    }
+    let mut data = vec![0; len as usize];
+    recv.read_exact(&mut data).await.map_err(hy_error)?;
+    Ok(data)
+}
+
+fn hy_error(e: impl std::fmt::Display) -> Error {
+    Error::Io(std::io::Error::other(e.to_string()))
+}
+
+async fn read_command(mut recv: quinn::RecvStream, send: quinn::SendStream) -> Result<HyCommand> {
+    let (kind, _) = read_varint_async(&mut recv).await?;
+    match kind {
+        TCP_REQUEST_ID => {
+            let address = read_bounded(&mut recv, MAX_ADDRESS).await?;
+            let address =
+                std::str::from_utf8(&address).map_err(|_| Error::Proto("hy2: address encoding"))?;
+            let dst = DstAddr::parse(address)?;
+            if dst.port == 0 {
+                return Err(Error::Proto("hy2: zero port"));
+            }
+            let _padding = read_bounded(&mut recv, MAX_PADDING).await?;
+            Ok(HyCommand::Tcp(dst, send, recv))
+        }
+        crate::h3_min::FRAME_HEADERS => {
+            let block = read_bounded(&mut recv, 16 * 1024).await?;
+            Ok(HyCommand::Auth(
+                crate::h3_min::decode_header_block(&block)?,
+                send,
+            ))
+        }
+        _ => Err(Error::Proto("hy2: unknown request")),
+    }
+}
