+struct FragmentSet {
+    created: tokio::time::Instant,
+    dst: Option<DstAddr>,
+    parts: Vec<Option<Bytes>>,
+    bytes: usize,
+}
+
+#[derive(Default)]
+struct Fragments(HashMap<(u16, u16), FragmentSet>);
+
+impl Fragments {
+    fn push(&mut self, pkt: PacketOpt) -> Option<Packet> {
+        if pkt.total == 1 {
+            return Some(Packet {
+                assoc: pkt.assoc,
+                dst: pkt.dst?,
+                payload: pkt.payload,
+            });
+        }
+        self.0
+            .retain(|_, f| f.created.elapsed() < Duration::from_secs(10));
+        let key = (pkt.assoc, pkt.id);
+        if !self.0.contains_key(&key) && self.0.len() >= 64 {
+            return None;
+        }
+        let f = self.0.entry(key).or_insert_with(|| FragmentSet {
+            created: tokio::time::Instant::now(),
+            dst: None,
+            parts: vec![None; pkt.total as usize],
+            bytes: 0,
+        });
+        if f.parts.len() != pkt.total as usize
+            || f.parts[pkt.index as usize].is_some()
+            || f.bytes + pkt.payload.len() > 65507
+        {
+            self.0.remove(&key);
+            return None;
+        }
+        if pkt.index == 0 {
+            f.dst = pkt.dst;
+        }
+        f.bytes += pkt.payload.len();
+        f.parts[pkt.index as usize] = Some(pkt.payload);
+        if f.parts.iter().any(Option::is_none) {
+            return None;
+        }
+        let f = self.0.remove(&key)?;
+        let mut data = Vec::with_capacity(f.bytes);
+        for part in f.parts {
+            data.extend_from_slice(&part?);
+        }
+        Some(Packet {
+            assoc: pkt.assoc,
+            dst: f.dst?,
+            payload: data.into(),
+        })
+    }
+}
