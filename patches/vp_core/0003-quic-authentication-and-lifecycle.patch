+//! Independent peer tests. Run with an integrity-verified official sing-box release:
+//! VP_SING_BOX=/path/to/sing-box cargo test -p vp-protocol --test quic_server_interop -- --ignored
+//! No downloaded binaries or credentials are committed. Every listener is loopback-only.
+use std::{
+    net::SocketAddr,
+    path::PathBuf,
+    process::{Child, Command, Stdio},
+    sync::Arc,
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, TcpStream, UdpSocket},
+    task::JoinSet,
+};
+use vp_core::{Inbound, InboundCtx};
+
+struct NoopRouter;
+#[async_trait::async_trait]
+impl vp_core::Router for NoopRouter {
+    async fn pick(&self, _: &vp_core::session::Session) -> vp_core::router::Resolution {
+        unreachable!("server currently uses direct outbound")
+    }
+}
+
+struct Peer {
+    child: Child,
+    dir: PathBuf,
+}
+impl Drop for Peer {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+async fn read_socks_address(stream: &mut TcpStream) -> SocketAddr {
+    let mut head = [0; 4];
+    stream.read_exact(&mut head).await.unwrap();
+    assert_eq!(head[..3], [5, 0, 0], "SOCKS reply");
+    match head[3] {
+        1 => {
+            let mut a = [0; 6];
+            stream.read_exact(&mut a).await.unwrap();
+            SocketAddr::from(([a[0], a[1], a[2], a[3]], u16::from_be_bytes([a[4], a[5]])))
+        }
+        4 => {
+            let mut a = [0; 18];
+            stream.read_exact(&mut a).await.unwrap();
+            SocketAddr::new(
+                std::net::Ipv6Addr::from(<[u8; 16]>::try_from(&a[..16]).unwrap()).into(),
+                u16::from_be_bytes([a[16], a[17]]),
+            )
+        }
+        other => panic!("unexpected SOCKS address {other}"),
+    }
+}
+
+async fn socks(socks_port: u16, command: u8, dst: SocketAddr) -> (TcpStream, SocketAddr) {
+    let mut stream = TcpStream::connect(("127.0.0.1", socks_port)).await.unwrap();
+    stream.write_all(&[5, 1, 0]).await.unwrap();
+    let mut reply = [0; 2];
+    stream.read_exact(&mut reply).await.unwrap();
+    assert_eq!(reply, [5, 0]);
+    let mut req = vec![5, command, 0, 1, 127, 0, 0, 1];
+    req.extend_from_slice(&dst.port().to_be_bytes());
+    stream.write_all(&req).await.unwrap();
+    let bound = read_socks_address(&mut stream).await;
+    (stream, bound)
+}
+
+async fn interop(protocol: &str, mode: Option<&str>) {
+    let bin =
+        std::env::var_os("VP_SING_BOX").expect("VP_SING_BOX must identify verified official peer");
+    let version = Command::new(&bin).arg("version").output().unwrap();
+    assert!(version.status.success());
+    assert!(
+        String::from_utf8_lossy(&version.stdout).contains("sing-box version 1.14.4"),
+        "test peer must be pinned 1.14.4"
+    );
+    let cert = rcgen::generate_simple_self_signed(vec!["localhost".into()]).unwrap();
+    let uuid = "b831381d-6324-4d53-ad4f-8cda48b30811";
+    let password = format!("test-only-{:032x}", rand::random::<u128>());
+    let ctx = InboundCtx {
+        router: Arc::new(NoopRouter),
+        stats: Arc::default(),
+        conns: Arc::new(vp_core::ConnTable::new()),
+    };
+    let server: Arc<dyn Inbound> = match protocol {
+        "tuic" => Arc::new(vp_protocol::tuic::TuicInbound::new(
+            "127.0.0.1",
+            0,
+            "interop",
+            vec![(uuid.into(), password.clone())],
+            cert.cert.pem().into_bytes(),
+            cert.key_pair.serialize_pem().into_bytes(),
+        )),
+        "hysteria2" => Arc::new(vp_protocol::hysteria2::Hysteria2Inbound::new(
+            "127.0.0.1",
+            0,
+            "interop",
+            &password,
+            cert.cert.pem().into_bytes(),
+            cert.key_pair.serialize_pem().into_bytes(),
+        )),
+        _ => unreachable!(),
+    };
+    let port = server.start(ctx).await.unwrap();
+    let socks_reserve = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let socks_port = socks_reserve.local_addr().unwrap().port();
+    drop(socks_reserve);
+    let dir = std::env::temp_dir().join(format!(
+        "vp-quic-interop-{}-{:016x}",
+        std::process::id(),
+        rand::random::<u64>()
+    ));
+    std::fs::create_dir(&dir).unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o700)).unwrap();
+    }
+    std::fs::write(dir.join("cert.pem"), cert.cert.pem()).unwrap();
+    let mut outbound = serde_json::json!({"type":protocol,"tag":"proxy","server":"127.0.0.1","server_port":port,"password":password,
+        "tls":{"enabled":true,"server_name":"localhost","certificate_path":dir.join("cert.pem"),"alpn":["h3"]}});
