+// Established QUIC connections are tracked Work, not owned by the accept task.
+// Dropping ingress detaches only these join waiters; managed shutdown can drain the
+// connection tasks and then cancel/await their destructors deterministically.
+pub(crate) fn spawn_connection(
+    set: &mut JoinSet<()>,
+    future: impl std::future::Future<Output = ()> + Send + 'static,
+) {
+    let task = vp_core::task_scope::spawn(future);
+    set.spawn(async move {
+        let _ = task.await;
+    });
+}
+
+// JoinSet owns cancellation; the managed scope also awaits every child destructor.
+pub(crate) fn spawn_owned<T: Send + 'static>(
+    set: &mut JoinSet<T>,
+    future: impl std::future::Future<Output = T> + Send + 'static,
+) -> AbortHandle {
+    vp_core::task_scope::spawn_in(set, future)
+}
