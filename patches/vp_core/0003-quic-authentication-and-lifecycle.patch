+async fn managed_shutdown(proto: Protocol) {
+    use tokio::io::AsyncReadExt;
+    let rig = Rig::new(proto).await;
+    let raw = rig.connect().await;
+    rig.auth(&raw.conn, true).await;
+    let (tcp, udp) = targets().await;
+    let _request = rig.tcp(&raw.conn, tcp.local_addr().unwrap()).await.unwrap();
+    let (mut target, _) = timeout(Duration::from_secs(1), tcp.accept())
+        .await
+        .unwrap()
+        .unwrap();
+    rig.udp(&raw.conn, udp.local_addr().unwrap());
+    let mut buf = [0; 128];
+    let (_, udp_source) = timeout(Duration::from_secs(1), udp.recv_from(&mut buf))
+        .await
+        .unwrap()
+        .unwrap();
+    timeout(Duration::from_secs(1), async {
+        while rig.conns.is_empty() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    let report = rig
+        .scope
+        .shutdown(Duration::ZERO, Duration::from_secs(2))
+        .await;
+    assert_eq!(
+        report.remaining_tasks, 0,
+        "QUIC work must be owned by managed scope"
+    );
+    assert_eq!(report.panics, 0);
+    assert!(rig.conns.is_empty(), "canceled relay must unregister");
+    timeout(Duration::from_secs(1), raw.conn.closed())
+        .await
+        .unwrap();
+    let mut payload = Vec::new();
+    timeout(Duration::from_secs(1), target.read_to_end(&mut payload))
+        .await
+        .unwrap()
+        .unwrap();
+    let _released = UdpSocket::bind(udp_source)
+        .await
+        .expect("UDP association socket must be released on shutdown");
+    timeout(Duration::from_secs(1), async {
+        loop {
+            if let Ok(socket) = UdpSocket::bind(("127.0.0.1", rig.port)).await {
+                drop(socket);
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("QUIC listener port must be released");
+}
+#[tokio::test]
+async fn tuic_managed_shutdown_releases_connections_and_udp() {
+    managed_shutdown(Protocol::Tuic).await;
+}
+#[tokio::test]
+async fn hy2_managed_shutdown_releases_connections_and_udp() {
+    managed_shutdown(Protocol::Hy2).await;
+}
+
+async fn graceful_drain(proto: Protocol) {
+    let rig = Rig::new(proto).await;
+    let raw = rig.connect().await;
+    rig.auth(&raw.conn, true).await;
+    let (tcp, _) = targets().await;
+    let _request = rig.tcp(&raw.conn, tcp.local_addr().unwrap()).await;
+    let (_target, _) = timeout(Duration::from_secs(1), tcp.accept())
+        .await
+        .unwrap()
+        .unwrap();
+    let shutdown = rig
+        .scope
+        .shutdown(Duration::from_secs(1), Duration::from_secs(1));
+    let complete = async {
+        tokio::time::sleep(Duration::from_millis(50)).await;
+        assert!(
+            raw.conn.close_reason().is_none(),
+            "stopping ingress must not prematurely kill established QUIC work"
+        );
+        raw.conn.close(0u32.into(), b"graceful test completion");
+    };
+    let (report, _) = tokio::join!(shutdown, complete);
+    assert!(report.drained);
+    assert_eq!(report.forced_tasks, 0);
+    assert_eq!(report.remaining_tasks, 0);
+    assert!(rig.conns.is_empty());
+}
+#[tokio::test]
+async fn tuic_managed_listener_drains_existing_connections() {
+    graceful_drain(Protocol::Tuic).await;
+}
+#[tokio::test]
+async fn hy2_managed_listener_drains_existing_connections() {
+    graceful_drain(Protocol::Hy2).await;
+}
