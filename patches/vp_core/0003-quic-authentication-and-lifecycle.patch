+        "PASS independent sing-box 1.14.4 -> vp_core {protocol} {}: TCP echo/half-close, UDP two-way repeated/multi-target/stable-association, 6000-byte fragmentation",
+        mode.unwrap_or("datagram")
+    );
+}
