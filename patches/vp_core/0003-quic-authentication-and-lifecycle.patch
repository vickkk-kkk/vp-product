+fn send_udp_message(
+    conn: &quinn::Connection,
+    session: u32,
+    id: u16,
+    dst: &DstAddr,
+    payload: &[u8],
+) -> Result<()> {
+    if payload.len() > 65507 {
+        return Err(Error::Proto("hy2: oversized UDP"));
+    }
+    let addr = dst.to_string();
+    let max = conn
+        .max_datagram_size()
+        .ok_or(Error::Proto("hy2: datagrams disabled"))?;
+    let mut header = Vec::new();
+    header.extend_from_slice(&session.to_be_bytes());
+    header.extend_from_slice(&id.to_be_bytes());
+    header.extend_from_slice(&[0, 1]);
+    write_varint(&mut header, addr.len() as u64);
+    header.extend_from_slice(addr.as_bytes());
+    let chunk = max
+        .checked_sub(header.len())
+        .filter(|n| *n > 0)
+        .ok_or(Error::Proto("hy2: datagram too small"))?;
+    let total = payload.len().max(1).div_ceil(chunk);
+    if total > 255 {
+        return Err(Error::Proto("hy2: too many fragments"));
+    }
