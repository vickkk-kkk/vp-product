+        let mut msg = header.clone();
+        msg[6] = index as u8;
+        msg[7] = total as u8;
+        msg.extend_from_slice(
+            &payload[(index * chunk).min(payload.len())..((index + 1) * chunk).min(payload.len())],
+        );
+        conn.send_datagram(msg.into()).map_err(hy_error)?;
     }
