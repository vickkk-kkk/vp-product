+async fn resolve_udp(dst: &DstAddr) -> Result<SocketAddr> {
+    match &dst.host {
+        Host::Ip(ip) => Ok(SocketAddr::new(*ip, dst.port)),
+        Host::Domain(host) => tokio::time::timeout(
+            HEADER_TIMEOUT,
+            tokio::net::lookup_host((host.as_str(), dst.port)),
+        )
+        .await
+        .map_err(|_| Error::Proto("tuic: DNS timeout"))??
+        .next()
+        .ok_or(Error::Proto("tuic: no address")),
+    }
+}
