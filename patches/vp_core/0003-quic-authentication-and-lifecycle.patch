index 0000000..8093e77
--- /dev/null
+++ b/crates/vp-protocol/tests/quic_auth_negative.rs
@@ -0,0 +1,662 @@
+//! Raw-peer authentication regression tests. Assertions observe the destination side;
+//! a client-side rejection by itself is not treated as proof of no forwarding.
+use std::{net::SocketAddr, sync::Arc, time::Duration};
+use tokio::{
+    net::{TcpListener, UdpSocket},
+    time::timeout,
+};
+use vp_core::{Inbound, InboundCtx};
+
+const UUID: [u8; 16] = [
+    0xb8, 0x31, 0x38, 0x1d, 0x63, 0x24, 0x4d, 0x53, 0xad, 0x4f, 0x8c, 0xda, 0x48, 0xb3, 0x08, 0x11,
+];
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Protocol {
+    Tuic,
+    Hy2,
+}
+struct NoopRouter;
+#[async_trait::async_trait]
+impl vp_core::Router for NoopRouter {
+    async fn pick(&self, _: &vp_core::session::Session) -> vp_core::router::Resolution {
+        unreachable!()
+    }
+}
+struct Rig {
+    proto: Protocol,
+    port: u16,
+    password: String,
+    config: quinn::ClientConfig,
+    scope: Arc<vp_core::task_scope::TaskScope>,
+    conns: Arc<vp_core::ConnTable>,
+}
+impl Drop for Rig {
+    fn drop(&mut self) {
+        self.scope.cancel_all();
+    }
+}
+struct Raw {
+    _endpoint: quinn::Endpoint,
+    conn: quinn::Connection,
+    _controls: Vec<quinn::SendStream>,
+}
+impl Drop for Raw {
+    fn drop(&mut self) {
+        self.conn.close(0u32.into(), b"test done");
+    }
+}
+impl Rig {
+    async fn new(proto: Protocol) -> Self {
+        let cert = rcgen::generate_simple_self_signed(vec!["localhost".into()]).unwrap();
+        let password = format!("ephemeral-{:032x}", rand::random::<u128>());
+        let ctx = InboundCtx {
+            router: Arc::new(NoopRouter),
+            stats: Arc::default(),
+            conns: Arc::new(vp_core::ConnTable::new()),
+        };
+        let server: Arc<dyn Inbound> = match proto {
+            Protocol::Tuic => Arc::new(vp_protocol::tuic::TuicInbound::new(
+                "127.0.0.1",
+                0,
+                "negative",
+                vec![(
+                    "b831381d-6324-4d53-ad4f-8cda48b30811".into(),
+                    password.clone(),
+                )],
+                cert.cert.pem().into_bytes(),
+                cert.key_pair.serialize_pem().into_bytes(),
+            )),
+            Protocol::Hy2 => Arc::new(vp_protocol::hysteria2::Hysteria2Inbound::new(
+                "127.0.0.1",
+                0,
+                "negative",
+                &password,
+                cert.cert.pem().into_bytes(),
+                cert.key_pair.serialize_pem().into_bytes(),
+            )),
+        };
+        let conns = ctx.conns.clone();
+        let scope = vp_core::task_scope::TaskScope::new();
+        let port = scope.run(server.start(ctx)).await.unwrap();
+        let mut roots = rustls::RootCertStore::empty();
+        roots.add(cert.cert.der().clone()).unwrap();
+        let mut tls = rustls::ClientConfig::builder()
+            .with_root_certificates(roots)
+            .with_no_client_auth();
+        tls.alpn_protocols = vec![b"h3".to_vec()];
+        let mut config = quinn::ClientConfig::new(Arc::new(
+            quinn::crypto::rustls::QuicClientConfig::try_from(tls).unwrap(),
+        ));
+        let mut transport = quinn::TransportConfig::default();
+        transport.datagram_receive_buffer_size(Some(1 << 20));
+        config.transport_config(Arc::new(transport));
+        Self {
+            proto,
+            port,
+            password,
+            config,
+            scope,
+            conns,
+        }
+    }
+    async fn connect(&self) -> Raw {
+        let mut ep = quinn::Endpoint::client("127.0.0.1:0".parse().unwrap()).unwrap();
+        ep.set_default_client_config(self.config.clone());
+        let conn = ep
+            .connect(SocketAddr::from(([127, 0, 0, 1], self.port)), "localhost")
+            .unwrap()
+            .await
+            .unwrap();
+        let mut controls = Vec::new();
+        if self.proto == Protocol::Hy2 {
+            for data in [&[0u8, 4, 0][..], &[2][..], &[3][..]] {
+                let mut send = conn.open_uni().await.unwrap();
+                send.write_all(data).await.unwrap();
+                controls.push(send);
+            }
+        }
+        Raw {
+            _endpoint: ep,
+            conn,
+            _controls: controls,
+        }
+    }
+    fn auth_bytes(&self, conn: &quinn::Connection, correct: bool) -> Vec<u8> {
+        let password = if correct {
+            &self.password
+        } else {
+            "wrong-credential"
+        };
+        match self.proto {
+            Protocol::Tuic => {
+                let mut token = [0; 32];
+                conn.export_keying_material(&mut token, &UUID, password.as_bytes())
+                    .unwrap();
+                let mut auth = vec![5, 0];
+                auth.extend_from_slice(&UUID);
+                auth.extend_from_slice(&token);
+                auth
+            }
+            Protocol::Hy2 => headers(&[
+                (":method", "POST"),
+                (":scheme", "https"),
+                (":authority", "hysteria"),
+                (":path", "/auth"),
+                ("hysteria-auth", password),
+                ("hysteria-cc-rx", "0"),
+            ]),
+        }
+    }
+    async fn auth(&self, conn: &quinn::Connection, correct: bool) -> Option<Vec<u8>> {
+        let auth = self.auth_bytes(conn, correct);
+        if self.proto == Protocol::Tuic {
+            let Ok(mut send) = conn.open_uni().await else {
+                return None;
+            };
+            if send.write_all(&auth).await.is_err() {
+                return None;
+            }
+            let _ = send.finish();
+            None
+        } else {
+            let Ok((mut send, mut recv)) = conn.open_bi().await else {
+                return None;
+            };
+            if send.write_all(&auth).await.is_err() {
+                return None;
+            }
+            let _ = send.finish();
+            timeout(Duration::from_secs(1), recv.read_to_end(16384))
+                .await
+                .ok()?
+                .ok()
+        }
+    }
+    async fn tcp(
+        &self,
+        conn: &quinn::Connection,
+        dst: SocketAddr,
+    ) -> Option<(quinn::SendStream, quinn::RecvStream)> {
+        let Ok((mut send, recv)) = conn.open_bi().await else {
+            return None;
+        };
+        let mut req = if self.proto == Protocol::Tuic {
+            vec![5, 1, 1, 127, 0, 0, 1]
+        } else {
+            vec![0x44, 1]
+        };
+        if self.proto == Protocol::Tuic {
+            req.extend_from_slice(&dst.port().to_be_bytes());
+        } else {
+            let addr = dst.to_string();
+            varint(&mut req, addr.len() as u64);
+            req.extend_from_slice(addr.as_bytes());
+            req.push(0);
+        }
+        req.extend_from_slice(b"must-not-forward-before-auth");
+        if send.write_all(&req).await.is_err() {
+            return None;
+        }
+        Some((send, recv))
+    }
+    fn udp_bytes(&self, dst: SocketAddr) -> Vec<u8> {
+        if self.proto == Protocol::Tuic {
+            let mut msg = vec![5, 2, 0, 1, 0, 1, 1, 0, 0, 4, 1, 127, 0, 0, 1];
+            msg.extend_from_slice(&dst.port().to_be_bytes());
+            msg.extend_from_slice(b"test");
+            msg
+        } else {
+            let mut msg = vec![0, 0, 0, 1, 0, 1, 0, 1];
+            let addr = dst.to_string();
+            varint(&mut msg, addr.len() as u64);
+            msg.extend_from_slice(addr.as_bytes());
+            msg.extend_from_slice(b"test");
+            msg
+        }
+    }
+    fn udp(&self, conn: &quinn::Connection, dst: SocketAddr) {
+        let _ = conn.send_datagram(self.udp_bytes(dst).into());
+    }
+}
+fn varint(out: &mut Vec<u8>, n: u64) {
+    vp_protocol::hysteria2::write_varint(out, n);
+}
+fn pint(out: &mut Vec<u8>, n: usize, bits: u8, flags: u8) {
+    let max = (1usize << bits) - 1;
+    if n < max {
+        out.push(flags | n as u8);
+    } else {
+        out.push(flags | max as u8);
+        let mut n = n - max;
+        while n >= 128 {
+            out.push((n as u8 & 127) | 128);
+            n >>= 7;
+        }
+        out.push(n as u8);
+    }
+}
+fn headers(fields: &[(&str, &str)]) -> Vec<u8> {
+    let mut block = vec![0, 0];
+    for (name, value) in fields {
+        pint(&mut block, name.len(), 3, 0x20);
+        block.extend_from_slice(name.as_bytes());
+        pint(&mut block, value.len(), 7, 0);
+        block.extend_from_slice(value.as_bytes());
+    }
+    let mut frame = vec![1];
+    varint(&mut frame, block.len() as u64);
+    frame.extend_from_slice(&block);
+    frame
+}
+async fn targets() -> (TcpListener, UdpSocket) {
+    (
+        TcpListener::bind("127.0.0.1:0").await.unwrap(),
+        UdpSocket::bind("127.0.0.1:0").await.unwrap(),
+    )
+}
+async fn quiet(tcp: &TcpListener, udp: &UdpSocket) {
+    let mut buf = [0; 128];
+    assert!(
+        timeout(Duration::from_millis(100), tcp.accept())
+            .await
+            .is_err(),
+        "unauthorized target TCP connection"
+    );
+    assert!(
+        timeout(Duration::from_millis(100), udp.recv_from(&mut buf))
+            .await
+            .is_err(),
+        "unauthorized target UDP packet"
+    );
+}
+
+async fn missing_and_stalled(proto: Protocol) {
+    let rig = Rig::new(proto).await;
+    for partial in [false, true] {
+        let raw = rig.connect().await;
+        let (tcp, udp) = targets().await;
+        let _request = rig.tcp(&raw.conn, tcp.local_addr().unwrap()).await.unwrap();
+        rig.udp(&raw.conn, udp.local_addr().unwrap());
+        let _stalled = if partial {
+            if proto == Protocol::Tuic {
+                let mut s = raw.conn.open_uni().await.unwrap();
+                s.write_all(&[5, 0, 0]).await.unwrap();
+                Some(s)
+            } else {
+                let (mut s, _r) = raw.conn.open_bi().await.unwrap();
+                s.write_all(&[1, 0x7f]).await.unwrap();
+                Some(s)
+            }
+        } else {
+            None
+        };
+        quiet(&tcp, &udp).await;
+        timeout(Duration::from_secs(4), raw.conn.closed())
+            .await
+            .expect("unauthenticated connection must expire");
+        quiet(&tcp, &udp).await;
+    }
+}
+#[tokio::test]
+async fn tuic_missing_and_stalled_auth_never_forward() {
+    missing_and_stalled(Protocol::Tuic).await
+}
+#[tokio::test]
+async fn hy2_missing_and_stalled_auth_never_forward() {
+    missing_and_stalled(Protocol::Hy2).await
+}
+
+async fn incorrect_then_correct(proto: Protocol) {
+    let rig = Rig::new(proto).await;
+    let raw = rig.connect().await;
+    let (tcp, udp) = targets().await;
+    let _request = rig.tcp(&raw.conn, tcp.local_addr().unwrap()).await;
+    rig.udp(&raw.conn, udp.local_addr().unwrap());
+    let denied = rig.auth(&raw.conn, false).await;
+    if proto == Protocol::Hy2 {
+        assert!(denied.unwrap().windows(3).any(|w| w == b"404"));
+    }
+    quiet(&tcp, &udp).await;
+    let retry = rig.auth(&raw.conn, true).await;
+    if proto == Protocol::Hy2 {
+        assert!(retry.unwrap().windows(3).any(|w| w == b"404"));
+    }
+    let _retry_request = rig.tcp(&raw.conn, tcp.local_addr().unwrap()).await;
+    rig.udp(&raw.conn, udp.local_addr().unwrap());
+    quiet(&tcp, &udp).await;
+}
+#[tokio::test]
+async fn tuic_bad_auth_is_terminal() {
+    incorrect_then_correct(Protocol::Tuic).await
+}
+#[tokio::test]
+async fn hy2_bad_auth_is_terminal() {
+    incorrect_then_correct(Protocol::Hy2).await
+}
+
+async fn delayed_valid(proto: Protocol) {
+    let rig = Rig::new(proto).await;
+    let raw = rig.connect().await;
+    let (tcp, udp) = targets().await;
+    // Hold an unrelated header open: it cannot block the authentication stream.
+    let (mut stalled, _r) = raw.conn.open_bi().await.unwrap();
+    stalled.write_all(&[0x44]).await.unwrap();
+    let _request = rig.tcp(&raw.conn, tcp.local_addr().unwrap()).await.unwrap();
+    rig.udp(&raw.conn, udp.local_addr().unwrap());
+    quiet(&tcp, &udp).await;
+    let auth = rig.auth(&raw.conn, true).await;
+    if proto == Protocol::Hy2 {
+        assert!(auth.unwrap().windows(3).any(|w| w == b"233"));
+    }
+    let (_target, _) = timeout(Duration::from_secs(1), tcp.accept())
+        .await
+        .unwrap()
+        .unwrap();
+    if proto == Protocol::Hy2 {
+        rig.udp(&raw.conn, udp.local_addr().unwrap());
+    }
+    let mut buf = [0; 128];
+    let (n, _) = timeout(Duration::from_secs(1), udp.recv_from(&mut buf))
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(&buf[..n], b"test");
+    // A new unauthenticated connection cannot inherit the previous one's auth bit.
+    let other = rig.connect().await;
+    let (tcp2, udp2) = targets().await;
+    let _request = rig
+        .tcp(&other.conn, tcp2.local_addr().unwrap())
+        .await
+        .unwrap();
+    rig.udp(&other.conn, udp2.local_addr().unwrap());
+    quiet(&tcp2, &udp2).await;
+}
