+        outbound["congestion_control"] = "cubic".into();
+        outbound["udp_relay_mode"] = mode.unwrap().into();
+    }
+    let config = serde_json::json!({"log":{"level":"error"},"inbounds":[{"type":"socks","listen":"127.0.0.1","listen_port":socks_port}],"outbounds":[outbound]});
+    std::fs::write(
+        dir.join("config.json"),
+        serde_json::to_vec(&config).unwrap(),
+    )
+    .unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(
+            dir.join("config.json"),
+            std::fs::Permissions::from_mode(0o600),
+        )
+        .unwrap();
+    }
+    let child = Command::new(&bin)
+        .args(["run", "-c"])
+        .arg(dir.join("config.json"))
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::inherit())
+        .spawn()
+        .unwrap();
+    let mut peer = Peer { child, dir };
+    tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            assert!(
+                peer.child.try_wait().unwrap().is_none(),
+                "reference peer exited during startup"
+            );
+            if TcpStream::connect(("127.0.0.1", socks_port)).await.is_ok() {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await
+    .unwrap();
+    let mut tasks = JoinSet::new();
+    let tcp = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let tcp_addr = tcp.local_addr().unwrap();
+    tasks.spawn(async move {
+        let (mut s, _) = tcp.accept().await.unwrap();
+        let (mut rd, mut wr) = s.split();
+        tokio::io::copy(&mut rd, &mut wr).await.unwrap();
+    });
+    let (mut stream, _) = socks(socks_port, 1, tcp_addr).await;
+    let payload = b"independent-peer-TCP-payload";
+    stream.write_all(payload).await.unwrap();
+    let mut reply = vec![0; payload.len()];
+    stream.read_exact(&mut reply).await.unwrap();
+    assert_eq!(reply, payload);
+    stream.shutdown().await.unwrap();
+    let mut eof = [0];
+    assert_eq!(
+        stream.read(&mut eof).await.unwrap(),
+        0,
+        "half-close preserves return stream"
+    );
+
+    let client_udp = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+    let (_association, relay) = socks(socks_port, 3, client_udp.local_addr().unwrap()).await;
+    // One association, two destinations, repeated packets, and fragmentation-sized payloads.
+    // Source port must remain stable per association instead of allocating one per packet.
+    let mut expected_source = None;
+    for i in 0..4 {
+        let target = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let target_addr = target.local_addr().unwrap();
+        let body = vec![0x31 + i; if i % 2 == 0 { 73 } else { 6000 }];
+        let mut message = vec![0, 0, 0, 1, 127, 0, 0, 1];
+        message.extend_from_slice(&target_addr.port().to_be_bytes());
+        message.extend_from_slice(&body);
+        client_udp.send_to(&message, relay).await.unwrap();
+        let mut buf = vec![0; 65535];
+        let (n, source) = target.recv_from(&mut buf).await.unwrap();
+        assert_eq!(&buf[..n], &body);
+        if let Some(expected) = expected_source {
+            assert_eq!(source, expected, "UDP association changed source socket");
+        }
+        expected_source = Some(source);
+        target.send_to(&buf[..n], source).await.unwrap();
+        let (n, _) = client_udp.recv_from(&mut buf).await.unwrap();
+        assert_eq!(&buf[10..n], &body, "UDP reply from independent peer");
+    }
