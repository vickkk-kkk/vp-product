+// Compare credential-derived tags through ring's public constant-time HMAC verification API.
+pub(crate) fn credentials_equal(expected: &[u8], received: &[u8]) -> bool {
+    let key = ring::hmac::Key::new(ring::hmac::HMAC_SHA256, b"vp-quic-credential-comparison-v1");
+    let tag = ring::hmac::sign(&key, expected);
+    ring::hmac::verify(&key, received, tag.as_ref()).is_ok()
+}
