+/// Explicit managed-host forwarding authority. Domain names are denied in
+/// loopback-only mode before DNS; resolving localhost is not an authority check.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DestinationPolicy {
+    Unrestricted,
+    LoopbackIpOnly,
+}
+
+pub fn destination_policy() -> DestinationPolicy {
+    CURRENT
+        .try_with(|scope| scope.destination_policy)
+        .unwrap_or(DestinationPolicy::Unrestricted)
+}
+pub fn check_destination(dst: &vp_common::DstAddr) -> vp_common::Result<()> {
+    if destination_policy() == DestinationPolicy::LoopbackIpOnly
+        && !matches!(&dst.host, vp_common::Host::Ip(ip) if ip.is_loopback())
+    {
+        return Err(vp_common::Error::Unsupported(
+            "managed host permits loopback IP destinations only".into(),
+        ));
+    }
+    Ok(())
+}
+
 pub struct TaskScope {
+    destination_policy: DestinationPolicy,
     state: Mutex<State>,
     changed: Notify,
 }
 impl TaskScope {
     pub fn new() -> Arc<Self> {
+        Self::with_destination_policy(DestinationPolicy::Unrestricted)
+    }
+    pub fn with_destination_policy(destination_policy: DestinationPolicy) -> Arc<Self> {
         Arc::new(Self {
+            destination_policy,
             state: Mutex::new(State {
                 phase: Phase::Running,
                 next: 0,
@@ -475,3 +504,46 @@ mod tests {
