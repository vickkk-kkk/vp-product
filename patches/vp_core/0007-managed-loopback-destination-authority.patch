     }
 }
+
+#[cfg(test)]
+mod destination_tests {
+    use super::*;
+    use vp_common::{DstAddr, Host};
+    #[tokio::test]
+    async fn loopback_policy_is_inherited_and_rejects_names_before_dns() {
+        let scope = TaskScope::with_destination_policy(DestinationPolicy::LoopbackIpOnly);
+        scope
+            .run(async {
+                for host in [
+                    Host::Ip("127.0.0.1".parse().unwrap()),
+                    Host::Ip("::1".parse().unwrap()),
+                ] {
+                    assert!(check_destination(&DstAddr { host, port: 80 }).is_ok());
+                }
+                for host in [
+                    Host::Ip("192.0.2.1".parse().unwrap()),
+                    Host::Domain("localhost".into()),
+                    Host::Domain("example.invalid".into()),
+                ] {
+                    let dst = DstAddr { host, port: 80 };
+                    assert!(check_destination(&dst).is_err());
+                    assert!(
+                        spawn(async move { check_destination(&dst) })
+                            .await
+                            .unwrap()
+                            .is_err()
+                    );
+                }
+            })
+            .await;
+        assert!(
+            check_destination(&DstAddr {
+                host: Host::Domain("example.invalid".into()),
+                port: 80
+            })
+            .is_ok()
+        );
+        let stopped = scope.shutdown(Duration::ZERO, Duration::from_secs(1)).await;
+        assert_eq!(stopped.remaining_tasks, 0);
+    }
+}
