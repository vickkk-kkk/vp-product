+#[tokio::test]
+async fn ss2022_mixed_family_replies_reject_unsolicited_plaintext_sources() {
+    for method in &METHODS[4..] {
+        let (cipher, password, key) = credentials(method);
+        let port = inbound(method, &password).await;
+        let target4 = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let target6 = ipv6_loopback().await;
+        let attacker4 = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let attacker6 = ipv6_loopback().await;
+        let mut client = vp_protocol::udp_out::SsUdpConn::bind("127.0.0.1", port, cipher, key)
+            .await
+            .unwrap();
+        for (target, attacker) in [(&target4, &attacker4), (&target6, &attacker6)] {
+            let dst = target.local_addr().unwrap();
+            client
+                .send(&UdpPacket {
+                    src: dst,
+                    dst,
+                    data: b"authorized"[..].into(),
+                })
+                .await
+                .unwrap();
+            let mut buffer = [0; 1024];
+            let (_, relay) = timeout(Duration::from_secs(2), target.recv_from(&mut buffer))
+                .await
+                .unwrap()
+                .unwrap();
+            attacker.send_to(b"unsolicited", relay).await.unwrap();
+            assert!(
+                timeout(Duration::from_millis(80), client.recv())
+                    .await
+                    .is_err(),
+                "{method}: authenticated association must not encrypt unsolicited plaintext source"
+            );
+            target.send_to(b"authorized-reply", relay).await.unwrap();
+            let response = timeout(Duration::from_secs(2), client.recv())
+                .await
+                .unwrap()
+                .unwrap();
+            assert_eq!(response.src, dst);
+            assert_eq!(&response.data[..], b"authorized-reply");
+        }
+    }
+}
