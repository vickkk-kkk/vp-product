+/// Authenticated UDP frame. `payload` is SOCKS address followed by application data.
+/// Replay state is deliberately separate and may only be advanced after address
+/// and session association validation by the caller.
+pub struct UdpFrame {
+    pub session_id: u64,
+    pub packet_id: u64,
+    pub client_session_id: Option<u64>,
+    pub payload: Vec<u8>,
+    pub salt: Vec<u8>,
+}
+
+impl Cipher {
+    pub fn seal_udp(
+        &self,
+        key: &[u8],
+        payload: &[u8],
+        session_id: u64,
+        packet_id: u64,
+        client_session_id: Option<u64>,
+    ) -> Result<Vec<u8>> {
+        if !self.is_2022 {
+            let mut salt = vec![0; self.salt_len()];
+            vp_common::rand_bytes(&mut salt);
+            let subkey = self.subkey(key, &salt)?;
+            salt.extend_from_slice(&SsAead::new(self, &subkey)?.seal(&[0; 24], payload));
+            return Ok(salt);
+        }
+        let mut separate = [0; 16];
+        separate[..8].copy_from_slice(&session_id.to_be_bytes());
+        separate[8..].copy_from_slice(&packet_id.to_be_bytes());
+        let mut body = vec![u8::from(client_session_id.is_some())];
+        body.extend_from_slice(&unix_seconds().to_be_bytes());
+        if let Some(client) = client_session_id {
+            body.extend_from_slice(&client.to_be_bytes());
+        }
+        body.extend_from_slice(&0u16.to_be_bytes()); // UDP padding is optional.
+        body.extend_from_slice(payload);
+        if self.kind == AeadKind::ChaCha20Poly1305 {
+            let mut nonce = [0; 24];
+            vp_common::rand_bytes(&mut nonce);
+            let aead = XChaCha20Poly1305::new_from_slice(key)
+                .map_err(|_| Error::Proto("invalid XChaCha key"))?;
+            let mut plain = separate.to_vec();
+            plain.extend_from_slice(&body);
+            let mut out = nonce.to_vec();
+            out.extend_from_slice(
+                &aead
+                    .encrypt(XNonce::from_slice(&nonce), plain.as_slice())
+                    .map_err(|_| Error::Proto("SS2022 UDP encryption failed"))?,
+            );
+            Ok(out)
+        } else {
+            let subkey = self.subkey(key, &separate[..8])?;
+            let ciphertext =
+                self.aead(&subkey)?
+                    .seal_nonce(separate[4..].try_into().unwrap(), &body, b"");
+            aes_header(self.kind, key, &mut separate, false)?;
+            let mut out = separate.to_vec();
+            out.extend_from_slice(&ciphertext);
+            Ok(out)
+        }
+    }
+
+    pub fn open_udp(&self, key: &[u8], packet: &[u8], server_response: bool) -> Result<UdpFrame> {
+        if !self.is_2022 {
+            let size = self.salt_len();
+            if packet.len() < size + 16 {
+                return Err(Error::Proto("short SS UDP packet"));
+            }
+            let salt = packet[..size].to_vec();
+            let subkey = self.subkey(key, &salt)?;
+            let payload = SsAead::new(self, &subkey)?.open(&[0; 24], &packet[size..])?;
+            return Ok(UdpFrame {
+                session_id: 0,
+                packet_id: 0,
+                client_session_id: None,
+                payload,
+                salt,
+            });
+        }
+        let (separate, body) = if self.kind == AeadKind::ChaCha20Poly1305 {
+            if packet.len() < 24 + 16 + 16 {
+                return Err(Error::Proto("short SS2022 UDP packet"));
+            }
+            let aead = XChaCha20Poly1305::new_from_slice(key)
+                .map_err(|_| Error::Proto("invalid XChaCha key"))?;
+            let plain = aead
+                .decrypt(XNonce::from_slice(&packet[..24]), &packet[24..])
+                .map_err(|_| Error::Proto("SS2022 UDP authentication failed"))?;
+            (plain[..16].to_vec(), plain[16..].to_vec())
+        } else {
+            if packet.len() < 32 {
+                return Err(Error::Proto("short SS2022 UDP packet"));
+            }
+            let mut separate: [u8; 16] = packet[..16].try_into().unwrap();
+            aes_header(self.kind, key, &mut separate, true)?;
+            let subkey = self.subkey(key, &separate[..8])?;
+            let body = self.aead(&subkey)?.open_nonce(
+                separate[4..].try_into().unwrap(),
+                &packet[16..],
+                b"",
+            )?;
+            (separate.to_vec(), body)
+        };
+        let prefix = 9 + if server_response { 8 } else { 0 };
+        if body.len() < prefix + 2 || body[0] != u8::from(server_response) {
+            return Err(Error::Proto("invalid SS2022 UDP header type/size"));
+        }
+        validate_timestamp(u64::from_be_bytes(body[1..9].try_into().unwrap()))?;
+        let client_session_id = if server_response {
+            Some(u64::from_be_bytes(body[9..17].try_into().unwrap()))
+        } else {
+            None
         };
-        self.counter += 2;
-        Some(Ok((data, total)))
+        let padding = u16::from_be_bytes(body[prefix..prefix + 2].try_into().unwrap()) as usize;
+        let offset = prefix + 2 + padding;
+        if offset >= body.len() {
+            return Err(Error::Proto("invalid SS2022 UDP padding"));
+        }
+        Ok(UdpFrame {
+            session_id: u64::from_be_bytes(separate[..8].try_into().unwrap()),
+            packet_id: u64::from_be_bytes(separate[8..].try_into().unwrap()),
+            client_session_id,
+            payload: body[offset..].to_vec(),
+            salt: Vec::new(),
+        })
+    }
+}
+
+fn aes_header(kind: AeadKind, key: &[u8], header: &mut [u8; 16], decrypt: bool) -> Result<()> {
+    use aes::cipher::{BlockDecrypt, BlockEncrypt, KeyInit};
+    let block = aes::cipher::generic_array::GenericArray::from_mut_slice(header);
+    match kind {
+        AeadKind::Aes128Gcm => {
+            let aes =
+                aes::Aes128::new_from_slice(key).map_err(|_| Error::Proto("invalid AES key"))?;
+            if decrypt {
+                aes.decrypt_block(block);
+            } else {
+                aes.encrypt_block(block);
+            }
+        }
+        AeadKind::Aes256Gcm => {
+            let aes =
+                aes::Aes256::new_from_slice(key).map_err(|_| Error::Proto("invalid AES key"))?;
+            if decrypt {
+                aes.decrypt_block(block);
+            } else {
+                aes.encrypt_block(block);
+            }
+        }
+        _ => return Err(Error::Proto("AES header requested for non-AES cipher")),
+    }
+    Ok(())
+}
