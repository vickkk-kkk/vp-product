diff --git a/crates/vp-protocol/tests/reference_ss/main.go b/crates/vp-protocol/tests/reference_ss/main.go
new file mode 100644
index 0000000..8819a10
--- /dev/null
+++ b/crates/vp-protocol/tests/reference_ss/main.go
@@ -0,0 +1,113 @@
+// Test-only adapter: all Shadowsocks implementation code remains unmodified upstream.
+package main
+
+import (
+ "bytes"
+ "context"
+ "encoding/json"
+ "errors"
+ "fmt"
+ "io"
+ "net"
+ "os"
+ "strings"
+ "time"
+
+ SS "github.com/sagernet/sing-shadowsocks"
+ "github.com/sagernet/sing-shadowsocks/shadowaead"
+ SS22 "github.com/sagernet/sing-shadowsocks/shadowaead_2022"
+ "github.com/sagernet/sing/common/buf"
+ M "github.com/sagernet/sing/common/metadata"
+ N "github.com/sagernet/sing/common/network"
+)
+
+type input struct { Method, Password, Mode string; Port uint16; Negative bool }
+func deadline()time.Time{return time.Now().Add(5*time.Second)}
+func method(c input)(SS.Method,error){
+ if strings.HasPrefix(c.Method,"2022-"){return SS22.NewWithPassword(c.Method,c.Password,nil)}
+ return shadowaead.New(c.Method,nil,c.Password)
+}
+func runClient(c input)error{
+ if c.Port==0{return errors.New("missing loopback server port")}
+ m,err:=method(c);if err!=nil{return err}
+ target,err:=net.ListenTCP("tcp4",&net.TCPAddr{IP:net.IPv4(127,0,0,1)});if err!=nil{return err};defer target.Close()
+ udpTarget,err:=net.ListenUDP("udp4",&net.UDPAddr{IP:net.IPv4(127,0,0,1)});if err!=nil{return err};defer udpTarget.Close()
+ server:=fmt.Sprintf("127.0.0.1:%d",c.Port)
+ raw,err:=net.DialTimeout("tcp4",server,3*time.Second);if err!=nil{return err};defer raw.Close();raw.SetDeadline(deadline())
+ conn,err:=m.DialConn(raw,M.SocksaddrFromNet(target.Addr()));if err!=nil&&!c.Negative{return fmt.Errorf("TCP handshake: %w",err)}
+ if c.Negative {
+  if err==nil{defer conn.Close();conn.Write([]byte("must-not-arrive"))}
+  wire,e:=net.DialTimeout("udp4",server,3*time.Second);if e!=nil{return e};defer wire.Close()
+  packet:=m.DialPacketConn(wire);packet.SetDeadline(deadline());packet.WriteTo([]byte("must-not-arrive"),udpTarget.LocalAddr())
+  target.SetDeadline(time.Now().Add(200*time.Millisecond));if remote,e:=target.Accept();e==nil{remote.Close();return errors.New("invalid credentials reached TCP target")}
+  udpTarget.SetReadDeadline(time.Now().Add(200*time.Millisecond));if _,_,e:=udpTarget.ReadFrom(make([]byte,100));e==nil{return errors.New("invalid credentials reached UDP target")}
+  return json.NewEncoder(os.Stdout).Encode(map[string]any{"ok":true,"kind":"official-protocol-library","method":c.Method,"negative":true})
+ }
+ defer conn.Close()
+ go func(){remote,e:=target.AcceptTCP();if e==nil{defer remote.Close();remote.SetDeadline(deadline());io.Copy(remote,remote)}}()
+ body:=bytes.Repeat([]byte("independent-reference-tcp"),2000)
+ if _,err=conn.Write(body);err!=nil{return fmt.Errorf("TCP write: %w",err)}
+ got:=make([]byte,len(body));if _,err=io.ReadFull(conn,got);err!=nil{return fmt.Errorf("TCP read: %w",err)}
+ if !bytes.Equal(got,body){return errors.New("TCP payload mismatch")}
+ wire,err:=net.DialTimeout("udp4",server,3*time.Second);if err!=nil{return err};defer wire.Close()
+ packet:=m.DialPacketConn(wire);defer packet.Close();packet.SetDeadline(deadline())
+ previous:=""
+ for _,size:=range []int{1,128,4096}{
+  body=bytes.Repeat([]byte{0x53},size);udpTarget.SetDeadline(deadline())
+  if _,err=packet.WriteTo(body,udpTarget.LocalAddr());err!=nil{return fmt.Errorf("UDP write: %w",err)}
+  received:=make([]byte,65535);n,source,e:=udpTarget.ReadFrom(received);if e!=nil{return fmt.Errorf("UDP target: %w",e)}
+  if !bytes.Equal(body,received[:n]){return errors.New("UDP target payload mismatch")}
+  if previous!=""&&previous!=source.String(){return errors.New("UDP session outgoing source changed")};previous=source.String()
+  if _,e=udpTarget.WriteTo(received[:n],source);e!=nil{return e}
+  n,source,e=packet.ReadFrom(received);if e!=nil{return fmt.Errorf("UDP reply: %w",e)}
+  if !bytes.Equal(body,received[:n])||source.String()!=udpTarget.LocalAddr().String(){return errors.New("UDP reply payload/address mismatch")}
+ }
+ return json.NewEncoder(os.Stdout).Encode(map[string]any{"ok":true,"kind":"official-protocol-library","method":c.Method,"tcp":true,"udp_sizes":[]int{1,128,4096},"udp_source_stable":true})
+}
+
+type handler struct{}
+func(handler)NewError(_ context.Context,e error){fmt.Fprintln(os.Stderr,"reference handler:",e)}
+func(handler)NewConnection(_ context.Context,conn net.Conn,metadata M.Metadata)error{
+ defer conn.Close()
+ if !metadata.Destination.Addr.IsLoopback(){return errors.New("non-loopback destination refused")}
+ target,err:=net.DialTimeout("tcp",metadata.Destination.String(),3*time.Second);if err!=nil{return err};defer target.Close()
+ conn.SetDeadline(deadline());target.SetDeadline(deadline())
+ done:=make(chan struct{});go func(){io.Copy(target,conn);if tcp,ok:=target.(*net.TCPConn);ok{tcp.CloseWrite()};close(done)}()
+ _,err=io.Copy(conn,target);conn.Close();<-done;return err
+}
+func(handler)NewPacketConnection(_ context.Context,conn N.PacketConn,_ M.Metadata)error{
+ defer conn.Close()
+ target,err:=net.ListenUDP("udp4",&net.UDPAddr{IP:net.IPv4(127,0,0,1)});if err!=nil{return err};defer target.Close()
+ for {
+  incoming:=buf.NewPacket();destination,e:=conn.ReadPacket(incoming);if e!=nil{incoming.Release();return e}
+  if !destination.Addr.IsLoopback(){incoming.Release();return errors.New("non-loopback UDP target refused")}
+  target.SetDeadline(deadline());_,e=target.WriteToUDP(incoming.Bytes(),destination.UDPAddr());incoming.Release();if e!=nil{return e}
+  response:=buf.NewSize(65535);response.Resize(1024,0)
+  n,source,e:=target.ReadFromUDP(response.FreeBytes());if e!=nil{response.Release();return e};response.Truncate(n)
+  if e=conn.WritePacket(response,M.SocksaddrFromNet(source));e!=nil{return e}
+ }
+}
+type wirePacket struct{*net.UDPConn}
+func(w wirePacket)ReadPacket(b *buf.Buffer)(M.Socksaddr,error){_,from,e:=b.ReadPacketFrom(w.UDPConn);if e!=nil{return M.Socksaddr{},e};return M.SocksaddrFromNet(from),nil}
+func(w wirePacket)WritePacket(b *buf.Buffer,destination M.Socksaddr)error{
+ defer b.Release();if !destination.Addr.IsLoopback(){return errors.New("non-loopback UDP recipient refused")}
+ _,err:=w.WriteToUDP(b.Bytes(),destination.UDPAddr());return err
+}
+func runServer(c input)error{
+ tcp,err:=net.ListenTCP("tcp4",&net.TCPAddr{IP:net.IPv4(127,0,0,1)});if err!=nil{return err};defer tcp.Close()
+ udp,err:=net.ListenUDP("udp4",&net.UDPAddr{IP:net.IPv4(127,0,0,1),Port:tcp.Addr().(*net.TCPAddr).Port});if err!=nil{return err};defer udp.Close()
+ var service SS.Service
+ if strings.HasPrefix(c.Method,"2022-"){service,err=SS22.NewServiceWithPassword(c.Method,c.Password,300,handler{},nil)}else{service,err=shadowaead.NewService(c.Method,nil,c.Password,300,handler{})};if err!=nil{return err}
+ ctx,cancel:=context.WithTimeout(context.Background(),20*time.Second);defer cancel()
+ go func(){for{conn,e:=tcp.Accept();if e!=nil{return};go func(){conn.SetDeadline(deadline());if e:=service.NewConnection(ctx,conn,M.Metadata{Source:M.SocksaddrFromNet(conn.RemoteAddr())});e!=nil{conn.Close()}}()}}()
+ go func(){for{packet:=buf.NewPacket();_,from,e:=packet.ReadPacketFrom(udp);if e!=nil{packet.Release();return};if e=service.NewPacket(ctx,wirePacket{udp},packet,M.Metadata{Source:M.SocksaddrFromNet(from)});e!=nil{packet.Release()}}}()
+ if err=json.NewEncoder(os.Stdout).Encode(map[string]any{"ready":tcp.Addr().(*net.TCPAddr).Port,"kind":"official-protocol-library"});err!=nil{return err}
+ // Parent keeps stdin open during tests; closing it terminates this isolated peer.
+ done:=make(chan struct{});go func(){io.Copy(io.Discard,os.Stdin);close(done)}()
+ select{case <-done:return nil;case <-ctx.Done():return ctx.Err()}
+}
+func main(){
+ var c input;if err:=json.NewDecoder(io.LimitReader(os.Stdin,16384)).Decode(&c);err!=nil{fmt.Fprintln(os.Stderr,err);os.Exit(1)}
+ var err error;switch c.Mode{case "client":err=runClient(c);case "server":err=runServer(c);default:err=errors.New("invalid fixture mode")}
+ if err!=nil{fmt.Fprintln(os.Stderr,"reference-ss:",err);os.Exit(1)}
+}
diff --git a/crates/vp-protocol/tests/ss_library_interop.rs b/crates/vp-protocol/tests/ss_library_interop.rs
