+#[tokio::test]
+async fn ss2022_mixed_family_target_quota_preserves_established_destinations() {
+    let method = "2022-blake3-aes-128-gcm";
+    let (cipher, password, key) = credentials(method);
+    let port = inbound(method, &password).await;
+    let client = vp_protocol::udp_out::SsUdpConn::bind("127.0.0.1", port, cipher, key)
+        .await
+        .unwrap();
+    let mut targets = Vec::new();
+    let mut source_port = None;
+    for index in 0..65 {
+        let target = if index % 2 == 0 {
+            UdpSocket::bind("127.0.0.1:0").await.unwrap()
+        } else {
+            ipv6_loopback().await
+        };
+        let dst = target.local_addr().unwrap();
+        client
+            .send(&UdpPacket {
+                src: dst,
+                dst,
+                data: b"quota"[..].into(),
+            })
+            .await
+            .unwrap();
+        if index < 64 {
+            let (_, source) = timeout(Duration::from_secs(2), target.recv_from(&mut [0; 100]))
+                .await
+                .unwrap()
+                .unwrap();
+            if let Some(previous) = source_port {
+                assert_eq!(source.port(), previous)
+            } else {
+                source_port = Some(source.port())
+            }
+        } else {
+            assert!(
+                timeout(Duration::from_millis(80), target.recv_from(&mut [0; 100]))
+                    .await
+                    .is_err(),
+                "65th distinct target must fail closed instead of evicting an established destination"
+            );
+        }
+        targets.push(target);
+    }
+    // Capacity failure does not discard the authenticated session, replay state,
+    // stable source port, or existing target authorization.
+    let target = &targets[1];
+    let dst = target.local_addr().unwrap();
+    client
+        .send(&UdpPacket {
+            src: dst,
+            dst,
+            data: b"existing-still-works"[..].into(),
+        })
+        .await
+        .unwrap();
+    let mut data = [0; 100];
+    let (n, source) = timeout(Duration::from_secs(2), target.recv_from(&mut data))
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(&data[..n], b"existing-still-works");
+    assert_eq!(Some(source.port()), source_port);
+}
