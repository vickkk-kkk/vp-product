+/// Exact 1024-packet replay window. Advancing is only allowed after authentication
+/// and complete semantic validation. An old/out-of-window packet fails closed.
+#[derive(Default)]
+pub struct ReplayWindow {
+    highest: Option<u64>,
+    seen: std::collections::BTreeSet<u64>,
+}
+impl ReplayWindow {
+    pub fn accept(&mut self, packet: u64) -> bool {
+        if self.seen.contains(&packet)
+            || self
+                .highest
+                .is_some_and(|h| h.saturating_sub(packet) >= 1024)
+        {
+            return false;
+        }
+        let highest = self.highest.map_or(packet, |h| h.max(packet));
+        self.highest = Some(highest);
+        self.seen.retain(|p| highest.saturating_sub(*p) < 1024);
+        self.seen.insert(packet);
+        true
     }
 }
 
