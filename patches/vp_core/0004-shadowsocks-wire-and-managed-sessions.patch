+#[tokio::test]
+async fn ss2022_client_rejects_misassociated_tcp_response() {
+    for method in &METHODS[4..] {
+        let (cipher, password, key) = credentials(method);
+        let fake = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let port = fake.local_addr().unwrap().port();
+        let peer = tokio::spawn(async move {
+            let (mut stream, _) = fake.accept().await.unwrap();
+            let mut request_salt = vec![0; cipher.salt_len()];
+            stream.read_exact(&mut request_salt).await.unwrap();
+            request_salt[0] ^= 1;
+            let own_salt = vec![0x77; cipher.salt_len()];
+            let mut enc =
+                AeadChunkCodec::new(&cipher, &cipher.subkey(&key, &own_salt).unwrap()).unwrap();
+            let mut fixed = vec![1];
+            fixed.extend_from_slice(&vp_crypto::ss::unix_seconds().to_be_bytes());
+            fixed.extend_from_slice(&request_salt);
+            fixed.extend_from_slice(&4u16.to_be_bytes());
+            let mut response = own_salt;
+            response.extend_from_slice(&enc.seal_record(&fixed));
+            response.extend_from_slice(&enc.seal_record(b"evil"));
+            stream.write_all(&response).await.unwrap();
+            // Stay alive until the client validates, avoiding an unread-data RST.
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        });
+        let out = outbound(method, &password, port);
+        let dst = DstAddr::ip("127.0.0.1".parse().unwrap(), 80);
+        let mut stream = out
+            .connect_stream(&Session::new_tcp("test".into(), None, dst.clone()), &dst)
+            .await
+            .unwrap();
+        let error = timeout(Duration::from_secs(2), stream.read_exact(&mut [0; 4]))
+            .await
+            .unwrap()
+            .unwrap_err();
+        assert_eq!(error.kind(), std::io::ErrorKind::InvalidData);
+        peer.await.unwrap();
+    }
+}
