+                    .or_insert_with(|| (Default::default(), now));
+                if !window.accept(frame.packet_id) {
+                    continue;
+                }
+                *seen = now;
+            } else if !self.salts.accept(&frame.salt) {
+                continue;
+            }
             return Ok(UdpPacket {
-                src: std::net::SocketAddr::new(
-                    match &src.host {
-                        vp_common::Host::Ip(ip) => *ip,
-                        vp_common::Host::Domain(_) => [0, 0, 0, 0].into(),
-                    },
-                    src.port,
-                ),
