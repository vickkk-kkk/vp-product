+        match self {
+            Self::Standard(a) => a.seal_nonce(nonce[..12].try_into().unwrap(), plaintext, b""),
+            Self::XChaCha(a) => a
+                .encrypt(XNonce::from_slice(nonce), plaintext)
+                .expect("AEAD size bounded"),
+        }
+    }
+
+    fn open(&self, nonce: &[u8; 24], ciphertext: &[u8]) -> Result<Vec<u8>> {
+        match self {
+            Self::Standard(a) => a.open_nonce(nonce[..12].try_into().unwrap(), ciphertext, b""),
+            Self::XChaCha(a) => a
+                .decrypt(XNonce::from_slice(nonce), ciphertext)
+                .map_err(|_| Error::Proto("XChaCha authentication failed")),
+        }
+    }
+}
