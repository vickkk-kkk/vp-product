index 0000000..e60dba3
--- /dev/null
+++ b/crates/vp-protocol/tests/ss_library_interop.rs
@@ -0,0 +1,298 @@
+//! Independent official protocol-library tests, explicitly NOT sing-box CLI tests.
+//! Run only after building/authorizing tests/reference_ss and setting VP_SS_REFERENCE.
+use base64::Engine;
+use std::{
+    io::{BufRead, Read, Write},
+    process::{Child, Command, Output},
+    sync::Arc,
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, UdpSocket},
+    time::timeout,
+};
+use vp_common::DstAddr;
+use vp_core::{Inbound, InboundCtx, Outbound, Session, UdpPacket};
+const METHODS: [&str; 7] = [
+    "aes-128-gcm",
+    "aes-256-gcm",
+    "chacha20-ietf-poly1305",
+    "xchacha20-ietf-poly1305",
+    "2022-blake3-aes-128-gcm",
+    "2022-blake3-aes-256-gcm",
+    "2022-blake3-chacha20-poly1305",
+];
+struct NoopRouter;
+#[async_trait::async_trait]
+impl vp_core::Router for NoopRouter {
+    async fn pick(&self, _: &Session) -> vp_core::Resolution {
+        unreachable!()
+    }
+}
+fn password(method: &str) -> String {
+    let cipher = vp_crypto::ss::Cipher::parse(method).unwrap();
+    let mut bytes = vec![0; cipher.key_len()];
+    vp_common::rand_bytes(&mut bytes);
+    base64::engine::general_purpose::STANDARD.encode(bytes)
+}
+fn context() -> InboundCtx {
+    InboundCtx {
+        router: Arc::new(NoopRouter),
+        stats: Arc::default(),
+        conns: Arc::new(vp_core::ConnTable::new()),
+    }
+}
+struct Peer(Child);
+impl std::ops::Deref for Peer {
+    type Target = Child;
+    fn deref(&self) -> &Child {
+        &self.0
+    }
+}
+impl std::ops::DerefMut for Peer {
+    fn deref_mut(&mut self) -> &mut Child {
+        &mut self.0
+    }
+}
+impl Drop for Peer {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+async fn finish(mut child: Peer) -> Output {
+    let status = timeout(Duration::from_secs(15), async {
+        loop {
+            if let Some(status) = child.try_wait().unwrap() {
+                break status;
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await
+    .expect("reference child timeout");
+    let mut stdout = Vec::new();
+    let mut stderr = Vec::new();
+    if let Some(mut stream) = child.stdout.take() {
+        stream.read_to_end(&mut stdout).unwrap();
+    }
+    if let Some(mut stream) = child.stderr.take() {
+        stream.read_to_end(&mut stderr).unwrap();
+    }
+    Output {
+        status,
+        stdout,
+        stderr,
+    }
+}
+async fn peer(config: serde_json::Value) -> Peer {
+    let binary = std::env::var_os("VP_SS_REFERENCE")
+        .expect("build authorized checksum-verified official SS library harness first");
+    let mut child = Peer(
+        Command::new(binary)
+            .stdin(std::process::Stdio::piped())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::piped())
+            .spawn()
+            .unwrap(),
+    );
+    let mut bytes = serde_json::to_vec(&config).unwrap();
+    bytes.push(b'\n');
+    child.stdin.as_mut().unwrap().write_all(&bytes).unwrap();
+    child
+}
+fn outbound(method: &str, password: &str, port: u16) -> vp_protocol::ss::SsOutbound {
+    vp_protocol::ss::SsOutbound::new(&vp_config::SsCfg {
+        server: "127.0.0.1".into(),
+        port,
+        cipher: method.into(),
+        password: password.into(),
+        udp: true,
+        plugin: None,
+        plugin_opts: None,
+    })
+    .unwrap()
+}
+
+#[tokio::test]
+#[ignore = "requires authorized official Go protocol-library peer; not a CLI pass"]
+async fn official_client_to_vp_server_all_seven_methods_tcp_udp_and_wrong_key() {
+    for method in METHODS {
+        let key = password(method);
+        let server = Arc::new(
+            vp_protocol::ss::SsInbound::new("127.0.0.1", 0, "ss-reference", method, &key).unwrap(),
+        );
+        let port = server.start(context()).await.unwrap();
+        for negative in [false, true] {
+            let credential = if negative {
+                password(method)
+            } else {
+                key.clone()
+            };
+            let mut child=peer(serde_json::json!({"method":method,"password":credential,"mode":"client","port":port,"negative":negative})).await;
+            child.stdin.take();
+            let output = finish(child).await;
+            assert!(
+                output.status.success(),
+                "{method} negative={negative}: {}",
+                String::from_utf8_lossy(&output.stderr)
+            );
+            let result: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();
+            assert_eq!(result["ok"], true);
+            assert_eq!(result["kind"], "official-protocol-library");
+            eprintln!(
+                "PASS official SS client -> vp server {method} negative={negative}: {}",
+                String::from_utf8_lossy(&output.stdout).trim()
+            );
+        }
+    }
+}
+
+#[tokio::test]
+#[ignore = "requires authorized official Go protocol-library peer; not a CLI pass"]
+async fn vp_client_to_official_server_all_seven_methods_tcp_udp_and_wrong_key() {
+    for method in METHODS {
+        let key = password(method);
+        let mut child =
+            peer(serde_json::json!({"method":method,"password":key,"mode":"server"})).await;
+        let stdout = child.stdout.take().unwrap();
+        let line = timeout(
+            Duration::from_secs(5),
+            tokio::task::spawn_blocking(move || {
+                let mut line = String::new();
+                std::io::BufReader::new(stdout)
+                    .read_line(&mut line)
+                    .unwrap();
+                line
+            }),
+        )
+        .await
+        .expect("reference server readiness timeout")
+        .unwrap();
+        if line.is_empty() {
+            let output = finish(child).await;
+            panic!(
+                "reference startup: {}",
+                String::from_utf8_lossy(&output.stderr)
+            );
+        }
+        let ready: serde_json::Value = serde_json::from_str(&line).unwrap();
+        assert_eq!(ready["kind"], "official-protocol-library");
+        let port = ready["ready"].as_u64().unwrap() as u16;
+        let echo = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = echo.local_addr().unwrap();
+        let echo_task = tokio::spawn(async move {
+            let (mut stream, _) = echo.accept().await.unwrap();
+            let mut buf = [0; 8192];
+            loop {
+                let n = stream.read(&mut buf).await.unwrap();
+                if n == 0 {
+                    break;
+                };
+                stream.write_all(&buf[..n]).await.unwrap();
+            }
+        });
+        let out = outbound(method, &key, port);
+        let dst = DstAddr::ip(addr.ip(), addr.port());
+        let mut stream = out
+            .connect_stream(&Session::new_tcp("test".into(), None, dst.clone()), &dst)
+            .await
+            .unwrap();
+        let body = vec![0x39; 48000];
+        timeout(Duration::from_secs(5), async {
+            stream.write_all(&body).await.unwrap();
+            stream.flush().await.unwrap();
+            let mut got = vec![0; body.len()];
+            stream.read_exact(&mut got).await.unwrap();
+            assert_eq!(got, body);
+        })
+        .await
+        .unwrap_or_else(|_| panic!("{method} TCP timeout"));
+        stream.shutdown().await.unwrap();
+        drop(stream);
+        echo_task.abort();
+        let target = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let addr = target.local_addr().unwrap();
+        let dst = DstAddr::ip(addr.ip(), addr.port());
+        let mut packet = out
+            .connect_packet(&Session::new_tcp("test".into(), None, dst.clone()), &dst)
+            .await
+            .unwrap();
+        let mut original = None;
+        for size in [1, 128, 4096] {
+            timeout(Duration::from_secs(5), async {
+                let body = vec![0x56; size];
+                packet
+                    .send(&UdpPacket {
+                        src: addr,
+                        dst: addr,
+                        data: body.clone().into(),
+                    })
+                    .await
+                    .unwrap();
+                let mut buf = [0; 8192];
+                let (n, from) = target.recv_from(&mut buf).await.unwrap();
+                assert_eq!(&buf[..n], &body);
+                if let Some(previous) = original {
+                    assert_eq!(from, previous)
+                } else {
+                    original = Some(from)
+                };
+                target.send_to(&buf[..n], from).await.unwrap();
+                let response = packet.recv().await.unwrap();
+                assert_eq!(response.src, addr);
+                assert_eq!(&response.data[..], &body);
+            })
+            .await
+            .unwrap_or_else(|_| panic!("{method} UDP timeout"));
+        }
+        // Wrong-key target absence, independently observed on plaintext sockets.
+        let badout = outbound(method, &password(method), port);
+        let forbidden = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let badaddr = forbidden.local_addr().unwrap();
+        let baddst = DstAddr::ip(badaddr.ip(), badaddr.port());
+        if let Ok(mut bad) = badout
+            .connect_stream(
+                &Session::new_tcp("test".into(), None, baddst.clone()),
+                &baddst,
+            )
+            .await
+        {
+            let _ = bad.write_all(b"must-not-arrive").await;
+            let _ = bad.flush().await;
+        }
+        assert!(
+            timeout(Duration::from_millis(100), forbidden.accept())
+                .await
+                .is_err()
+        );
+        let badpacket = badout
+            .connect_packet(&Session::new_tcp("test".into(), None, dst.clone()), &dst)
+            .await
+            .unwrap();
+        badpacket
+            .send(&UdpPacket {
+                src: addr,
+                dst: addr,
+                data: b"must-not-arrive"[..].into(),
+            })
+            .await
+            .unwrap();
+        assert!(
+            timeout(Duration::from_millis(100), target.recv_from(&mut [0; 100]))
+                .await
+                .is_err()
+        );
+        child.stdin.take();
+        let output = finish(child).await;
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        eprintln!(
+            "PASS vp SS client -> official server {method}: TCP 48000 bytes, UDP [1,128,4096], stable source, wrong-key target absence"
+        );
+    }
+}
diff --git a/crates/vp-protocol/tests/ss_managed.rs b/crates/vp-protocol/tests/ss_managed.rs
new file mode 100644
index 0000000..bb5cfcc
--- /dev/null
+++ b/crates/vp-protocol/tests/ss_managed.rs
@@ -0,0 +1,224 @@
+//! Managed SS lifecycle acceptance. Actual sockets and target-side observations;
+//! no mock readiness, detached relay, or process shutdown is used for cleanup.
+use base64::Engine;
+use std::{sync::Arc, time::Duration};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, TcpStream, UdpSocket},
+    time::timeout,
+};
+use vp_common::DstAddr;
+use vp_core::{
+    Inbound, InboundCtx, Outbound, Session, UdpPacket,
+    task_scope::{Phase, TaskScope},
+};
+struct NoopRouter;
+#[async_trait::async_trait]
+impl vp_core::Router for NoopRouter {
+    async fn pick(&self, _: &Session) -> vp_core::Resolution {
+        unreachable!()
+    }
+}
+fn context() -> InboundCtx {
+    InboundCtx {
+        router: Arc::new(NoopRouter),
+        stats: Arc::default(),
+        conns: Arc::new(vp_core::ConnTable::new()),
+    }
+}
+async fn server(method: &str) -> (Arc<TaskScope>, InboundCtx, u16, vp_protocol::ss::SsOutbound) {
+    let cipher = vp_crypto::ss::Cipher::parse(method).unwrap();
+    let mut bytes = vec![0; cipher.key_len()];
+    vp_common::rand_bytes(&mut bytes);
+    let password = base64::engine::general_purpose::STANDARD.encode(bytes);
+    let scope = TaskScope::new();
+    let ctx = context();
+    let inbound = Arc::new(
+        vp_protocol::ss::SsInbound::new("127.0.0.1", 0, "managed-ss", method, &password).unwrap(),
+    );
+    let port = scope.run(inbound.start(ctx.clone())).await.unwrap();
+    assert_eq!(scope.snapshot().listeners.len(), 2);
+    let outbound = vp_protocol::ss::SsOutbound::new(&vp_config::SsCfg {
+        server: "127.0.0.1".into(),
+        port,
+        cipher: method.into(),
+        password,
+        udp: true,
+        plugin: None,
+        plugin_opts: None,
+    })
+    .unwrap();
+    (scope, ctx, port, outbound)
+}
+async fn draining(scope: &TaskScope) {
+    timeout(Duration::from_secs(1), async {
+        while scope.snapshot().phase == Phase::Running {
+            tokio::task::yield_now().await
+        }
+    })
+    .await
+    .unwrap();
+    tokio::time::sleep(Duration::from_millis(20)).await;
+}
+async fn ports_released(port: u16) {
+    let _tcp = TcpListener::bind(("127.0.0.1", port))
+        .await
+        .expect("SS TCP listening socket must be destructed before shutdown completion");
+    let _udp = UdpSocket::bind(("127.0.0.1", port))
+        .await
+        .expect("SS UDP listening socket must be destructed before shutdown completion");
+}
+
+#[tokio::test]
+async fn established_tcp_finishes_during_managed_drain_and_cleans_connection_table() {
+    for method in ["aes-128-gcm", "2022-blake3-aes-128-gcm"] {
+        let (scope, ctx, port, out) = server(method).await;
+        let target = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = target.local_addr().unwrap();
+        let dst = DstAddr::ip(address.ip(), address.port());
+        let mut client = out
+            .connect_stream(&Session::new_tcp("test".into(), None, dst.clone()), &dst)
+            .await
+            .unwrap();
+        client.write_all(b"request").await.unwrap();
+        client.flush().await.unwrap();
+        let (mut remote, _) = timeout(Duration::from_secs(2), target.accept())
+            .await
+            .unwrap()
+            .unwrap();
+        let mut request = [0; 7];
+        remote.read_exact(&mut request).await.unwrap();
+        assert_eq!(&request, b"request");
+        let closing_scope = scope.clone();
+        let closing = tokio::spawn(async move {
+            closing_scope
+                .shutdown(Duration::from_secs(2), Duration::from_secs(1))
+                .await
+        });
+        draining(&scope).await;
+        assert!(
+            TcpStream::connect(("127.0.0.1", port)).await.is_err(),
+            "new TCP ingress must stop before established work drains"
+        );
+        remote.write_all(b"reply-after-ingress-stop").await.unwrap();
+        remote.shutdown().await.unwrap();
+        let mut response = [0; 24];
+        timeout(Duration::from_secs(1), client.read_exact(&mut response))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(&response, b"reply-after-ingress-stop");
+        client.shutdown().await.unwrap();
+        drop(client);
+        drop(remote);
+        let report = closing.await.unwrap();
+        assert!(
+            report.drained,
+            "{method}: established TCP must finish without abort"
+        );
+        assert_eq!(report.forced_tasks, 0);
+        assert_eq!(report.remaining_tasks, 0);
+        assert_eq!(report.panics, 0);
+        assert!(ctx.conns.is_empty());
+        assert_eq!(scope.snapshot().task_count(), 0);
+        ports_released(port).await;
+    }
+}
+
+#[tokio::test]
+async fn udp_reply_survives_ingress_stop_then_bounded_cancel_releases_both_families() {
+    for ipv6 in [false, true] {
+        let (scope, ctx, port, out) = server("2022-blake3-aes-128-gcm").await;
+        let target = UdpSocket::bind(if ipv6 { "[::1]:0" } else { "127.0.0.1:0" })
+            .await
+            .expect("IPv6 unavailable is a blocked acceptance, not a pass");
+        let address = target.local_addr().unwrap();
+        let dst = DstAddr::ip(address.ip(), address.port());
+        let mut client = out
+            .connect_packet(&Session::new_udp("test".into(), None, dst.clone()), &dst)
+            .await
+            .unwrap();
+        client
+            .send(&UdpPacket {
+                src: address,
+                dst: address,
+                data: b"request"[..].into(),
+            })
+            .await
+            .unwrap();
+        let mut request = [0; 100];
+        let (_, relay) = timeout(Duration::from_secs(2), target.recv_from(&mut request))
+            .await
+            .unwrap()
+            .unwrap();
+        let closing_scope = scope.clone();
+        let closing = tokio::spawn(async move {
+            closing_scope
+                .shutdown(Duration::from_millis(300), Duration::from_secs(1))
+                .await
+        });
+        draining(&scope).await;
+        // UDP has no EOF: established response work remains live during the
+        // configured drain window, then the scope forcibly cancels idle state.
+        target.send_to(b"reply-during-drain", relay).await.unwrap();
+        let reply = timeout(Duration::from_millis(150), client.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(&reply.data[..], b"reply-during-drain");
+        assert_eq!(reply.src, address);
+        client
+            .send(&UdpPacket {
+                src: address,
+                dst: address,
+                data: b"new-ingress-must-stop"[..].into(),
+            })
+            .await
+            .unwrap();
+        assert!(
+            timeout(Duration::from_millis(80), target.recv_from(&mut request))
+                .await
+                .is_err()
+        );
+        let report = closing.await.unwrap();
+        assert!(!report.drained);
+        assert!(report.forced_tasks >= 1);
+        assert_eq!(report.remaining_tasks, 0);
+        assert_eq!(report.panics, 0);
+        assert!(ctx.conns.is_empty());
+        assert_eq!(scope.snapshot().task_count(), 0);
+        ports_released(port).await;
+        let _outgoing = UdpSocket::bind(("::", relay.port()))
+            .await
+            .expect("single dual-stack outgoing session socket must be released");
+    }
+}
+
+#[tokio::test]
+async fn managed_stop_cancels_partial_handshake_and_all_owned_destructors() {
+    for _ in 0..5 {
+        let (scope, ctx, port, _) = server("2022-blake3-aes-128-gcm").await;
+        let mut client = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+        // No bytes: the parser is waiting within its ten-second deadline.
+        timeout(Duration::from_secs(1), async {
+            while scope.snapshot().work == 0 {
+                tokio::task::yield_now().await
+            }
+        })
+        .await
+        .unwrap();
+        let report = scope.shutdown(Duration::ZERO, Duration::from_secs(1)).await;
+        assert_eq!(report.remaining_tasks, 0);
+        assert_eq!(report.panics, 0);
+        assert!(ctx.conns.is_empty());
+        assert_eq!(scope.snapshot().task_count(), 0);
+        match timeout(Duration::from_secs(1), client.read(&mut [0; 1]))
+            .await
+            .unwrap()
+        {
+            Ok(n) => assert_eq!(n, 0),
+            Err(_) => {}
+        }
+        ports_released(port).await;
+    }
+}
