+pub fn unix_seconds() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+pub fn validate_timestamp(timestamp: u64) -> Result<()> {
+    if unix_seconds().abs_diff(timestamp) > 30 {
+        return Err(Error::Proto("SS2022 timestamp outside 30 second window"));
+    }
+    Ok(())
+}
