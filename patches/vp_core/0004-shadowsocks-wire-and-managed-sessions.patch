new file mode 100644
index 0000000..533c171
--- /dev/null
+++ b/crates/vp-protocol/tests/ss_standard.rs
@@ -0,0 +1,650 @@
+//! Focused Shadowsocks regression tests. These are local, same-implementation
+//! conformance/regression tests, NOT independent-reference interoperability.
+use base64::Engine;
+use std::{net::SocketAddr, sync::Arc, time::Duration};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, TcpStream, UdpSocket},
+    time::timeout,
+};
+use vp_common::{DstAddr, Stats};
+use vp_core::{Inbound, InboundCtx, Outbound, PacketConn, Session, UdpPacket};
+use vp_crypto::ss::{AeadChunkCodec, Cipher};
+use vp_protocol::ss::{SsInbound, SsOutbound};
+
+const METHODS: [&str; 7] = [
+    "aes-128-gcm",
+    "aes-256-gcm",
+    "chacha20-ietf-poly1305",
+    "xchacha20-ietf-poly1305",
+    "2022-blake3-aes-128-gcm",
+    "2022-blake3-aes-256-gcm",
+    "2022-blake3-chacha20-poly1305",
+];
+struct NoopRouter;
+#[async_trait::async_trait]
+impl vp_core::Router for NoopRouter {
+    async fn pick(&self, _: &Session) -> vp_core::Resolution {
+        unreachable!("SS server uses direct outbound")
+    }
+}
+fn ctx() -> InboundCtx {
+    InboundCtx {
+        router: Arc::new(NoopRouter),
+        stats: Arc::new(Stats::default()),
+        conns: Arc::new(vp_core::ConnTable::new()),
+    }
+}
+fn credentials(method: &str) -> (Cipher, String, Vec<u8>) {
+    let cipher = Cipher::parse(method).unwrap();
+    let mut secret = vec![0; cipher.key_len()];
+    vp_common::rand_bytes(&mut secret);
+    let password = base64::engine::general_purpose::STANDARD.encode(&secret);
+    let key = cipher.derive_key(&password).unwrap();
+    (cipher, password, key)
+}
+async fn inbound(method: &str, password: &str) -> u16 {
+    Arc::new(SsInbound::new("127.0.0.1", 0, "ss-test", method, password).unwrap())
+        .start(ctx())
+        .await
+        .unwrap()
+}
+fn outbound(method: &str, password: &str, port: u16) -> SsOutbound {
+    SsOutbound::new(&vp_config::SsCfg {
+        server: "127.0.0.1".into(),
+        port,
+        cipher: method.into(),
+        password: password.into(),
+        udp: true,
+        plugin: None,
+        plugin_opts: None,
+    })
+    .unwrap()
+}
+
+#[tokio::test]
+async fn seven_methods_tcp_large_payload_and_half_close() {
+    for method in METHODS {
+        timeout(Duration::from_secs(5), async {
+            let (_, password, _) = credentials(method);
+            let echo = TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let addr = echo.local_addr().unwrap();
+            let echo_task = tokio::spawn(async move {
+                let (mut socket, _) = echo.accept().await.unwrap();
+                let mut data = Vec::new();
+                socket.read_to_end(&mut data).await.unwrap();
+                socket.write_all(&data).await.unwrap();
+                socket.shutdown().await.unwrap();
+            });
+            let port = inbound(method, &password).await;
+            let out = outbound(method, &password, port);
+            let dst = DstAddr::ip(addr.ip(), addr.port());
+            let mut stream = out
+                .connect_stream(&Session::new_tcp("test".into(), None, dst.clone()), &dst)
+                .await
+                .unwrap();
+            let payload: Vec<_> = (0..180_000).map(|i| (i % 251) as u8).collect();
+            stream.write_all(&payload).await.unwrap();
+            stream.shutdown().await.unwrap();
+            let mut result = Vec::new();
+            stream.read_to_end(&mut result).await.unwrap();
+            assert_eq!(result, payload, "{method}");
+            echo_task.await.unwrap();
+        })
+        .await
+        .unwrap_or_else(|_| panic!("{method} timeout"));
+    }
+}
+
+#[tokio::test]
+async fn seven_methods_udp_roundtrip_and_tamper_rejection() {
+    for method in METHODS {
+        timeout(Duration::from_secs(5), async {
+            let (cipher, password, key) = credentials(method);
+            let target = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+            let addr = target.local_addr().unwrap();
+            let port = inbound(method, &password).await;
+            let mut client = vp_protocol::udp_out::SsUdpConn::bind(
+                "127.0.0.1",
+                port,
+                cipher.clone(),
+                key.clone(),
+            )
+            .await
+            .unwrap();
+            for size in [0, 128, 4096] {
+                let data = vec![0x5a; size];
+                client
+                    .send(&UdpPacket {
+                        src: "127.0.0.1:1".parse().unwrap(),
+                        dst: addr,
+                        data: data.clone().into(),
+                    })
+                    .await
+                    .unwrap();
+                let mut buffer = vec![0; 8192];
+                let (n, from) = target.recv_from(&mut buffer).await.unwrap();
+                assert_eq!(&buffer[..n], &data);
+                target.send_to(&buffer[..n], from).await.unwrap();
+                let result = client.recv().await.unwrap();
+                assert_eq!(result.src, addr);
+                assert_eq!(&result.data[..], &data);
+            }
+            let socket = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+            let mut plain = Vec::new();
+            vp_common::addr::encode_socks_addr(&DstAddr::ip(addr.ip(), addr.port()), &mut plain);
+            plain.extend_from_slice(b"must-not-arrive");
+            let mut packet = cipher.seal_udp(&key, &plain, 55, 0, None).unwrap();
+            *packet.last_mut().unwrap() ^= 1;
+            socket.send_to(&packet, ("127.0.0.1", port)).await.unwrap();
+            assert!(
+                timeout(Duration::from_millis(80), target.recv_from(&mut [0; 100]))
+                    .await
+                    .is_err(),
+                "{method} forwarded tampered packet"
+            );
+        })
+        .await
+        .unwrap_or_else(|_| panic!("{method} timeout"));
+    }
+}
+
+#[tokio::test]
+async fn ss2022_udp_replay_and_mobility() {
+    for method in &METHODS[4..] {
+        let (cipher, password, key) = credentials(method);
+        let port = inbound(method, &password).await;
+        let target = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let addr = target.local_addr().unwrap();
+        let a = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let b = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let mut plain = Vec::new();
+        vp_common::addr::encode_socks_addr(&DstAddr::ip(addr.ip(), addr.port()), &mut plain);
+        plain.extend_from_slice(b"mobility");
+        let request = cipher.seal_udp(&key, &plain, 1234, 0, None).unwrap();
+        a.send_to(&request, ("127.0.0.1", port)).await.unwrap();
+        let (_, initial_source) = timeout(Duration::from_secs(2), target.recv_from(&mut [0; 128]))
+            .await
+            .unwrap()
+            .unwrap();
+        // Duplicates from a different address are still replays, not new sessions.
+        b.send_to(&request, ("127.0.0.1", port)).await.unwrap();
+        assert!(
+            timeout(Duration::from_millis(80), target.recv_from(&mut [0; 128]))
+                .await
+                .is_err()
+        );
+        let second = cipher.seal_udp(&key, &plain, 1234, 1, None).unwrap();
+        b.send_to(&second, ("127.0.0.1", port)).await.unwrap();
+        let (_, next_source) = timeout(Duration::from_secs(2), target.recv_from(&mut [0; 128]))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            initial_source, next_source,
+            "session must retain outgoing socket across client address changes"
+        );
+        target.send_to(b"reply", next_source).await.unwrap();
+        let mut buf = [0; 512];
+        let (n, _) = timeout(Duration::from_secs(2), b.recv_from(&mut buf))
+            .await
+            .unwrap()
+            .unwrap();
+        let response = cipher.open_udp(&key, &buf[..n], true).unwrap();
+        assert_eq!(response.client_session_id, Some(1234));
+        assert_ne!(response.session_id, 1234);
+        assert!(
+            timeout(Duration::from_millis(80), a.recv_from(&mut buf))
+                .await
+                .is_err()
+        );
+    }
+}
+
+fn request(
+    cipher: &Cipher,
+    key: &[u8],
+    salt: &[u8],
+    addr: SocketAddr,
+    timestamp: u64,
+    kind: u8,
+    padding: usize,
+    early: &[u8],
+) -> Vec<u8> {
+    let mut variable = Vec::new();
+    vp_common::addr::encode_socks_addr(&DstAddr::ip(addr.ip(), addr.port()), &mut variable);
+    variable.extend_from_slice(&(padding as u16).to_be_bytes());
+    variable.resize(variable.len() + padding, 0x11);
+    variable.extend_from_slice(early);
+    let mut header = vec![kind];
+    header.extend_from_slice(&timestamp.to_be_bytes());
+    header.extend_from_slice(&(variable.len() as u16).to_be_bytes());
+    let sub = cipher.subkey(key, salt).unwrap();
+    let mut codec = AeadChunkCodec::new(cipher, &sub).unwrap();
+    let mut wire = salt.to_vec();
+    wire.extend_from_slice(&codec.seal_record(&header));
+    wire.extend_from_slice(&codec.seal_record(&variable));
+    wire
+}
+
+#[tokio::test]
+async fn ss2022_tcp_replay_wrong_key_type_timestamp_padding_and_early_data() {
+    for method in &METHODS[4..] {
+        let (cipher, password, key) = credentials(method);
+        let port = inbound(method, &password).await;
+        let target = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = target.local_addr().unwrap();
+        let mut salt = vec![0; cipher.salt_len()];
+        vp_common::rand_bytes(&mut salt);
+        let good = request(
+            &cipher,
+            &key,
+            &salt,
+            addr,
+            vp_crypto::ss::unix_seconds(),
+            0,
+            0,
+            b"early-data",
+        );
+        let mut client = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+        client.write_all(&good).await.unwrap();
+        let (mut remote, _) = timeout(Duration::from_secs(2), target.accept())
+            .await
+            .unwrap()
+            .unwrap();
+        let mut early = [0; 10];
+        timeout(Duration::from_secs(2), remote.read_exact(&mut early))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            &early, b"early-data",
+            "authenticated early plaintext must not be passed back into the ciphertext decoder"
+        );
+        drop(remote);
+        drop(client);
+        let mut wrong_key = key.clone();
+        wrong_key[0] ^= 1;
+        let mut new_salt = salt.clone();
+        new_salt[0] ^= 1;
+        for packet in [
+            good,
+            request(
+                &cipher,
+                &wrong_key,
+                &new_salt,
+                addr,
+                vp_crypto::ss::unix_seconds(),
+                0,
+                1,
+                b"",
+            ),
+            request(
+                &cipher,
+                &key,
+                &new_salt,
+                addr,
+                vp_crypto::ss::unix_seconds() - 31,
+                0,
+                1,
+                b"",
+            ),
+            request(
+                &cipher,
+                &key,
+                &new_salt,
+                addr,
+                vp_crypto::ss::unix_seconds(),
+                1,
+                1,
+                b"",
+            ),
+            request(
+                &cipher,
+                &key,
+                &new_salt,
+                addr,
+                vp_crypto::ss::unix_seconds(),
+                0,
+                0,
+                b"",
+            ),
+            vec![0; 1],
+        ] {
+            let mut bad = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+            let _ = bad.write_all(&packet).await;
+            assert!(
+                timeout(Duration::from_millis(80), target.accept())
+                    .await
+                    .is_err(),
+                "{method} forwarded invalid request"
+            );
+        }
+    }
+}
