+#[tokio::test]
+async fn seven_methods_single_udp_session_mixes_ipv4_ipv6_with_one_source_port() {
+    for method in METHODS {
+        timeout(Duration::from_secs(5), async {
+            let (cipher, password, key) = credentials(method);
+            let port = inbound(method, &password).await;
+            let ipv4 = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+            let ipv6 = ipv6_loopback().await;
+            let mut client = vp_protocol::udp_out::SsUdpConn::bind("127.0.0.1", port, cipher, key)
+                .await
+                .unwrap();
+            let mut source_port = None;
+            for (index, target) in [&ipv4, &ipv6, &ipv4, &ipv6].into_iter().enumerate() {
+                let dst = target.local_addr().unwrap();
+                let data = vec![0x30 + index as u8; 200 + index * 1024];
+                client
+                    .send(&UdpPacket {
+                        src: dst,
+                        dst,
+                        data: data.clone().into(),
+                    })
+                    .await
+                    .unwrap();
+                let mut buffer = [0; 8192];
+                let (n, from) = target.recv_from(&mut buffer).await.unwrap();
+                assert_eq!(&buffer[..n], &data);
+                assert_eq!(from.is_ipv4(), dst.is_ipv4());
+                if let Some(previous) = source_port {
+                    assert_eq!(
+                        from.port(),
+                        previous,
+                        "{method}: one session must retain one outgoing source port across families"
+                    );
+                } else {
+                    source_port = Some(from.port());
+                }
+                target.send_to(&buffer[..n], from).await.unwrap();
+                let response = client.recv().await.unwrap();
+                assert_eq!(
+                    response.src, dst,
+                    "{method}: IPv4-mapped response addresses must be canonicalized"
+                );
+                assert_eq!(&response.data[..], &data);
+            }
+            // An explicitly mapped address denotes the same IPv4 endpoint.
+            let v4 = match ipv4.local_addr().unwrap() {
+                SocketAddr::V4(v4) => v4,
+                _ => unreachable!(),
+            };
+            let mapped = SocketAddr::new(v4.ip().to_ipv6_mapped().into(), v4.port());
+            client
+                .send(&UdpPacket {
+                    src: mapped,
+                    dst: mapped,
+                    data: b"mapped"[..].into(),
+                })
+                .await
+                .unwrap();
+            let mut buffer = [0; 1024];
+            let (n, from) = ipv4.recv_from(&mut buffer).await.unwrap();
+            assert_eq!(Some(from.port()), source_port);
+            ipv4.send_to(&buffer[..n], from).await.unwrap();
+            assert_eq!(client.recv().await.unwrap().src, ipv4.local_addr().unwrap());
+        })
+        .await
+        .unwrap_or_else(|_| panic!("{method}: mixed-family timeout"));
+    }
+}
