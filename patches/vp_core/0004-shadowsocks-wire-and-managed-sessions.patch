+async fn ipv6_loopback() -> UdpSocket {
+    UdpSocket::bind("[::1]:0").await.unwrap_or_else(|error| {
+        panic!(
+            "IPv6 loopback is unavailable; mixed-family acceptance is BLOCKED, not passed: {error}"
+        )
+    })
+}
