+#[tokio::test]
+async fn ss2022_udp_invalid_association_does_not_poison_replay_window() {
+    for method in &METHODS[4..] {
+        let (cipher, _, key) = credentials(method);
+        let peer = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let mut client = vp_protocol::udp_out::SsUdpConn::bind(
+            "127.0.0.1",
+            peer.local_addr().unwrap().port(),
+            cipher.clone(),
+            key.clone(),
+        )
+        .await
+        .unwrap();
+        let target: SocketAddr = "127.0.0.1:12345".parse().unwrap();
+        client
+            .send(&UdpPacket {
+                src: target,
+                dst: target,
+                data: b"request"[..].into(),
+            })
+            .await
+            .unwrap();
+        let mut buffer = [0; 1024];
+        let (n, from) = peer.recv_from(&mut buffer).await.unwrap();
+        let request = cipher.open_udp(&key, &buffer[..n], false).unwrap();
+        let mut payload = Vec::new();
+        vp_common::addr::encode_socks_addr(&DstAddr::ip(target.ip(), target.port()), &mut payload);
+        payload.extend_from_slice(b"good");
+        let server_id = request.session_id.wrapping_add(1);
+        let bad = cipher
+            .seal_udp(&key, &payload, server_id, 42, Some(request.session_id ^ 1))
+            .unwrap();
+        peer.send_to(&bad, from).await.unwrap();
+        let good = cipher
+            .seal_udp(&key, &payload, server_id, 42, Some(request.session_id))
+            .unwrap();
+        peer.send_to(&good, from).await.unwrap();
+        let response = timeout(Duration::from_secs(2), client.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(&response.data[..], b"good");
+    }
+}
