+#[tokio::test]
+async fn encrypted_stream_handles_backpressure_without_duplicate_plaintext() {
+    for method in METHODS {
+        let (cipher, _, key) = credentials(method);
+        let (writer, mut wire) = tokio::io::duplex(7);
+        let decode_cipher = cipher.clone();
+        let decode_key = key.clone();
+        let consumer = tokio::spawn(async move {
+            let mut salt = vec![0; decode_cipher.salt_len()];
+            wire.read_exact(&mut salt).await.unwrap();
+            let mut dec = AeadChunkCodec::new(
+                &decode_cipher,
+                &decode_cipher.subkey(&decode_key, &salt).unwrap(),
+            )
+            .unwrap();
+            let mut raw = Vec::new();
+            wire.read_to_end(&mut raw).await.unwrap();
+            let mut offset = 0;
+            if decode_cipher.is_2022 {
+                let header = dec.open_record(&raw[..27]).unwrap();
+                let size = u16::from_be_bytes(header[9..11].try_into().unwrap()) as usize;
+                dec.open_record(&raw[27..27 + size + 16]).unwrap();
+                offset = 27 + size + 16;
+            } else {
+                let (_, used) = dec.try_open_chunk(&raw).unwrap().unwrap();
+                offset += used;
+            }
+            let mut plain = Vec::new();
+            while offset < raw.len() {
+                let (body, used) = dec.try_open_chunk(&raw[offset..]).unwrap().unwrap();
+                plain.extend_from_slice(&body);
+                offset += used;
+            }
+            plain
+        });
+        let mut address = Vec::new();
+        vp_common::addr::encode_socks_addr(
+            &DstAddr::ip("127.0.0.1".parse().unwrap(), 1234),
+            &mut address,
+        );
+        let mut stream =
+            vp_protocol::ss::SsCryptoStream::new_client(writer, cipher, key, address).unwrap();
+        let data = vec![0x43; 35_000];
+        timeout(Duration::from_secs(2), async {
+            stream.write_all(&data).await.unwrap();
+            stream.shutdown().await.unwrap();
+        })
+        .await
+        .unwrap();
+        assert_eq!(consumer.await.unwrap(), data, "{method}");
+    }
+}
