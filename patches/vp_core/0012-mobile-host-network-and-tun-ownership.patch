index 0000000000000000000000000000000000000000..49b09f2277440d1ff53a34a0f4a26c04c86d2718
--- /dev/null
+++ b/crates/vp-core/src/host_network.rs
@@ -0,0 +1,183 @@
+//! Per-generation host socket authority. No process-wide network state.
+//! Mobile callers must install a host on TaskScope. Android fails closed if a
+//! task loses its scope. Protection runs after socket creation, before connect
+//! or any first send; RAII closes a rejected socket.
+use std::{io, net::SocketAddr, sync::Arc};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Protocol {
+    Tcp,
+    Udp,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Purpose {
+    Proxy,
+    Dns,
+    Bootstrap,
+    Subscription,
+    ConnectivityCheck,
+}
+pub trait HostNetwork: Send + Sync {
+    fn before_connect(
+        &self,
+        socket: u64,
+        protocol: Protocol,
+        destination: SocketAddr,
+        purpose: Purpose,
+    ) -> io::Result<()>;
+    /// Explicit IP-only bootstrap resolvers; never OS getaddrinfo on mobile.
+    fn dns_servers(&self) -> Vec<SocketAddr>;
+}
+pub fn current() -> Option<Arc<dyn HostNetwork>> {
+    crate::task_scope::current_scope().and_then(|s| s.host_network())
+}
+pub fn requires_protection() -> bool {
+    cfg!(target_os = "android") || current().is_some()
+}
+#[cfg(unix)]
+fn native<T: std::os::fd::AsRawFd>(socket: &T) -> u64 {
+    socket.as_raw_fd() as u64
+}
+#[cfg(windows)]
+fn native<T: std::os::windows::io::AsRawSocket>(socket: &T) -> u64 {
+    socket.as_raw_socket() as u64
+}
+fn before(
+    socket: u64,
+    protocol: Protocol,
+    destination: SocketAddr,
+    purpose: Purpose,
+) -> io::Result<()> {
+    if let Some(host) = current() {
+        host.before_connect(socket, protocol, destination, purpose)
+    } else if cfg!(target_os = "android") {
+        Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "Android host socket authority is missing",
+        ))
+    } else {
+        Ok(())
+    }
+}
+pub async fn connect_tcp(
+    destination: SocketAddr,
+    purpose: Purpose,
+) -> io::Result<tokio::net::TcpStream> {
+    let socket = if destination.is_ipv4() {
+        tokio::net::TcpSocket::new_v4()?
+    } else {
+        tokio::net::TcpSocket::new_v6()?
+    };
+    before(native(&socket), Protocol::Tcp, destination, purpose)?;
+    socket.connect(destination).await
+}
+pub fn udp_socket(destination: SocketAddr, purpose: Purpose) -> io::Result<std::net::UdpSocket> {
+    let bind = if destination.is_ipv4() {
+        "0.0.0.0:0"
+    } else {
+        "[::]:0"
+    };
+    let socket = std::net::UdpSocket::bind(bind)?;
+    before(native(&socket), Protocol::Udp, destination, purpose)?;
+    socket.set_nonblocking(true)?;
+    Ok(socket)
+}
+pub fn bind_udp(destination: SocketAddr, purpose: Purpose) -> io::Result<tokio::net::UdpSocket> {
+    tokio::net::UdpSocket::from_std(udp_socket(destination, purpose)?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::task_scope::{DestinationPolicy, TaskScope};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    struct Host {
+        calls: AtomicUsize,
+        deny: bool,
+    }
+    impl HostNetwork for Host {
+        fn before_connect(&self, _: u64, _: Protocol, _: SocketAddr, _: Purpose) -> io::Result<()> {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            if self.deny {
+                Err(io::Error::new(io::ErrorKind::PermissionDenied, "test deny"))
+            } else {
+                Ok(())
+            }
+        }
+        fn dns_servers(&self) -> Vec<SocketAddr> {
+            vec![]
+        }
+    }
+    #[tokio::test]
+    async fn tcp_protection_precedes_connect_and_denial_prevents_peer_accept() {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let host = Arc::new(Host {
+            calls: AtomicUsize::new(0),
+            deny: true,
+        });
+        let scope =
+            TaskScope::with_host_network(DestinationPolicy::Unrestricted, Some(host.clone()));
+        scope
+            .run(async {
+                assert_eq!(
+                    connect_tcp(addr, Purpose::Proxy).await.unwrap_err().kind(),
+                    io::ErrorKind::PermissionDenied
+                );
+                assert!(
+                    tokio::time::timeout(std::time::Duration::from_millis(30), listener.accept())
+                        .await
+                        .is_err()
+                );
+            })
+            .await;
+        assert_eq!(host.calls.load(Ordering::SeqCst), 1);
+    }
+    #[tokio::test]
+    async fn inherited_task_protects_tcp_and_udp_exactly_once() {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let host = Arc::new(Host {
+            calls: AtomicUsize::new(0),
+            deny: false,
+        });
+        let scope =
+            TaskScope::with_host_network(DestinationPolicy::Unrestricted, Some(host.clone()));
+        scope
+            .run(async {
+                let tcp =
+                    crate::task_scope::spawn(
+                        async move { connect_tcp(addr, Purpose::Proxy).await },
+                    )
+                    .await
+                    .unwrap()
+                    .unwrap();
+                drop(tcp);
+                drop(bind_udp(addr, Purpose::Dns).unwrap());
+            })
+            .await;
+        assert_eq!(host.calls.load(Ordering::SeqCst), 2);
+        assert_eq!(
+            scope
+                .shutdown(std::time::Duration::ZERO, std::time::Duration::from_secs(1))
+                .await
+                .remaining_tasks,
+            0
+        );
+    }
+    #[tokio::test]
+    async fn udp_denied_before_socket_return() {
+        let host = Arc::new(Host {
+            calls: AtomicUsize::new(0),
+            deny: true,
+        });
+        let scope =
+            TaskScope::with_host_network(DestinationPolicy::Unrestricted, Some(host.clone()));
+        scope
+            .run(async {
+                assert!(bind_udp("127.0.0.1:9".parse().unwrap(), Purpose::Dns).is_err());
+            })
+            .await;
+        assert_eq!(host.calls.load(Ordering::SeqCst), 1);
+    }
+}
