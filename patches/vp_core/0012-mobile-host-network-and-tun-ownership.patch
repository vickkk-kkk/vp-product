+/// Protected node/bootstrap lookup. Numeric addresses bypass DNS. OS DNS is never
+/// used by a protected generation; resolver list comes from its host context.
+pub async fn lookup_host(host: &str, port: u16) -> std::io::Result<std::vec::IntoIter<SocketAddr>> {
+    if let Ok(ip) = host.parse::<IpAddr>() {
+        return Ok(vec![SocketAddr::new(ip, port)].into_iter());
+    }
+    if vp_core::host_network::requires_protection() {
+        let host_network = vp_core::host_network::current().ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "missing host resolver",
+            )
+        })?;
+        let servers = host_network.dns_servers();
+        if servers.is_empty() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "missing explicit DNS servers",
+            ));
+        }
+        let resolver = Resolver::new(servers.iter().map(ToString::to_string).collect());
+        let ips = resolver
+            .resolve_domain(host, false)
+            .await
+            .map_err(|_| std::io::Error::other("protected DNS failed"))?;
+        return Ok(ips
+            .iter()
+            .map(|ip| SocketAddr::new(*ip, port))
+            .collect::<Vec<_>>()
+            .into_iter());
+    }
+    Ok(tokio::net::lookup_host((host, port))
+        .await?
+        .collect::<Vec<_>>()
+        .into_iter())
+}
