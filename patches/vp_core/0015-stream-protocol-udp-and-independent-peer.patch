+                let target6 = UdpSocket::bind("[::1]:0").await.unwrap();
+                let addr = target4.local_addr().unwrap();
+                let dst = DstAddr::ip(addr.ip(), addr.port());
+                let local = "127.0.0.1:54321".parse().unwrap();
+                let sess = Session::new_udp("test".into(), Some(local), dst.clone());
+                let mut conn = out.connect_packet(&sess, &dst).await.unwrap();
+                let mut previous = [None, None];
+                let mut sizes = vec![1, 128, 4096, 8192, 15000, 60000, 1];
+                if protocol != "vmess-none" {
+                    sizes.push(0);
+                }
+                for (i, size) in sizes.into_iter().enumerate() {
+                    let index = i % 2;
+                    let target = if index == 0 { &target4 } else { &target6 };
+                    let addr = target.local_addr().unwrap();
+                    let data = vec![(i + 1) as u8; size];
+                    timeout(
+                        Duration::from_secs(3),
