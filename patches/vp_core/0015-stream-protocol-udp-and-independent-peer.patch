+//! Bounded datagram sessions carried by authenticated proxy streams.
+//!
+//! VLESS/VMess command-UDP fixes the destination in the request header. A
+//! PacketConn can target several peers, so each destination gets its own proxy
+//! stream (never a direct client socket). Readers own framing until completion:
+//! canceling PacketConn::recv cannot lose a partially received length/header.
+use std::{collections::HashMap, net::SocketAddr, sync::Arc, time::Duration};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tokio::{
+    io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt},
+    sync::{Mutex, mpsc, oneshot},
+    task::JoinHandle,
+};
+use vp_common::{DstAddr, Error, Host, Result};
+use vp_core::{PacketConn, UdpPacket};
+
+pub(crate) const MAX_DATAGRAM: usize = 65_507;
+const MAX_SESSIONS: usize = 16;
+const QUEUE: usize = 16;
+const IO_TIMEOUT: Duration = Duration::from_secs(10);
+const IDLE_TIMEOUT: Duration = Duration::from_secs(120);
+
+pub(crate) struct Frame {
+    pub target: DstAddr,
+    pub data: Bytes,
+}
+#[async_trait]
+pub(crate) trait ReadDatagram: Send {
+    async fn read(&mut self) -> Result<Frame>;
+}
+#[async_trait]
+pub(crate) trait WriteDatagram: Send {
+    async fn write(&mut self, frame: &Frame) -> Result<()>;
+}
+pub(crate) type DatagramIo = (Box<dyn ReadDatagram>, Box<dyn WriteDatagram>);
+#[async_trait]
+pub(crate) trait Factory: Send + Sync {
+    async fn open(&self, dst: &DstAddr) -> Result<DatagramIo>;
+}
+
+fn closed() -> Error {
+    Error::Io(std::io::Error::new(
+        std::io::ErrorKind::BrokenPipe,
+        "UDP stream session closed",
+    ))
+}
+fn timed_out() -> Error {
+    Error::Io(std::io::Error::new(
+        std::io::ErrorKind::TimedOut,
+        "UDP stream session deadline",
+    ))
+}
+pub(crate) fn validate_target(dst: &DstAddr) -> Result<()> {
+    if dst.port == 0 {
+        return Err(Error::Proto("UDP destination port is zero"));
+    }
+    if let Host::Domain(name) = &dst.host {
+        if name.is_empty() || name.len() > 255 {
+            return Err(Error::Proto("UDP destination domain length is invalid"));
+        }
+    }
+    vp_core::task_scope::check_destination(dst)
+}
+pub(crate) fn validate_payload(data: &[u8]) -> Result<()> {
+    if data.len() > MAX_DATAGRAM {
+        return Err(Error::Proto("UDP payload exceeds maximum datagram size"));
+    }
+    Ok(())
+}
+struct SendRequest {
+    frame: Frame,
+    done: oneshot::Sender<Result<()>>,
+}
+struct Handle {
+    tx: mpsc::Sender<SendRequest>,
+    task: JoinHandle<()>,
+}
+impl Drop for Handle {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+struct Pool {
+    factory: Arc<dyn Factory>,
+    sessions: Mutex<HashMap<DstAddr, Handle>>,
+    responses: mpsc::Sender<Result<Frame>>,
+    scope: Option<Arc<vp_core::task_scope::TaskScope>>,
+}
+impl Pool {
+    async fn send(&self, frame: Frame) -> Result<()> {
+        if let Some(scope) = &self.scope {
+            scope.run(self.send_scoped(frame)).await
+        } else {
+            self.send_scoped(frame).await
+        }
+    }
+    async fn send_scoped(&self, frame: Frame) -> Result<()> {
+        validate_target(&frame.target)?;
+        validate_payload(&frame.data)?;
+        if self.scope.as_ref().is_some_and(|scope| {
+            matches!(
+                scope.snapshot().phase,
+                vp_core::task_scope::Phase::Canceling | vp_core::task_scope::Phase::Stopped
+            )
+        }) {
+            return Err(closed());
+        }
+        let mut sessions = self.sessions.lock().await;
+        sessions.retain(|_, value| !value.task.is_finished());
+        if !sessions.contains_key(&frame.target) {
+            if sessions.len() >= MAX_SESSIONS {
+                return Err(Error::Proto("UDP stream destination session limit reached"));
+            }
+            if self
+                .scope
+                .as_ref()
+                .is_some_and(|scope| scope.snapshot().phase != vp_core::task_scope::Phase::Running)
+            {
+                return Err(closed());
+            }
+            // Opening is itself tracked/owned. A canceled send or generation
+            // shutdown drops this JoinSet and closes a partially dialed stream.
+            let factory = self.factory.clone();
+            let target = frame.target.clone();
+            let mut opening = tokio::task::JoinSet::new();
+            vp_core::task_scope::spawn_in(&mut opening, async move {
+                tokio::time::timeout(IO_TIMEOUT, factory.open(&target))
+                    .await
+                    .map_err(|_| timed_out())?
+            });
+            let (mut reader, mut writer) = opening
+                .join_next()
+                .await
+                .ok_or_else(closed)?
+                .map_err(|_| closed())??;
+            if self
+                .scope
+                .as_ref()
+                .is_some_and(|scope| scope.snapshot().phase != vp_core::task_scope::Phase::Running)
+            {
+                return Err(closed());
+            }
+            let (tx, mut rx) = mpsc::channel::<SendRequest>(QUEUE);
+            let responses = self.responses.clone();
+            let task = vp_core::task_scope::spawn(async move {
+                let read = async {
+                    loop {
+                        let frame = reader.read().await?;
+                        validate_payload(&frame.data)?;
+                        responses.send(Ok(frame)).await.map_err(|_| closed())?;
+                    }
+                    #[allow(unreachable_code)]
+                    Ok::<(), Error>(())
+                };
+                let write = async {
+                    loop {
+                        let request = tokio::time::timeout(IDLE_TIMEOUT, rx.recv())
+                            .await
+                            .map_err(|_| timed_out())?
+                            .ok_or_else(closed)?;
+                        let result = tokio::time::timeout(IO_TIMEOUT, writer.write(&request.frame))
+                            .await
+                            .map_err(|_| timed_out())
+                            .and_then(|r| r);
+                        let failed = result.is_err();
+                        let _ = request.done.send(result);
+                        if failed {
+                            return Err::<(), Error>(closed());
+                        }
+                    }
+                };
+                // Dropping either half closes the entire destination session.
+                // No read_exact future is canceled and then resumed on this IO.
+                let result = tokio::select! { result = read => result, result = write => result };
+                if let Err(error) = result {
+                    let _ = responses.try_send(Err(error));
+                }
+            });
+            sessions.insert(frame.target.clone(), Handle { tx, task });
+        }
+        let tx = sessions.get(&frame.target).unwrap().tx.clone();
+        drop(sessions);
+        let (done, result) = oneshot::channel();
+        tokio::time::timeout(IO_TIMEOUT, tx.send(SendRequest { frame, done }))
+            .await
+            .map_err(|_| timed_out())?
+            .map_err(|_| closed())?;
+        tokio::time::timeout(IO_TIMEOUT, result)
+            .await
+            .map_err(|_| timed_out())?
+            .map_err(|_| closed())?
+    }
+}
+
+pub(crate) struct StreamPacketConn {
+    pool: Pool,
+    responses: mpsc::Receiver<Result<Frame>>,
+    source: SocketAddr,
+}
+impl StreamPacketConn {
+    pub(crate) fn new(factory: Arc<dyn Factory>, source: Option<SocketAddr>) -> Self {
+        let (tx, responses) = mpsc::channel(QUEUE);
+        Self {
+            pool: Pool {
+                factory,
+                sessions: Mutex::new(HashMap::new()),
+                responses: tx,
+                scope: vp_core::task_scope::current_scope(),
+            },
+            responses,
+            source: source.unwrap_or_else(|| "0.0.0.0:0".parse().unwrap()),
+        }
+    }
+}
+#[async_trait]
+impl PacketConn for StreamPacketConn {
+    async fn send(&self, pkt: &UdpPacket) -> Result<()> {
+        self.pool
+            .send(Frame {
+                target: DstAddr::ip(pkt.dst.ip(), pkt.dst.port()),
+                data: pkt.data.clone(),
+            })
+            .await
+    }
+    async fn recv(&mut self) -> Result<UdpPacket> {
+        let frame = self.responses.recv().await.ok_or_else(closed)??;
+        let Host::Ip(ip) = frame.target.host else {
+            return Err(Error::Proto(
+                "UDP response domain cannot be represented as SocketAddr",
+            ));
+        };
+        Ok(UdpPacket {
+            src: SocketAddr::new(ip, frame.target.port),
+            dst: self.source,
+            data: frame.data,
+        })
+    }
+}
+
+/// Server-side only: destinations authenticated by the protocol are checked
+/// before resolution and passed through the generation's protected UDP helper.
+struct DirectFactory(Arc<crate::direct::DirectOutbound>);
+struct UdpIo {
+    socket: Arc<tokio::net::UdpSocket>,
+    destination: SocketAddr,
+}
+#[async_trait]
+impl Factory for DirectFactory {
+    async fn open(&self, dst: &DstAddr) -> Result<DatagramIo> {
+        validate_target(dst)?;
+        let target = self
+            .0
+            .resolve(dst)
+            .await?
+            .into_iter()
+            .next()
+            .ok_or_else(|| Error::Addr("UDP target has no address".into()))?;
+        let socket = Arc::new(vp_core::host_network::bind_udp(
+            target,
+            vp_core::host_network::Purpose::Proxy,
+        )?);
+        socket.connect(target).await?;
+        Ok((
+            Box::new(UdpIo {
+                socket: socket.clone(),
+                destination: target,
+            }),
+            Box::new(UdpIo {
+                socket,
+                destination: target,
+            }),
+        ))
+    }
+}
+#[async_trait]
+impl ReadDatagram for UdpIo {
+    async fn read(&mut self) -> Result<Frame> {
+        let mut data = vec![0; MAX_DATAGRAM + 1];
+        let n = self.socket.recv(&mut data).await?;
+        data.truncate(n);
+        validate_payload(&data)?;
+        Ok(Frame {
+            target: DstAddr::ip(self.destination.ip(), self.destination.port()),
+            data: data.into(),
+        })
+    }
+}
+#[async_trait]
+impl WriteDatagram for UdpIo {
+    async fn write(&mut self, frame: &Frame) -> Result<()> {
+        let n = self.socket.send(&frame.data).await?;
+        if n != frame.data.len() {
+            return Err(Error::Proto("short UDP write"));
+        }
+        Ok(())
+    }
+}
+pub(crate) async fn serve(
+    mut reader: Box<dyn ReadDatagram>,
+    mut writer: Box<dyn WriteDatagram>,
+    direct: Arc<crate::direct::DirectOutbound>,
+) -> Result<()> {
+    let (tx, mut responses) = mpsc::channel(QUEUE);
+    let pool = Pool {
+        factory: Arc::new(DirectFactory(direct)),
+        sessions: Mutex::new(HashMap::new()),
+        responses: tx,
+        scope: vp_core::task_scope::current_scope(),
+    };
+    let requests = async {
+        loop {
+            let frame = tokio::time::timeout(IDLE_TIMEOUT, reader.read())
+                .await
+                .map_err(|_| timed_out())??;
+            pool.send(frame).await?;
+        }
+        #[allow(unreachable_code)]
+        Ok::<(), Error>(())
+    };
+    let replies = async {
+        loop {
+            let frame = responses.recv().await.ok_or_else(closed)??;
+            tokio::time::timeout(IO_TIMEOUT, writer.write(&frame))
+                .await
+                .map_err(|_| timed_out())??;
+        }
+        #[allow(unreachable_code)]
+        Ok::<(), Error>(())
+    };
+    tokio::select! { result = requests => result, result = replies => result }
+}
+
+pub(crate) struct LengthReader<R> {
+    pub io: R,
+    pub target: DstAddr,
+    pub vless_response: bool,
+}
+pub(crate) struct LengthWriter<W> {
+    pub io: W,
+}
+#[async_trait]
+impl<R: AsyncRead + Unpin + Send> ReadDatagram for LengthReader<R> {
+    async fn read(&mut self) -> Result<Frame> {
+        if self.vless_response {
+            let version = self.io.read_u8().await?;
+            if version != 0 {
+                return Err(Error::Proto("VLESS UDP response version mismatch"));
+            }
+            let n = self.io.read_u8().await? as usize;
+            let mut addons = vec![0; n];
+            self.io.read_exact(&mut addons).await?;
+            self.vless_response = false;
+        }
+        let n = self.io.read_u16().await? as usize;
+        if n > MAX_DATAGRAM {
+            return Err(Error::Proto("UDP frame exceeds maximum datagram size"));
+        }
+        let mut data = vec![0; n];
+        self.io.read_exact(&mut data).await?;
+        Ok(Frame {
+            target: self.target.clone(),
+            data: data.into(),
+        })
+    }
+}
+#[async_trait]
+impl<W: AsyncWrite + Unpin + Send> WriteDatagram for LengthWriter<W> {
+    async fn write(&mut self, frame: &Frame) -> Result<()> {
+        validate_payload(&frame.data)?;
+        self.io.write_u16(frame.data.len() as u16).await?;
+        self.io.write_all(&frame.data).await?;
+        self.io.flush().await?;
+        Ok(())
+    }
+}
+
+pub(crate) async fn read_socks_addr<R: AsyncRead + Unpin + Send>(io: &mut R) -> Result<DstAddr> {
+    let atyp = io.read_u8().await?;
+    let mut encoded = vec![atyp];
+    let len = match atyp {
+        1 => 6,
+        4 => 18,
+        3 => {
+            let n = io.read_u8().await?;
+            if n == 0 {
+                return Err(Error::Proto("empty UDP domain"));
+            }
+            encoded.push(n);
+            n as usize + 2
+        }
+        _ => return Err(Error::Proto("invalid UDP address type")),
+    };
+    let offset = encoded.len();
+    encoded.resize(offset + len, 0);
+    io.read_exact(&mut encoded[offset..]).await?;
+    vp_common::addr::decode_socks_addr(&encoded).map(|(dst, _)| dst)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    struct FakeFactory(AtomicUsize);
+    struct PendingReader;
+    struct SinkWriter;
+    #[async_trait]
+    impl ReadDatagram for PendingReader {
+        async fn read(&mut self) -> Result<Frame> {
+            std::future::pending().await
+        }
+    }
+    #[async_trait]
+    impl WriteDatagram for SinkWriter {
+        async fn write(&mut self, _: &Frame) -> Result<()> {
+            Ok(())
+        }
+    }
+    #[async_trait]
+    impl Factory for FakeFactory {
+        async fn open(&self, _: &DstAddr) -> Result<DatagramIo> {
+            self.0.fetch_add(1, Ordering::SeqCst);
+            Ok((Box::new(PendingReader), Box::new(SinkWriter)))
+        }
+    }
+    #[tokio::test]
+    async fn session_limit_and_drop_close_all_owned_readers() {
+        let scope = vp_core::task_scope::TaskScope::new();
+        let factory = Arc::new(FakeFactory(AtomicUsize::new(0)));
+        scope
+            .run(async {
+                let conn = StreamPacketConn::new(factory.clone(), None);
+                let src = "127.0.0.1:1".parse().unwrap();
+                for port in 1..=MAX_SESSIONS as u16 {
+                    conn.send(&UdpPacket {
+                        src,
+                        dst: SocketAddr::new(src.ip(), port),
+                        data: Bytes::from_static(b"one"),
+                    })
+                    .await
+                    .unwrap();
+                }
+                assert!(
+                    conn.send(&UdpPacket {
+                        src,
+                        dst: SocketAddr::new(src.ip(), 99),
+                        data: Bytes::from_static(b"limit")
+                    })
+                    .await
+                    .is_err()
+                );
+                assert_eq!(factory.0.load(Ordering::SeqCst), MAX_SESSIONS);
+                drop(conn);
+            })
+            .await;
+        let report = scope
+            .shutdown(Duration::from_millis(20), Duration::from_secs(1))
+            .await;
+        assert_eq!(report.remaining_tasks, 0);
+        assert_eq!(report.forced_tasks, 0);
+    }
+    #[tokio::test]
+    async fn stopped_generation_cannot_reopen_packet_session() {
+        let scope = vp_core::task_scope::TaskScope::new();
+        let factory = Arc::new(FakeFactory(AtomicUsize::new(0)));
+        let conn = scope
+            .run(async { StreamPacketConn::new(factory.clone(), None) })
+            .await;
+        scope.shutdown(Duration::ZERO, Duration::from_secs(1)).await;
+        let addr = "127.0.0.1:1".parse().unwrap();
+        assert!(
+            conn.send(&UdpPacket {
+                src: addr,
+                dst: addr,
+                data: Bytes::from_static(b"late")
+            })
+            .await
+            .is_err()
+        );
+        assert_eq!(factory.0.load(Ordering::SeqCst), 0);
+    }
+    #[tokio::test]
+    async fn fragmented_length_reader_preserves_zero_datagrams() {
+        let (mut peer, io) = tokio::io::duplex(16);
+        let task = tokio::spawn(async move {
+            for byte in [0u8, 0, 0, 3, b'o', b'n', b'e'] {
+                peer.write_all(&[byte]).await.unwrap();
+                tokio::task::yield_now().await;
+            }
+        });
+        let mut reader = LengthReader {
+            io,
+            target: DstAddr::new("127.0.0.1", 9),
+            vless_response: false,
+        };
+        assert!(reader.read().await.unwrap().data.is_empty());
+        assert_eq!(&reader.read().await.unwrap().data[..], b"one");
+        task.await.unwrap();
+    }
+}
