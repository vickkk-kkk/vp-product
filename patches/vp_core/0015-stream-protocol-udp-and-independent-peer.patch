index 0000000..a3aca66
--- /dev/null
+++ b/crates/vp-protocol/tests/stream_library_interop.rs
@@ -0,0 +1,303 @@
+//! Real independent official-library acceptance, never a production fallback.
+use std::{
+    io::{BufRead, Read, Write},
+    process::{Child, Command, Stdio},
+    sync::Arc,
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, UdpSocket},
+    time::timeout,
+};
+use vp_common::DstAddr;
+use vp_core::{
+    Inbound, InboundCtx, Outbound, Session, UdpPacket,
+    task_scope::{DestinationPolicy, TaskScope},
+};
+const ID: &str = "b831381d-6324-4d53-ad4f-8cda48b30811";
+struct Router;
+#[async_trait::async_trait]
+impl vp_core::Router for Router {
+    async fn pick(&self, _: &Session) -> vp_core::Resolution {
+        unreachable!()
+    }
+}
+fn ctx() -> InboundCtx {
+    InboundCtx {
+        router: Arc::new(Router),
+        stats: Arc::default(),
+        conns: Arc::new(vp_core::ConnTable::new()),
+    }
+}
+fn outbound(protocol: &str, port: u16, udp: bool) -> Box<dyn Outbound> {
+    let value = serde_json::json!({"server":"127.0.0.1","port":port,"uuid":ID,"password":ID,"tls":false,"udp":udp,"cipher":protocol.strip_prefix("vmess-").unwrap_or("auto")});
+    match protocol {
+        "vless" => Box::new(
+            vp_protocol::vless::VlessOutbound::new(&serde_json::from_value(value).unwrap())
+                .unwrap(),
+        ),
+        "trojan" => Box::new(
+            vp_protocol::trojan::TrojanOutbound::new(&serde_json::from_value(value).unwrap())
+                .unwrap(),
+        ),
+        _ => Box::new(
+            vp_protocol::vmess::VmessOutbound::new(&serde_json::from_value(value).unwrap())
+                .unwrap(),
+        ),
+    }
+}
+async fn server(protocol: &str) -> u16 {
+    let users = vec![ID.to_string()];
+    match protocol {
+        "vless" => {
+            Arc::new(vp_protocol::vless::VlessInbound::new("127.0.0.1", 0, "test", &users).unwrap())
+                .start(ctx())
+                .await
+                .unwrap()
+        }
+        "trojan" => Arc::new(
+            vp_protocol::trojan::TrojanInbound::new("127.0.0.1", 0, "test", &users).unwrap(),
+        )
+        .start(ctx())
+        .await
+        .unwrap(),
+        _ => {
+            Arc::new(vp_protocol::vmess::VmessInbound::new("127.0.0.1", 0, "test", &users).unwrap())
+                .start(ctx())
+                .await
+                .unwrap()
