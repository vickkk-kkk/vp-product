+
+struct Peer(Child);
+impl Drop for Peer {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+fn peer(config: serde_json::Value) -> Peer {
+    let binary = std::env::var_os("VP_STREAM_REFERENCE")
+        .expect("requires verified official protocol-library fixture");
+    let mut child = Command::new(binary)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    let mut bytes = serde_json::to_vec(&config).unwrap();
+    bytes.push(b'\n');
+    child.stdin.as_mut().unwrap().write_all(&bytes).unwrap();
+    Peer(child)
+}
+async fn finish(mut child: Peer) -> serde_json::Value {
+    let status = timeout(Duration::from_secs(45), async {
+        loop {
+            if let Some(status) = child.0.try_wait().unwrap() {
+                break status;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("official peer deadline");
+    let mut out = String::new();
+    let mut err = String::new();
+    child
+        .0
+        .stdout
+        .take()
+        .unwrap()
+        .read_to_string(&mut out)
+        .unwrap();
+    child
+        .0
+        .stderr
+        .take()
+        .unwrap()
+        .read_to_string(&mut err)
+        .unwrap();
+    assert!(
+        status.success(),
+        "official peer failed: {err}; stdout={out}"
+    );
+    serde_json::from_str(&out).unwrap()
+}
+fn name(protocol: &str) -> &str {
+    if protocol.starts_with("vmess-") {
+        "vmess"
+    } else {
+        protocol
+    }
+}
+#[tokio::test]
+#[ignore = "requires authorized pinned official Go stream protocol-library peer"]
+async fn official_client_to_vp_server_tcp_udp_auth_replay_tamper_padding() {
+    for protocol in [
+        "vless",
+        "trojan",
+        "vmess-aes-128-gcm",
+        "vmess-chacha20-poly1305",
+        "vmess-none",
+    ] {
+        eprintln!("official client -> vp server: {protocol}");
+        let scope = TaskScope::with_destination_policy(DestinationPolicy::LoopbackIpOnly);
+        let port = scope.run(server(protocol)).await;
+        let security = protocol.strip_prefix("vmess-").unwrap_or("auto");
+        for (negative, offset, padding) in [
+            (false, 0, false),
+            (true, 0, false),
+            (false, 0, true),
+            (true, -300, false),
+        ] {
+            if (padding || offset != 0) && !protocol.starts_with("vmess-") {
+                continue;
+            }
+            if padding && security == "none" {
+                continue;
+            }
+            let credential = if negative && offset == 0 {
+                "11111111-2222-3333-4444-555555555555"
+            } else {
+                ID
+            };
+            let mut child = peer(
+                serde_json::json!({"Mode":"client","Protocol":name(protocol),"Credential":credential,"Security":security,"Port":port,"Negative":negative,"Padding":padding,"TimeOffset":offset,"Tamper":true,"Replay":true}),
+            );
+            child.0.stdin.take();
+            let result = finish(child).await;
+            assert_eq!(
+                result["ok"], true,
+                "{protocol} {negative} {offset} {padding}"
+            );
+            assert_eq!(result["kind"], "official-protocol-library");
+        }
+        let report = scope
+            .shutdown(Duration::from_millis(50), Duration::from_secs(2))
+            .await;
+        assert_eq!(report.remaining_tasks, 0);
+        assert_eq!(report.panics, 0);
+    }
+}
+#[tokio::test]
+#[ignore = "requires authorized pinned official Go stream protocol-library peer"]
+async fn vp_client_to_official_server_multitarget_sizes_tcp_and_cleanup() {
+    for protocol in [
+        "vless",
+        "trojan",
+        "vmess-aes-128-gcm",
+        "vmess-chacha20-poly1305",
+        "vmess-none",
+    ] {
+        let mut child =
+            peer(serde_json::json!({"Mode":"server","Protocol":name(protocol),"Credential":ID}));
+        let stdout = child.0.stdout.take().unwrap();
+        let line = tokio::task::spawn_blocking(move || {
+            let mut line = String::new();
+            std::io::BufReader::new(stdout)
+                .read_line(&mut line)
+                .unwrap();
+            line
+        });
+        let line = timeout(Duration::from_secs(10), line)
+            .await
+            .unwrap()
+            .unwrap();
+        let ready: serde_json::Value = serde_json::from_str(&line).unwrap();
+        let port = ready["port"].as_u64().unwrap() as u16;
+        let scope = TaskScope::with_destination_policy(DestinationPolicy::LoopbackIpOnly);
+        scope
+            .run(async {
+                let out = outbound(protocol, port, true);
+                let echo = TcpListener::bind("127.0.0.1:0").await.unwrap();
+                let dst = DstAddr::new("127.0.0.1", echo.local_addr().unwrap().port());
+                vp_core::task_scope::spawn(async move {
+                    let (mut io, _) = echo.accept().await.unwrap();
+                    let (mut r, mut w) = io.split();
+                    let _ = tokio::io::copy(&mut r, &mut w).await;
+                });
+                let sess = Session::new_tcp("peer".into(), None, dst.clone());
+                let mut stream = out.connect_stream(&sess, &dst).await.unwrap();
+                let data = vec![91; 90000];
+                stream.write_all(&data).await.unwrap();
+                stream.flush().await.unwrap();
+                let mut response = vec![0; data.len()];
+                timeout(Duration::from_secs(8), stream.read_exact(&mut response))
+                    .await
+                    .unwrap()
+                    .unwrap();
+                assert_eq!(response, data);
+                drop(stream);
+                let target4 = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+                let target6 = UdpSocket::bind("[::1]:0").await.unwrap();
+                let addr = target4.local_addr().unwrap();
+                let dst = DstAddr::ip(addr.ip(), addr.port());
+                let src = "127.0.0.1:54321".parse().unwrap();
+                let sess = Session::new_udp("peer".into(), Some(src), dst.clone());
+                let mut packets = out.connect_packet(&sess, &dst).await.unwrap();
+                let mut previous = [None, None];
+                let mut sizes = vec![1, 128, 4096, 8192, 15000, 1];
+                if !protocol.starts_with("vmess-") {
+                    sizes.push(60000)
+                }
+                for (index, size) in sizes.into_iter().enumerate() {
+                    let family = index % 2;
+                    let target = if family == 0 { &target4 } else { &target6 };
+                    let addr = target.local_addr().unwrap();
+                    let data = vec![(index + 31) as u8; size];
+                    packets
+                        .send(&UdpPacket {
+                            src,
+                            dst: addr,
+                            data: data.clone().into(),
+                        })
+                        .await
+                        .unwrap();
+                    let mut got = vec![0; 65535];
+                    let (n, from) = timeout(Duration::from_secs(8), target.recv_from(&mut got))
+                        .await
+                        .unwrap()
+                        .unwrap();
+                    assert_eq!(&got[..n], data);
+                    if let Some(old) = previous[family] {
+                        assert_eq!(old, from)
+                    }
+                    previous[family] = Some(from);
+                    assert!(
+                        timeout(Duration::from_millis(2), packets.recv())
+                            .await
+                            .is_err()
+                    );
+                    target.send_to(&got[..n], from).await.unwrap();
+                    let response = timeout(Duration::from_secs(8), packets.recv())
+                        .await
+                        .unwrap()
+                        .unwrap();
+                    assert_eq!(response.src, addr);
+                    assert_eq!(response.dst, src);
+                    assert_eq!(&response.data[..], data);
+                }
+                drop(packets);
+            })
+            .await;
+        let report = scope
+            .shutdown(Duration::from_millis(20), Duration::from_secs(2))
+            .await;
+        assert_eq!(report.remaining_tasks, 0);
+        assert_eq!(report.panics, 0);
+        child.0.stdin.take();
+        let status = timeout(Duration::from_secs(5), async {
+            loop {
+                if let Some(status) = child.0.try_wait().unwrap() {
+                    break status;
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .unwrap();
+        assert!(status.success());
+    }
+}
