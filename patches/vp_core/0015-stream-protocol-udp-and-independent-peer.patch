+#[async_trait]
+impl crate::stream_udp::Factory for TrojanOutbound {
+    async fn open(&self, dst: &DstAddr) -> Result<crate::stream_udp::DatagramIo> {
+        crate::stream_udp::validate_target(dst)?;
+        let mut io = transport::dial(&self.server, self.port, &self.transport).await?;
+        let mut header = self
+            .hash
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect::<String>()
+            .into_bytes();
+        header.extend_from_slice(b"\r\n");
+        header.push(3);
+        encode_socks_addr(dst, &mut header);
+        header.extend_from_slice(b"\r\n");
+        io.write_all(&header).await?;
+        io.flush().await?;
+        let (read, write) = tokio::io::split(io);
+        Ok((Box::new(TrojanReader(read)), Box::new(TrojanWriter(write))))
+    }
+}
+struct TrojanReader<R>(R);
+struct TrojanWriter<W>(W);
+#[async_trait]
+impl<R: AsyncRead + Unpin + Send> crate::stream_udp::ReadDatagram for TrojanReader<R> {
+    async fn read(&mut self) -> Result<crate::stream_udp::Frame> {
+        let target = crate::stream_udp::read_socks_addr(&mut self.0).await?;
+        let len = self.0.read_u16().await? as usize;
+        if len > crate::stream_udp::MAX_DATAGRAM {
+            return Err(Error::Proto("Trojan UDP frame exceeds datagram limit"));
+        }
+        let mut crlf = [0; 2];
+        self.0.read_exact(&mut crlf).await?;
+        if &crlf != b"\r\n" {
+            return Err(Error::Proto("Trojan UDP frame missing CRLF"));
+        }
+        let mut data = vec![0; len];
+        self.0.read_exact(&mut data).await?;
+        Ok(crate::stream_udp::Frame {
+            target,
+            data: data.into(),
+        })
