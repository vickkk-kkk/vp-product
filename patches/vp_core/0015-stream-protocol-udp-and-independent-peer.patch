diff --git a/crates/vp-protocol/tests/reference_stream/main.go b/crates/vp-protocol/tests/reference_stream/main.go
new file mode 100644
index 0000000..b232ea1
--- /dev/null
+++ b/crates/vp-protocol/tests/reference_stream/main.go
@@ -0,0 +1,445 @@
+// Test-only adapter. Protocol framing/authentication/crypto are unmodified
+// official sing-vmess and sing-box transport/trojan libraries.
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"time"
+
+	T "github.com/sagernet/sing-box/transport/trojan"
+	V "github.com/sagernet/sing-vmess"
+	L "github.com/sagernet/sing-vmess/vless"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type input struct {
+	Mode, Protocol, Credential, Security string
+	Port                                 uint16
+	Negative, Padding, Tamper, Replay    bool
+	TimeOffset                           int64
+}
+
+func deadline() time.Time { return time.Now().Add(8 * time.Second) }
+func loopback(a M.Socksaddr) error {
+	if !a.Addr.IsLoopback() || a.Port == 0 {
+		return errors.New("reference target must be a nonzero loopback IP address")
+	}
+	return nil
+}
+func emit(v any) error { return json.NewEncoder(os.Stdout).Encode(v) }
+func packetBuffer(data []byte) *buf.Buffer {
+	b := buf.NewSize(len(data) + 1024)
+	b.Resize(512, 0)
+	b.Write(data)
+	return b
+}
+
+type handler struct{}
+
+func (handler) NewConnectionEx(ctx context.Context, conn net.Conn, source, dst M.Socksaddr, onClose N.CloseHandlerFunc) {
+	go func() {
+		defer conn.Close()
+		if onClose != nil {
+			defer onClose(nil)
+		}
+		if loopback(dst) != nil {
+			return
+		}
+		remote, err := net.DialTimeout("tcp", dst.String(), 3*time.Second)
+		if err != nil {
+			return
+		}
+		defer remote.Close()
+		conn.SetDeadline(deadline())
+		remote.SetDeadline(deadline())
+		done := make(chan struct{})
+		go func() {
+			io.Copy(remote, conn)
+			if tcp, ok := remote.(*net.TCPConn); ok {
+				tcp.CloseWrite()
+			}
+			close(done)
+		}()
+		io.Copy(conn, remote)
+		conn.Close()
+		remote.Close()
+		<-done
+	}()
+}
+func (handler) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	go func() {
+		defer conn.Close()
+		if onClose != nil {
+			defer onClose(nil)
+		}
+		sockets := make(map[M.Socksaddr]*net.UDPConn)
+		defer func() {
+			for _, s := range sockets {
+				s.Close()
+			}
+		}()
+		for {
+			conn.SetDeadline(deadline())
+			buffer := buf.NewSize(65535)
+			dst, err := conn.ReadPacket(buffer)
+			if err != nil {
+				buffer.Release()
+				return
+			}
+			if loopback(dst) != nil {
+				buffer.Release()
+				return
+			}
+			socket := sockets[dst]
+			if socket == nil {
+				if len(sockets) >= 16 {
+					buffer.Release()
+					return
+				}
+				socket, err = net.DialUDP("udp", nil, dst.UDPAddr())
+				if err != nil {
+					buffer.Release()
+					return
+				}
+				sockets[dst] = socket
+			}
+			socket.SetDeadline(deadline())
+			_, err = socket.Write(buffer.Bytes())
+			buffer.Release()
+			if err != nil {
+				return
+			}
+			response := make([]byte, 65535)
+			n, err := socket.Read(response)
+			if err != nil {
+				return
+			}
+			if err = conn.WritePacket(packetBuffer(response[:n]), dst); err != nil {
+				return
+			}
+		}
+	}()
+}
+
+type service interface {
+	NewConnection(context.Context, net.Conn, M.Socksaddr, N.CloseHandlerFunc) error
+}
+
+func newService(c input) (service, error) {
+	switch c.Protocol {
+	case "vless":
+		s := L.NewService[string](logger.NOP(), handler{})
+		s.UpdateUsers([]string{"test"}, []string{c.Credential}, []string{""})
+		return s, nil
+	case "vmess":
+		s := V.NewService[string](handler{}, V.ServiceWithDisableHeaderProtection())
+		if err := s.UpdateUsers([]string{"test"}, []string{c.Credential}, []int{0}); err != nil {
+			return nil, err
+		}
+		return s, nil
+	case "trojan":
+		s := T.NewService[string](handler{}, nil, logger.NOP())
+		if err := s.UpdateUsers([]string{"test"}, []string{c.Credential}); err != nil {
+			return nil, err
+		}
+		return s, nil
+	default:
+		return nil, errors.New("unsupported reference protocol")
+	}
+}
+func runServer(c input) error {
+	s, err := newService(c)
+	if err != nil {
+		return err
+	}
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+	if err = emit(map[string]any{"port": listener.Addr().(*net.TCPAddr).Port, "kind": "official-protocol-library"}); err != nil {
+		return err
+	}
+	go func() {
+		for {
+			conn, e := listener.Accept()
+			if e != nil {
+				return
+			}
+			go func() {
+				conn.SetDeadline(deadline())
+				if e = s.NewConnection(context.Background(), conn, M.SocksaddrFromNet(conn.RemoteAddr()), nil); e != nil {
+					conn.Close()
+				}
+			}()
+		}
+	}()
+	_, err = io.Copy(io.Discard, os.Stdin)
+	return err
+}
+
+type capture struct {
+	net.Conn
+	bytes   []byte
+	corrupt bool
+}
+
+func (c *capture) Write(b []byte) (int, error) {
+	data := append([]byte(nil), b...)
+	if c.corrupt && len(data) > 2 {
+		data[2] ^= 0x80
+	}
+	c.bytes = append(c.bytes, data...)
+	return c.Conn.Write(data)
+}
+func vmessClient(c input) (*V.Client, error) {
+	var opts []V.ClientOption
+	if c.Padding {
+		opts = append(opts, V.ClientWithGlobalPadding())
+	}
+	if c.TimeOffset != 0 {
+		opts = append(opts, V.ClientWithTimeFunc(func() time.Time { return time.Now().Add(time.Duration(c.TimeOffset) * time.Second) }))
+	}
+	return V.NewClient(c.Credential, c.Security, 0, opts...)
+}
+func tcpClient(c input, raw net.Conn, dst M.Socksaddr) (net.Conn, error) {
+	switch c.Protocol {
+	case "vless":
+		client, e := L.NewClient(c.Credential, "", logger.NOP())
+		if e != nil {
+			return nil, e
+		}
+		return client.DialConn(raw, dst)
+	case "vmess":
+		client, e := vmessClient(c)
+		if e != nil {
+			return nil, e
+		}
+		return client.DialConn(raw, dst)
+	case "trojan":
+		return T.NewClientConn(raw, T.Key(c.Credential), dst), nil
+	}
+	return nil, errors.New("unsupported protocol")
+}
+
+type vlessPacket struct {
+	*L.PacketConn
+	dst M.Socksaddr
+}
+
+func (c *vlessPacket) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	_, err := buffer.ReadOnceFrom(c.PacketConn)
+	return c.dst, err
+}
+func (c *vlessPacket) WritePacket(buffer *buf.Buffer, _ M.Socksaddr) error {
+	defer buffer.Release()
+	_, err := c.PacketConn.Write(buffer.Bytes())
+	return err
+}
+func packetClient(c input, raw net.Conn, dst M.Socksaddr) (N.PacketConn, error) {
+	switch c.Protocol {
+	case "vless":
+		client, e := L.NewClient(c.Credential, "", logger.NOP())
+		if e != nil {
+			return nil, e
+		}
+		packet, err := client.DialEarlyPacketConn(raw, dst)
+		if err != nil {
+			return nil, err
+		}
+		return &vlessPacket{packet, dst}, nil
+	case "vmess":
+		client, e := vmessClient(c)
+		if e != nil {
+			return nil, e
+		}
+		return client.DialPacketConn(raw, dst)
+	case "trojan":
+		return T.NewClientPacketConn(raw, T.Key(c.Credential)), nil
+	}
+	return nil, errors.New("unsupported protocol")
+}
+func runClient(c input) error {
+	if c.Port == 0 {
+		return errors.New("missing loopback proxy port")
+	}
+	server := fmt.Sprintf("127.0.0.1:%d", c.Port)
+	tcpTarget, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return err
+	}
+	defer tcpTarget.Close()
+	u4, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return err
+	}
+	defer u4.Close()
+	u6, err := net.ListenUDP("udp6", &net.UDPAddr{IP: net.IPv6loopback})
+	if err != nil {
+		return err
+	}
+	defer u6.Close()
+	raw, err := net.DialTimeout("tcp4", server, 3*time.Second)
+	if err != nil {
+		return err
+	}
+	defer raw.Close()
+	raw.SetDeadline(deadline())
+	captured := &capture{Conn: raw}
+	tcp, err := tcpClient(c, captured, M.SocksaddrFromNet(tcpTarget.Addr()))
+	if err != nil && !c.Negative {
+		return err
+	}
+	if c.Negative {
+		if err == nil {
+			tcp.Write([]byte("must-not-forward"))
+			tcp.Close()
+		}
+		wire, e := net.DialTimeout("tcp4", server, 3*time.Second)
+		if e != nil {
+			return e
+		}
+		defer wire.Close()
+		wire.SetDeadline(deadline())
+		packet, e := packetClient(c, wire, M.SocksaddrFromNet(u4.LocalAddr()))
+		if e == nil {
+			packet.WritePacket(packetBuffer([]byte("must-not-forward")), M.SocksaddrFromNet(u4.LocalAddr()))
+			packet.Close()
+		}
+		tcpTarget.SetDeadline(time.Now().Add(150 * time.Millisecond))
+		if conn, e := tcpTarget.Accept(); e == nil {
+			conn.Close()
+			return errors.New("invalid TCP request reached target")
+		}
+		u4.SetDeadline(time.Now().Add(150 * time.Millisecond))
+		if _, _, e := u4.ReadFrom(make([]byte, 100)); e == nil {
+			return errors.New("invalid UDP request reached target")
+		}
+		return emit(map[string]any{"ok": true, "negative": true, "kind": "official-protocol-library"})
+	}
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		remote, e := tcpTarget.AcceptTCP()
+		if e == nil {
+			defer remote.Close()
+			remote.SetDeadline(deadline())
+			io.Copy(remote, remote)
+		}
+	}()
+	payload := bytes.Repeat([]byte("independent-stream-tcp"), 2000)
+	if _, err = tcp.Write(payload); err != nil {
+		return err
+	}
+	response := make([]byte, len(payload))
+	if _, err = io.ReadFull(tcp, response); err != nil {
+		return fmt.Errorf("TCP response: %w", err)
+	}
+	if !bytes.Equal(payload, response) {
+		return errors.New("TCP mismatch")
+	}
+	tcp.Close()
+	wg.Wait()
+	if c.Replay && c.Protocol == "vmess" {
+		replay, e := net.DialTimeout("tcp4", server, 3*time.Second)
+		if e != nil {
+			return e
+		}
+		replay.SetDeadline(deadline())
+		replay.Write(captured.bytes)
+		defer replay.Close()
+		tcpTarget.SetDeadline(time.Now().Add(150 * time.Millisecond))
+		if conn, e := tcpTarget.Accept(); e == nil {
+			conn.Close()
+			return errors.New("VMess replay reached target")
+		}
+	}
+	for _, target := range []*net.UDPConn{u4, u6} {
+		wire, e := net.DialTimeout("tcp4", server, 3*time.Second)
+		if e != nil {
+			return e
+		}
+		wire.SetDeadline(deadline())
+		defer wire.Close()
+		cap := &capture{Conn: wire}
+		packet, e := packetClient(c, cap, M.SocksaddrFromNet(target.LocalAddr()))
+		if e != nil {
+			return e
+		}
+		defer packet.Close()
+		sizes := []int{1, 128, 4096, 8192, 15000, 1}
+		if c.Protocol != "vmess" {
+			sizes = append(sizes, 60000)
+		}
+		for index, size := range sizes {
+			body := bytes.Repeat([]byte{byte(index + 71)}, size)
+			dst := M.SocksaddrFromNet(target.LocalAddr())
+			if e = packet.WritePacket(packetBuffer(body), dst); e != nil {
+				return fmt.Errorf("UDP write %d: %w", size, e)
+			}
+			target.SetDeadline(deadline())
+			read := make([]byte, 65535)
+			n, from, e := target.ReadFrom(read)
+			if e != nil {
+				return fmt.Errorf("UDP target %d: %w", size, e)
+			}
+			if !bytes.Equal(body, read[:n]) {
+				return errors.New("UDP target mismatch")
+			}
+			target.WriteTo(read[:n], from)
+			reply := buf.NewSize(65535)
+			got, e := packet.ReadPacket(reply)
+			if e != nil {
+				reply.Release()
+				return fmt.Errorf("UDP reply %d: %w", size, e)
+			}
+			ok := got == dst && bytes.Equal(body, reply.Bytes())
+			reply.Release()
+			if !ok {
+				return errors.New("UDP reply or identity mismatch")
+			}
+		}
+		if c.Tamper && c.Protocol == "vmess" && c.Security != "none" {
+			cap.corrupt = true
+			packet.WritePacket(packetBuffer([]byte("tamper-must-not-arrive")), M.SocksaddrFromNet(target.LocalAddr()))
+			target.SetDeadline(time.Now().Add(150 * time.Millisecond))
+			if _, _, e := target.ReadFrom(make([]byte, 100)); e == nil {
+				return errors.New("tampered VMess UDP payload reached target")
+			}
+		}
+	}
+	return emit(map[string]any{"ok": true, "kind": "official-protocol-library", "tcp": true, "udp": true, "ipv4_ipv6": true, "vmess_replay": c.Replay && c.Protocol == "vmess", "vmess_tamper": c.Tamper && c.Protocol == "vmess" && c.Security != "none", "padding": c.Padding})
+}
+func main() {
+	var c input
+	dec := json.NewDecoder(os.Stdin)
+	if err := dec.Decode(&c); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	var err error
+	switch c.Mode {
+	case "server":
+		err = runServer(c)
+	case "client":
+		err = runClient(c)
+	default:
+		err = errors.New("invalid mode")
+	}
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
diff --git a/crates/vp-protocol/tests/stream_library_interop.rs b/crates/vp-protocol/tests/stream_library_interop.rs
