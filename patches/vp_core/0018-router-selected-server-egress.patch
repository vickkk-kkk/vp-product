+//! Loopback/synthetic egress proof. These tests exercise authenticated wire
+//! handlers, not a reject-only guard or a task-local loopback restriction.
+use async_trait::async_trait;
+use bytes::Bytes;
+use std::{
+    collections::HashMap,
+    net::SocketAddr,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, UdpSocket},
+    sync::mpsc,
+    time::timeout,
+};
+use vp_common::{DstAddr, Result};
+use vp_core::{
+    Inbound, InboundCtx, Network, Outbound, PacketConn, ProxyStream, Resolution, Router, Session,
+    UdpPacket, task_scope::TaskScope,
+};
+const ID: &str = "b831381d-6324-4d53-ad4f-8cda48b30811";
+const OTHER: &str = "11111111-1111-4111-8111-111111111111";
+const PASSWORD: &str = "ephemeral-routing-test";
+struct Probe {
+    selected: AtomicUsize,
+    first: Arc<Tagged>,
+    second: Arc<Tagged>,
+    reject: Arc<dyn Router>,
+    seen: Mutex<Vec<Session>>,
+}
+#[async_trait]
+impl Router for Probe {
+    async fn pick(&self, session: &Session) -> Resolution {
+        self.seen.lock().unwrap().push(session.clone());
+        let outbound: Arc<dyn Outbound> = match self.selected.load(Ordering::SeqCst) {
+            0 => self.first.clone(),
+            1 => self.second.clone(),
+            _ => return self.reject.pick(session).await,
+        };
+        Resolution {
+            via: outbound.name().into(),
+            outbound,
+            rule: None,
+        }
+    }
+}
+struct Tagged(u8);
+struct Packet {
+    marker: u8,
+    tx: mpsc::Sender<UdpPacket>,
+    rx: mpsc::Receiver<UdpPacket>,
+}
+#[async_trait]
+impl Outbound for Tagged {
+    fn name(&self) -> &str {
+        if self.0 == 1 { "FIRST" } else { "SECOND" }
+    }
+    async fn connect_stream(&self, _: &Session, _: &DstAddr) -> Result<Box<dyn ProxyStream>> {
+        let (mut remote, stream) = tokio::io::duplex(1024);
+        let marker = self.0;
+        vp_core::task_scope::spawn(async move {
+            let mut data = [0; 5];
+            if remote.read_exact(&mut data).await.is_ok() {
+                let _ = remote.write_all(&[marker]).await;
+            }
+        });
+        Ok(Box::new(stream))
+    }
+    fn support_udp(&self) -> bool {
+        true
+    }
+    async fn connect_packet(&self, _: &Session, _: &DstAddr) -> Result<Box<dyn PacketConn>> {
+        let (tx, rx) = mpsc::channel(4);
+        Ok(Box::new(Packet {
+            marker: self.0,
+            tx,
+            rx,
+        }))
+    }
+}
+#[async_trait]
+impl PacketConn for Packet {
+    async fn send(&self, packet: &UdpPacket) -> Result<()> {
+        self.tx
+            .send(UdpPacket {
+                src: packet.dst,
+                dst: packet.src,
+                data: Bytes::from(vec![self.marker]),
+            })
+            .await
+            .map_err(|_| vp_common::Error::Proto("test packet closed"))
+    }
+    async fn recv(&mut self) -> Result<UdpPacket> {
+        self.rx
+            .recv()
+            .await
+            .ok_or(vp_common::Error::Proto("test packet closed"))
+    }
+}
+fn probe() -> Arc<Probe> {
+    let rules = vp_rule::compile(
+        &["MATCH,REJECT".into()],
+        &vp_rule::CompileEnv {
+            is_known_target: &|t| matches!(t, "DIRECT" | "REJECT"),
+            geosite: &None,
+            #[cfg(feature = "geoip")]
+            geoip: &None,
+            #[cfg(feature = "geoip")]
+            asn: &None,
+            providers: &HashMap::new(),
+            sub_rules: &HashMap::new(),
+        },
+    )
+    .unwrap();
+    let dns = Arc::new(vp_dns::Resolver::system());
+    let mut outbounds: HashMap<String, Arc<dyn Outbound>> = HashMap::new();
+    outbounds.insert(
+        "DIRECT".into(),
+        Arc::new(vp_protocol::DirectOutbound::new(dns.clone(), false)),
+    );
+    outbounds.insert("REJECT".into(), Arc::new(vp_protocol::RejectOutbound));
+    let reject = vp_router::Router::build(vp_router::RouterSpec {
+        outbounds,
+        groups: vec![],
+        dialers: HashMap::new(),
+        rules,
+        mode: vp_config::Mode::Rule,
+        dns,
+        ipv6: false,
+    })
+    .unwrap();
+    Arc::new(Probe {
+        selected: AtomicUsize::new(0),
+        first: Arc::new(Tagged(1)),
+        second: Arc::new(Tagged(2)),
+        reject,
+        seen: Mutex::new(Vec::new()),
+    })
+}
+async fn server(protocol: &str, router: Arc<Probe>) -> u16 {
+    let ids = vec![OTHER.into(), ID.into()];
+    let passwords = vec!["unused-credential".into(), PASSWORD.into()];
+    let named = vec!["other:unused".into(), format!("user:{PASSWORD}")];
+    let inbound: Arc<dyn Inbound> = match protocol {
+        "vless" => {
+            Arc::new(vp_protocol::vless::VlessInbound::new("127.0.0.1", 0, protocol, &ids).unwrap())
+        }
+        "vmess" => {
+            Arc::new(vp_protocol::vmess::VmessInbound::new("127.0.0.1", 0, protocol, &ids).unwrap())
+        }
+        "trojan" => Arc::new(
+            vp_protocol::trojan::TrojanInbound::new("127.0.0.1", 0, protocol, &passwords).unwrap(),
+        ),
+        "ss" => Arc::new(
+            vp_protocol::ss::SsInbound::new("127.0.0.1", 0, protocol, "aes-128-gcm", PASSWORD)
+                .unwrap(),
+        ),
+        "snell" => Arc::new(
+            vp_protocol::snell::SnellInbound::new("127.0.0.1", 0, protocol, &passwords, 4).unwrap(),
+        ),
+        "brook" => Arc::new(
+            vp_protocol::brook::BrookInbound::new("127.0.0.1", 0, protocol, &passwords).unwrap(),
+        ),
+        "mieru" => Arc::new(
+            vp_protocol::mieru::MieruInbound::new("127.0.0.1", 0, protocol, &named).unwrap(),
+        ),
+        "naive" => Arc::new(
+            vp_protocol::naive::NaiveInbound::new("127.0.0.1", 0, protocol, &named).unwrap(),
+        ),
+        _ => panic!("unsupported test protocol"),
+    };
+    inbound
+        .start(InboundCtx {
+            router,
+            stats: Arc::default(),
+            conns: Arc::new(vp_core::ConnTable::new()),
+        })
+        .await
+        .unwrap()
+}
+fn outbound(protocol: &str, port: u16) -> Box<dyn Outbound> {
+    let config = serde_json::json!({"server":"127.0.0.1","port":port,"uuid":ID,"password":PASSWORD,"username":"user","psk":PASSWORD,"version":4,"cipher":if protocol=="ss" {"aes-128-gcm"} else {"auto"},"tls":false,"udp":true});
+    match protocol {
+        "vless" => Box::new(
+            vp_protocol::vless::VlessOutbound::new(&serde_json::from_value(config).unwrap())
+                .unwrap(),
+        ),
+        "vmess" => Box::new(
+            vp_protocol::vmess::VmessOutbound::new(&serde_json::from_value(config).unwrap())
+                .unwrap(),
+        ),
+        "trojan" => Box::new(
+            vp_protocol::trojan::TrojanOutbound::new(&serde_json::from_value(config).unwrap())
+                .unwrap(),
+        ),
+        "ss" => Box::new(
+            vp_protocol::ss::SsOutbound::new(&serde_json::from_value(config).unwrap()).unwrap(),
+        ),
+        "snell" => Box::new(
+            vp_protocol::snell::SnellOutbound::new(&serde_json::from_value(config).unwrap())
+                .unwrap(),
+        ),
+        "brook" => Box::new(
+            vp_protocol::brook::BrookOutbound::new(&serde_json::from_value(config).unwrap())
+                .unwrap(),
+        ),
+        "mieru" => Box::new(
+            vp_protocol::mieru::MieruOutbound::new(&serde_json::from_value(config).unwrap())
+                .unwrap(),
+        ),
+        "naive" => Box::new(
+            vp_protocol::naive::NaiveOutbound::new(&serde_json::from_value(config).unwrap())
+                .unwrap(),
+        ),
+        _ => panic!("unsupported test protocol"),
+    }
+}
+fn check_metadata(router: &Probe, protocol: &str, port: u16, network: Network) {
+    let seen = router.seen.lock().unwrap();
+    assert!(!seen.is_empty(), "{protocol}: routing never invoked");
+    for session in seen.iter() {
+        assert_eq!(session.inbound.as_ref(), protocol);
+        assert!(session.src.unwrap().ip().is_loopback());
+        assert_eq!(
+            session.inbound_port,
+            Some(port),
+            "{protocol}: lost bound port"
+        );
+        let user = if protocol == "ss" { "user:0" } else { "user:1" };
+        assert_eq!(
+            session.inbound_user.as_deref(),
+            Some(user),
+            "{protocol}: lost credential identity"
+        );
