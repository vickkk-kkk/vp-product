+    #[tokio::test]
+    async fn authenticated_anytls_routes_with_nonsecret_user_and_bound_port() {
+        struct Policy {
+            seen: std::sync::Mutex<Vec<Session>>,
+        }
+        #[async_trait]
+        impl vp_core::Router for Policy {
+            async fn pick(&self, session: &Session) -> vp_core::Resolution {
+                self.seen.lock().unwrap().push(session.clone());
+                vp_core::Resolution {
+                    outbound: Arc::new(crate::RejectOutbound),
+                    via: "REJECT".into(),
+                    rule: None,
+                }
+            }
+        }
+        let observer = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let target = observer.local_addr().unwrap();
+        let policy = Arc::new(Policy {
+            seen: std::sync::Mutex::new(Vec::new()),
+        });
+        let mut ctx = test_ctx();
+        ctx.router = policy.clone();
+        let scope = vp_core::task_scope::TaskScope::new();
+        let server = Arc::new(
+            AnytlsInbound::new(
+                "127.0.0.1",
+                0,
+                "route-test",
+                &["unused".into(), "ephemeral".into()],
+            )
+            .unwrap(),
+        );
+        let port = scope.run(server.start(ctx)).await.unwrap();
+        let out = outbound_plain("127.0.0.1", port, "ephemeral");
+        let dst = DstAddr::ip(target.ip(), target.port());
+        let session = Session::new_tcp("client".into(), None, dst.clone());
+        let result = timeout(Duration::from_secs(1), async {
+            let mut stream = out.connect_stream(&session, &dst).await?;
+            stream.write_all(b"must reject").await?;
+            let mut byte = [0];
+            stream.read_exact(&mut byte).await?;
+            Ok::<(), Error>(())
+        })
+        .await;
+        assert!(!matches!(result, Ok(Ok(()))));
+        assert!(
+            timeout(Duration::from_millis(30), observer.accept())
+                .await
+                .is_err()
+        );
+        {
+            let sessions = policy.seen.lock().unwrap();
+            assert_eq!(sessions.len(), 1);
+            assert_eq!(sessions[0].inbound_port, Some(port));
+            assert_eq!(sessions[0].inbound_user.as_deref(), Some("user:1"));
+            assert!(sessions[0].src.unwrap().ip().is_loopback());
+        }
+        assert_eq!(
+            scope
+                .shutdown(Duration::from_millis(20), Duration::from_secs(1))
+                .await
+                .remaining_tasks,
+            0
+        );
+    }
 }
