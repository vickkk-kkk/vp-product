+/// One UDP socket/source port for mixed IPv4/IPv6 destinations. Host protection
+/// is mandatory before the socket is exposed for any send.
+fn bind_dual_stack(target: std::net::SocketAddr) -> std::io::Result<(tokio::net::UdpSocket, bool)> {
+    let dual = (|| {
+        let socket = socket2::Socket::new(
+            socket2::Domain::IPV6,
+            socket2::Type::DGRAM,
+            Some(socket2::Protocol::UDP),
+        )?;
+        socket.set_only_v6(false)?;
+        socket.bind(&"[::]:0".parse::<std::net::SocketAddr>().unwrap().into())?;
+        Ok::<std::net::UdpSocket, std::io::Error>(socket.into())
+    })();
+    let (socket, dual_stack) = match dual {
+        Ok(socket) => (socket, true),
+        Err(error) if target.is_ipv6() => return Err(error),
+        Err(_) => (std::net::UdpSocket::bind("0.0.0.0:0")?, false),
+    };
+    #[cfg(unix)]
+    let handle = {
+        use std::os::fd::AsRawFd;
+        socket.as_raw_fd() as u64
+    };
+    #[cfg(windows)]
+    let handle = {
+        use std::os::windows::io::AsRawSocket;
+        socket.as_raw_socket() as u64
+    };
+    if let Some(host) = vp_core::host_network::current() {
+        host.before_connect(
+            handle,
+            vp_core::host_network::Protocol::Udp,
+            target,
+            vp_core::host_network::Purpose::Proxy,
+        )?;
+    } else if cfg!(target_os = "android") {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            "Android host socket authority is missing",
+        ));
     }
+    socket.set_nonblocking(true)?;
+    Ok((tokio::net::UdpSocket::from_std(socket)?, dual_stack))
 }
 
