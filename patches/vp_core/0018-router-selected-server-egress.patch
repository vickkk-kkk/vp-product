+struct Marker(u8);
+struct MarkerPacket {
+    marker: u8,
+    tx: tokio::sync::mpsc::Sender<vp_core::UdpPacket>,
+    rx: tokio::sync::mpsc::Receiver<vp_core::UdpPacket>,
+}
+#[async_trait::async_trait]
+impl vp_core::Outbound for Marker {
+    fn name(&self) -> &str {
+        if self.0 == 1 { "first" } else { "second" }
+    }
+    async fn connect_stream(
+        &self,
+        _: &vp_core::Session,
+        _: &vp_common::DstAddr,
+    ) -> vp_common::Result<Box<dyn vp_core::ProxyStream>> {
+        use tokio::io::AsyncWriteExt;
+        let (mut peer, stream) = tokio::io::duplex(64);
+        let marker = self.0;
+        vp_core::task_scope::spawn(async move {
+            let _ = peer.write_all(&[marker]).await;
+        });
+        Ok(Box::new(stream))
+    }
+    fn support_udp(&self) -> bool {
+        true
+    }
+    async fn connect_packet(
+        &self,
+        _: &vp_core::Session,
+        _: &vp_common::DstAddr,
+    ) -> vp_common::Result<Box<dyn vp_core::PacketConn>> {
+        let (tx, rx) = tokio::sync::mpsc::channel(4);
+        Ok(Box::new(MarkerPacket {
+            marker: self.0,
+            tx,
+            rx,
+        }))
+    }
+}
+#[async_trait::async_trait]
+impl vp_core::PacketConn for MarkerPacket {
+    async fn send(&self, packet: &vp_core::UdpPacket) -> vp_common::Result<()> {
+        self.tx
+            .send(vp_core::UdpPacket {
+                src: packet.dst,
+                dst: packet.src,
+                data: vec![self.marker].into(),
+            })
+            .await
+            .map_err(|_| vp_common::Error::Proto("marker closed"))
+    }
+    async fn recv(&mut self) -> vp_common::Result<vp_core::UdpPacket> {
+        self.rx
+            .recv()
+            .await
+            .ok_or(vp_common::Error::Proto("marker closed"))
+    }
+}
+#[tokio::test]
+async fn authenticated_quic_tcp_udp_honor_selected_outbound_and_reject() {
+    for protocol in [Protocol::Tuic, Protocol::Hy2] {
+        let router = Arc::new(RoutingProbe {
+            selected: 0.into(),
+            outbounds: vec![
+                Arc::new(Marker(1)),
+                Arc::new(Marker(2)),
+                Arc::new(vp_protocol::RejectOutbound),
+            ],
+            seen: std::sync::Mutex::new(Vec::new()),
+        });
+        let rig = Rig::with_router(protocol, router.clone()).await;
+        let raw = rig.connect().await;
+        rig.auth(&raw.conn, true).await;
+        let (tcp, udp) = targets().await;
+        for selected in 0..3 {
+            router
+                .selected
+                .store(selected, std::sync::atomic::Ordering::SeqCst);
+            let (_, mut recv) = rig.tcp(&raw.conn, tcp.local_addr().unwrap()).await.unwrap();
+            let result = timeout(Duration::from_millis(500), async {
+                if protocol == Protocol::Hy2 {
+                    let mut response = [0; 3];
+                    recv.read_exact(&mut response).await?;
+                    if response != [0; 3] {
+                        return Ok(None);
+                    }
+                }
+                let mut marker = [0];
+                recv.read_exact(&mut marker).await?;
+                Ok::<_, quinn::ReadExactError>(Some(marker[0]))
+            })
+            .await;
+            if selected < 2 {
+                assert_eq!(result.unwrap().unwrap(), Some(selected as u8 + 1));
+            } else {
+                assert!(!matches!(result, Ok(Ok(Some(_)))));
+            }
+            rig.udp(&raw.conn, udp.local_addr().unwrap());
+            let result = timeout(Duration::from_millis(500), raw.conn.read_datagram()).await;
+            if selected < 2 {
+                assert_eq!(result.unwrap().unwrap().last(), Some(&(selected as u8 + 1)));
+            } else {
+                assert!(result.is_err());
+            }
+        }
+        quiet(&tcp, &udp).await;
+        {
+            let seen = router.seen.lock().unwrap();
+            assert_eq!(seen.len(), 6);
+            for session in seen.iter() {
+                assert_eq!(session.inbound_port, Some(rig.port));
+                assert_eq!(session.inbound_user.as_deref(), Some("user:0"));
+                assert!(session.src.unwrap().ip().is_loopback());
+            }
+        }
+        drop(raw);
+        assert_eq!(
+            rig.scope
+                .shutdown(Duration::from_millis(20), Duration::from_secs(1))
+                .await
+                .remaining_tasks,
+            0
+        );
+    }
+}
