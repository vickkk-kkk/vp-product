+//! Authenticated server egress. Routing is a decision, never a direct-dial guard.
+//! Each datagram re-evaluates policy; existing streams keep their original route.
+use bytes::Bytes;
+use std::{
+    collections::{HashMap, HashSet},
+    net::SocketAddr,
+    sync::{Arc, Mutex as StdMutex},
+    time::Duration,
+};
+use tokio::sync::{Mutex, mpsc, oneshot};
+use vp_common::{DstAddr, Error, Host, Result};
+use vp_core::{InboundCtx, Network, ProxyStream, Resolution, Router, Session, UdpPacket};
+
+const DEADLINE: Duration = Duration::from_secs(10);
+const IDLE: Duration = Duration::from_secs(300);
+const MAX_ROUTES: usize = 64;
+const QUEUE: usize = 16;
+tokio::task_local! { static LISTEN_PORT: u16; }
+pub(crate) async fn on_port<F: std::future::Future>(port: u16, future: F) -> F::Output {
+    LISTEN_PORT.scope(port, future).await
+}
+/// Labels describe configured credential slots, never passwords, hashes or UUIDs.
+pub(crate) fn session(
+    tag: Arc<str>,
+    source: SocketAddr,
+    destination: DstAddr,
+    network: Network,
+    port: u16,
+    user: Option<usize>,
+) -> Session {
+    let mut session = match network {
+        Network::Tcp => Session::new_tcp(tag, Some(source), destination),
+        Network::Udp => Session::new_udp(tag, Some(source), destination),
+    };
+    let port = LISTEN_PORT.try_with(|p| *p).unwrap_or(port);
+    session.inbound_port = (port != 0).then_some(port);
+    session.inbound_user = user.map(|i| format!("user:{i}").into());
+    session
+}
+pub(crate) async fn connect(ctx: &InboundCtx, session: &Session) -> Result<Box<dyn ProxyStream>> {
+    connect_routed(ctx, session).await.map(|(stream, _)| stream)
+}
+pub(crate) async fn connect_routed(
+    ctx: &InboundCtx,
+    session: &Session,
+) -> Result<(Box<dyn ProxyStream>, Resolution)> {
+    // The reserved UoT control name is not a network destination. Raw
+    // authenticated ingress has no generic UoT bridge yet; never leak it to DNS
+    // or silently turn it into a direct/proxy TCP connection.
+    if crate::uot::is_magic(&session.dst) {
+        return Err(Error::Unsupported(
+            "generic UoT ingress is not implemented for this raw protocol".into(),
+        ));
+    }
+    vp_core::task_scope::check_destination(&session.dst)?;
+    tokio::time::timeout(Duration::from_secs(30), async {
+        let resolution = ctx.router.pick(session).await;
+        let stream = resolution
+            .outbound
+            .connect_stream(session, &session.dst)
+            .await?;
+        Ok((stream, resolution))
+    })
+    .await
+    .map_err(|_| timed_out())?
+}
+pub(crate) fn metadata(session: &Session, resolution: &Resolution) -> vp_core::ConnMeta {
+    vp_core::ConnMeta {
+        id: session.id,
+        inbound: session.inbound.clone(),
+        network: session.network.as_str(),
+        host: session.dst.host.to_string(),
+        dst_port: session.dst.port,
+        src: session.src.map(|s| s.to_string()),
+        process: session.process.clone(),
+        rule: resolution.rule.as_ref().map(|r| r.rule.clone()),
+        chain: Some(resolution.connected_via()),
+        start: vp_common::now_millis(),
+    }
+}
+fn closed() -> Error {
+    Error::Proto("routed UDP association closed")
+}
+fn timed_out() -> Error {
+    Error::Proto("routed UDP deadline")
+}
+pub(crate) fn canonical(address: SocketAddr) -> SocketAddr {
+    match address {
+        SocketAddr::V6(v6) => v6
+            .ip()
+            .to_ipv4_mapped()
+            .map(|ip| SocketAddr::new(ip.into(), v6.port()))
+            .unwrap_or(address),
+        _ => address,
+    }
+}
+#[derive(Clone, Hash, Eq, PartialEq)]
+struct RouteKey {
+    outbound: usize,
+    via: Arc<str>,
+    target: Option<SocketAddr>,
+    generation: u64,
+}
+impl RouteKey {
+    fn new(resolution: &Resolution, target: SocketAddr) -> Self {
+        Self {
+            outbound: Arc::as_ptr(&resolution.outbound) as *const () as usize,
+            via: resolution.via.clone(),
+            target: (!resolution.outbound.packet_session_shared()).then_some(target),
+            generation: 0,
+        }
+    }
+    fn same_selection(&self, other: &Self) -> bool {
+        self.outbound == other.outbound && self.via == other.via && self.target == other.target
+    }
+}
+struct Request {
+    packet: UdpPacket,
+    done: oneshot::Sender<Result<()>>,
+}
+struct Handle {
+    tx: mpsc::Sender<Request>,
+    task: tokio::task::JoinHandle<()>,
+    _outbound: Arc<dyn vp_core::Outbound>,
+}
+impl Drop for Handle {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+#[derive(Clone)]
+struct Target {
+    address: SocketAddr,
+    route: RouteKey,
+    used: std::time::Instant,
+}
+struct State {
+    handles: HashMap<RouteKey, Handle>,
+    targets: HashMap<DstAddr, Target>,
+}
+impl State {
+    async fn retire(&mut self, route: &RouteKey) {
+        if let Some(mut handle) = self.handles.remove(route) {
+            handle.task.abort();
+            // Release the old socket and physical-budget permit before creating
+            // its replacement, even when the pool is exactly full.
+            let _ = (&mut handle.task).await;
+        }
+        self.targets.retain(|_, t| &t.route != route);
+    }
+    fn sync_allowed(&self, allowed: &StdMutex<HashSet<(SocketAddr, RouteKey)>>) {
+        *allowed.lock().unwrap() = self
+            .targets
+            .values()
+            .map(|t| (t.address, t.route.clone()))
+            .collect();
+    }
+}
+struct Inner {
+    router: Arc<dyn Router>,
+    template: Session,
+    state: Mutex<State>,
+    // Shared only for reply validation; never held over an await.
+    allowed: Arc<StdMutex<HashSet<(SocketAddr, RouteKey)>>>,
+    responses: mpsc::Sender<(RouteKey, UdpPacket)>,
+    scope: Option<Arc<vp_core::task_scope::TaskScope>>,
+    budget: Arc<tokio::sync::Semaphore>,
+}
+#[derive(Clone)]
+pub(crate) struct DatagramSender(Arc<Inner>);
+pub(crate) struct DatagramReceiver {
+    responses: mpsc::Receiver<(RouteKey, UdpPacket)>,
+    allowed: Arc<StdMutex<HashSet<(SocketAddr, RouteKey)>>>,
+}
+pub(crate) fn datagrams(
+    router: Arc<dyn Router>,
+    template: Session,
+) -> (DatagramSender, DatagramReceiver) {
+    datagrams_with_budget(
+        router,
+        template,
+        Arc::new(tokio::sync::Semaphore::new(MAX_ROUTES)),
+    )
+}
+pub(crate) fn datagrams_with_budget(
+    router: Arc<dyn Router>,
+    template: Session,
+    budget: Arc<tokio::sync::Semaphore>,
+) -> (DatagramSender, DatagramReceiver) {
+    let (tx, responses) = mpsc::channel(QUEUE);
+    let allowed = Arc::new(StdMutex::new(HashSet::new()));
+    (
+        DatagramSender(Arc::new(Inner {
+            router,
+            template,
+            state: Mutex::new(State {
+                handles: HashMap::new(),
+                targets: HashMap::new(),
+            }),
+            allowed: allowed.clone(),
+            responses: tx,
+            scope: vp_core::task_scope::current_scope(),
+            budget,
+        })),
+        DatagramReceiver { responses, allowed },
+    )
+}
+impl DatagramSender {
+    pub(crate) async fn send(
+        &self,
+        destination: DstAddr,
+        data: Bytes,
+        source: Option<SocketAddr>,
+    ) -> Result<()> {
+        let sender = self.clone();
+        let operation = async move { sender.send_scoped(destination, data, source).await };
+        if let Some(scope) = &self.0.scope {
+            // A retained sender may be used outside an already registered task.
+            // Track the entire decision/DNS/open/send future, not only its reader
+            // actor. Dropping this JoinSet cancels partial network opens; shutdown
+            // waits for their actual destruction before it can report Stopped.
+            scope
+                .run(async {
+                    if matches!(
+                        scope.snapshot().phase,
+                        vp_core::task_scope::Phase::Canceling | vp_core::task_scope::Phase::Stopped
+                    ) {
+                        return Err(closed());
+                    }
+                    let mut operation_task = tokio::task::JoinSet::new();
+                    vp_core::task_scope::spawn_in(&mut operation_task, operation);
+                    operation_task
+                        .join_next()
+                        .await
+                        .ok_or_else(closed)?
+                        .map_err(|_| closed())?
+                })
+                .await
+        } else {
+            operation.await
+        }
+    }
+    async fn send_scoped(
+        &self,
+        destination: DstAddr,
+        data: Bytes,
+        source: Option<SocketAddr>,
+    ) -> Result<()> {
+        crate::stream_udp::validate_target(&destination)?;
+        crate::stream_udp::validate_payload(&data)?;
+        if self.0.scope.as_ref().is_some_and(|s| {
+            matches!(
+                s.snapshot().phase,
+                vp_core::task_scope::Phase::Canceling | vp_core::task_scope::Phase::Stopped
+            )
+        }) {
+            return Err(closed());
+        }
+        let mut session = self.0.template.clone();
+        session.dst = destination.clone();
+        if source.is_some() {
+            session.src = source;
+        }
+        let mut state = self.0.state.lock().await;
+        let resolution = tokio::time::timeout(DEADLINE, self.0.router.pick(&session))
+            .await
+            .map_err(|_| timed_out())?;
+        state.handles.retain(|_, h| !h.task.is_finished());
+        state.targets.retain(|_, t| t.used.elapsed() < IDLE);
+        let live: Vec<_> = state.handles.keys().cloned().collect();
+        state.targets.retain(|_, t| live.contains(&t.route));
+        let previous = state.targets.remove(&destination);
+        state.sync_allowed(&self.0.allowed);
+        if !resolution.outbound.support_udp() {
+            if let Some(previous) = previous {
+                state.retire(&previous.route).await;
+            }
+            state.sync_allowed(&self.0.allowed);
+            return Err(Error::Unsupported(format!(
+                "selected outbound '{}' has no UDP",
+                resolution.outbound.name()
+            )));
+        }
+        if state.targets.len() >= MAX_ROUTES {
+            return Err(Error::Proto("routed UDP target limit"));
+        }
+        if previous.is_none()
+            && self
+                .0
+                .scope
+                .as_ref()
+                .is_some_and(|s| s.snapshot().phase != vp_core::task_scope::Phase::Running)
+        {
+            return Err(closed());
+        }
+        // PacketConn currently has IP-only datagrams. DNS is strictly AFTER
+        // selection/support checks; original domain remains in Session for policy.
+        let target = match &destination.host {
+            Host::Ip(ip) => SocketAddr::new(*ip, destination.port),
+            Host::Domain(host) => {
+                tokio::time::timeout(DEADLINE, vp_dns::lookup_host(host, destination.port))
+                    .await
+                    .map_err(|_| timed_out())??
+                    .next()
+                    .ok_or(Error::Proto("UDP target has no address"))?
+            }
+        };
+        let target = canonical(target);
+        let selection = RouteKey::new(&resolution, target);
+        if let Some(previous) = previous {
+            if !previous.route.same_selection(&selection) || previous.address != target {
+                // A shared DIRECT socket cannot distinguish delayed replies from
+                // a revoked target. Retire the whole old route, then reopen other
+                // targets lazily. Stable policy retains its mixed-family port.
+                state.retire(&previous.route).await;
+                state.sync_allowed(&self.0.allowed);
+            }
+        }
+        let key = state
+            .handles
+            .keys()
+            .find(|k| k.same_selection(&selection))
+            .cloned()
+            .unwrap_or_else(|| {
+                static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+                RouteKey {
+                    generation: NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed),
+                    ..selection
+                }
+            });
+        let live: Vec<_> = state.targets.values().map(|t| t.route.clone()).collect();
+        let retired: Vec<_> = state
+            .handles
+            .keys()
+            .filter(|k| *k != &key && !live.contains(k))
+            .cloned()
+            .collect();
+        for retired in retired {
+            state.retire(&retired).await;
+        }
+        if !state.handles.contains_key(&key) {
+            if self
+                .0
+                .scope
+                .as_ref()
+                .is_some_and(|s| s.snapshot().phase != vp_core::task_scope::Phase::Running)
+            {
+                return Err(closed());
+            }
+            if state.handles.len() >= MAX_ROUTES {
+                return Err(Error::Proto("routed UDP outbound limit"));
+            }
+            let permit = self
+                .0
+                .budget
+                .clone()
+                .try_acquire_owned()
+                .map_err(|_| Error::Proto("routed UDP socket budget exhausted"))?;
+            let mut conn = tokio::time::timeout(
+                DEADLINE,
+                resolution
+                    .outbound
+                    .connect_packet(&session, &DstAddr::ip(target.ip(), target.port())),
+            )
+            .await
+            .map_err(|_| timed_out())??;
+            if self
+                .0
+                .scope
+                .as_ref()
+                .is_some_and(|s| s.snapshot().phase != vp_core::task_scope::Phase::Running)
+            {
+                return Err(closed());
+            }
+            let (tx, mut rx) = mpsc::channel::<Request>(QUEUE);
+            let responses = self.0.responses.clone();
+            let route = key.clone();
+            let allowed = self.0.allowed.clone();
+            let task = vp_core::task_scope::spawn(async move {
+                let _permit = permit;
+                loop {
+                    tokio::select! {
+                        packet = conn.recv() => {
+                            let Ok(mut packet) = packet else { break };
+                            packet.src = canonical(packet.src);
+                            let valid = allowed.lock().unwrap().contains(&(packet.src, route.clone()));
+                            if valid {
+                                // UDP backpressure drops replies rather than blocking
+                                // new requests behind an unconsumed response queue.
+                                if matches!(responses.try_send((route.clone(), packet)), Err(mpsc::error::TrySendError::Closed(_))) { break; }
+                            }
+                        }
+                        request = rx.recv() => {
+                            let Some(request) = request else { break };
+                            if request.done.is_closed() { continue; }
+                            let result = tokio::time::timeout(DEADLINE, conn.send(&request.packet)).await.map_err(|_| timed_out()).and_then(|r| r);
+                            let failed = result.is_err();
+                            let _ = request.done.send(result);
+                            if failed { break; }
+                        }
+                        _ = tokio::time::sleep(IDLE) => break,
+                    }
+                }
+            });
+            state.handles.insert(
+                key.clone(),
+                Handle {
+                    tx,
+                    task,
+                    _outbound: resolution.outbound,
+                },
+            );
+        }
+        state.targets.insert(
+            destination,
+            Target {
+                address: target,
+                route: key.clone(),
+                used: std::time::Instant::now(),
+            },
+        );
+        self.0.allowed.lock().unwrap().insert((target, key.clone()));
+        let tx = state.handles.get(&key).ok_or_else(closed)?.tx.clone();
+        let (done, result) = oneshot::channel();
+        // Serialize send + acknowledgement with route changes. No old send may
+        // be queued after a later decision has invalidated its route.
+        let packet = UdpPacket {
+            src: session.src.unwrap_or_else(|| "0.0.0.0:0".parse().unwrap()),
+            dst: target,
+            data,
+        };
+        tokio::time::timeout(DEADLINE, tx.send(Request { packet, done }))
+            .await
+            .map_err(|_| timed_out())?
+            .map_err(|_| closed())?;
+        let result = tokio::time::timeout(DEADLINE, result)
+            .await
+            .map_err(|_| timed_out())?
+            .map_err(|_| closed())?;
+        drop(state);
+        result
+    }
+}
+impl DatagramReceiver {
+    pub(crate) async fn recv(&mut self) -> Result<UdpPacket> {
+        loop {
+            let (route, packet) = self.responses.recv().await.ok_or_else(closed)?;
+            if self.allowed.lock().unwrap().contains(&(packet.src, route)) {
+                return Ok(packet);
+            }
+        }
+    }
+}
