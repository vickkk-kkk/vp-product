+struct RoutingProbe {
+    selected: std::sync::atomic::AtomicUsize,
+    outbounds: Vec<Arc<dyn vp_core::Outbound>>,
+    seen: std::sync::Mutex<Vec<vp_core::Session>>,
+}
+#[async_trait::async_trait]
+impl vp_core::Router for RoutingProbe {
+    async fn pick(&self, session: &vp_core::Session) -> vp_core::Resolution {
+        self.seen.lock().unwrap().push(session.clone());
+        let outbound =
+            self.outbounds[self.selected.load(std::sync::atomic::Ordering::SeqCst)].clone();
+        vp_core::Resolution {
