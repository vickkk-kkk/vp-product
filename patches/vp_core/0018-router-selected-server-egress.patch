+/// Per-routing-decision immutable candidate plan. Metadata never advances a
+/// selector. Retries happen only during connect, before application bytes exist.
+struct PreparedGroup {
+    group: Arc<Group>,
+    candidates: Vec<(usize, Arc<dyn Outbound>)>,
+    successful: Mutex<Option<Arc<str>>>,
+}
+tokio::task_local! { static CONNECT_BUDGET: Cell<usize>; }
+impl PreparedGroup {
+    fn new(group: Arc<Group>, primary: usize, session: &Session) -> Self {
+        let mut indices = vec![primary];
+        let alive = group.alive.lock().unwrap();
+        let mut alternatives: Vec<_> = (0..group.members.len()).filter(|i| *i != primary).collect();
+        alternatives.sort_by_key(|i| !alive.get(*i).copied().unwrap_or(false));
+        indices.extend(alternatives.into_iter().take(2));
+        drop(alive);
+        // Keep only configured object identities here. Preparing every nested
+        // backup recursively would expand a reused fallback DAG exponentially.
+        let candidates = indices
+            .into_iter()
+            .map(|index| (index, group.members[index].clone()))
+            .collect();
+        let _ = session;
+        Self {
+            group,
+            candidates,
+            successful: Mutex::new(None),
+        }
+    }
+}
+#[async_trait]
+impl Outbound for PreparedGroup {
+    fn name(&self) -> &str {
+        &self.group.name
+    }
+    fn connected_via(&self) -> Option<Arc<str>> {
+        self.successful.lock().unwrap().clone()
+    }
+    async fn connect_stream(
+        &self,
+        session: &Session,
+        destination: &DstAddr,
+    ) -> Result<Box<dyn ProxyStream>> {
+        if CONNECT_BUDGET.try_with(|_| ()).is_ok() {
+            self.connect_plan(session, destination).await
+        } else {
+            CONNECT_BUDGET
+                .scope(Cell::new(32), self.connect_plan(session, destination))
+                .await
+        }
+    }
+}
+impl PreparedGroup {
+    async fn connect_plan(
+        &self,
+        session: &Session,
+        destination: &DstAddr,
+    ) -> Result<Box<dyn ProxyStream>> {
+        let mut first_error = None;
+        for (index, candidate) in &self.candidates {
+            let available = CONNECT_BUDGET.with(|budget| {
+                let remaining = budget.get();
+                budget.set(remaining.saturating_sub(1));
+                remaining != 0
+            });
+            if !available {
+                return Err(Error::Unsupported(
+                    "nested fallback connect budget exhausted".into(),
+                ));
+            }
+            let mut member = candidate.clone();
+            let mut resolved = false;
+            for _ in 0..8 {
+                let Some(next) = member.clone().route_selection(session) else {
+                    resolved = true;
+                    break;
+                };
+                member = next;
+            }
+            if !resolved {
+                return Err(Error::Unsupported("nested selector depth exceeded".into()));
+            }
+            match member.connect_stream(session, destination).await {
+                Ok(stream) => {
+                    let actual = member
+                        .connected_via()
+                        .unwrap_or_else(|| Arc::from(member.name()));
+                    *self.successful.lock().unwrap() = Some(actual);
+                    self.group.selected.store(*index, Ordering::Relaxed);
+                    self.group.alive.lock().unwrap()[*index] = true;
+                    return Ok(stream);
+                }
+                Err(error) => {
+                    self.group.alive.lock().unwrap()[*index] = false;
+                    if first_error.is_none() {
+                        first_error = Some(error);
+                    }
+                }
+            }
+        }
+        Err(first_error.unwrap_or_else(|| Error::Unsupported("empty prepared group".into())))
+    }
+}
