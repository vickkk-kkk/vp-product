index 0000000000000000000000000000000000000000..f0b5821e2996aac47a0a00a91a16215399c63f1d
--- /dev/null
+++ b/crates/vp-protocol/src/stream_inbound.rs
@@ -0,0 +1,117 @@
+//! Composes a real TCP listener, bounded accepted sessions, a server carrier,
+//! and an injected protocol handler. It never opens a hidden raw loopback proxy.
+use async_trait::async_trait;
+use std::{net::SocketAddr, sync::Arc};
+use vp_common::{Error, Result};
+use vp_core::{Inbound, ProxyStream, inbound::InboundCtx};
+use vp_transport::server::ServerTransport;
+
+#[derive(Clone)]
+pub enum StreamProtocol {
+    #[cfg(feature = "trojan")]
+    Trojan(Arc<crate::trojan::TrojanInbound>),
+    #[cfg(feature = "vmess")]
+    Vmess(Arc<crate::vmess::VmessInbound>),
+    #[cfg(feature = "vless")]
+    Vless(Arc<crate::vless::VlessInbound>),
+    Anytls(Arc<crate::anytls::AnytlsInbound>),
+}
+impl StreamProtocol {
+    async fn serve(
+        &self,
+        io: Box<dyn ProxyStream>,
+        peer: SocketAddr,
+        ctx: &InboundCtx,
+    ) -> Result<()> {
+        match self {
+            #[cfg(feature = "trojan")]
+            Self::Trojan(protocol) => protocol.serve_stream(io, peer, ctx).await,
+            #[cfg(feature = "vmess")]
+            Self::Vmess(protocol) => protocol.serve_stream(io, peer, ctx).await,
+            #[cfg(feature = "vless")]
+            Self::Vless(protocol) => protocol.serve_stream(io, peer, ctx).await,
+            Self::Anytls(protocol) => protocol.serve_stream(io, peer, ctx).await,
+        }
+    }
+}
+
+pub struct TransportInbound {
+    bind: String,
+    port: u16,
+    tag: String,
+    transport: ServerTransport,
+    protocol: StreamProtocol,
+    max_connections: usize,
+}
+impl TransportInbound {
+    pub fn new(
+        bind: &str,
+        port: u16,
+        tag: &str,
+        transport: ServerTransport,
+        protocol: StreamProtocol,
+        max_connections: usize,
+    ) -> Result<Self> {
+        // A caller cannot silently fall back to a public interface for an invalid
+        // bind. DNS names are excluded from listener binding (IP literal only).
+        bind.parse::<std::net::IpAddr>()
+            .map_err(|_| Error::Config("listener bind must be an IP literal".into()))?;
+        if tag.is_empty() || tag.len() > 256 || !(1..=1024).contains(&max_connections) {
+            return Err(Error::Config(
+                "invalid stream listener tag/connection bound".into(),
+            ));
+        }
+        Ok(Self {
+            bind: bind.into(),
+            port,
+            tag: tag.into(),
+            transport,
+            protocol,
+            max_connections,
+        })
+    }
+}
+#[async_trait]
+impl Inbound for TransportInbound {
+    fn tag(&self) -> &str {
+        &self.tag
+    }
+    async fn start(self: Arc<Self>, ctx: InboundCtx) -> Result<u16> {
+        let listener = tokio::net::TcpListener::bind((self.bind.as_str(), self.port)).await?;
+        let bound = listener.local_addr()?.port();
+        let permits = Arc::new(tokio::sync::Semaphore::new(self.max_connections));
+        vp_core::task_scope::spawn_listener(self.tag.clone(), async move {
+            // The accept task stops immediately; tracked connection tasks remain
+            // Work until drain completes. This JoinSet only reaps their handles,
+            // so dropping it does not abort the independently tracked sessions.
+            let mut sessions = tokio::task::JoinSet::new();
+            loop {
+                tokio::select! {
+                    accepted = listener.accept() => {
+                        let (tcp, peer) = match accepted {
+                            Ok(value) => value,
+                            Err(_) => { tokio::time::sleep(std::time::Duration::from_millis(50)).await; continue; }
+                        };
+                        let Ok(permit) = permits.clone().try_acquire_owned() else { drop(tcp); continue; };
+                        vp_transport::tune(&tcp);
+                        let this = self.clone(); let ctx = ctx.clone();
+                        let session = vp_core::task_scope::spawn(async move {
+                            let _permit = permit;
+                            let protocol = this.protocol.clone();
+                            let _ = this.transport.serve(Box::new(tcp), move |io| {
+                                let protocol = protocol.clone(); let ctx = ctx.clone();
+                                async move { protocol.serve(io, peer, &ctx).await }
+                            }).await;
+                        });
+                        sessions.spawn(async move { let _ = session.await; });
+                    }
+                    _ = sessions.join_next(), if !sessions.is_empty() => {}
+                }
+            }
+        });
+        Ok(bound)
+    }
+}
+
+#[cfg(all(test, feature = "vless", feature = "trojan", feature = "vmess"))]
+mod tests;
