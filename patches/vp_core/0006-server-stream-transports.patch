+fn anytls_frame(cmd: u8, sid: u32, body: &[u8], out: &mut Vec<u8>) {
+    out.push(cmd);
+    out.extend_from_slice(&sid.to_be_bytes());
+    out.extend_from_slice(&(body.len() as u16).to_be_bytes());
+    out.extend_from_slice(body);
+}
