+#[tokio::test]
+async fn bounded_sessions_force_stop_rebind_and_graceful_drain() {
+    let (port, scope) = start(vless(), ServerNetwork::Tcp, None, 1).await;
+    let mut idle = connect(port, None, "").await;
+    tokio::time::timeout(Duration::from_secs(2), async {
+        while scope.snapshot().work == 0 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    let mut excess = connect(port, None, "").await;
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(2), excess.read_u8())
+            .await
+            .unwrap()
+            .unwrap_err()
+            .kind(),
+        std::io::ErrorKind::UnexpectedEof
+    );
+    let report = scope.shutdown(Duration::ZERO, Duration::from_secs(2)).await;
+    assert_eq!(report.remaining_tasks, 0);
+    assert!(report.forced_tasks > 0);
+    assert!(idle.read_u8().await.is_err());
+    drop(idle);
+    let rebound = tokio::net::TcpListener::bind(("127.0.0.1", port))
+        .await
+        .unwrap();
+    drop(rebound);
+    let (port, scope) = start(vless(), ServerNetwork::Tcp, None, 2).await;
+    let mut client = connect(port, None, "").await;
+    let (target_port, target) = target(b"payload-during-drain".to_vec()).await;
+    // Authenticate and establish the target before graceful shutdown begins.
+    client
+        .write_all(&vless_request(target_port, &[]))
+        .await
+        .unwrap();
+    let mut response = [0; 2];
+    client.read_exact(&mut response).await.unwrap();
+    assert_eq!(response, [0, 0]);
+    let stop_scope = scope.clone();
+    let shutdown = tokio::spawn(async move {
+        stop_scope
+            .shutdown(Duration::from_secs(2), Duration::from_secs(2))
+            .await
+    });
+    tokio::time::timeout(Duration::from_secs(1), async {
+        while !scope.snapshot().listeners.is_empty() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert!(
+        tokio::net::TcpStream::connect(("127.0.0.1", port))
+            .await
+            .is_err()
+    );
+    client.write_all(b"payload-during-drain").await.unwrap();
+    let mut reply = [0; 10];
+    client.read_exact(&mut reply).await.unwrap();
+    assert_eq!(&reply, b"TARGET-ACK");
+    client.shutdown().await.unwrap();
+    drop(client);
+    target.await.unwrap();
+    let report = shutdown.await.unwrap();
+    assert!(report.drained);
+    assert_eq!(report.forced_tasks, 0);
+    assert_eq!(report.remaining_tasks, 0);
+}
