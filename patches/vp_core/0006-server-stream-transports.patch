+//! Bounded server-side stream composition. This is not an outbound dialer.
+//!
+//! TLS terminates before the selected carrier. HTTPUpgrade is the sing-box
+//! upgrade-to-raw-stream profile, NOT RFC 6455 framing. HTTP/2 maps every request
+//! body/response body pair to an independent stream; it is not gRPC.
+//! The caller owns the TCP listener and this future. Dropping it closes the
+//! connection and aborts all owned H2 stream tasks. No task is detached here.
+
+use crate::ProxyStreamBox;
+use base64::Engine;
+use std::{future::Future, io, sync::Arc, time::Duration};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use vp_common::{Error, Result};
+
+mod h2_stream;
+mod websocket;
+
+/// Limits apply per accepted TCP connection; the listener must separately bound
+/// concurrent TCP sessions. None of these bounds is a protocol-authentication gate.
+#[derive(Clone, Debug)]
+pub struct ServerLimits {
+    pub handshake_timeout: Duration,
+    pub idle_timeout: Duration,
+    pub max_header_bytes: usize,
+    pub max_ws_frame_bytes: usize,
+    pub max_ws_message_bytes: usize,
+    pub max_h2_streams: u32,
+    pub max_h2_requests: usize,
+}
+impl Default for ServerLimits {
+    fn default() -> Self {
+        Self {
+            handshake_timeout: Duration::from_secs(10),
+            idle_timeout: Duration::from_secs(30),
+            max_header_bytes: 16 * 1024,
+            max_ws_frame_bytes: 1024 * 1024,
+            max_ws_message_bytes: 4 * 1024 * 1024,
+            max_h2_streams: 32,
+            max_h2_requests: 1024,
+        }
+    }
+}
+impl ServerLimits {
+    fn validate(&self) -> Result<()> {
+        if self.handshake_timeout.is_zero()
+            || self.handshake_timeout > Duration::from_secs(60)
+            || self.idle_timeout.is_zero()
+            || self.idle_timeout > Duration::from_secs(3600)
+            || !(512..=65536).contains(&self.max_header_bytes)
+            || !(125..=4 * 1024 * 1024).contains(&self.max_ws_frame_bytes)
+            || self.max_ws_message_bytes < self.max_ws_frame_bytes
+            || self.max_ws_message_bytes > 16 * 1024 * 1024
+            || !(1..=128).contains(&self.max_h2_streams)
+            || !(1..=65536).contains(&self.max_h2_requests)
+        {
+            return Err(Error::Config(
+                "invalid server transport resource limits".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+
+/// Host is a complete HTTP authority (including a port if configured). Empty
+/// hosts means no virtual-host restriction. Path is a decoded absolute URI path.
+#[derive(Clone, Debug)]
+pub struct HttpRoute {
+    path: String,
+    hosts: Vec<String>,
+    method: Option<http::Method>,
+}
+impl HttpRoute {
+    pub fn new(path: &str, hosts: Vec<String>) -> Result<Self> {
+        let path = if path.is_empty() { "/" } else { path };
+        if !path.starts_with('/')
+            || path.len() > 2048
+            || path
+                .bytes()
+                .any(|b| b <= 32 || b == 127 || b == b'?' || b == b'#')
+            || hosts.len() > 32
+        {
+            return Err(Error::Config("invalid transport path/host list".into()));
+        }
+        for host in &hosts {
+            if !valid_authority(host) {
+                return Err(Error::Config("invalid transport host authority".into()));
+            }
+        }
+        Ok(Self {
+            path: path.into(),
+            hosts,
+            method: None,
+        })
+    }
+    /// HTTP/2 method check. None accepts any valid method, matching the V2Ray
+    /// HTTP server default; its clients normally send PUT. Upgrades require GET.
+    pub fn with_method(mut self, method: &str) -> Result<Self> {
+        self.method = Some(
+            method
+                .parse()
+                .map_err(|_| Error::Config("invalid HTTP method".into()))?,
+        );
+        Ok(self)
+    }
+    fn matches(&self, authority: &str, target: &str, prefix: bool) -> bool {
+        if !valid_authority(authority)
+            || (!self.hosts.is_empty()
+                && !self.hosts.iter().any(|h| h.eq_ignore_ascii_case(authority)))
+        {
+            return false;
+        }
+        let Ok(uri) = target.parse::<http::Uri>() else {
+            return false;
+        };
+        if !target.starts_with('/') {
+            return false;
+        }
+        let Some(path) = decode_path(uri.path()) else {
+            return false;
+        };
+        if prefix {
+            path.starts_with(&self.path)
+        } else {
+            path == self.path
+        }
+    }
+}
+fn valid_authority(value: &str) -> bool {
+    if value.is_empty() || value.len() > 255 || !value.is_ascii() || value.contains('@') {
+        return false;
+    }
+    let Ok(authority) = value.parse::<http::uri::Authority>() else {
+        return false;
+    };
+    let suffix = if value.starts_with('[') {
+        value.split_once(']').map(|(_, tail)| tail)
+    } else {
+        Some(value.find(':').map_or("", |index| &value[index..]))
+    };
+    let Some(suffix) = suffix else {
+        return false;
+    };
+    if !suffix.is_empty()
+        && !suffix.strip_prefix(':').is_some_and(|port| {
+            !port.is_empty()
+                && port.bytes().all(|b| b.is_ascii_digit())
+                && port.parse::<u16>().is_ok()
+        })
+    {
+        return false;
+    }
+    let host = authority.host();
+    if let Some(ip) = host.strip_prefix('[').and_then(|h| h.strip_suffix(']')) {
+        return ip.parse::<std::net::Ipv6Addr>().is_ok();
+    }
+    let host = host.strip_suffix('.').unwrap_or(host);
+    !host.is_empty()
+        && host.split('.').all(|label| {
+            !label.is_empty()
+                && label.len() <= 63
+                && label
+                    .as_bytes()
+                    .first()
+                    .is_some_and(u8::is_ascii_alphanumeric)
+                && label
+                    .as_bytes()
+                    .last()
+                    .is_some_and(u8::is_ascii_alphanumeric)
+                && label
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-')
+        })
+}
+
+fn decode_path(path: &str) -> Option<String> {
+    let mut bytes = Vec::with_capacity(path.len());
+    let mut it = path.as_bytes().iter().copied();
+    while let Some(b) = it.next() {
+        if b == b'%' {
+            let h = (it.next()? as char).to_digit(16)?;
+            let l = (it.next()? as char).to_digit(16)?;
+            bytes.push((h * 16 + l) as u8);
+        } else {
+            bytes.push(b);
+        }
+    }
+    if bytes.iter().any(|b| *b < 32 || *b == 127) {
+        return None;
+    }
+    String::from_utf8(bytes).ok()
+}
+
+#[derive(Clone, Debug)]
+pub enum ServerNetwork {
+    Tcp,
+    WebSocket(HttpRoute),
+    HttpUpgrade(HttpRoute),
+    Http2(HttpRoute),
+}
+
+/// In-memory identity only. No filesystem, certificate issuance, or trust bypass.
+/// rustls verifies DER/key usability and the leaf/key match at construction.
+/// The connecting client remains responsible for chain/name/time verification.
+#[derive(Clone)]
+pub struct ServerTlsIdentity {
+    config: rustls::ServerConfig,
+}
+impl ServerTlsIdentity {
+    pub fn from_pem(cert_pem: &[u8], key_pem: &[u8]) -> Result<Self> {
+        if cert_pem.is_empty() || cert_pem.len() > 1024 * 1024 || key_pem.len() > 65536 {
+            return Err(Error::Config(
+                "TLS identity exceeds bounds or is empty".into(),
+            ));
+        }
+        let certs = rustls_pemfile::certs(&mut &cert_pem[..])
+            .collect::<io::Result<Vec<_>>>()
+            .map_err(|_| Error::Config("invalid TLS certificate PEM".into()))?;
+        if certs.is_empty() || certs.len() > 8 {
+            return Err(Error::Config("invalid TLS chain length".into()));
+        }
+        let mut keys = key_pem;
+        let key = rustls_pemfile::private_key(&mut keys)
+            .map_err(|_| Error::Config("invalid TLS private key PEM".into()))?
+            .ok_or_else(|| Error::Config("missing TLS private key".into()))?;
+        if rustls_pemfile::private_key(&mut keys)
+            .map_err(|_| Error::Config("invalid trailing TLS key PEM".into()))?
+            .is_some()
+        {
+            return Err(Error::Config("multiple TLS private keys".into()));
+        }
+        let config = rustls::ServerConfig::builder_with_provider(Arc::new(
+            rustls::crypto::ring::default_provider(),
+        ))
+        .with_safe_default_protocol_versions()
+        .map_err(|_| Error::Config("TLS protocol configuration".into()))?
+        .with_no_client_auth()
+        .with_single_cert(certs, key)
+        .map_err(|_| {
+            Error::Config("TLS certificate/key mismatch or unsupported identity".into())
+        })?;
+        Ok(Self { config })
+    }
+}
+
+#[derive(Clone)]
+pub struct ServerTransport {
+    network: ServerNetwork,
+    tls: Option<tokio_rustls::TlsAcceptor>,
+    limits: ServerLimits,
+}
+impl ServerTransport {
+    pub fn new(
+        network: ServerNetwork,
+        tls: Option<ServerTlsIdentity>,
+        limits: ServerLimits,
+    ) -> Result<Self> {
+        limits.validate()?;
+        if matches!(&network, ServerNetwork::WebSocket(r) | ServerNetwork::HttpUpgrade(r) if r.method.is_some())
+        {
+            return Err(Error::Config(
+                "upgrade method must be GET (do not set a method override)".into(),
+            ));
+        }
+        let tls = tls.map(|mut identity| {
+            identity.config.alpn_protocols = match network {
+                ServerNetwork::Http2(_) => vec![b"h2".to_vec()],
+                ServerNetwork::WebSocket(_) | ServerNetwork::HttpUpgrade(_) => {
+                    vec![b"http/1.1".to_vec()]
+                }
+                ServerNetwork::Tcp => Vec::new(),
+            };
+            tokio_rustls::TlsAcceptor::from(Arc::new(identity.config))
+        });
+        Ok(Self {
+            network,
+            tls,
+            limits,
+        })
+    }
+
+    /// Call handler once per logical stream and retain it until it finishes.
+    /// The handler must not detach relay work, or stream concurrency/drain would
+    /// cease to measure actual stream lifetime. Protocol authentication is its job.
+    pub async fn serve<F, Fut>(&self, io: ProxyStreamBox, handler: F) -> Result<()>
+    where
+        F: Fn(ProxyStreamBox) -> Fut + Send + Sync,
+        Fut: Future<Output = Result<()>> + Send + 'static,
+    {
+        let io = tokio::time::timeout(self.limits.handshake_timeout, async {
+            let mut io = if let Some(tls) = &self.tls {
+                let stream = tls.accept(io).await?;
+                let alpn = stream.get_ref().1.alpn_protocol();
+                if matches!(self.network, ServerNetwork::Http2(_)) && alpn != Some(b"h2".as_slice()) {
+                    return Err(Error::Proto("HTTP/2 requires negotiated h2 ALPN"));
+                }
+                Box::new(stream) as ProxyStreamBox
+            } else { io };
+            match &self.network {
+                ServerNetwork::WebSocket(route) | ServerNetwork::HttpUpgrade(route) => {
+                    let head = read_http_head(&mut io, self.limits.max_header_bytes).await?;
+                    let key = validate_upgrade(&head, route, matches!(self.network, ServerNetwork::WebSocket(_)))?;
+                    let accept = if let Some(key) = key {
+                        use sha1::Digest;
+                        let digest = sha1::Sha1::digest(format!("{key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11").as_bytes());
+                        format!("Sec-WebSocket-Accept: {}\r\n", base64::engine::general_purpose::STANDARD.encode(digest))
+                    } else { String::new() };
+                    io.write_all(format!("HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n{accept}\r\n").as_bytes()).await?;
+                    io.flush().await?;
+                    if matches!(self.network, ServerNetwork::WebSocket(_)) {
+                        return Ok(Box::new(websocket::ServerWebSocket::new(io, &self.limits)) as ProxyStreamBox);
+                    }
+                }
+                _ => {}
+            }
+            Ok(io)
+        }).await.map_err(|_| Error::Io(io::Error::new(io::ErrorKind::TimedOut, "server transport handshake timed out")))??;
+        match &self.network {
+            ServerNetwork::Http2(route) => {
+                h2_stream::serve(io, route, &self.limits, self.tls.is_some(), handler).await
+            }
+            _ => handler(io).await,
+        }
+    }
+}
+
+/// Read only through CRLFCRLF: deliberately do not consume early payload bytes.
+async fn read_http_head(io: &mut ProxyStreamBox, limit: usize) -> Result<Vec<u8>> {
+    let mut head = Vec::with_capacity(limit.min(1024));
+    loop {
+        if head.len() == limit {
+            return Err(Error::Proto("HTTP header limit exceeded"));
+        }
+        head.push(io.read_u8().await?);
+        if head.ends_with(b"\r\n\r\n") {
+            return Ok(head);
+        }
+    }
+}
+fn validate_upgrade<'a>(
+    head: &'a [u8],
+    route: &HttpRoute,
+    websocket: bool,
+) -> Result<Option<&'a str>> {
+    let mut headers = [httparse::EMPTY_HEADER; 64];
+    let mut req = httparse::Request::new(&mut headers);
+    let status = req
+        .parse(head)
+        .map_err(|_| Error::Proto("malformed HTTP upgrade"))?;
+    if !status.is_complete() || req.method != Some("GET") || req.version != Some(1) {
+        return Err(Error::Proto("HTTP upgrade requires GET HTTP/1.1"));
+    }
+    let get = |name: &str| -> Result<Option<&'a str>> {
+        let mut values = req
+            .headers
+            .iter()
+            .filter(|h| h.name.eq_ignore_ascii_case(name));
+        let first = values
+            .next()
+            .map(|h| std::str::from_utf8(h.value).map(str::trim));
+        if values.next().is_some() {
+            return Err(Error::Proto("duplicate HTTP security header"));
+        }
+        first
+            .transpose()
+            .map_err(|_| Error::Proto("non-ASCII HTTP security header"))
+    };
+    let host = get("host")?.ok_or(Error::Proto("HTTP Host required"))?;
+    if !route.matches(host, req.path.unwrap_or(""), false) {
+        return Err(Error::Proto("HTTP route mismatch"));
+    }
+    let connection = get("connection")?.unwrap_or("");
+    if !connection
+        .split(',')
+        .any(|t| t.trim().eq_ignore_ascii_case("upgrade"))
+        || !get("upgrade")?
+            .unwrap_or("")
+            .eq_ignore_ascii_case("websocket")
+        || get("transfer-encoding")?.is_some()
+        || get("content-length")?.is_some_and(|v| v != "0")
+    {
+        return Err(Error::Proto("invalid HTTP upgrade headers/body"));
+    }
+    let key = get("sec-websocket-key")?;
+    if websocket {
+        let key = key.ok_or(Error::Proto("missing WebSocket key"))?;
+        if get("sec-websocket-version")? != Some("13")
+            || base64::engine::general_purpose::STANDARD
+                .decode(key)
+                .map_or(true, |k| k.len() != 16)
+            || get("sec-websocket-protocol")?.is_some()
+            || get("sec-websocket-extensions")?.is_some()
+        {
+            return Err(Error::Proto("invalid or unsupported WebSocket handshake"));
+        }
+        Ok(Some(key))
+    } else {
+        if key.is_some()
+            || get("sec-websocket-version")?.is_some()
+            || get("sec-websocket-protocol")?.is_some()
+        {
+            return Err(Error::Proto("HTTPUpgrade is not framed WebSocket"));
+        }
+        Ok(None)
+    }
+}
