+//! Binary RFC 6455 server stream. Extension/subprotocol/early-data negotiation is
+//! intentionally absent. Masking, fragmentation, control frames and lengths are
+//! checked before any payload is exposed. Both read and write buffering is bounded.
+use super::ServerLimits;
+use crate::ProxyStreamBox;
+use bytes::{Buf, BytesMut};
+use std::{
+    io,
+    pin::Pin,
+    task::{Context, Poll},
+};
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+
+pub(super) struct ServerWebSocket {
+    io: ProxyStreamBox,
+    raw: BytesMut,
+    payload: BytesMut,
+    output: BytesMut,
+    frame_limit: usize,
+    message_limit: usize,
+    fragment_bytes: Option<usize>,
+    read_closed: bool,
+    write_closed: bool,
+    close_queued: bool,
+}
+fn invalid(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+impl ServerWebSocket {
+    pub(super) fn new(io: ProxyStreamBox, limits: &ServerLimits) -> Self {
+        Self {
+            io,
+            raw: BytesMut::new(),
+            payload: BytesMut::new(),
+            output: BytesMut::new(),
+            frame_limit: limits.max_ws_frame_bytes,
+            message_limit: limits.max_ws_message_bytes,
+            fragment_bytes: None,
+            read_closed: false,
+            write_closed: false,
+            close_queued: false,
+        }
+    }
+    fn queue(&mut self, opcode: u8, data: &[u8]) {
+        self.output.extend_from_slice(&[0x80 | opcode]);
+        if data.len() < 126 {
+            self.output.extend_from_slice(&[data.len() as u8]);
+        } else {
+            self.output.extend_from_slice(&[126]);
+            self.output
+                .extend_from_slice(&(data.len() as u16).to_be_bytes());
+        }
+        self.output.extend_from_slice(data);
+    }
+    fn flush_output(&mut self, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        while !self.output.is_empty() {
+            let count = std::task::ready!(Pin::new(&mut self.io).poll_write(cx, &self.output))?;
+            if count == 0 {
+                return Poll::Ready(Err(io::Error::new(
+                    io::ErrorKind::WriteZero,
+                    "WebSocket write zero",
+                )));
+            }
+            self.output.advance(count);
+        }
+        std::task::ready!(Pin::new(&mut self.io).poll_flush(cx))?;
+        Poll::Ready(Ok(()))
+    }
+    /// Return true if a complete frame was consumed, false when more IO is needed.
+    fn frame(&mut self) -> io::Result<bool> {
+        if self.raw.len() < 2 {
+            return Ok(false);
+        }
+        let first = self.raw[0];
+        let final_frame = first & 0x80 != 0;
+        let opcode = first & 15;
+        if first & 0x70 != 0 || self.raw[1] & 0x80 == 0 {
+            return Err(invalid("WebSocket RSV/masking violation"));
+        }
+        if !matches!(opcode, 0 | 2 | 8 | 9 | 10) {
+            return Err(invalid("WebSocket binary/control opcode required"));
+        }
+        let mut header = 2;
+        let short = self.raw[1] & 127;
+        let length = match short {
+            126 => {
+                if self.raw.len() < 4 {
+                    return Ok(false);
+                }
+                header = 4;
+                let n = u16::from_be_bytes([self.raw[2], self.raw[3]]) as u64;
+                if n < 126 {
+                    return Err(invalid("nonminimal WebSocket length"));
+                }
+                n
+            }
+            127 => {
+                if self.raw.len() < 10 {
+                    return Ok(false);
+                }
+                header = 10;
+                let n = u64::from_be_bytes(
+                    self.raw[2..10]
+                        .try_into()
+                        .map_err(|_| invalid("WebSocket length"))?,
+                );
+                if n < 65536 || n >> 63 != 0 {
+                    return Err(invalid("invalid WebSocket 64-bit length"));
+                }
+                n
+            }
+            n => n as u64,
+        };
+        if length > self.frame_limit as u64 {
+            return Err(invalid("WebSocket frame limit exceeded"));
+        }
+        if opcode >= 8 && (!final_frame || length > 125) {
+            return Err(invalid("invalid WebSocket control frame"));
+        }
+        let length = length as usize;
+        if self.raw.len() < header + 4 + length {
+            return Ok(false);
+        }
+        let mask: [u8; 4] = self.raw[header..header + 4]
+            .try_into()
+            .map_err(|_| invalid("WebSocket mask"))?;
+        self.raw.advance(header + 4);
+        let mut data = self.raw.split_to(length);
+        for (index, byte) in data.iter_mut().enumerate() {
+            *byte ^= mask[index % 4];
+        }
+        match opcode {
+            0 | 2 => {
+                let total = if opcode == 0 {
+                    self.fragment_bytes
+                        .ok_or_else(|| invalid("unexpected WebSocket continuation"))?
+                        .checked_add(length)
+                        .ok_or_else(|| invalid("WebSocket message overflow"))?
+                } else {
+                    if self.fragment_bytes.is_some() {
+                        return Err(invalid("interleaved WebSocket data messages"));
+                    }
+                    length
+                };
+                if total > self.message_limit {
+                    return Err(invalid("WebSocket message limit exceeded"));
+                }
+                self.fragment_bytes = if final_frame { None } else { Some(total) };
+                self.payload = data;
+            }
+            8 => {
+                if data.len() == 1 {
+                    return Err(invalid("WebSocket close length"));
+                }
+                if data.len() >= 2 {
+                    let code = u16::from_be_bytes([data[0], data[1]]);
+                    if !(matches!(code, 1000..=1003 | 1007..=1014) || (3000..=4999).contains(&code))
+                        || std::str::from_utf8(&data[2..]).is_err()
+                    {
+                        return Err(invalid("WebSocket close code/reason"));
+                    }
+                }
+                if !self.close_queued {
+                    self.queue(8, &data);
+                    self.close_queued = true;
+                }
+                self.read_closed = true;
+                self.write_closed = true;
+            }
+            9 => self.queue(10, &data), // Pong MUST echo the ping application data.
+            10 => {}
+            _ => unreachable!(),
+        }
+        Ok(true)
+    }
+}
+impl AsyncRead for ServerWebSocket {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        if buf.remaining() == 0 {
+            return Poll::Ready(Ok(()));
+        }
+        for _ in 0..32 {
+            std::task::ready!(self.flush_output(cx))?;
+            if !self.payload.is_empty() {
+                let count = self.payload.len().min(buf.remaining());
+                buf.put_slice(&self.payload[..count]);
+                self.payload.advance(count);
+                return Poll::Ready(Ok(()));
+            }
+            if self.read_closed {
+                return Poll::Ready(Ok(()));
+            }
+            if self.frame()? {
+                continue;
+            }
+            let available = (self.frame_limit + 14)
+                .saturating_sub(self.raw.len())
+                .min(4096);
+            if available == 0 {
+                return Poll::Ready(Err(invalid("WebSocket read buffer limit")));
+            }
+            let mut temp = [0u8; 4096];
+            let mut read = ReadBuf::new(&mut temp[..available]);
+            std::task::ready!(Pin::new(&mut self.io).poll_read(cx, &mut read))?;
+            if read.filled().is_empty() {
+                return Poll::Ready(Err(io::Error::new(
+                    io::ErrorKind::UnexpectedEof,
+                    "WebSocket closed without close frame",
+                )));
+            }
+            self.raw.extend_from_slice(read.filled());
+        }
+        cx.waker().wake_by_ref();
+        Poll::Pending
+    }
+}
+impl AsyncWrite for ServerWebSocket {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        if self.write_closed {
+            return Poll::Ready(Err(io::Error::new(
+                io::ErrorKind::BrokenPipe,
+                "WebSocket closed",
+            )));
+        }
+        if buf.is_empty() {
+            return Poll::Ready(Ok(0));
+        }
+        std::task::ready!(self.flush_output(cx))?;
+        let count = buf.len().min(16384).min(self.frame_limit);
+        self.queue(2, &buf[..count]);
+        // Ownership transferred once. Returning Pending after queuing would let
+        // AsyncWriteExt retry the same bytes and duplicate protocol payload.
+        Poll::Ready(Ok(count))
+    }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        self.flush_output(cx)
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        if !self.close_queued {
+            std::task::ready!(self.flush_output(cx))?;
+            self.queue(8, &[3, 232]);
+            self.close_queued = true;
+            self.write_closed = true;
+        }
+        std::task::ready!(self.flush_output(cx))?;
+        Pin::new(&mut self.io).poll_shutdown(cx)
+    }
+}
