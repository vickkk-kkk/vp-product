+        vec![0xc2, 0x80, 0, 0, 0, 0],                // RSV
+        masked(0x80, b"x"),                          // unexpected continuation
+        masked(0x09, b"x"),                          // fragmented ping
+        vec![0x82, 0xfe, 0, 1, 0, 0, 0, 0, b'x'],    // nonminimal length
+        vec![0x82, 0xff, 0xff, 0, 0, 0, 0, 0, 0, 0], // sign bit
+        vec![0x82, 0xfe, 1, 0],                      // > configured frame bound, no body needed
