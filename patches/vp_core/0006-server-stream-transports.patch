+#[tokio::test]
+async fn websocket_fragment_total_limit_and_pending_write_no_duplication() {
+    let limits = ServerLimits {
+        max_ws_frame_bytes: 125,
+        max_ws_message_bytes: 125,
+        ..ServerLimits::default()
+    };
+    let server =
+        ServerTransport::new(ServerNetwork::WebSocket(route()), None, limits.clone()).unwrap();
+    let (addr, task) = start(server, echo).await;
+    let mut client = TcpStream::connect(addr).await.unwrap();
+    client
+        .write_all(&upgrade("/proxy", "localhost", true))
+        .await
+        .unwrap();
+    head(&mut client).await;
+    let mut request = masked(0x02, &[1; 100]);
+    request.extend(masked(0x80, &[2; 100]));
+    client.write_all(&request).await.unwrap();
+    assert!(task.await.unwrap().is_err());
+    // Tiny capacity forces poll_write/Pending for every outgoing frame. Decode
+    // frames independently rather than trusting the legacy WsStream client.
+    let (io, mut reader) = tokio::io::duplex(7);
+    let mut stream = websocket::ServerWebSocket::new(Box::new(io), &limits);
+    let write = tokio::spawn(async move {
+        stream.write_all(&vec![42; 50_000]).await.unwrap();
+        stream.shutdown().await.unwrap();
+    });
+    let mut received = Vec::new();
+    loop {
+        let opcode = reader.read_u8().await.unwrap();
+        let len = reader.read_u8().await.unwrap();
+        assert!(len <= 125);
+        let mut data = vec![0; len as usize];
+        reader.read_exact(&mut data).await.unwrap();
+        if opcode == 0x88 {
+            assert_eq!(data, [3, 232]);
+            break;
+        }
+        assert_eq!(opcode, 0x82);
+        received.extend(data);
+    }
+    assert_eq!(received, vec![42; 50_000]);
+    write.await.unwrap();
+}
