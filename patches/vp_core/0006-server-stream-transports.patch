+        |mut io| async move {
+            let mut data = Vec::new();
+            io.read_to_end(&mut data).await?;
+            io.write_all(&data).await?;
+            io.shutdown().await?;
+            Ok(())
+        },
+    )
+    .await;
+    let (mut client, driver) = h2_client(addr).await;
+    let (bad, _) = client.send_request(h2_request("/wrong"), true).unwrap();
+    assert_eq!(bad.await.unwrap().status(), 404);
+    let mut sessions = Vec::new();
+    for number in 0..3 {
+        client = client.ready().await.unwrap();
+        let (response, mut body) = client
+            .send_request(h2_request("/proxy/suffix"), false)
+            .unwrap();
+        let bytes = vec![number; 200_000];
+        body.send_data(Bytes::from(bytes.clone()), true).unwrap();
+        sessions.push(tokio::spawn(async move {
+            let response = response.await.unwrap();
+            assert_eq!(response.status(), 200);
+            let mut body = response.into_body();
+            let mut received = Vec::new();
+            while let Some(data) = body.data().await {
+                let data = data.unwrap();
+                received.extend_from_slice(&data);
+                body.flow_control().release_capacity(data.len()).unwrap();
+            }
+            assert_eq!(received, bytes);
+        }));
+    }
+    for session in sessions {
+        tokio::time::timeout(Duration::from_secs(5), session)
+            .await
+            .unwrap()
+            .unwrap();
+    }
+    drop(client);
+    driver.abort();
+    let _ = driver.await;
+    tokio::time::timeout(Duration::from_secs(2), server)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
