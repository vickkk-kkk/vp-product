+            .unwrap()
+        });
+        let route = HttpRoute::new("/proxy", vec!["localhost".into()]).unwrap();
+        let network = match mode {
+            0 | 1 => ServerNetwork::Tcp,
+            2 => ServerNetwork::WebSocket(route),
+            _ => ServerNetwork::HttpUpgrade(route),
+        };
