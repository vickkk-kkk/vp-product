@@ -0,0 +1,713 @@
+use super::*;
+use sha2::Digest;
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use vp_core::task_scope::TaskScope;
+use vp_transport::server::{HttpRoute, ServerLimits, ServerNetwork, ServerTlsIdentity};
+
+fn context() -> InboundCtx {
+    InboundCtx {
+        router: Arc::new(crate::test_support::NoopRouter()),
+        stats: Arc::new(vp_common::Stats::default()),
+        conns: Arc::new(vp_core::ConnTable::new()),
+    }
+}
+fn vless() -> StreamProtocol {
+    StreamProtocol::Vless(Arc::new(
+        crate::vless::VlessInbound::new(
+            "127.0.0.1",
+            0,
+            "composed",
+            &["11111111-1111-1111-1111-111111111111".into()],
+        )
+        .unwrap(),
+    ))
+}
+fn vless_request(port: u16, payload: &[u8]) -> Vec<u8> {
+    let mut out = vec![0];
+    out.extend_from_slice(&[0x11; 16]);
+    out.extend_from_slice(&[0, 1]);
+    out.extend_from_slice(&port.to_be_bytes());
+    out.extend_from_slice(&[1, 127, 0, 0, 1]);
+    out.extend_from_slice(payload);
+    out
+}
+async fn target(payload: Vec<u8>) -> (u16, tokio::task::JoinHandle<()>) {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let port = listener.local_addr().unwrap().port();
+    (
+        port,
+        tokio::spawn(async move {
+            let (mut io, _) = listener.accept().await.unwrap();
+            let mut actual = vec![0; payload.len()];
+            io.read_exact(&mut actual).await.unwrap();
+            assert_eq!(actual, payload);
+            io.write_all(b"TARGET-ACK").await.unwrap();
+            io.shutdown().await.unwrap();
+        }),
+    )
+}
+async fn start(
+    protocol: StreamProtocol,
+    network: ServerNetwork,
+    tls: Option<ServerTlsIdentity>,
+    max: usize,
+) -> (u16, Arc<TaskScope>) {
+    let transport = ServerTransport::new(network, tls, ServerLimits::default()).unwrap();
+    let listener = Arc::new(
+        TransportInbound::new("127.0.0.1", 0, "composed", transport, protocol, max).unwrap(),
+    );
+    let scope = TaskScope::new();
+    let port = scope.run(listener.start(context())).await.unwrap();
+    assert_eq!(scope.snapshot().listeners, vec!["composed"]);
+    assert!(scope.snapshot().healthy());
+    (port, scope)
+}
+async fn connect(
+    port: u16,
+    cert: Option<&rcgen::CertifiedKey>,
+    alpn: &str,
+) -> Box<dyn ProxyStream> {
+    let io = tokio::net::TcpStream::connect(("127.0.0.1", port))
+        .await
+        .unwrap();
+    if let Some(cert) = cert {
+        let mut roots = rustls::RootCertStore::empty();
+        roots.add(cert.cert.der().clone()).unwrap();
+        let mut config = rustls::ClientConfig::builder_with_provider(Arc::new(
+            rustls::crypto::ring::default_provider(),
+        ))
+        .with_safe_default_protocol_versions()
+        .unwrap()
+        .with_root_certificates(roots)
+        .with_no_client_auth();
+        if !alpn.is_empty() {
+            config.alpn_protocols = vec![alpn.as_bytes().to_vec()];
+        }
+        let tls = tokio_rustls::TlsConnector::from(Arc::new(config))
+            .connect("localhost".try_into().unwrap(), io)
+            .await
+            .unwrap();
+        Box::new(tls)
+    } else {
+        Box::new(io)
+    }
+}
+fn carrier_network(mode: u8) -> ServerNetwork {
+    let route = HttpRoute::new("/proxy", vec!["localhost".into()]).unwrap();
+    match mode {
+        2 | 5 => ServerNetwork::WebSocket(route),
+        3 => ServerNetwork::HttpUpgrade(route),
+        4 => ServerNetwork::Http2(route),
+        _ => ServerNetwork::Tcp,
+    }
+}
+// Test harness only: map HTTP/2 DATA to a bounded duplex stream for exercising
+// an existing VMess encoder over each carrier. This is NOT independent interop.
+async fn carrier(
+    port: u16,
+    cert: &rcgen::CertifiedKey,
+    mode: u8,
+) -> (Box<dyn ProxyStream>, Vec<tokio::task::JoinHandle<()>>) {
+    let mut io = connect(
+        port,
+        (mode != 5).then_some(cert),
+        if mode == 4 {
+            "h2"
+        } else if mode >= 2 {
+            "http/1.1"
+        } else {
+            ""
+        },
+    )
+    .await;
+    if mode == 2 || mode == 5 {
+        io = Box::new(
+            vp_transport::ws::ws_handshake_client(
+                io,
+                "localhost",
+                &vp_transport::WsConfig {
+                    path: "/proxy".into(),
+                    headers: vec![],
+                },
+            )
+            .await
+            .unwrap(),
+        );
+    } else if mode == 3 {
+        io.write_all(b"GET /proxy HTTP/1.1\r\nHost: localhost\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\n").await.unwrap();
+        let mut head = Vec::new();
+        while !head.ends_with(b"\r\n\r\n") {
+            head.push(io.read_u8().await.unwrap());
+        }
+        assert!(head.starts_with(b"HTTP/1.1 101 "));
+    } else if mode == 4 {
+        let (mut client, connection) = h2::client::handshake(io).await.unwrap();
+        let driver = tokio::spawn(async move {
+            let _ = connection.await;
+        });
+        let request = http::Request::builder()
+            .method("PUT")
+            .uri("https://localhost/proxy")
+            .body(())
+            .unwrap();
+        let (response, mut send) = client.send_request(request, false).unwrap();
+        let response = response.await.unwrap();
+        assert_eq!(response.status(), 200);
+        let mut receive = response.into_body();
+        let (local, remote) = tokio::io::duplex(65536);
+        let (mut read, mut write) = tokio::io::split(remote);
+        let bridge = tokio::spawn(async move {
+            let upload = async move {
+                let mut buf = [0; 16384];
+                loop {
+                    let n = match read.read(&mut buf).await {
+                        Ok(n) => n,
+                        Err(_) => return,
+                    };
+                    if n == 0 {
+                        let _ = send.send_data(bytes::Bytes::new(), true);
+                        return;
+                    }
+                    let mut offset = 0;
+                    while offset < n {
+                        send.reserve_capacity(n - offset);
+                        let cap = match std::future::poll_fn(|cx| send.poll_capacity(cx)).await {
+                            Some(Ok(cap)) => cap,
+                            _ => return,
+                        };
+                        let count = cap.min(n - offset);
+                        if count == 0 {
+                            tokio::task::yield_now().await;
+                            continue;
+                        }
+                        if send
+                            .send_data(
+                                bytes::Bytes::copy_from_slice(&buf[offset..offset + count]),
+                                false,
+                            )
+                            .is_err()
+                        {
+                            return;
+                        }
+                        offset += count;
+                    }
+                }
+            };
+            let download = async move {
+                while let Some(data) = receive.data().await {
+                    let data = match data {
+                        Ok(data) => data,
+                        Err(_) => break,
+                    };
+                    if write.write_all(&data).await.is_err() {
+                        break;
+                    }
+                    if receive.flow_control().release_capacity(data.len()).is_err() {
+                        break;
+                    }
+                }
+                let _ = write.shutdown().await;
+            };
+            tokio::join!(upload, download);
+        });
+        return (Box::new(local), vec![driver, bridge]);
+    }
+    (io, vec![])
+}
+async fn finish_carrier(tasks: Vec<tokio::task::JoinHandle<()>>) {
+    for task in tasks {
+        task.abort();
+        let _ = task.await;
+    }
+}
+
+async fn stop(scope: Arc<TaskScope>) {
+    let report = scope.shutdown(Duration::ZERO, Duration::from_secs(2)).await;
+    assert_eq!(report.remaining_tasks, 0);
+    assert_eq!(report.panics, 0);
+}
+
+#[tokio::test]
+async fn composed_vless_tcp_tls_websocket_and_httpupgrade() {
+    for mode in 0..4 {
+        let cert = rcgen::generate_simple_self_signed(vec!["localhost".into()]).unwrap();
+        let tls = (mode != 0).then(|| {
