+    let (port, scope) = start(protocol(), ServerNetwork::Tcp, None, 4).await;
+    let (target_port, target) = target(b"late-anytls-payload".to_vec()).await;
+    let mut io = connect(port, None, "").await;
+    let mut fixture = sha2::Sha256::digest(b"ephemeral-password").to_vec();
+    fixture.extend_from_slice(&[0, 0]);
+    anytls_frame(4, 0, b"v=2", &mut fixture);
+    anytls_frame(1, 1, &[], &mut fixture);
+    let mut address = vec![1, 127, 0, 0, 1];
+    address.extend_from_slice(&target_port.to_be_bytes());
+    anytls_frame(2, 1, &address, &mut fixture);
+    io.write_all(&fixture).await.unwrap();
+    loop {
+        let cmd = io.read_u8().await.unwrap();
+        let sid = io.read_u32().await.unwrap();
+        let len = io.read_u16().await.unwrap();
+        let mut body = vec![0; len as usize];
+        io.read_exact(&mut body).await.unwrap();
+        if cmd == 7 && sid == 1 {
+            assert!(body.is_empty());
+            break;
+        }
+    }
+    let draining_scope = scope.clone();
+    let shutdown = tokio::spawn(async move {
+        draining_scope
+            .shutdown(Duration::from_secs(2), Duration::from_secs(2))
+            .await
+    });
+    scope.draining().await;
+    let mut frames = Vec::new();
+    anytls_frame(2, 1, b"late-anytls-payload", &mut frames);
+    io.write_all(&frames).await.unwrap();
+    let mut received = Vec::new();
+    while received.len() < 10 {
+        let cmd = io.read_u8().await.unwrap();
+        let sid = io.read_u32().await.unwrap();
+        let len = io.read_u16().await.unwrap();
+        let mut body = vec![0; len as usize];
+        io.read_exact(&mut body).await.unwrap();
+        if cmd == 2 && sid == 1 {
+            received.extend_from_slice(&body);
+        }
+    }
+    assert_eq!(received, b"TARGET-ACK");
+    target.await.unwrap();
+    let report = shutdown.await.unwrap();
+    assert!(report.drained);
+    assert_eq!(report.forced_tasks, 0);
+    assert_eq!(report.remaining_tasks, 0);
+    drop(io);
+
+    let (port, scope) = start(protocol(), ServerNetwork::Tcp, None, 4).await;
+    let mut io = connect(port, None, "").await;
+    let mut fixture = sha2::Sha256::digest(b"ephemeral-password").to_vec();
+    fixture.extend_from_slice(&[0, 0]);
+    anytls_frame(4, 0, b"v=2", &mut fixture);
+    for sid in 1..=129 {
+        anytls_frame(1, sid, &[], &mut fixture);
+    }
+    io.write_all(&fixture).await.unwrap();
+    let mut buffer = Vec::new();
+    // No pending address stream is allowed to grow the map past 128.
+    tokio::time::timeout(Duration::from_secs(2), io.read_to_end(&mut buffer))
+        .await
+        .unwrap()
+        .unwrap();
+    drop(io);
+    stop(scope).await;
+}
