+use super::*;
+use bytes::Bytes;
+use std::{
+    net::SocketAddr,
+    sync::atomic::{AtomicUsize, Ordering},
+};
+use tokio::{
+    net::{TcpListener, TcpStream},
+    task::JoinHandle,
+};
+
+fn route() -> HttpRoute {
+    HttpRoute::new("/proxy", vec!["localhost".into()]).unwrap()
+}
+fn transport(network: ServerNetwork) -> ServerTransport {
+    ServerTransport::new(network, None, ServerLimits::default()).unwrap()
+}
+async fn start<F, Fut>(server: ServerTransport, handler: F) -> (SocketAddr, JoinHandle<Result<()>>)
+where
+    F: Fn(ProxyStreamBox) -> Fut + Send + Sync + 'static,
+    Fut: Future<Output = Result<()>> + Send + 'static,
+{
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    // Bound before returning: a second bind is evidence of readiness/ownership.
+    assert!(TcpListener::bind(addr).await.is_err());
+    let task = vp_core::task_scope::spawn(async move {
+        let (io, _) = listener.accept().await?;
+        server.serve(Box::new(io), handler).await
+    });
+    (addr, task)
+}
+async fn echo(mut io: ProxyStreamBox) -> Result<()> {
+    let mut buf = [0u8; 8192];
+    loop {
+        let n = io.read(&mut buf).await?;
+        if n == 0 {
+            return Ok(());
+        }
+        io.write_all(&buf[..n]).await?;
+        io.flush().await?;
+    }
+}
+async fn head(io: &mut TcpStream) -> Vec<u8> {
+    let mut head = Vec::new();
+    while !head.ends_with(b"\r\n\r\n") {
+        head.push(io.read_u8().await.unwrap());
+        assert!(head.len() <= 16384);
+    }
+    head
+}
+fn upgrade(path: &str, host: &str, ws: bool) -> Vec<u8> {
+    format!("GET {path} HTTP/1.1\r\nHost: {host}\r\nConnection: keep-alive, Upgrade\r\nUpgrade: websocket\r\n{}\r\n",
+        if ws { "Sec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n" } else { "" }).into_bytes()
+}
+fn masked(op: u8, data: &[u8]) -> Vec<u8> {
+    let mut out = vec![op];
+    if data.len() < 126 {
+        out.push(0x80 | data.len() as u8);
+    } else {
+        out.push(0x80 | 126);
+        out.extend_from_slice(&(data.len() as u16).to_be_bytes());
+    }
+    let mask = [17, 29, 73, 101];
+    out.extend_from_slice(&mask);
+    out.extend(data.iter().enumerate().map(|(i, b)| *b ^ mask[i % 4]));
+    out
+}
+async fn ws_frame(io: &mut TcpStream) -> (u8, Vec<u8>) {
+    let op = io.read_u8().await.unwrap();
+    let len = io.read_u8().await.unwrap();
+    assert_eq!(len & 0x80, 0);
+    let len = if len == 126 {
+        io.read_u16().await.unwrap() as usize
+    } else {
+        len as usize
+    };
+    let mut data = vec![0; len];
+    io.read_exact(&mut data).await.unwrap();
+    (op, data)
+}
+
+#[tokio::test]
+async fn websocket_rfc_accept_fragment_ping_close() {
+    let (addr, task) = start(transport(ServerNetwork::WebSocket(route())), echo).await;
+    let mut client = TcpStream::connect(addr).await.unwrap();
+    client
+        .write_all(&upgrade("/proxy", "localhost", true))
+        .await
+        .unwrap();
+    let response = String::from_utf8(head(&mut client).await).unwrap();
+    assert!(response.contains("Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo="));
+    let mut frames = masked(0x02, b"ab");
+    frames.extend(masked(0x89, b"keep-alive"));
+    frames.extend(masked(0x80, b"cd"));
+    client.write_all(&frames).await.unwrap();
+    assert_eq!(ws_frame(&mut client).await, (0x82, b"ab".to_vec()));
+    assert_eq!(ws_frame(&mut client).await, (0x8a, b"keep-alive".to_vec()));
+    assert_eq!(ws_frame(&mut client).await, (0x82, b"cd".to_vec()));
+    client.write_all(&masked(0x88, &[3, 232])).await.unwrap();
+    assert_eq!(ws_frame(&mut client).await, (0x88, vec![3, 232]));
+    task.await.unwrap().unwrap();
+}
+
+#[tokio::test]
+async fn upgrades_validate_host_path_and_mode_without_calling_protocol() {
+    let cases = [
+        (ServerNetwork::WebSocket(route()), upgrade("/wrong", "localhost", true)),
+        (ServerNetwork::WebSocket(route()), upgrade("/proxy", "wrong.test", true)),
+        (ServerNetwork::WebSocket(route()), upgrade("/proxy", "localhost", false)),
+        (ServerNetwork::HttpUpgrade(route()), upgrade("/proxy", "localhost", true)),
+        (ServerNetwork::HttpUpgrade(route()), upgrade("/proxy/suffix", "localhost", false)),
+        (ServerNetwork::HttpUpgrade(route()), b"GET /proxy HTTP/1.1\r\nHost: localhost\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: upgrade\r\n\r\n".to_vec()),
+        (ServerNetwork::WebSocket(route()), b"POST /proxy HTTP/1.1\r\nHost: localhost\r\n\r\n".to_vec()),
+    ];
+    for (network, request) in cases {
+        let called = Arc::new(AtomicUsize::new(0));
+        let check = called.clone();
+        let (addr, task) = start(transport(network), move |_| {
+            check.fetch_add(1, Ordering::SeqCst);
+            async { Ok(()) }
+        })
+        .await;
+        let mut client = TcpStream::connect(addr).await.unwrap();
+        client.write_all(&request).await.unwrap();
+        assert!(task.await.unwrap().is_err());
