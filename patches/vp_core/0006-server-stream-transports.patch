diff --git a/crates/vp-transport/src/server/h2_stream.rs b/crates/vp-transport/src/server/h2_stream.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e9a2649dd2476a63becf4724b74043530d0ed782
--- /dev/null
+++ b/crates/vp-transport/src/server/h2_stream.rs
@@ -0,0 +1,226 @@
+use super::{HttpRoute, ServerLimits};
+use crate::ProxyStreamBox;
+use bytes::{Buf, Bytes};
+use std::{
+    future::Future,
+    io,
+    pin::Pin,
+    task::{Context, Poll},
+};
+use tokio::{
+    io::{AsyncRead, AsyncWrite, ReadBuf},
+    task::JoinSet,
+};
+use vp_common::{Error, Result};
+
+fn h2_error(error: h2::Error) -> io::Error {
+    io::Error::other(error)
+}
+
+pub(super) async fn serve<F, Fut>(
+    io: ProxyStreamBox,
+    route: &HttpRoute,
+    limits: &ServerLimits,
+    tls: bool,
+    handler: F,
+) -> Result<()>
+where
+    F: Fn(ProxyStreamBox) -> Fut + Send + Sync,
+    Fut: Future<Output = Result<()>> + Send + 'static,
+{
+    let mut builder = h2::server::Builder::new();
+    builder
+        .max_concurrent_streams(limits.max_h2_streams)
+        .max_header_list_size(limits.max_header_bytes as u32)
+        .header_table_size(4096)
+        .initial_window_size(65535)
+        .initial_connection_window_size(1024 * 1024)
+        .max_frame_size(16384)
+        .max_send_buffer_size(65536)
+        .max_concurrent_reset_streams(32)
+        .max_pending_accept_reset_streams(32)
+        .max_local_error_reset_streams(Some(32));
+    let mut connection =
+        tokio::time::timeout(limits.handshake_timeout, builder.handshake::<_, Bytes>(io))
+            .await
+            .map_err(|_| {
+                Error::Io(io::Error::new(
+                    io::ErrorKind::TimedOut,
+                    "h2 preface timeout",
+                ))
+            })?
+            .map_err(h2_error)?;
+    let mut tasks = JoinSet::new();
+    let mut requests = 0;
+    let scope = vp_core::task_scope::current_scope();
+    let drain = async {
+        match &scope {
+            Some(scope) => scope.draining().await,
+            None => std::future::pending::<()>().await,
+        }
+    };
+    tokio::pin!(drain);
+    let mut draining = false;
+    let mut idle_deadline = tokio::time::Instant::now() + limits.handshake_timeout;
+    loop {
+        if draining && tasks.is_empty() {
+            tokio::time::timeout(
+                limits.handshake_timeout,
+                std::future::poll_fn(|cx| connection.poll_closed(cx)),
+            )
+            .await
+            .map_err(|_| Error::Io(io::Error::new(io::ErrorKind::TimedOut, "h2 drain timeout")))?
+            .map_err(h2_error)?;
+            break;
+        }
+        tokio::select! {
+            _ = &mut drain, if !draining => {
+                draining = true;
+                connection.graceful_shutdown();
+            }
+            incoming = connection.accept() => {
+                let Some(incoming) = incoming else { break; };
+                let (request, mut response) = incoming.map_err(h2_error)?;
+                requests += 1;
+                let authority = request.uri().authority().map(|a| a.as_str()).unwrap_or("");
+                let path = request.uri().path_and_query().map(|p| p.as_str()).unwrap_or("");
+                let host_ok = request.headers().get_all(http::header::HOST).iter().count() <= 1
+                    && request.headers().get(http::header::HOST).is_none_or(|h| h.to_str().is_ok_and(|h| h.eq_ignore_ascii_case(authority)));
+                let matches = host_ok && route.matches(authority, path, true)
+                    && route.method.as_ref().is_none_or(|m| request.method() == m)
+                    && request.uri().scheme_str() == Some(if tls { "https" } else { "http" });
+                if draining {
+                    response.send_reset(h2::Reason::REFUSED_STREAM);
+                } else if !matches {
+                    let response_head = http::Response::builder().status(404).body(())
+                        .map_err(|_| Error::Proto("h2 rejection response"))?;
+                    response.send_response(response_head, true).map_err(h2_error)?;
+                } else if tasks.len() >= limits.max_h2_streams as usize {
+                    response.send_reset(h2::Reason::REFUSED_STREAM);
+                } else {
+                    let response_head = http::Response::builder().status(200)
+                        .header("cache-control", "no-store").body(())
+                        .map_err(|_| Error::Proto("h2 response"))?;
+                    let send = response.send_response(response_head, false).map_err(h2_error)?;
+                    let stream = H2Stream { recv: request.into_body(), send, pending: Bytes::new(), closed: false };
+                    // Owned and tracked: parent-drop cancellation plus managed drain.
+                    vp_core::task_scope::spawn_in(&mut tasks, handler(Box::new(stream)));
+                }
+                if requests >= limits.max_h2_requests {
+                    draining = true;
+                    connection.graceful_shutdown();
+                }
+                if tasks.is_empty() { idle_deadline = tokio::time::Instant::now() + limits.idle_timeout; }
+            }
+            completed = tasks.join_next(), if !tasks.is_empty() => {
+                if let Some(result) = completed {
+                    match result {
+                        Ok(Ok(())) => {},
+                        Ok(Err(_)) => {}, // a protocol failure is local to this stream
+                        Err(_) => return Err(Error::Proto("h2 stream task failed")),
+                    }
+                }
+                if tasks.is_empty() { idle_deadline = tokio::time::Instant::now() + limits.idle_timeout; }
+            }
+            _ = tokio::time::sleep_until(idle_deadline), if tasks.is_empty() && !draining => {
+                connection.abrupt_shutdown(h2::Reason::NO_ERROR);
+                // Drive the queued GOAWAY once, without permitting an unbounded drain.
+                let _ = tokio::time::timeout(limits.handshake_timeout, std::future::poll_fn(|cx| connection.poll_closed(cx))).await;
+                break;
+            }
+        }
+    }
+    // A peer connection close cancels the stream handlers, including stalled IO.
+    tasks.shutdown().await;
+    Ok(())
+}
+
+/// A real HTTP/2 DATA stream with per-stream flow control. Receive capacity is
+/// returned only after the application consumes bytes; writes are at most 16KiB.
+struct H2Stream {
+    recv: h2::RecvStream,
+    send: h2::SendStream<Bytes>,
+    pending: Bytes,
+    closed: bool,
+}
+impl AsyncRead for H2Stream {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        if buf.remaining() == 0 {
+            return Poll::Ready(Ok(()));
+        }
+        for _ in 0..32 {
+            if !self.pending.is_empty() {
+                let count = buf.remaining().min(self.pending.len());
+                buf.put_slice(&self.pending[..count]);
+                self.pending.advance(count);
+                self.recv
+                    .flow_control()
+                    .release_capacity(count)
+                    .map_err(h2_error)?;
+                return Poll::Ready(Ok(()));
+            }
+            match self.recv.poll_data(cx) {
+                Poll::Ready(Some(Ok(data))) => self.pending = data,
+                Poll::Ready(Some(Err(error))) => return Poll::Ready(Err(h2_error(error))),
+                Poll::Ready(None) => return Poll::Ready(Ok(())),
+                Poll::Pending => return Poll::Pending,
+            }
+        }
+        cx.waker().wake_by_ref();
+        Poll::Pending
+    }
+}
+impl AsyncWrite for H2Stream {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        if self.closed {
+            return Poll::Ready(Err(io::Error::new(
+                io::ErrorKind::BrokenPipe,
+                "h2 send closed",
+            )));
+        }
+        if buf.is_empty() {
+            return Poll::Ready(Ok(0));
+        }
+        let wanted = buf.len().min(16384);
+        self.send.reserve_capacity(wanted);
+        match self.send.poll_capacity(cx) {
+            Poll::Ready(Some(Ok(capacity))) if capacity > 0 => {
+                let count = wanted.min(capacity);
+                self.send
+                    .send_data(Bytes::copy_from_slice(&buf[..count]), false)
+                    .map_err(h2_error)?;
+                Poll::Ready(Ok(count))
+            }
+            Poll::Ready(Some(Ok(_))) => {
+                cx.waker().wake_by_ref();
+                Poll::Pending
+            }
+            Poll::Ready(Some(Err(error))) => Poll::Ready(Err(h2_error(error))),
+            Poll::Ready(None) => Poll::Ready(Err(io::Error::new(
+                io::ErrorKind::BrokenPipe,
+                "h2 stream reset",
+            ))),
+            Poll::Pending => Poll::Pending,
+        }
+    }
+    fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+        // send_data transfers ownership into h2's bounded send queue. The parent
+        // serve future continuously drives that queue; no detached driver exists.
+        Poll::Ready(Ok(()))
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+        if !self.closed {
+            self.send.send_data(Bytes::new(), true).map_err(h2_error)?;
+            self.closed = true;
+        }
+        Poll::Ready(Ok(()))
+    }
+}
