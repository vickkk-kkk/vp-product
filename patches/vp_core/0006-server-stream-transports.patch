+                        headers: vec![],
+                    },
+                )
+                .await
+                .unwrap(),
+            );
+        } else if mode == 3 {
+            io.write_all(b"GET /proxy HTTP/1.1\r\nHost: localhost\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\n").await.unwrap();
+            let mut head = Vec::new();
+            while !head.ends_with(b"\r\n\r\n") {
+                head.push(io.read_u8().await.unwrap());
+            }
+            assert!(head.starts_with(b"HTTP/1.1 101 "));
+        }
+        io.write_all(&vless_request(target_port, b"independent-payload"))
+            .await
+            .unwrap();
+        io.flush().await.unwrap();
+        let mut result = [0; 12];
+        tokio::time::timeout(Duration::from_secs(2), io.read_exact(&mut result))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(&result, b"\0\0TARGET-ACK");
+        let _ = io.shutdown().await;
+        drop(io);
+        target.await.unwrap();
+        stop(scope).await;
+    }
