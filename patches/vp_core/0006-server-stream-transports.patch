+    let (mut target_io, _) = tokio::time::timeout(Duration::from_secs(2), target.accept())
+        .await
+        .unwrap()
+        .unwrap();
+    let mut frames = Vec::new();
+    anytls_frame(3, 1, &[], &mut frames);
+    anytls_frame(8, 0, &[], &mut frames);
+    io.write_all(&frames).await.unwrap();
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(2), target_io.read_u8())
+            .await
+            .unwrap()
+            .unwrap_err()
+            .kind(),
+        std::io::ErrorKind::UnexpectedEof
+    );
+    loop {
+        let cmd = io.read_u8().await.unwrap();
+        let _sid = io.read_u32().await.unwrap();
+        let len = io.read_u16().await.unwrap();
+        let mut body = vec![0; len as usize];
+        io.read_exact(&mut body).await.unwrap();
+        if cmd == 9 {
+            assert!(body.is_empty());
+            break;
