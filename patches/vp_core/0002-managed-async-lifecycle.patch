diff --git a/crates/vp-app/src/managed.rs b/crates/vp-app/src/managed.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bc3e92a805e2af12edf5e54a4f645e19f2634bc1
--- /dev/null
+++ b/crates/vp-app/src/managed.rs
@@ -0,0 +1,239 @@
+//! Managed app startup/stop: all scoped ingress, work and background tasks are
+//! owned by one application generation. Readiness here means bound + live accept
+//! tasks only, not authentication/forwarding/OS tunnel certification.
+use crate::App;
+use std::path::Path;
+use std::sync::Arc;
+use std::time::Duration;
+use vp_common::{Error, Result};
+use vp_core::task_scope::{ShutdownReport, Snapshot, TaskScope};
+
+pub struct ManagedApp {
+    app: Arc<App>,
+    scope: Arc<TaskScope>,
+}
+struct StartupGuard {
+    scope: Arc<TaskScope>,
+    armed: bool,
+}
+impl Drop for StartupGuard {
+    fn drop(&mut self) {
+        if self.armed {
+            self.scope.cancel_all();
+        }
+    }
+}
+impl ManagedApp {
+    pub async fn start(
+        text: &str,
+        format: vp_config::Format,
+        base_dir: &Path,
+        startup_timeout: Duration,
+        cleanup_timeout: Duration,
+    ) -> Result<Self> {
+        Self::start_operation(
+            App::start(text, format, base_dir, true),
+            startup_timeout,
+            cleanup_timeout,
+        )
+        .await
+    }
+    async fn start_operation<F: std::future::Future<Output = Result<Arc<App>>>>(
+        operation: F,
+        startup_timeout: Duration,
+        cleanup_timeout: Duration,
+    ) -> Result<Self> {
+        let scope = TaskScope::new();
+        let mut guard = StartupGuard {
+            scope: scope.clone(),
+            armed: true,
+        };
+        let result = scope
+            .run(tokio::time::timeout(startup_timeout, operation))
+            .await;
+        let app = match result {
+            Ok(Ok(app)) => app,
+            result => {
+                let cleanup = scope.shutdown(Duration::ZERO, cleanup_timeout).await;
+                if cleanup.remaining_tasks != 0 {
+                    return Err(Error::Other("managed startup cleanup timed out".into()));
+                }
+                return match result {
+                    Ok(Err(error)) => Err(error),
+                    _ => Err(Error::Other("managed startup timed out".into())),
+                };
+            }
+        };
+        // Let immediately failing accept tasks publish their exit before ready.
+        tokio::task::yield_now().await;
+        let managed = Self { app, scope };
+        if !managed.listeners_ready() {
+            let _ = managed.shutdown(Duration::ZERO, cleanup_timeout).await;
+            return Err(Error::Other(
+                "declared listener has no live managed accept task".into(),
+            ));
+        }
+        guard.armed = false;
+        Ok(managed)
+    }
+    pub fn app(&self) -> &Arc<App> {
+        &self.app
+    }
+    pub fn task_snapshot(&self) -> Snapshot {
+        self.scope.snapshot()
+    }
+    pub fn listeners_ready(&self) -> bool {
+        let observed = self.scope.snapshot();
+        observed.healthy()
+            && !self.app.listen_ports.is_empty()
+            && self
+                .app
+                .listen_ports
+                .iter()
+                .all(|(tag, _)| observed.listeners.contains(tag))
+    }
+    pub async fn shutdown(
+        &self,
+        drain_timeout: Duration,
+        cleanup_timeout: Duration,
+    ) -> ShutdownReport {
+        self.scope.shutdown(drain_timeout, cleanup_timeout).await
+    }
+}
+impl Drop for ManagedApp {
+    fn drop(&mut self) {
+        self.scope.cancel_all();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    fn config(port: u16) -> String {
+        format!("mixed-port: {port}\nallow-lan: false\nrules: ['MATCH,DIRECT']\n")
+    }
+    async fn start(config: &str) -> Result<ManagedApp> {
+        ManagedApp::start(
+            config,
+            vp_config::Format::Yaml,
+            &std::env::temp_dir(),
+            Duration::from_secs(2),
+            Duration::from_secs(1),
+        )
+        .await
+    }
+    #[tokio::test]
+    async fn ready_then_stop_releases_listening_port() {
+        let app = start(&config(0)).await.unwrap();
+        assert!(app.listeners_ready());
+        let port = app.app().listen_ports[0].1;
+        let report = app
+            .shutdown(Duration::from_millis(50), Duration::from_secs(1))
+            .await;
+        assert_eq!(report.remaining_tasks, 0);
+        assert!(!app.listeners_ready());
+        let _rebound = tokio::net::TcpListener::bind(("127.0.0.1", port))
+            .await
+            .unwrap();
+    }
+    #[tokio::test]
+    async fn partial_bind_failure_cleans_already_started_listener() {
+        let probe = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let first = probe.local_addr().unwrap().port();
+        drop(probe);
+        let occupied = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let config = format!(
+            "mixed-port: {first}\nlisteners:\n - name: failed\n   type: vless\n   port: {}\n   users: [00000000-0000-0000-0000-000000000001]\n",
+            occupied.local_addr().unwrap().port()
+        );
+        assert!(start(&config).await.is_err());
+        let _rebound = tokio::net::TcpListener::bind(("127.0.0.1", first))
+            .await
+            .unwrap();
+    }
+    #[tokio::test]
+    async fn idle_handshake_is_forcibly_closed_after_drain_deadline() {
+        let app = start(&config(0)).await.unwrap();
+        let port = app.app().listen_ports[0].1;
+        let mut client = tokio::net::TcpStream::connect(("127.0.0.1", port))
+            .await
+            .unwrap();
+        client.write_all(&[5]).await.unwrap();
+        // Ensure the accepted connection is registered rather than racing shutdown.
+        tokio::time::timeout(Duration::from_secs(1), async {
+            while app.task_snapshot().work == 0 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        let report = app
+            .shutdown(Duration::from_millis(10), Duration::from_secs(1))
+            .await;
+        assert!(!report.drained);
+        assert_eq!(report.remaining_tasks, 0);
+        let mut byte = [0];
+        let result = tokio::time::timeout(Duration::from_secs(1), client.read(&mut byte))
+            .await
+            .unwrap();
+        assert!(matches!(result, Ok(0) | Err(_)));
+    }
+    #[tokio::test]
+    async fn drop_aborts_listener_without_explicit_stop() {
+        let app = start(&config(0)).await.unwrap();
+        let port = app.app().listen_ports[0].1;
+        drop(app);
+        tokio::time::timeout(Duration::from_secs(1), async {
+            loop {
+                if tokio::net::TcpListener::bind(("127.0.0.1", port))
+                    .await
+                    .is_ok()
+                {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+    }
+    #[tokio::test]
+    async fn canceled_start_future_releases_already_bound_listener() {
+        let (bound, observed) = tokio::sync::oneshot::channel();
+        let start = tokio::spawn(async move {
+            let operation = async {
+                let app = App::start(
+                    &config(0),
+                    vp_config::Format::Yaml,
+                    &std::env::temp_dir(),
+                    true,
+                )
+                .await?;
+                bound.send(app.listen_ports[0].1).unwrap();
+                // Test-only delayed post-bind initialization under the exact same
+                // production StartupGuard, not a fake running proxy.
+                std::future::pending::<()>().await;
+                Ok(app)
+            };
+            ManagedApp::start_operation(operation, Duration::from_secs(30), Duration::from_secs(1))
+                .await
+        });
+        let port = observed.await.unwrap();
+        start.abort();
+        assert!(matches!(start.await, Err(error) if error.is_cancelled()));
+        tokio::time::timeout(Duration::from_secs(1), async {
+            loop {
+                if tokio::net::TcpListener::bind(("127.0.0.1", port))
+                    .await
+                    .is_ok()
+                {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+    }
+}
