+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    #[tokio::test]
+    async fn nested_spawn_inherits_scope_and_is_canceled() {
+        let scope = TaskScope::new();
+        let child_started = Arc::new(Notify::new());
+        let started = child_started.clone();
+        scope
+            .run(async {
+                spawn(async move {
+                    spawn(std::future::pending::<()>());
+                    started.notify_one();
+                    std::future::pending::<()>().await
+                });
+            })
+            .await;
+        child_started.notified().await;
+        assert_eq!(scope.snapshot().work, 2);
+        let result = scope.shutdown(Duration::ZERO, Duration::from_secs(1)).await;
+        assert_eq!(result.remaining_tasks, 0);
+        assert!(result.forced_tasks > 0);
+    }
+    #[tokio::test]
+    async fn canceled_before_first_poll_does_not_leak_registration() {
+        let scope = TaskScope::new();
+        scope
+            .run(async {
+                let handle = spawn(std::future::pending::<()>());
+                handle.abort();
+            })
+            .await;
+        let result = scope.shutdown(Duration::ZERO, Duration::from_secs(1)).await;
+        assert_eq!(result.remaining_tasks, 0);
+    }
+    #[tokio::test]
+    async fn refused_task_is_never_polled() {
+        let scope = TaskScope::new();
+        scope.cancel_all();
+        let polled = Arc::new(AtomicBool::new(false));
+        let flag = polled.clone();
+        let task = scope
+            .run(async {
+                spawn(async move {
+                    flag.store(true, Ordering::SeqCst);
+                })
+            })
+            .await;
+        assert!(task.await.unwrap_err().is_cancelled());
+        assert!(!polled.load(Ordering::SeqCst));
+    }
+    #[tokio::test]
+    async fn drain_allows_existing_work_to_complete() {
+        let scope = TaskScope::new();
+        scope
+            .run(async {
+                spawn(async { tokio::time::sleep(Duration::from_millis(10)).await });
+            })
+            .await;
+        let result = scope
+            .shutdown(Duration::from_secs(1), Duration::from_secs(1))
+            .await;
+        assert!(result.drained);
+        assert_eq!(result.forced_tasks, 0);
+        assert_eq!(result.remaining_tasks, 0);
+    }
+    #[tokio::test]
+    async fn unexpected_listener_exit_is_not_healthy() {
+        let scope = TaskScope::new();
+        scope
+            .run(async {
+                spawn_listener("test", async {}).await.unwrap();
+            })
+            .await;
+        assert!(!scope.snapshot().healthy());
+        assert_eq!(scope.snapshot().unexpected_listener_exits, 1);
+    }
+    #[tokio::test]
+    async fn panicking_task_is_observed_and_registry_is_cleaned() {
+        let scope = TaskScope::new();
+        scope
+            .run(async {
+                assert!(spawn(async { panic!("injected panic") }).await.is_err());
+            })
+            .await;
+        assert_eq!(scope.snapshot().panics, 1);
+        assert_eq!(scope.snapshot().task_count(), 0);
+    }
+    #[tokio::test]
+    async fn joinset_child_cleanup_is_tracked_until_future_drop() {
+        let scope = TaskScope::new();
+        scope
+            .run(async {
+                let mut tasks = tokio::task::JoinSet::new();
+                spawn_in(&mut tasks, std::future::pending::<()>());
+                assert_eq!(scope.snapshot().work, 1);
+                drop(tasks);
+            })
+            .await;
+        let report = scope.shutdown(Duration::ZERO, Duration::from_secs(1)).await;
+        assert_eq!(report.remaining_tasks, 0);
+    }
+    #[tokio::test]
+    async fn protocol_driver_receives_drain_before_forced_cancellation() {
+        let scope = TaskScope::new();
+        scope
+            .run(async {
+                let captured = current_scope().unwrap();
+                spawn(async move {
+                    captured.draining().await;
+                });
+            })
+            .await;
+        let report = scope
+            .shutdown(Duration::from_secs(1), Duration::from_secs(1))
+            .await;
+        assert!(report.drained);
+        assert_eq!(report.forced_tasks, 0);
+        assert_eq!(report.remaining_tasks, 0);
+        // Also returns immediately for a listener registering after drain begins.
+        scope.draining().await;
+    }
+}
