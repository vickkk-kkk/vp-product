diff --git a/crates/vp-core/src/task_scope.rs b/crates/vp-core/src/task_scope.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ca07a65627af6ca60b60b08e9fbf485fc47f9d7c
--- /dev/null
+++ b/crates/vp-core/src/task_scope.rs
@@ -0,0 +1,477 @@
+//! Owned async task lifetime for a managed application generation.
+//!
+//! No global singleton: task-local inheritance follows only tracked spawn calls.
+//! Unmanaged legacy callers retain normal Tokio behavior. External runtime/library
+//! tasks still require their owning runtime to be shut down at the host boundary.
+use std::collections::HashMap;
+use std::future::Future;
+use std::sync::{Arc, Mutex, MutexGuard};
+use std::time::Duration;
+use tokio::sync::Notify;
+use tokio::task::{AbortHandle, JoinHandle};
+
+tokio::task_local! { static CURRENT: Arc<TaskScope>; }
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Phase {
+    Running,
+    Draining,
+    Canceling,
+    Stopped,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum Role {
+    Listener(String),
+    Work,
+    Background,
+}
+struct Entry {
+    role: Role,
+    abort: AbortHandle,
+}
+struct State {
+    phase: Phase,
+    next: u64,
+    tasks: HashMap<u64, Entry>,
+    panics: u64,
+    unexpected_listener_exits: u64,
+    refused_tasks: u64,
+}
+#[derive(Clone, Debug)]
+pub struct Snapshot {
+    pub phase: Phase,
+    pub listeners: Vec<String>,
+    pub work: usize,
+    pub background: usize,
+    pub panics: u64,
+    pub unexpected_listener_exits: u64,
+    pub refused_tasks: u64,
+}
+impl Snapshot {
+    pub fn task_count(&self) -> usize {
+        self.listeners.len() + self.work + self.background
+    }
+    pub fn healthy(&self) -> bool {
+        self.phase == Phase::Running
+            && self.panics == 0
+            && self.unexpected_listener_exits == 0
+            && self.refused_tasks == 0
+    }
+}
+#[derive(Clone, Debug)]
+pub struct ShutdownReport {
+    pub drained: bool,
+    pub forced_tasks: usize,
+    pub remaining_tasks: usize,
+    pub panics: u64,
+}
+
+pub struct TaskScope {
+    state: Mutex<State>,
+    changed: Notify,
+}
+impl TaskScope {
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self {
+            state: Mutex::new(State {
+                phase: Phase::Running,
+                next: 0,
+                tasks: HashMap::new(),
+                panics: 0,
+                unexpected_listener_exits: 0,
+                refused_tasks: 0,
+            }),
+            changed: Notify::new(),
+        })
+    }
+    fn lock(&self) -> MutexGuard<'_, State> {
+        self.state.lock().unwrap_or_else(|error| error.into_inner())
+    }
+    pub async fn run<F: Future>(self: &Arc<Self>, future: F) -> F::Output {
+        CURRENT.scope(self.clone(), future).await
+    }
+    pub fn snapshot(&self) -> Snapshot {
+        let state = self.lock();
+        let mut snapshot = Snapshot {
+            phase: state.phase,
+            listeners: Vec::new(),
+            work: 0,
+            background: 0,
+            panics: state.panics,
+            unexpected_listener_exits: state.unexpected_listener_exits,
+            refused_tasks: state.refused_tasks,
+        };
+        for entry in state.tasks.values() {
+            match &entry.role {
+                Role::Listener(tag) => snapshot.listeners.push(tag.clone()),
+                Role::Work => snapshot.work += 1,
+                Role::Background => snapshot.background += 1,
+            }
+        }
+        snapshot.listeners.sort();
+        snapshot
+    }
+    fn spawn<F>(self: &Arc<Self>, role: Role, future: F) -> JoinHandle<F::Output>
+    where
+        F: Future + Send + 'static,
+        F::Output: Send + 'static,
+    {
+        let mut state = self.lock();
+        let allowed =
+            state.phase == Phase::Running || (state.phase == Phase::Draining && role == Role::Work);
+        if !allowed || state.next == u64::MAX || state.tasks.len() >= 65_536 {
+            state.refused_tasks = state.refused_tasks.saturating_add(1);
+            // Never poll a refused future, including when a worker runs immediately.
+            let handle = tokio::spawn(async move {
+                drop(future);
+                std::future::pending::<F::Output>().await
+            });
+            handle.abort();
+            return handle;
+        }
+        let id = state.next;
+        state.next += 1;
+        let guard = TaskGuard {
+            scope: self.clone(),
+            id,
+            role: role.clone(),
+        };
+        let scope = self.clone();
+        let handle = tokio::spawn(async move {
+            let _guard = guard; // captured even if canceled before first poll
+            scope.run(future).await
+        });
+        // Keep the lock through registration: completion/cancel cannot race insertion.
+        state.tasks.insert(
+            id,
+            Entry {
+                role,
+                abort: handle.abort_handle(),
+            },
+        );
+        handle
+    }
+    fn spawn_in<F>(
+        self: &Arc<Self>,
+        tasks: &mut tokio::task::JoinSet<F::Output>,
+        future: F,
+    ) -> AbortHandle
+    where
+        F: Future + Send + 'static,
+        F::Output: Send + 'static,
+    {
+        let mut state = self.lock();
+        if !matches!(state.phase, Phase::Running | Phase::Draining)
+            || state.next == u64::MAX
+            || state.tasks.len() >= 65_536
+        {
+            state.refused_tasks = state.refused_tasks.saturating_add(1);
+            let abort = tasks.spawn(async move {
+                drop(future);
+                std::future::pending::<F::Output>().await
+            });
+            abort.abort();
+            return abort;
+        }
+        let id = state.next;
+        state.next += 1;
+        let guard = TaskGuard {
+            scope: self.clone(),
+            id,
+            role: Role::Work,
+        };
+        let scope = self.clone();
+        let abort = tasks.spawn(async move {
+            let _guard = guard;
+            scope.run(future).await
+        });
+        state.tasks.insert(
+            id,
+            Entry {
+                role: Role::Work,
+                abort: abort.clone(),
+            },
+        );
+        abort
+    }
+    pub fn cancel_all(&self) {
+        let mut state = self.lock();
+        if state.phase != Phase::Stopped {
+            state.phase = Phase::Canceling;
+        }
+        for entry in state.tasks.values() {
+            entry.abort.abort();
+        }
+        self.changed.notify_waiters();
+    }
+    fn stop_ingress(&self) {
+        let mut state = self.lock();
+        if state.phase == Phase::Running {
+            state.phase = Phase::Draining;
+        }
+        for entry in state.tasks.values() {
+            if entry.role != Role::Work {
+                entry.abort.abort();
+            }
+        }
+        drop(state);
+        self.changed.notify_waiters();
+    }
+    /// Notify protocol drivers (for example HTTP/2 GOAWAY) before waiting for
+    /// established work to drain. Cancellation also satisfies this notification.
+    pub async fn draining(&self) {
+        loop {
+            let changed = self.changed.notified();
+            tokio::pin!(changed);
+            changed.as_mut().enable();
+            if self.lock().phase != Phase::Running {
+                return;
+            }
+            changed.await;
+        }
+    }
+    async fn wait_empty(&self, timeout: Duration) -> bool {
+        let wait = async {
+            loop {
+                // Register before checking, avoiding completion between check/wait.
+                let changed = self.changed.notified();
+                tokio::pin!(changed);
+                changed.as_mut().enable();
+                if self.lock().tasks.is_empty() {
+                    return;
+                }
+                changed.await;
+            }
+        };
+        tokio::time::timeout(timeout, wait).await.is_ok()
+    }
+    /// Stop accept/background tasks first, give established work a bounded drain,
+    /// then abort remaining tasks and await their destructors within cleanup_timeout.
+    pub async fn shutdown(
+        &self,
+        drain_timeout: Duration,
+        cleanup_timeout: Duration,
+    ) -> ShutdownReport {
+        self.stop_ingress();
+        let drained = self.wait_empty(drain_timeout).await;
+        let forced_tasks = if drained {
+            0
+        } else {
+            self.snapshot().task_count()
+        };
+        self.cancel_all();
+        let _ = self.wait_empty(cleanup_timeout).await;
+        let mut state = self.lock();
+        let remaining_tasks = state.tasks.len();
+        if remaining_tasks == 0 {
+            state.phase = Phase::Stopped;
+        }
+        ShutdownReport {
+            drained,
+            forced_tasks,
+            remaining_tasks,
+            panics: state.panics,
+        }
+    }
+}
+struct TaskGuard {
+    scope: Arc<TaskScope>,
+    id: u64,
+    role: Role,
+}
+impl Drop for TaskGuard {
+    fn drop(&mut self) {
+        let mut state = self.scope.lock();
+        state.tasks.remove(&self.id);
+        if std::thread::panicking() {
+            state.panics = state.panics.saturating_add(1);
+        }
+        if matches!(&self.role, Role::Listener(_)) && state.phase == Phase::Running {
+            state.unexpected_listener_exits = state.unexpected_listener_exits.saturating_add(1);
+        }
+        drop(state);
+        self.scope.changed.notify_waiters();
+    }
+}
+fn spawn_role<F>(role: Role, future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    match CURRENT.try_with(Arc::clone) {
+        Ok(scope) => scope.spawn(role, future),
+        Err(_) => tokio::spawn(future),
+    }
+}
+/// Read-only lifecycle context for protocol-specific graceful shutdown.
+pub fn current_scope() -> Option<Arc<TaskScope>> {
+    CURRENT.try_with(Arc::clone).ok()
+}
+/// Capture at future creation, so JoinSet/custom executors can preserve scope.
+pub fn inherit<F: Future>(future: F) -> impl Future<Output = F::Output> {
+    let scope = CURRENT.try_with(Arc::clone).ok();
+    async move {
+        match scope {
+            Some(scope) => scope.run(future).await,
+            None => future.await,
+        }
+    }
+}
+pub fn spawn<F>(future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    spawn_role(Role::Work, future)
+}
+/// JoinSet ownership plus scope tracking: shutdown observes actual child future
+/// destruction instead of assuming JoinSet::drop has already finished cleanup.
+pub fn spawn_in<F>(tasks: &mut tokio::task::JoinSet<F::Output>, future: F) -> AbortHandle
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    match CURRENT.try_with(Arc::clone) {
+        Ok(scope) => scope.spawn_in(tasks, future),
+        Err(_) => tasks.spawn(future),
+    }
+}
+pub fn spawn_listener<F>(tag: impl Into<String>, future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    spawn_role(Role::Listener(tag.into()), future)
+}
+pub fn spawn_background<F>(future: F) -> JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    spawn_role(Role::Background, future)
+}
