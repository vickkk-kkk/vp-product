+struct CredentialVerifier {
+    username: [u8; 32],
+    password: [u8; 32],
+}
+enum Socks5Authentication {
+    Anonymous,
+    UsernamePassword(Vec<CredentialVerifier>),
+}
+impl Socks5Authentication {
+    fn from_users(users: &[(String, String)]) -> Result<Self> {
+        use sha2::{Digest, Sha256};
+        if users.is_empty() || users.len() > 128 {
+            return Err(Error::Config("socks5 requires 1..128 users".into()));
+        }
+        let mut names = std::collections::HashSet::new();
+        let mut values = Vec::new();
+        for (username, password) in users {
+            if !(1..=255).contains(&username.len())
+                || !(1..=255).contains(&password.len())
+                || !names.insert(username)
+            {
+                return Err(Error::Config(
+                    "invalid or duplicate SOCKS5 credential".into(),
+                ));
+            }
+            values.push(CredentialVerifier {
+                username: Sha256::digest(username.as_bytes()).into(),
+                password: Sha256::digest(password.as_bytes()).into(),
+            });
+        }
+        Ok(Self::UsernamePassword(values))
+    }
+}
+async fn authenticate<S: AsyncRead + AsyncWrite + Unpin>(
+    stream: &mut S,
+    policy: &Socks5Authentication,
+) -> Result<Option<usize>> {
+    use sha2::{Digest, Sha256};
+    let mut head = [0; 2];
+    stream.read_exact(&mut head).await?;
+    if head[0] != 5 || head[1] == 0 {
+        return Err(Error::Proto("invalid SOCKS5 greeting"));
+    }
+    let mut methods = [0; 255];
+    stream.read_exact(&mut methods[..head[1] as usize]).await?;
+    let method = match policy {
+        Socks5Authentication::Anonymous => 0,
+        Socks5Authentication::UsernamePassword(_) => 2,
+    };
+    if !methods[..head[1] as usize].contains(&method) {
+        stream.write_all(&[5, 255]).await?;
+        return Err(Error::Proto("SOCKS5 authentication method not offered"));
+    }
+    stream.write_all(&[5, method]).await?;
+    let Socks5Authentication::UsernamePassword(users) = policy else {
+        return Ok(None);
+    };
+    stream.read_exact(&mut head).await?;
+    if head[0] != 1 || head[1] == 0 {
+        stream.write_all(&[1, 1]).await?;
+        return Err(Error::Proto("invalid SOCKS5 authentication frame"));
+    }
+    let mut username = [0; 255];
+    stream.read_exact(&mut username[..head[1] as usize]).await?;
+    let username_hash: [u8; 32] = Sha256::digest(&username[..head[1] as usize]).into();
+    let length = stream.read_u8().await?;
+    if length == 0 {
+        stream.write_all(&[1, 1]).await?;
+        return Err(Error::Proto("invalid SOCKS5 authentication frame"));
+    }
+    let mut password = [0; 255];
+    stream.read_exact(&mut password[..length as usize]).await?;
+    let password_hash: [u8; 32] = Sha256::digest(&password[..length as usize]).into();
+    // Reuse the core's ring-HMAC equality oracle; raw secrets/verifiers are never
+    // placed in diagnostics. Best-effort stack scrub is not a process-compromise guarantee.
+    username.fill(0);
+    password.fill(0);
+    let mut selected = None;
+    for (index, user) in users.iter().enumerate() {
+        let name_matches = crate::tuic::credentials_equal(&user.username, &username_hash);
+        let password_matches = crate::tuic::credentials_equal(&user.password, &password_hash);
+        if name_matches & password_matches {
+            selected = Some(index);
+        }
+    }
+    stream
+        .write_all(&[1, if selected.is_some() { 0 } else { 1 }])
+        .await?;
+    selected
+        .map(Some)
+        .ok_or(Error::Proto("SOCKS5 authentication rejected"))
+}
+
+async fn authenticate_bounded<S: AsyncRead + AsyncWrite + Unpin>(
+    stream: &mut S,
+    policy: &Socks5Authentication,
+) -> Result<Option<usize>> {
+    tokio::time::timeout(Duration::from_secs(10), authenticate(stream, policy))
+        .await
+        .map_err(|_| Error::Proto("socks5 authentication timed out"))?
+}
+fn udp_client_endpoint(
+    dst: &DstAddr,
+    src: std::net::SocketAddr,
+) -> Result<Option<std::net::SocketAddr>> {
+    match &dst.host {
+        vp_common::Host::Ip(ip) if ip.is_unspecified() || *ip == src.ip() => {
+            Ok((dst.port != 0).then_some(std::net::SocketAddr::new(src.ip(), dst.port)))
+        }
+        _ => Err(Error::Proto("socks5 UDP client endpoint mismatch")),
+    }
+}
