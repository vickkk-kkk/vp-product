+#[cfg(test)]
+mod authenticated_tests {
+    use super::*;
+
+    // Ephemeral synthetic fixtures: these are not stored product credentials.
+    fn policy() -> Socks5Authentication {
+        Socks5Authentication::from_users(&[("fixture-user".into(), "fixture-password".into())])
+            .unwrap()
+    }
+    async fn exchange(
+        bytes: &[u8],
+        policy: Socks5Authentication,
+    ) -> (Result<Option<usize>>, Vec<u8>) {
+        let (mut server, mut client) = tokio::io::duplex(1024);
+        client.write_all(bytes).await.unwrap();
+        client.shutdown().await.unwrap();
+        let result = authenticate(&mut server, &policy).await;
+        drop(server);
+        let mut reply = Vec::new();
+        client.read_to_end(&mut reply).await.unwrap();
+        (result, reply)
+    }
+    fn frame(username: &[u8], password: &[u8]) -> Vec<u8> {
+        let mut out = vec![5, 2, 0, 2, 1, username.len() as u8];
+        out.extend(username);
+        out.push(password.len() as u8);
+        out.extend(password);
+        out
+    }
+    #[tokio::test]
+    async fn authenticated_policy_never_downgrades_to_anonymous() {
+        let (result, reply) = exchange(&[5, 1, 0], policy()).await;
+        assert!(result.is_err());
+        assert_eq!(reply, [5, 255]);
+        let (result, reply) = exchange(&[5, 1, 2], Socks5Authentication::Anonymous).await;
+        assert!(result.is_err());
+        assert_eq!(reply, [5, 255]);
+    }
+    #[tokio::test]
+    async fn exact_username_and_password_select_user_before_request_is_read() {
+        let (mut server, mut client) = tokio::io::duplex(1024);
+        let mut bytes = frame(b"fixture-user", b"fixture-password");
+        bytes.push(42); // sentinel stands for a request not consumed by authentication
+        client.write_all(&bytes).await.unwrap();
+        assert_eq!(authenticate(&mut server, &policy()).await.unwrap(), Some(0));
+        assert_eq!(server.read_u8().await.unwrap(), 42);
+        let mut reply = [0; 4];
+        client.read_exact(&mut reply).await.unwrap();
+        assert_eq!(reply, [5, 2, 1, 0]);
+    }
+    #[tokio::test]
+    async fn wrong_and_retired_credentials_fail_closed() {
+        for (username, password) in [
+            (b"wrong".as_slice(), b"fixture-password".as_slice()),
+            (b"fixture-user", b"retired-password"),
+        ] {
+            let (result, reply) = exchange(&frame(username, password), policy()).await;
+            assert!(result.is_err());
+            assert_eq!(reply, [5, 2, 1, 1]);
+        }
+    }
+    #[tokio::test]
+    async fn malformed_empty_and_truncated_frames_cannot_authenticate() {
+        for bytes in [
+            vec![4, 1, 2],
+            vec![5, 0],
+            vec![5, 1, 2, 2, 1],
+            vec![5, 1, 2, 1, 0],
+            vec![5, 1, 2, 1, 1, b'u', 0],
+            vec![5, 1, 2, 1, 4, b'u'],
+        ] {
+            let (result, _) = exchange(&bytes, policy()).await;
+            assert!(result.is_err());
+        }
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn authentication_deadline_is_bounded_for_a_silent_client() {
+        let (_client, mut server) = tokio::io::duplex(1024);
+        assert!(matches!(
+            authenticate_bounded(&mut server, &policy()).await,
+            Err(Error::Proto("socks5 authentication timed out"))
+        ));
+    }
+    #[test]
+    fn udp_endpoint_validation_precedes_socket_allocation() {
+        let peer = "127.0.0.1:35000".parse().unwrap();
+        assert_eq!(
+            udp_client_endpoint(&DstAddr::ip([0, 0, 0, 0].into(), 0), peer).unwrap(),
+            None
+        );
+        assert_eq!(
+            udp_client_endpoint(&DstAddr::ip([127, 0, 0, 1].into(), 35001), peer).unwrap(),
+            Some("127.0.0.1:35001".parse().unwrap())
+        );
+        assert!(udp_client_endpoint(&DstAddr::ip([127, 0, 0, 2].into(), 35001), peer).is_err());
+        assert!(
+            udp_client_endpoint(
+                &DstAddr {
+                    host: vp_common::Host::Domain("localhost".into()),
+                    port: 35001
+                },
+                peer
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn invalid_configuration_fails_before_any_bind() {
+        for users in [
+            vec![],
+            vec![(String::new(), "p".into())],
+            vec![("u".into(), String::new())],
+            vec![("u".repeat(256), "p".into())],
+            vec![("u".into(), "a".into()), ("u".into(), "b".into())],
+        ] {
+            assert!(
+                Socks5Inbound::new_authenticated("127.0.0.1".into(), 0, "fixture", &users).is_err()
+            );
+        }
+    }
+}
