+    async fn lazy_stream_handles_one_byte_writes_and_small_response_reads() {
+        let (client, mut peer) = tokio::io::duplex(1);
+        let outbound = VlessOutbound {
+            name: "partial".into(),
+            server: "127.0.0.1".into(),
+            port: 9,
