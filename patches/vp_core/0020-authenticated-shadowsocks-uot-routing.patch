+#[tokio::test]
+async fn authenticated_ss_uot_match_reject_precedes_domain_dns_and_target_io() {
+    for destination in [
+        DstAddr::new("blocked.test", 53),
+        DstAddr::new("127.0.0.1", 5353),
+    ] {
+        let dns = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let host = Arc::new(DenyHost {
+            calls: 0.into(),
+            dns: dns.local_addr().unwrap(),
+        });
+        let scope = TaskScope::with_host_network(
+            vp_core::task_scope::DestinationPolicy::Unrestricted,
+            Some(host.clone()),
+        );
+        let router = probe();
+        router.selected.store(2, Ordering::SeqCst);
+        let port = scope.run(server("ss", router.clone())).await;
+        let magic = vp_protocol::uot::magic_dst();
+        let out = outbound("ss", port);
+        let session = Session::new_tcp("client".into(), None, magic.clone());
+        let mut stream = out.connect_stream(&session, &magic).await.unwrap();
+        stream
+            .write_all(&vp_protocol::uot::encode_frame(&destination, b"blocked"))
+            .await
+            .unwrap();
+        stream.flush().await.unwrap();
+        assert!(!matches!(
+            timeout(Duration::from_secs(1), stream.read_u8()).await,
+            Ok(Ok(_))
+        ));
+        let seen = router.seen.lock().unwrap().clone();
+        assert_eq!(seen.len(), 1);
+        assert_eq!(seen[0].dst, destination);
+        check_metadata(&router, "ss", port, Network::Udp);
+        assert_eq!(
+            host.calls.load(Ordering::SeqCst),
+            0,
+            "REJECT must precede DNS/socket creation"
+        );
+        assert!(
+            timeout(Duration::from_millis(20), dns.recv_from(&mut [0; 64]))
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            scope
+                .shutdown(Duration::ZERO, Duration::from_secs(1))
+                .await
+                .remaining_tasks,
+            0
+        );
+    }
+}
