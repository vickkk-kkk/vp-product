+#[tokio::test]
+async fn authenticated_ss_uot_routes_each_target_and_selection_without_magic_dns() {
+    let dns = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+    let host = Arc::new(DenyHost {
+        calls: 0.into(),
+        dns: dns.local_addr().unwrap(),
+    });
+    let scope = TaskScope::with_host_network(
+        vp_core::task_scope::DestinationPolicy::Unrestricted,
+        Some(host.clone()),
+    );
+    let router = probe();
+    let port = scope.run(server("ss", router.clone())).await;
+    let first = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+    let second = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+    let out = outbound("ss", port);
+    let magic = vp_protocol::uot::magic_dst();
+    let session = Session::new_tcp("client".into(), None, magic.clone());
+    let mut stream = out.connect_stream(&session, &magic).await.unwrap();
+    // Same authenticated connection, distinct targets, then a changed selection
+    // for the original target. None may use the real observer sockets directly.
+    for (selected, target) in [
+        (0, first.local_addr().unwrap()),
+        (0, second.local_addr().unwrap()),
+        (1, first.local_addr().unwrap()),
+    ] {
+        router.selected.store(selected, Ordering::SeqCst);
+        let destination = DstAddr::ip(target.ip(), target.port());
+        stream
+            .write_all(&vp_protocol::uot::encode_frame(&destination, b"uot-probe"))
+            .await
+            .unwrap();
+        stream.flush().await.unwrap();
+        let (source, bytes) = timeout(
+            Duration::from_secs(2),
+            vp_protocol::uot::read_frame(&mut stream),
+        )
+        .await
+        .unwrap()
+        .unwrap();
+        assert_eq!(source, destination);
+        assert_eq!(bytes.as_ref(), &[selected as u8 + 1]);
+    }
+    // Shared SOCKS parsing intentionally normalizes ASCII case. A raw uppercase
+    // v1 control token must therefore enter the authenticated bridge, not DNS.
+    let uppercase = DstAddr {
+        host: vp_common::Host::Domain("SP.UDP-OVER-TCP.ARPA".into()),
+        port: 443,
+    };
+    let mut normalized = out.connect_stream(&session, &uppercase).await.unwrap();
+    let target = first.local_addr().unwrap();
+    let destination = DstAddr::ip(target.ip(), target.port());
+    normalized
+        .write_all(&vp_protocol::uot::encode_frame(&destination, b"normalized"))
+        .await
+        .unwrap();
+    normalized.flush().await.unwrap();
+    let (source, bytes) = timeout(
+        Duration::from_secs(2),
+        vp_protocol::uot::read_frame(&mut normalized),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(source, destination);
+    assert_eq!(bytes.as_ref(), &[2]);
+    assert_eq!(router.seen.lock().unwrap().len(), 4);
+    check_metadata(&router, "ss", port, Network::Udp);
+    assert!(
+        router
+            .seen
+            .lock()
+            .unwrap()
+            .iter()
+            .all(|s| !vp_protocol::uot::is_magic(&s.dst))
+    );
+    assert_eq!(
+        host.calls.load(Ordering::SeqCst),
+        0,
+        "control name/targets must not reach DNS/direct sockets"
+    );
+    for observer in [&first, &second, &dns] {
+        assert!(
+            timeout(Duration::from_millis(20), observer.recv_from(&mut [0; 64]))
+                .await
+                .is_err()
+        );
+    }
+    // Leave an accepted stream and its routed packet workers live, then force
+    // managed stop. All scoped workers must be destroyed and TCP must close.
+    let stopped = scope.shutdown(Duration::ZERO, Duration::from_secs(1)).await;
+    assert_eq!(stopped.remaining_tasks, 0);
+    assert_eq!(stopped.panics, 0);
+    assert!(!matches!(
+        timeout(Duration::from_secs(1), stream.read_u8()).await,
+        Ok(Ok(_))
+    ));
+    let rebound = tokio::net::TcpListener::bind(("127.0.0.1", port))
+        .await
+        .unwrap();
+    drop(rebound);
+}
