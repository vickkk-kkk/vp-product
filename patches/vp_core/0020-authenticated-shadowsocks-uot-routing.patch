+#[tokio::test]
+async fn ss_uot_wrong_credentials_v2_and_nested_magic_never_reach_router() {
+    for scenario in [
+        "wrong-password",
+        "v2",
+        "nested-magic",
+        "trailing-dot",
+        "nested-variant",
+    ] {
+        let dns = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let host = Arc::new(DenyHost {
+            calls: 0.into(),
+            dns: dns.local_addr().unwrap(),
+        });
+        let scope = TaskScope::with_host_network(
+            vp_core::task_scope::DestinationPolicy::Unrestricted,
+            Some(host.clone()),
+        );
+        let router = probe();
+        let port = scope.run(server("ss", router.clone())).await;
+        let magic = match scenario {
+            "v2" => DstAddr::new(vp_protocol::uot::MAGIC_HOST_V2, 443),
+            "trailing-dot" => DstAddr::new("sp.udp-over-tcp.arpa.", 443),
+            _ => vp_protocol::uot::magic_dst(),
+        };
+        let destination = match scenario {
+            "nested-magic" => magic.clone(),
+            "nested-variant" => DstAddr {
+                host: vp_common::Host::Domain("Sp.V2.Udp-Over-Tcp.Arpa.".into()),
+                port: 443,
+            },
+            _ => DstAddr::new("127.0.0.1", 5353),
+        };
+        let config = serde_json::json!({"server":"127.0.0.1","port":port,"cipher":"aes-128-gcm","password":if scenario=="wrong-password" {"wrong"} else {PASSWORD}});
+        let out =
+            vp_protocol::ss::SsOutbound::new(&serde_json::from_value(config).unwrap()).unwrap();
+        let session = Session::new_tcp("client".into(), None, magic.clone());
+        let result = timeout(Duration::from_secs(1), async {
+            let mut stream = out.connect_stream(&session, &magic).await?;
+            stream
+                .write_all(&vp_protocol::uot::encode_frame(
+                    &destination,
+                    b"must-not-forward",
+                ))
+                .await?;
+            stream.flush().await?;
+            stream.read_u8().await?;
+            Ok::<(), vp_common::Error>(())
+        })
+        .await;
+        assert!(
+            matches!(result, Ok(Err(_))),
+            "{scenario}: rejection must close promptly, not merely time out: {result:?}"
+        );
+        assert!(
+            router.seen.lock().unwrap().is_empty(),
+            "{scenario}: unauthenticated/control data reached routing"
+        );
+        assert_eq!(
+            host.calls.load(Ordering::SeqCst),
+            0,
+            "{scenario}: DNS/socket leak"
+        );
+        assert!(
+            timeout(Duration::from_millis(20), dns.recv_from(&mut [0; 64]))
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            scope
+                .shutdown(Duration::ZERO, Duration::from_secs(1))
+                .await
+                .remaining_tasks,
+            0
+        );
+    }
+}
