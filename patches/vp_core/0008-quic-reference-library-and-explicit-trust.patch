diff --git a/crates/vp-protocol/tests/quic_library_interop.rs b/crates/vp-protocol/tests/quic_library_interop.rs
new file mode 100644
index 0000000..46b91c5
--- /dev/null
+++ b/crates/vp-protocol/tests/quic_library_interop.rs
@@ -0,0 +1,592 @@
+//! Official sing-box protocol-library interoperability; NOT a full sing-box CLI test.
+//! The unmodified pinned reference libraries run only behind a loopback-enforcing adapter.
+use std::{
+    io::{Read, Write},
+    process::{Child, Command, Stdio},
+    sync::Arc,
+    time::Duration,
+};
+use vp_core::{Inbound, InboundCtx};
+struct NoopRouter;
+#[async_trait::async_trait]
+impl vp_core::Router for NoopRouter {
+    async fn pick(&self, _: &vp_core::session::Session) -> vp_core::router::Resolution {
+        unreachable!()
+    }
+}
+struct Peer(Child);
+impl Drop for Peer {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+struct EphemeralIdentity {
+    ca: rcgen::Certificate,
+    cert: rcgen::Certificate,
+    key: rcgen::KeyPair,
+}
+fn ephemeral_identity() -> EphemeralIdentity {
+    use rcgen::{
+        BasicConstraints, CertificateParams, ExtendedKeyUsagePurpose, IsCa, KeyPair,
+        KeyUsagePurpose,
+    };
+    let mut ca_params = CertificateParams::new(Vec::new()).unwrap();
+    ca_params.is_ca = IsCa::Ca(BasicConstraints::Unconstrained);
+    ca_params.distinguished_name.push(
+        rcgen::DnType::CommonName,
+        format!("ephemeral-ca-{:032x}", rand::random::<u128>()),
+    );
+    ca_params.key_usages = vec![KeyUsagePurpose::KeyCertSign, KeyUsagePurpose::CrlSign];
+    let ca_key = KeyPair::generate().unwrap();
+    let ca = ca_params.self_signed(&ca_key).unwrap();
+    let key = KeyPair::generate().unwrap();
+    let mut leaf = CertificateParams::new(vec!["localhost".into()]).unwrap();
+    leaf.key_usages = vec![KeyUsagePurpose::DigitalSignature];
+    leaf.extended_key_usages = vec![ExtendedKeyUsagePurpose::ServerAuth];
+    let cert = leaf.signed_by(&key, &ca, &ca_key).unwrap();
+    EphemeralIdentity { ca, cert, key }
+}
+fn roots(ca: &rcgen::Certificate) -> rustls::RootCertStore {
+    let mut roots = rustls::RootCertStore::empty();
+    roots.add(ca.der().clone()).unwrap();
+    roots
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Failure {
+    None,
+    Auth,
+    WrongCa,
+    WrongName,
+    PublicRoots,
+}
+impl Failure {
+    fn tls_reason(self) -> Option<&'static str> {
+        match self {
+            Self::WrongCa | Self::PublicRoots => Some("UnknownIssuer"),
+            Self::WrongName => Some("certificate not valid for name"),
+            _ => None,
+        }
+    }
+}
+
+async fn interop(protocol: &str, mode: &str, negative: bool) {
+    let bin = std::env::var_os("VP_QUIC_REFERENCE")
+        .expect("build the verified official protocol-library harness first");
+    let cert = ephemeral_identity();
+    let password = format!("ephemeral-{:032x}", rand::random::<u128>());
+    let ctx = InboundCtx {
+        router: Arc::new(NoopRouter),
+        stats: Arc::default(),
+        conns: Arc::new(vp_core::ConnTable::new()),
+    };
+    let server: Arc<dyn Inbound> = match protocol {
+        "tuic" => Arc::new(vp_protocol::tuic::TuicInbound::new(
+            "127.0.0.1",
+            0,
+            "reference",
+            vec![(
+                "b831381d-6324-4d53-ad4f-8cda48b30811".into(),
+                password.clone(),
+            )],
+            cert.cert.pem().into_bytes(),
+            cert.key.serialize_pem().into_bytes(),
+        )),
+        "hysteria2" => Arc::new(vp_protocol::hysteria2::Hysteria2Inbound::new(
+            "127.0.0.1",
+            0,
+            "reference",
+            &password,
+            cert.cert.pem().into_bytes(),
+            cert.key.serialize_pem().into_bytes(),
+        )),
+        _ => unreachable!(),
+    };
+    let scope = vp_core::task_scope::TaskScope::new();
+    let port = scope.run(server.start(ctx)).await.unwrap();
+    let config = serde_json::json!({"protocol":protocol,"mode":mode,"port":port,"password":if negative {"invalid-ephemeral"}else{&password},"certificate":cert.ca.pem(),"negative":negative});
+    let child = Command::new(bin)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    let mut peer = Peer(child);
+    peer.0
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(&serde_json::to_vec(&config).unwrap())
+        .unwrap();
+    let status = tokio::time::timeout(Duration::from_secs(20), async {
+        loop {
+            if let Some(status) = peer.0.try_wait().unwrap() {
+                break status;
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await
+    .expect("reference harness must terminate");
+    let mut stdout = String::new();
+    let mut stderr = String::new();
+    peer.0
+        .stdout
+        .take()
+        .unwrap()
+        .read_to_string(&mut stdout)
+        .unwrap();
+    peer.0
+        .stderr
+        .take()
+        .unwrap()
+        .read_to_string(&mut stderr)
+        .unwrap();
+    let shutdown = scope.shutdown(Duration::ZERO, Duration::from_secs(2)).await;
+    assert_eq!(
+        shutdown.remaining_tasks, 0,
+        "reference test leaked product tasks"
+    );
+    assert!(status.success(), "reference library failed: {stderr}");
+    let result: serde_json::Value = serde_json::from_str(&stdout).unwrap();
+    assert_eq!(result["ok"], true);
+    assert_eq!(result["kind"], "official-protocol-library");
+    eprintln!("PASS official protocol-library peer (not CLI): {stdout}");
+}
+#[tokio::test]
+#[ignore = "requires verified official-library harness"]
+async fn sing_quic_tuic_native_tcp_udp() {
+    interop("tuic", "native", false).await
+}
+#[tokio::test]
+#[ignore = "requires verified official-library harness"]
+async fn sing_quic_tuic_stream_tcp_udp() {
+    interop("tuic", "quic", false).await
+}
+#[tokio::test]
+#[ignore = "requires verified official-library harness"]
+async fn sing_quic_hysteria2_tcp_udp() {
+    interop("hysteria2", "native", false).await
+}
+#[tokio::test]
+#[ignore = "requires verified official-library harness"]
+async fn sing_quic_tuic_invalid_auth_never_forwards() {
+    interop("tuic", "native", true).await
+}
+#[tokio::test]
+#[ignore = "requires verified official-library harness"]
+async fn sing_quic_hysteria2_invalid_auth_never_forwards() {
+    interop("hysteria2", "native", true).await
+}
+
+async fn finish_server(peer: &mut Peer, stdin: std::process::ChildStdin) {
+    // EOF requests normal service Close; Drop remains a kill/wait fallback on panic.
+    drop(stdin);
+    let status = tokio::time::timeout(Duration::from_secs(3), async {
+        loop {
+            if let Some(status) = peer.0.try_wait().unwrap() {
+                break status;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("reference server must close after stdin EOF");
+    let mut stderr = String::new();
+    peer.0
+        .stderr
+        .take()
+        .unwrap()
+        .read_to_string(&mut stderr)
+        .unwrap();
+    assert!(
+        status.success(),
+        "reference server shutdown failed: {stderr}"
+    );
+}
+
+async fn reverse_interop(protocol: &str, mode: &str, failure: Failure) {
+    use std::io::BufRead;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    use vp_common::DstAddr;
+    use vp_core::{Outbound, UdpPacket, session::Session};
+    let bin = std::env::var_os("VP_QUIC_REFERENCE").expect("verified test-only reference required");
+    let cert = ephemeral_identity();
+    let password = format!("ephemeral-{:032x}", rand::random::<u128>());
+    let config = serde_json::json!({"role":"server","protocol":protocol,"password":password,"certificate":cert.cert.pem(),"privateKey":cert.key.serialize_pem()});
+    let child = Command::new(bin)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    let mut peer = Peer(child);
+    let mut stdin = peer.0.stdin.take().unwrap();
+    stdin
+        .write_all(&serde_json::to_vec(&config).unwrap())
+        .unwrap();
+    stdin.write_all(b"\n").unwrap();
+    let stdout = peer.0.stdout.take().unwrap();
+    let ready = tokio::time::timeout(
+        Duration::from_secs(5),
+        tokio::task::spawn_blocking(move || {
+            let mut line = String::new();
+            std::io::BufReader::new(stdout)
+                .read_line(&mut line)
+                .unwrap();
+            line
+        }),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    if ready.is_empty() {
+        let mut err = String::new();
+        peer.0
+            .stderr
+            .take()
+            .unwrap()
+            .read_to_string(&mut err)
+            .unwrap();
+        panic!("reference server failed: {err}");
+    }
+    let ready: serde_json::Value = serde_json::from_str(&ready).unwrap();
+    assert_eq!(ready["ready"], true);
+    let port = ready["port"].as_u64().unwrap() as u16;
+    let credential = if failure == Failure::Auth {
+        "invalid-ephemeral"
+    } else {
+        &password
+    };
+    // Per-instance owned CA, normal rustls validation; no global trust changes.
+    let root_store = if failure == Failure::WrongCa {
+        roots(&ephemeral_identity().ca)
+    } else {
+        roots(&cert.ca)
+    };
+    let name = if failure == Failure::WrongName {
+        "wrong.invalid"
+    } else {
+        "localhost"
+    };
+    let cfg = serde_json::json!({"server":"127.0.0.1","port":port,"password":credential,
+        "uuid":"b831381d-6324-4d53-ad4f-8cda48b30811","sni":name,"skip_cert_verify":false,"udp_relay_mode":mode});
+    let outbound: Box<dyn Outbound> = match protocol {
+        "tuic" => {
+            let cfg = serde_json::from_value(cfg).unwrap();
+            Box::new(
+                if failure == Failure::PublicRoots {
+                    vp_protocol::tuic::TuicOutbound::new(&cfg)
+                } else {
+                    vp_protocol::tuic::TuicOutbound::new_with_root_certificates(&cfg, root_store)
+                }
+                .unwrap(),
+            )
+        }
+        "hysteria2" => {
+            let cfg = serde_json::from_value(cfg).unwrap();
+            Box::new(
+                if failure == Failure::PublicRoots {
+                    vp_protocol::hysteria2::Hysteria2Outbound::new(&cfg)
+                } else {
+                    vp_protocol::hysteria2::Hysteria2Outbound::new_with_root_certificates(
+                        &cfg, root_store,
+                    )
+                }
+                .unwrap(),
+            )
+        }
+        _ => unreachable!(),
+    };
+    let tcp = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let tcp_addr = tcp.local_addr().unwrap();
+    let udp = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+    let udp_addr = udp.local_addr().unwrap();
+    let tcp_dst = DstAddr::ip(tcp_addr.ip(), tcp_addr.port());
+    let udp_dst = DstAddr::ip(udp_addr.ip(), udp_addr.port());
+    let tcp_session = Session::new_tcp("reverse".into(), None, tcp_dst.clone());
+    let udp_session = Session::new_udp("reverse".into(), None, udp_dst.clone());
+    if failure != Failure::None {
+        let tcp_result = tokio::time::timeout(
+            Duration::from_secs(3),
+            outbound.connect_stream(&tcp_session, &tcp_dst),
+        )
+        .await
+        .unwrap();
+        if let Some(reason) = failure.tls_reason() {
+            assert!(
+                tcp_result
+                    .as_ref()
+                    .err()
+                    .is_some_and(|error| error.to_string().contains(reason)),
+                "expected TCP TLS {reason}, got {:?}",
+                tcp_result.as_ref().err()
+            );
+        }
+        let mut tcp_attempt = tcp_result.ok();
+        if let Some(stream) = &mut tcp_attempt {
+            let _ = stream.write_all(b"unauthorized").await;
+        }
+        let udp_result = tokio::time::timeout(
+            Duration::from_secs(3),
+            outbound.connect_packet(&udp_session, &udp_dst),
+        )
+        .await
+        .unwrap();
+        if let Some(reason) = failure.tls_reason() {
+            assert!(
+                udp_result
+                    .as_ref()
+                    .err()
+                    .is_some_and(|error| error.to_string().contains(reason)),
+                "expected UDP TLS {reason}, got {:?}",
+                udp_result.as_ref().err()
+            );
+        }
+        let udp_attempt = udp_result.ok();
+        if let Some(packet) = &udp_attempt {
+            let _ = packet
+                .send(&UdpPacket {
+                    src: "127.0.0.1:0".parse().unwrap(),
+                    dst: udp_addr,
+                    data: b"unauthorized".as_slice().into(),
+                })
+                .await;
+        }
+        assert!(
+            tokio::time::timeout(Duration::from_millis(400), tcp.accept())
+                .await
+                .is_err(),
+            "invalid vp_core credentials reached reference TCP target"
+        );
+        let mut bytes = [0; 128];
+        assert!(
+            tokio::time::timeout(Duration::from_millis(400), udp.recv_from(&mut bytes))
+                .await
+                .is_err(),
+            "invalid vp_core credentials reached reference UDP target"
+        );
+        eprintln!(
+            "PASS vp_core outbound -> official protocol-library {protocol}/{mode}: {failure:?} causes no TCP/UDP destination traffic (not CLI; certificate verification ON)"
+        );
+        finish_server(&mut peer, stdin).await;
+        return;
+    }
+    let mut targets = tokio::task::JoinSet::new();
+    targets.spawn(async move {
+        let (mut stream, _) = tcp.accept().await.unwrap();
+        let (mut read, mut write) = stream.split();
+        tokio::io::copy(&mut read, &mut write).await.unwrap();
+    });
+    let mut stream = outbound
+        .connect_stream(&tcp_session, &tcp_dst)
+        .await
+        .unwrap();
+    stream.write_all(b"independent-reverse-tcp").await.unwrap();
+    let mut reply = [0; 23];
+    stream.read_exact(&mut reply).await.unwrap();
+    assert_eq!(&reply, b"independent-reverse-tcp");
+    stream.shutdown().await.unwrap();
+    let mut eof = [0];
+    assert_eq!(stream.read(&mut eof).await.unwrap(), 0);
+    let mut packet = outbound
+        .connect_packet(&udp_session, &udp_dst)
+        .await
+        .unwrap();
+    let second = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+    let sizes = if protocol == "hysteria2" {
+        [73, 4096, 4096, 73]
+    } else {
+        [73, 6000, 6000, 73]
+    };
+    let mut expected_source = None;
+    for (index, size) in sizes.into_iter().enumerate() {
+        let target = if index % 2 == 0 { &udp } else { &second };
+        let address = target.local_addr().unwrap();
+        let body = vec![0x41 + index as u8; size];
+        packet
+            .send(&UdpPacket {
+                src: "127.0.0.1:0".parse().unwrap(),
+                dst: address,
+                data: body.clone().into(),
+            })
+            .await
+            .unwrap();
+        let mut bytes = vec![0; 65535];
+        let (n, source) = target.recv_from(&mut bytes).await.unwrap();
+        assert_eq!(&bytes[..n], &body);
+        if let Some(expected) = expected_source {
+            assert_eq!(
+                source, expected,
+                "reference association source port changed"
+            );
+        }
+        expected_source = Some(source);
+        target.send_to(&bytes[..n], source).await.unwrap();
+        let reply = packet.recv().await.unwrap();
+        assert_eq!(reply.data.as_ref(), body);
+        assert_eq!(reply.src, address);
+    }
+    eprintln!(
+        "PASS vp_core outbound -> official protocol-library {protocol}/{mode}: TCP+half-close, UDP sizes {sizes:?}, multi-target/stable association (not CLI; ephemeral CA chain/name/signature verification ON)"
+    );
+    finish_server(&mut peer, stdin).await;
+    targets.join_next().await.unwrap().unwrap();
+}
