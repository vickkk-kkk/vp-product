diff --git a/crates/vp-protocol/tests/reference_quic/main.go b/crates/vp-protocol/tests/reference_quic/main.go
new file mode 100644
index 0000000..37630a9
--- /dev/null
+++ b/crates/vp-protocol/tests/reference_quic/main.go
@@ -0,0 +1,238 @@
+// Test-only adapter around UNMODIFIED official sing-box protocol dependencies.
+// No NetworkManager, TUN, route/firewall API, system proxy, or remote target exists.
+// Credentials and certificates arrive on stdin and are never written or logged.
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"time"
+
+	"github.com/sagernet/sing-quic/hysteria2"
+	"github.com/sagernet/sing-quic/tuic"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	aTLS "github.com/sagernet/sing/common/tls"
+)
+
+type input struct {
+	Protocol, Mode, Password, Certificate, PrivateKey, Role string
+	Port                                                    uint16
+	Negative                                                bool
+}
+type client interface {
+	DialConn(context.Context, M.Socksaddr) (net.Conn, error)
+	ListenPacket(context.Context) (net.PacketConn, error)
+	CloseWithError(error) error
+}
+
+// Supported public transport/TLS adapter interfaces only. Protocol processing,
+// auth framing, TLS/QUIC, HTTP/3 and datagram fragmentation remain official code.
+type loopbackDialer struct{}
+
+func (loopbackDialer) DialContext(ctx context.Context, network string, d M.Socksaddr) (net.Conn, error) {
+	if !d.Addr.IsLoopback() || (network != "tcp" && network != "udp") {
+		return nil, errors.New("test dialer refuses non-loopback target")
+	}
+	var dialer net.Dialer
+	return dialer.DialContext(ctx, network, d.String())
+}
+func (loopbackDialer) ListenPacket(ctx context.Context, d M.Socksaddr) (net.PacketConn, error) {
+	if !d.Addr.IsLoopback() {
+		return nil, errors.New("test dialer refuses non-loopback bind")
+	}
+	var listen net.ListenConfig
+	return listen.ListenPacket(ctx, "udp", "127.0.0.1:0")
+}
+
+type stdTLS struct {
+	config  *tls.Config
+	timeout time.Duration
+}
+
+func (t *stdTLS) ServerName() string                   { return t.config.ServerName }
+func (t *stdTLS) SetServerName(v string)               { t.config.ServerName = v }
+func (t *stdTLS) NextProtos() []string                 { return t.config.NextProtos }
+func (t *stdTLS) SetNextProtos(v []string)             { t.config.NextProtos = v }
+func (t *stdTLS) HandshakeTimeout() time.Duration      { return t.timeout }
+func (t *stdTLS) SetHandshakeTimeout(v time.Duration)  { t.timeout = v }
+func (t *stdTLS) STDConfig() (*tls.Config, error)      { return t.config, nil }
+func (t *stdTLS) Client(c net.Conn) (aTLS.Conn, error) { return tls.Client(c, t.config), nil }
+func (t *stdTLS) Clone() aTLS.Config                   { return &stdTLS{t.config.Clone(), t.timeout} }
+
+func run() error {
+	var cfg input
+	if err := json.NewDecoder(io.LimitReader(os.Stdin, 65536)).Decode(&cfg); err != nil {
+		return err
+	}
+	if cfg.Role == "server" {
+		return runServer(cfg)
+	}
+	if cfg.Port == 0 {
+		return errors.New("missing loopback server port")
+	}
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM([]byte(cfg.Certificate)) {
+		return errors.New("invalid ephemeral CA")
+	}
+	tlsConfig := &stdTLS{&tls.Config{RootCAs: roots, ServerName: "localhost", NextProtos: []string{"h3"}, MinVersion: tls.VersionTLS13}, 3 * time.Second}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	server := M.ParseSocksaddr(fmt.Sprintf("127.0.0.1:%d", cfg.Port))
+	var c client
+	var err error
+	switch cfg.Protocol {
+	case "tuic":
+		c, err = tuic.NewClient(tuic.ClientOptions{Context: ctx, Dialer: loopbackDialer{}, ServerAddress: server, TLSConfig: tlsConfig,
+			UUID:     [16]byte{0xb8, 0x31, 0x38, 0x1d, 0x63, 0x24, 0x4d, 0x53, 0xad, 0x4f, 0x8c, 0xda, 0x48, 0xb3, 0x08, 0x11},
+			Password: cfg.Password, CongestionControl: "cubic", UDPStream: cfg.Mode == "quic"})
+	case "hysteria2":
+		c, err = hysteria2.NewClient(hysteria2.ClientOptions{Logger: logger.NOP(), Context: ctx, Dialer: loopbackDialer{}, ServerAddress: server, TLSConfig: tlsConfig, Password: cfg.Password})
+	default:
+		return errors.New("unsupported test protocol")
+	}
+	if err != nil {
+		return err
+	}
+	defer c.CloseWithError(os.ErrClosed)
+	tcp, err := net.ListenTCP("tcp", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return err
+	}
+	defer tcp.Close()
+	target, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return err
+	}
+	defer target.Close()
+	tcpDst := M.SocksaddrFromNet(tcp.Addr())
+	if cfg.Negative {
+		conn, e := c.DialConn(ctx, tcpDst)
+		if e == nil {
+			defer conn.Close()
+			conn.SetDeadline(time.Now().Add(time.Second))
+			conn.Write([]byte("unauthorized"))
+		}
+		packet, e := c.ListenPacket(ctx)
+		if e == nil {
+			defer packet.Close()
+			packet.SetDeadline(time.Now().Add(time.Second))
+			packet.WriteTo([]byte("unauthorized"), target.LocalAddr())
+		}
+		tcp.SetDeadline(time.Now().Add(400 * time.Millisecond))
+		if conn, e := tcp.Accept(); e == nil {
+			conn.Close()
+			return errors.New("wrong credentials reached TCP destination")
+		} else if !errors.Is(e, os.ErrDeadlineExceeded) {
+			return fmt.Errorf("TCP negative observation failed: %w", e)
+		}
+		target.SetReadDeadline(time.Now().Add(400 * time.Millisecond))
+		var buf [64]byte
+		if _, _, e := target.ReadFrom(buf[:]); e == nil {
+			return errors.New("wrong credentials reached UDP destination")
+		} else if !errors.Is(e, os.ErrDeadlineExceeded) {
+			return fmt.Errorf("UDP negative observation failed: %w", e)
+		}
+		return json.NewEncoder(os.Stdout).Encode(map[string]any{"ok": true, "kind": "official-protocol-library", "protocol": cfg.Protocol, "mode": cfg.Mode, "negative": true})
+	}
+	// Echo target, authenticated TCP. It exists only on loopback and closes at exit.
+	echoDone := make(chan error, 1)
+	go func() {
+		conn, e := tcp.AcceptTCP()
+		if e != nil {
+			echoDone <- e
+			return
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(5 * time.Second))
+		_, e = io.Copy(conn, conn)
+		echoDone <- e
+	}()
+	conn, err := c.DialConn(ctx, tcpDst)
+	if err != nil {
+		return fmt.Errorf("TCP dial: %w", err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(5 * time.Second))
+	body := []byte("official-library-independent-TCP")
+	if _, err = conn.Write(body); err != nil {
+		return fmt.Errorf("TCP write: %w", err)
+	}
+	got := make([]byte, len(body))
+	if _, err = io.ReadFull(conn, got); err != nil {
+		return fmt.Errorf("TCP read: %w", err)
+	}
+	if !bytes.Equal(got, body) {
+		return errors.New("TCP payload mismatch")
+	}
+	conn.Close()
+	if err = <-echoDone; err != nil {
+		return fmt.Errorf("TCP target completion: %w", err)
+	}
+	packet, err := c.ListenPacket(ctx)
+	if err != nil {
+		return fmt.Errorf("UDP listen: %w", err)
+	}
+	defer packet.Close()
+	second, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return err
+	}
+	defer second.Close()
+	var source string
+	sizes := []int{73, 6000, 6000, 73}
+	// The unmodified official Hysteria2 peer caps UDP payloads at 4096 bytes.
+	// Exercise that boundary and fragmentation without changing reference code.
+	if cfg.Protocol == "hysteria2" {
+		sizes = []int{73, 4096, 4096, 73}
+	}
+	for i, size := range sizes {
+		dst := target
+		if i%2 == 1 {
+			dst = second
+		}
+		body = bytes.Repeat([]byte{byte(0x31 + i)}, size)
+		packet.SetDeadline(time.Now().Add(5 * time.Second))
+		dst.SetDeadline(time.Now().Add(5 * time.Second))
+		if _, err = packet.WriteTo(body, dst.LocalAddr()); err != nil {
+			return fmt.Errorf("UDP send size %d: %w", size, err)
+		}
+		buf := make([]byte, 65535)
+		n, from, e := dst.ReadFrom(buf)
+		if e != nil {
+			return fmt.Errorf("UDP target size %d: %w", size, e)
+		}
+		if !bytes.Equal(buf[:n], body) {
+			return errors.New("UDP destination payload mismatch")
+		}
+		if source != "" && source != from.String() {
+			return errors.New("UDP association source port changed")
+		}
+		source = from.String()
+		if _, e = dst.WriteTo(buf[:n], from); e != nil {
+			return e
+		}
+		n, from, e = packet.ReadFrom(buf)
+		if e != nil {
+			return fmt.Errorf("UDP reply size %d: %w", size, e)
+		}
+		if !bytes.Equal(buf[:n], body) || from.String() != dst.LocalAddr().String() {
+			return errors.New("UDP reply payload/source mismatch")
+		}
+	}
+	return json.NewEncoder(os.Stdout).Encode(map[string]any{"ok": true, "kind": "official-protocol-library", "protocol": cfg.Protocol, "mode": cfg.Mode, "tcp": true, "udp_sizes": sizes, "udp_source_stable": true})
+}
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, "reference-quic:", err)
+		os.Exit(1)
+	}
+}
diff --git a/crates/vp-protocol/tests/reference_quic/server.go b/crates/vp-protocol/tests/reference_quic/server.go
new file mode 100644
index 0000000..533301d
--- /dev/null
+++ b/crates/vp-protocol/tests/reference_quic/server.go
@@ -0,0 +1,148 @@
+package main
+
+import (
+	"context"
+	"crypto/tls"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"time"
+
+	"github.com/sagernet/sing-quic/hysteria2"
+	"github.com/sagernet/sing-quic/tuic"
+	"github.com/sagernet/sing/common/bufio"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	aTLS "github.com/sagernet/sing/common/tls"
+)
+
+func (t *stdTLS) Start() error                            { return nil }
+func (t *stdTLS) Close() error                            { return nil }
+func (t *stdTLS) Server(conn net.Conn) (aTLS.Conn, error) { return tls.Server(conn, t.config), nil }
+
+// This handler is only an ordinary loopback socket relay. All protocol negotiation,
+// access checks, QUIC stream/datagram framing and fragment processing are upstream.
+type loopbackHandler struct{}
+
+func (loopbackHandler) NewConnectionEx(ctx context.Context, conn net.Conn, _ M.Socksaddr, dst M.Socksaddr, onClose N.CloseHandlerFunc) {
+	defer conn.Close()
+	if onClose != nil {
+		defer onClose(nil)
+	}
+	remote, err := (loopbackDialer{}).DialContext(ctx, "tcp", dst)
+	if err != nil {
+		N.ReportHandshakeFailure(conn, err)
+		return
+	}
+	defer remote.Close()
+	if N.ReportHandshakeSuccess(conn) != nil {
+		return
+	}
+	conn.SetDeadline(time.Now().Add(10 * time.Second))
+	remote.SetDeadline(time.Now().Add(10 * time.Second))
+	done := make(chan struct{})
+	go func() {
+		io.Copy(remote, conn)
+		if c, ok := remote.(interface{ CloseWrite() error }); ok {
+			c.CloseWrite()
+		}
+		close(done)
+	}()
+	io.Copy(conn, remote)
+	conn.Close()
+	remote.Close()
+	<-done
+}
+func (loopbackHandler) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, _ M.Socksaddr, _ M.Socksaddr, onClose N.CloseHandlerFunc) {
+	defer conn.Close()
+	if onClose != nil {
+		defer onClose(nil)
+	}
+	packet := bufio.NewNetPacketConn(conn)
+	sock, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return
+	}
+	defer sock.Close()
+	buffer := make([]byte, 65535)
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		packet.SetReadDeadline(time.Now().Add(10 * time.Second))
+		n, destination, err := packet.ReadFrom(buffer)
+		if err != nil {
+			return
+		}
+		dst := M.SocksaddrFromNet(destination)
+		if !dst.Addr.Is4() || !dst.Addr.IsLoopback() {
+			return
+		}
+		sock.SetDeadline(time.Now().Add(5 * time.Second))
+		if _, err = sock.WriteTo(buffer[:n], dst.UDPAddr()); err != nil {
+			return
+		}
+		n, source, err := sock.ReadFrom(buffer)
+		if err != nil {
+			return
+		}
+		if _, err = packet.WriteTo(buffer[:n], source); err != nil {
+			return
+		}
+	}
+}
+
+func runServer(cfg input) error {
+	certificate, err := tls.X509KeyPair([]byte(cfg.Certificate), []byte(cfg.PrivateKey))
+	if err != nil {
+		return err
+	}
+	tlsConfig := &stdTLS{&tls.Config{Certificates: []tls.Certificate{certificate}, NextProtos: []string{"h3"}, MinVersion: tls.VersionTLS13}, 3 * time.Second}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	socket, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return err
+	}
+	defer socket.Close()
+	var server interface {
+		Start(net.PacketConn) error
+		Close() error
+	}
+	switch cfg.Protocol {
+	case "tuic":
+		service, e := tuic.NewService[int](tuic.ServiceOptions{Context: ctx, Logger: logger.NOP(), TLSConfig: tlsConfig, Handler: loopbackHandler{}, CongestionControl: "cubic", UDPTimeout: 10 * time.Second})
+		if e != nil {
+			return e
+		}
+		service.UpdateUsers([]int{1}, [][16]byte{{0xb8, 0x31, 0x38, 0x1d, 0x63, 0x24, 0x4d, 0x53, 0xad, 0x4f, 0x8c, 0xda, 0x48, 0xb3, 0x08, 0x11}}, []string{cfg.Password})
+		server = service
+	case "hysteria2":
+		service, e := hysteria2.NewService[int](hysteria2.ServiceOptions{Context: ctx, Logger: logger.NOP(), TLSConfig: tlsConfig, Handler: loopbackHandler{}, UDPTimeout: 10 * time.Second})
+		if e != nil {
+			return e
+		}
+		service.UpdateUsers([]int{1}, []string{cfg.Password})
+		server = service
+	default:
+		return errors.New("unsupported protocol")
+	}
+	if err = server.Start(socket); err != nil {
+		return err
+	}
+	defer server.Close()
+	if err = json.NewEncoder(os.Stdout).Encode(map[string]any{"ready": true, "kind": "official-protocol-library", "port": socket.LocalAddr().(*net.UDPAddr).Port}); err != nil {
+		return err
+	}
+	done := make(chan struct{})
+	go func() { io.Copy(io.Discard, os.Stdin); close(done) }()
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
