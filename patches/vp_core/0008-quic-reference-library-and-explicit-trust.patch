+    for insecure in [false, true] {
+        let cfg = serde_json::json!({"server":"127.0.0.1","port":1,"password":"ephemeral", "uuid":"b831381d-6324-4d53-ad4f-8cda48b30811","skip_cert_verify":insecure});
+        let tuic = serde_json::from_value(cfg.clone()).unwrap();
+        let hy2 = serde_json::from_value(cfg).unwrap();
+        let trust = || {
+            if insecure {
+                roots(&cert.ca)
+            } else {
+                rustls::RootCertStore::empty()
+            }
+        };
+        assert!(
+            vp_protocol::tuic::TuicOutbound::new_with_root_certificates(&tuic, trust()).is_err()
