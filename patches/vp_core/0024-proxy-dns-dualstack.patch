+//! Source-authored loopback coverage for protected endpoint hostname bootstrap.
+//! No public DNS, OS route changes, or production domains. Run only in an
+//! explicitly allocated Cargo lane; source presence is not execution evidence.
+use super::*;
+use std::sync::atomic::{AtomicBool, Ordering};
+use vp_core::host_network::{HostNetwork, Protocol, Purpose};
+use vp_core::task_scope::{DestinationPolicy, TaskScope};
+
+const ENDPOINT: &str = "proxy.bootstrap.fixture.invalid";
+const ALIAS: &str = "canonical.bootstrap.fixture.invalid";
+#[derive(Clone)]
+enum Reply {
+    Addresses(Vec<IpAddr>),
+    Empty,
+    ServFail,
+    WrongId,
+    Cname(String),
+    Silent,
+}
+fn reply(query: &[u8], response: Reply) -> Option<Vec<u8>> {
+    if matches!(&response, Reply::Silent) {
+        return None;
+    }
+    let mut out = wire::build_empty_response(query);
+    match response {
+        Reply::Addresses(ips) => {
+            out[6..8].copy_from_slice(&(ips.len() as u16).to_be_bytes());
+            for ip in ips {
+                out.extend_from_slice(&[0xc0, 0x0c]);
+                let (kind, bytes) = match ip {
+                    IpAddr::V4(v4) => (wire::TYPE_A, v4.octets().to_vec()),
+                    IpAddr::V6(v6) => (wire::TYPE_AAAA, v6.octets().to_vec()),
+                };
+                out.extend_from_slice(&kind.to_be_bytes());
+                out.extend_from_slice(&[0, 1, 0, 0, 0, 1]);
+                out.extend_from_slice(&(bytes.len() as u16).to_be_bytes());
+                out.extend_from_slice(&bytes);
+            }
+        }
+        Reply::Cname(name) => {
+            out[6..8].copy_from_slice(&1u16.to_be_bytes());
+            out.extend_from_slice(&[0xc0, 0x0c, 0, 5, 0, 1, 0, 0, 0, 1]);
+            let mut labels = Vec::new();
+            for label in name.split('.') {
+                labels.push(label.len() as u8);
+                labels.extend_from_slice(label.as_bytes());
+            }
+            labels.push(0);
+            out.extend_from_slice(&(labels.len() as u16).to_be_bytes());
+            out.extend_from_slice(&labels);
+        }
+        Reply::ServFail => out[3] = 0x82,
+        Reply::WrongId => out[0] ^= 1,
+        Reply::Empty => {}
+        Reply::Silent => unreachable!(),
+    }
+    Some(out)
+}
+struct Peer {
+    address: SocketAddr,
+    seen: Arc<Mutex<Vec<(String, u16)>>>,
+    task: tokio::task::JoinHandle<()>,
+}
+impl Drop for Peer {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+async fn peer<F>(ipv6: bool, response: F) -> Peer
+where
+    F: Fn(&str, u16) -> (Reply, Duration) + Send + Sync + 'static,
+{
+    let socket = Arc::new(
+        UdpSocket::bind(if ipv6 { "[::1]:0" } else { "127.0.0.1:0" })
+            .await
+            .unwrap(),
+    );
+    let address = socket.local_addr().unwrap();
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let observations = seen.clone();
+    let task = tokio::spawn(async move {
+        let mut responses = tokio::task::JoinSet::new();
+        let mut buf = [0; 4096];
+        loop {
+            tokio::select! {
+                received = socket.recv_from(&mut buf) => {
+                    let (len, source) = received.unwrap();
+                    assert!(source.ip().is_loopback());
+                    let (_, name, kind) = wire::parse_query(&buf[..len]).unwrap();
+                    observations.lock().unwrap().push((name.clone(),kind));
+                    assert!(observations.lock().unwrap().len() <= 128, "unexpected unbounded query chain");
+                    let (answer, delay) = response(&name, kind);
+                    let output = reply(&buf[..len], answer);
+                    let socket = socket.clone();
+                    responses.spawn(async move {
+                        if let Some(output) = output {
+                            tokio::time::sleep(delay).await;
+                            socket.send_to(&output, source).await.unwrap();
+                        }
+                    });
+                }
+                completed = responses.join_next(), if !responses.is_empty() => {completed.unwrap().unwrap();}
+            }
+        }
+    });
+    Peer {
+        address,
+        seen,
+        task,
+    }
+}
+struct Host {
+    servers: Vec<SocketAddr>,
+    calls: Mutex<Vec<SocketAddr>>,
+    deny: AtomicBool,
+}
+impl HostNetwork for Host {
+    fn before_connect(
+        &self,
+        _: u64,
+        protocol: Protocol,
+        destination: SocketAddr,
+        purpose: Purpose,
+    ) -> std::io::Result<()> {
+        assert_eq!(protocol, Protocol::Udp);
+        assert_eq!(purpose, Purpose::Bootstrap);
+        assert!(self.servers.contains(&destination));
+        self.calls.lock().unwrap().push(destination);
+        if self.deny.load(Ordering::SeqCst) {
+            Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "test protect denial",
+            ))
+        } else {
+            Ok(())
+        }
+    }
+    fn dns_servers(&self) -> Vec<SocketAddr> {
+        self.servers.clone()
+    }
+    fn bootstrap_host(&self) -> Option<String> {
+        Some(ENDPOINT.into())
+    }
+}
+fn new_scope(servers: Vec<SocketAddr>) -> (Arc<TaskScope>, Arc<Host>) {
+    let host = Arc::new(Host {
+        servers,
+        calls: Mutex::new(vec![]),
+        deny: AtomicBool::new(false),
+    });
+    (
+        TaskScope::with_host_network(DestinationPolicy::LoopbackIpOnly, Some(host.clone())),
+        host,
+    )
+}
+async fn stop(scope: &Arc<TaskScope>) {
+    let report = scope.shutdown(Duration::ZERO, Duration::from_secs(1)).await;
+    assert_eq!(report.remaining_tasks, 0);
+    assert_eq!(report.panics, 0);
+}
+async fn addresses(scope: &Arc<TaskScope>) -> Vec<IpAddr> {
+    timeout(
+        Duration::from_secs(6),
+        scope.run(lookup_host(ENDPOINT, 443)),
+    )
+    .await
+    .unwrap()
+    .unwrap()
+    .map(|address| {
+        assert_eq!(address.port(), 443);
+        address.ip()
+    })
+    .collect()
+}
+fn ips(values: &[&str]) -> Vec<IpAddr> {
+    values.iter().map(|value| value.parse().unwrap()).collect()
+}
+
+#[tokio::test]
+async fn bootstrap_aaaa_only_hostname_via_ipv6_resolver_and_ipv4_only_hostname() {
+    for v6_only in [true, false] {
+        let dns = peer(true, move |name, kind| {
+            assert_eq!(name, ENDPOINT);
+            (
+                if kind
+                    == if v6_only {
+                        wire::TYPE_AAAA
+                    } else {
+                        wire::TYPE_A
+                    }
+                {
+                    Reply::Addresses(ips(&[if v6_only { "::1" } else { "127.0.0.1" }]))
+                } else {
+                    Reply::Empty
+                },
+                Duration::ZERO,
+            )
+        })
+        .await;
+        let (scope, host) = new_scope(vec![dns.address]);
+        assert_eq!(
+            addresses(&scope).await,
+            ips(&[if v6_only { "::1" } else { "127.0.0.1" }])
+        );
+        let mut types = dns
+            .seen
+            .lock()
+            .unwrap()
+            .iter()
+            .map(|(_, kind)| *kind)
+            .collect::<Vec<_>>();
+        types.sort();
+        assert_eq!(types, vec![wire::TYPE_A, wire::TYPE_AAAA]);
+        assert_eq!(host.calls.lock().unwrap().len(), 2);
+        stop(&scope).await;
+    }
+}
+#[tokio::test]
+async fn bootstrap_dual_stack_deduplicates_and_interleaves_in_configured_server_order() {
+    let first = peer(false, |_, kind| {
+        if kind == wire::TYPE_A {
+            (
+                Reply::Addresses(ips(&["127.0.0.2", "127.0.0.1", "127.0.0.2"])),
+                Duration::from_millis(40),
+            )
+        } else {
+            (
+                Reply::Addresses(ips(&["::2", "::1", "::2"])),
+                Duration::from_millis(20),
+            )
+        }
+    })
+    .await;
+    let second = peer(true, |_, kind| {
+        (
+            Reply::Addresses(if kind == wire::TYPE_A {
+                ips(&["127.0.0.3", "127.0.0.1"])
+            } else {
+                ips(&["::3", "::1"])
+            }),
+            Duration::ZERO,
+        )
+    })
+    .await;
+    let (scope, host) = new_scope(vec![first.address, second.address]);
+    assert_eq!(
+        addresses(&scope).await,
+        ips(&["127.0.0.2", "::2", "127.0.0.1", "::1", "127.0.0.3", "::3"])
+    );
+    assert_eq!(host.calls.lock().unwrap().len(), 4);
+    stop(&scope).await;
+}
+#[tokio::test]
+async fn bootstrap_one_family_servfail_or_unassociated_response_preserves_other_family() {
+    for bad_v4 in [true, false] {
+        for wrong_id in [true, false] {
+            let dns = peer(false, move |_, kind| {
+                (
+                    if (kind == wire::TYPE_A) == bad_v4 {
+                        if wrong_id {
+                            Reply::WrongId
+                        } else {
+                            Reply::ServFail
+                        }
+                    } else {
+                        Reply::Addresses(ips(&[if bad_v4 { "::1" } else { "127.0.0.1" }]))
+                    },
+                    Duration::ZERO,
+                )
+            })
+            .await;
+            let (scope, _) = new_scope(vec![dns.address]);
+            assert_eq!(
+                addresses(&scope).await,
+                ips(&[if bad_v4 { "::1" } else { "127.0.0.1" }])
+            );
+            stop(&scope).await;
+        }
+    }
+}
+#[tokio::test]
+async fn bootstrap_family_timeout_and_silent_second_server_preserve_completed_answers() {
+    for silent_v4 in [true, false] {
+        let responsive = peer(true, move |_, kind| {
+            (
+                if (kind == wire::TYPE_A) == silent_v4 {
+                    Reply::Silent
+                } else {
+                    Reply::Addresses(ips(&[if silent_v4 { "::1" } else { "127.0.0.1" }]))
+                },
+                Duration::ZERO,
+            )
+        })
+        .await;
+        let silent = peer(false, |_, _| (Reply::Silent, Duration::ZERO)).await;
+        let (scope, host) = new_scope(vec![responsive.address, silent.address]);
+        let began = tokio::time::Instant::now();
+        assert_eq!(
+            addresses(&scope).await,
+            ips(&[if silent_v4 { "::1" } else { "127.0.0.1" }])
+        );
+        assert!(began.elapsed() >= BOOTSTRAP_TIMEOUT);
+        assert_eq!(host.calls.lock().unwrap().len(), 4);
+        stop(&scope).await;
+    }
+}
+#[tokio::test]
+async fn bootstrap_all_failed_and_protect_denial_are_explicit_without_fallback() {
+    let dns = peer(false, |_, kind| {
+        (
+            if kind == wire::TYPE_A {
+                Reply::ServFail
+            } else {
+                Reply::WrongId
+            },
+            Duration::ZERO,
+        )
+    })
+    .await;
+    let (scope, host) = new_scope(vec![dns.address]);
+    let error = scope.run(lookup_host(ENDPOINT, 443)).await.unwrap_err();
+    assert!(error.to_string().contains("A and AAAA"));
+    assert_eq!(dns.seen.lock().unwrap().len(), 2);
+    host.deny.store(true, Ordering::SeqCst);
+    assert!(scope.run(lookup_host(ENDPOINT, 443)).await.is_err());
+    assert_eq!(
+        dns.seen.lock().unwrap().len(),
+        2,
+        "denied lookup sent no datagrams"
+    );
+    assert_eq!(host.calls.lock().unwrap().len(), 4);
+    stop(&scope).await;
+    let silent = peer(true, |_, _| (Reply::Silent, Duration::ZERO)).await;
+    let (scope, host) = new_scope(vec![silent.address]);
+    let error = timeout(
+        Duration::from_secs(6),
+        scope.run(lookup_host(ENDPOINT, 443)),
+    )
+    .await
+    .unwrap()
+    .unwrap_err();
+    assert!(error.to_string().contains("A and AAAA"));
+    assert_eq!(host.calls.lock().unwrap().len(), 2);
+    stop(&scope).await;
+}
+#[tokio::test]
+async fn bootstrap_endpoint_and_numeric_destination_authority_precede_any_query() {
+    let dns = peer(true, |_, _| {
+        panic!("unauthorized name must never reach resolver")
+    })
+    .await;
+    let (scope, host) = new_scope(vec![dns.address]);
+    for name in [ALIAS, "user.fixture.invalid", "relay.fixture.invalid"] {
+        assert!(scope.run(lookup_host(name, 443)).await.is_err());
+    }
+    assert_eq!(
+        scope
+            .run(lookup_host("::1", 443))
+            .await
+            .unwrap()
+            .next()
+            .unwrap(),
+        "[::1]:443".parse().unwrap()
+    );
+    assert!(host.calls.lock().unwrap().is_empty());
+    assert!(dns.seen.lock().unwrap().is_empty());
+    stop(&scope).await;
+    // Documentation-only IP: policy must reject before creating/sending a socket.
+    let (scope, host) = new_scope(vec!["192.0.2.53:53".parse().unwrap()]);
+    assert!(scope.run(lookup_host(ENDPOINT, 443)).await.is_err());
+    assert!(host.calls.lock().unwrap().is_empty());
+    stop(&scope).await;
+}
+#[tokio::test]
+async fn bootstrap_cname_is_bounded_endpoint_work_not_new_lookup_authority() {
+    let dns = peer(true, |name, kind| {
+        (
+            if name == ENDPOINT {
+                Reply::Cname(ALIAS.into())
+            } else {
+                assert_eq!(name, ALIAS);
+                Reply::Addresses(ips(&[if kind == wire::TYPE_A {
+                    "127.0.0.1"
+                } else {
+                    "::1"
+                }]))
+            },
+            Duration::ZERO,
+        )
+    })
+    .await;
+    let (scope, host) = new_scope(vec![dns.address]);
+    assert_eq!(addresses(&scope).await, ips(&["127.0.0.1", "::1"]));
+    assert!(scope.run(lookup_host(ALIAS, 443)).await.is_err());
+    assert_eq!(host.calls.lock().unwrap().len(), 4);
+    stop(&scope).await;
+    let looping = peer(false, |_, _| (Reply::Cname(ALIAS.into()), Duration::ZERO)).await;
+    let (scope, host) = new_scope(vec![looping.address]);
+    assert!(
+        timeout(
+            Duration::from_secs(6),
+            scope.run(lookup_host(ENDPOINT, 443))
+        )
+        .await
+        .unwrap()
+        .is_err()
+    );
+    assert!(
+        host.calls.lock().unwrap().len() <= 18,
+        "existing eight-hop CNAME cap per family"
+    );
+    stop(&scope).await;
+}
+#[tokio::test]
+async fn bootstrap_cancellation_drops_all_eight_tracked_queries_and_never_retries() {
+    let mut peers = Vec::new();
+    for ipv6 in [false, true, false, true] {
+        peers.push(peer(ipv6, |_, _| (Reply::Silent, Duration::ZERO)).await);
+    }
+    let (scope, host) = new_scope(peers.iter().map(|peer| peer.address).collect());
+    // Return a tuple so the scoped future is not itself an awaitable result;
+    // the caller keeps the tracked operation handle and can cancel/join it.
+    let (operation,) = scope
+        .run(async { (vp_core::task_scope::spawn(lookup_host(ENDPOINT, 443)),) })
+        .await;
+    timeout(Duration::from_secs(1), async {
+        loop {
+            if peers
+                .iter()
+                .map(|peer| peer.seen.lock().unwrap().len())
+                .sum::<usize>()
+                == 8
+            {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert_eq!(host.calls.lock().unwrap().len(), 8);
+    assert!(
+        scope.snapshot().work <= 9,
+        "one caller plus at most eight DNS tasks"
+    );
+    operation.abort();
+    assert!(operation.await.unwrap_err().is_cancelled());
+    stop(&scope).await;
+    tokio::time::sleep(Duration::from_millis(20)).await;
+    assert_eq!(
+        host.calls.lock().unwrap().len(),
+        8,
+        "no retry after cancellation"
+    );
+}
diff --git a/crates/vp-dns/src/lib.rs b/crates/vp-dns/src/lib.rs
index e2f085b..ecc0d76 100644
--- a/crates/vp-dns/src/lib.rs
+++ b/crates/vp-dns/src/lib.rs
@@ -20,6 +20,9 @@ use vp_common::{Error, Host, Result};
 pub use wire::QType;
 
 const QUERY_TIMEOUT: Duration = Duration::from_secs(3);
