+    pub fn new_with_options(
+        bind: &str,
+        port: u16,
+        tag: &str,
+        users: Vec<(String, String)>,
+        cert_pem: Vec<u8>,
+        key_pem: Vec<u8>,
+        options: TuicServerOptions,
+    ) -> Result<Self> {
+        options.validate()?;
+        if users.is_empty() || users.len() > 1024 {
+            return Err(Error::Config("tuic: 1..1024 users required".into()));
+        }
+        let mut ids = std::collections::HashSet::new();
+        for (uuid, password) in &users {
+            let canonical = uuid.len() == 36
+                && uuid.bytes().enumerate().all(|(index, b)| {
+                    if [8, 13, 18, 23].contains(&index) {
+                        b == b'-'
+                    } else {
+                        b.is_ascii_hexdigit() && !b.is_ascii_uppercase()
+                    }
+                });
+            if !canonical
+                || password.is_empty()
+                || password.len() > 1024
+                || !ids.insert(parse_uuid16(uuid)?)
+            {
+                return Err(Error::Config(
+                    "tuic: invalid or duplicate credential".into(),
+                ));
+            }
+        }
+        if cert_pem.is_empty()
+            || cert_pem.len() > 1024 * 1024
+            || key_pem.is_empty()
+            || key_pem.len() > 65536
+        {
+            return Err(Error::Config(
+                "tuic: missing or oversized TLS identity".into(),
+            ));
+        }
+        let mut inbound = Self::new(bind, port, tag, users, cert_pem, key_pem);
+        inbound.options = Some(options);
+        Ok(inbound)
+    }
+
+    fn permits_udp_source(&self, native: bool) -> bool {
+        self.options
+            .as_ref()
+            .is_none_or(|options| options.udp_relay_mode.allows(native))
     }
 }
 
