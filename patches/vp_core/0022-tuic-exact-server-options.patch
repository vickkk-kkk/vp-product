+#[cfg(test)]
+mod explicit_server_options_tests {
+    use super::*;
+
+    #[test]
+    fn exact_congestion_selection_builds_the_requested_quinn_controller() {
+        use quinn::congestion::{Bbr, Cubic, NewReno};
+        let now = std::time::Instant::now();
+        assert!(
+            TuicCongestionControl::Cubic
+                .factory()
+                .build(now, 1200)
+                .into_any()
+                .is::<Cubic>()
+        );
+        assert!(
+            TuicCongestionControl::NewReno
+                .factory()
+                .build(now, 1200)
+                .into_any()
+                .is::<NewReno>()
+        );
+        assert!(
+            TuicCongestionControl::Bbr
+                .factory()
+                .build(now, 1200)
+                .into_any()
+                .is::<Bbr>()
+        );
+    }
+    #[test]
+    fn mode_gate_rejects_cross_carrier_packets() {
+        assert!(TuicUdpRelayMode::Native.allows(true));
+        assert!(!TuicUdpRelayMode::Native.allows(false));
+        assert!(TuicUdpRelayMode::Quic.allows(false));
+        assert!(!TuicUdpRelayMode::Quic.allows(true));
+    }
+    #[test]
+    fn alpn_is_not_silently_replaced() {
+        for alpn in [
+            vec![],
+            vec![b"h2".to_vec()],
+            vec![b"h3".to_vec(), b"h2".to_vec()],
+        ] {
+            assert!(
+                TuicServerOptions {
+                    congestion_control: TuicCongestionControl::Bbr,
+                    udp_relay_mode: TuicUdpRelayMode::Native,
+                    alpn
+                }
+                .validate()
+                .is_err()
+            );
+        }
+        assert!(
+            TuicServerOptions {
+                congestion_control: TuicCongestionControl::NewReno,
+                udp_relay_mode: TuicUdpRelayMode::Quic,
+                alpn: vec![b"h3".to_vec()]
+            }
+            .validate()
+            .is_ok()
+        );
+    }
+    #[test]
+    fn invalid_users_are_rejected_before_tls_or_udp_bind() {
+        let options = TuicServerOptions {
+            congestion_control: TuicCongestionControl::Cubic,
+            udp_relay_mode: TuicUdpRelayMode::Native,
+            alpn: vec![b"h3".to_vec()],
+        };
+        for users in [
+            vec![],
+            vec![("not-uuid".into(), "fixture".into())],
+            vec![("12345678-1234-1234-1234-123456789abc".into(), String::new())],
+            vec![(
+                "12345678-1234-1234-1234-123456789ABC".into(),
+                "fixture".into(),
+            )],
+        ] {
+            assert!(
+                TuicInbound::new_with_options(
+                    "127.0.0.1",
+                    0,
+                    "fixture",
+                    users,
+                    vec![1],
+                    vec![1],
+                    options.clone()
+                )
+                .is_err()
+            );
+        }
+    }
+}
