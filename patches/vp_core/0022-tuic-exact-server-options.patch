+/// Explicit server congestion selection. The factory is used by Quinn, not just
+/// retained as metadata in a product configuration.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TuicCongestionControl {
+    Cubic,
+    NewReno,
+    Bbr,
+}
+impl TuicCongestionControl {
+    fn factory(self) -> Arc<dyn quinn::congestion::ControllerFactory + Send + Sync> {
+        match self {
+            Self::Cubic => Arc::new(quinn::congestion::CubicConfig::default()),
+            Self::NewReno => Arc::new(quinn::congestion::NewRenoConfig::default()),
+            Self::Bbr => Arc::new(quinn::congestion::BbrConfig::default()),
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TuicUdpRelayMode {
+    Native,
+    Quic,
+}
+impl TuicUdpRelayMode {
+    fn allows(self, native: bool) -> bool {
+        native == matches!(self, Self::Native)
+    }
+}
+#[derive(Clone, Debug)]
+pub struct TuicServerOptions {
+    pub congestion_control: TuicCongestionControl,
+    pub udp_relay_mode: TuicUdpRelayMode,
+    pub alpn: Vec<Vec<u8>>,
+}
+impl TuicServerOptions {
+    fn validate(&self) -> Result<()> {
+        // The supported server profile is exact h3, not arbitrary ignored ALPN.
+        if self.alpn != [b"h3".to_vec()] {
+            return Err(Error::Config("tuic: server ALPN must be exactly h3".into()));
+        }
+        Ok(())
+    }
+}
