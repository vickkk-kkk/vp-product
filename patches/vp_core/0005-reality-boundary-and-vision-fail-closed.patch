+    use super::validate_flow;
+
+    #[test]
+    fn unsupported_flows_are_never_downgraded() {
+        assert!(validate_flow(None).is_ok());
+        assert!(validate_flow(Some("")).is_ok());
+        for flow in ["xtls-rprx-vision", "XTLS-RPRX-VISION", " ", "future-flow"] {
+            assert!(matches!(
+                validate_flow(Some(flow)),
+                Err(vp_common::Error::Unsupported(_))
+            ));
+        }
+    }
+}
