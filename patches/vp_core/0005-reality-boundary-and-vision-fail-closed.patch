+/// Reject unsupported flow requests before dialing, writing a success response,
+/// or connecting a server-side destination. Never silently downgrade a flow.
+pub fn validate_flow(flow: Option<&str>) -> vp_common::Result<()> {
+    match flow {
+        None | Some("") => Ok(()),
+        Some("xtls-rprx-vision") => Err(vp_common::Error::Unsupported(
+            "VLESS Vision requires UUID framing and an authenticated TLS/raw-stream transition; this backend does not implement them".into(),
+        )),
+        Some(_) => Err(vp_common::Error::Unsupported(
+            "unsupported VLESS flow".into(),
+        )),
+    }
+}
+
+#[cfg(test)]
