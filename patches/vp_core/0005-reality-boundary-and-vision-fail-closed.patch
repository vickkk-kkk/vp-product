+#[tokio::test]
+async fn truncated_and_mutated_fixture_hellos_are_rejected() {
+    let mut bytes = [0; 32];
+    vp_common::rand_bytes(&mut bytes);
+    let secret = StaticSecret::from(bytes);
+    let public_key = *PublicKey::from(&secret).as_bytes();
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let client = tokio::spawn(async move {
+        let cfg = UtlsConfig {
+            fingerprint: Fingerprint::Chrome,
+            server_name: Some(NAME.into()),
+            alpn: vec![],
+            skip_cert_verify: false,
+            reality: Some(vp_transport::RealityConfig {
+                public_key,
+                short_id: SHORT_ID,
+                spider_x: None,
+            }),
+        };
+        let stream = TcpStream::connect(addr).await.unwrap();
+        assert!(utls_connect(stream, NAME, &cfg).await.is_err());
+    });
+    let capture = async {
+        let (mut stream, _) = listener.accept().await.unwrap();
+        read_fixture_hello(&mut stream).await.unwrap().1
+    };
+    let hello = tokio::time::timeout(Duration::from_secs(5), capture)
+        .await
+        .unwrap();
+    client.await.unwrap();
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    assert!(authenticate_fixture(&hello, &secret, NAME, &SHORT_ID, now).is_ok());
+    for length in 0..hello.len() {
+        assert!(authenticate_fixture(&hello[..length], &secret, NAME, &SHORT_ID, now).is_err());
+    }
+    for offset in 0..hello.len() {
+        let mut changed = hello.clone();
+        changed[offset] ^= 1;
+        assert!(
+            authenticate_fixture(&changed, &secret, NAME, &SHORT_ID, now).is_err(),
+            "mutation at byte {offset} accepted"
+        );
+    }
+}
