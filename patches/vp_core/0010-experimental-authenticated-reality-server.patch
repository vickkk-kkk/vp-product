+/// Errors intentionally omit peer-controlled strings and authentication details.
+/// This type is not a capability or certification result.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RealityAcceptError {
+    InvalidConfiguration,
+    Busy,
+    TimedOut,
+    Rejected,
+    Io,
+    Internal,
+}
+
+impl fmt::Display for RealityAcceptError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::InvalidConfiguration => "invalid experimental REALITY configuration",
+            Self::Busy => "experimental REALITY handshake capacity exhausted",
+            Self::TimedOut => "experimental REALITY handshake timed out",
+            Self::Rejected => "experimental REALITY handshake rejected",
+            Self::Io => "experimental REALITY transport I/O failed",
+            Self::Internal => "experimental REALITY cryptographic setup failed",
+        })
+    }
+}
+impl std::error::Error for RealityAcceptError {}
+
+/// Owns authentication policy and a bounded permit pool. No sockets are opened,
+/// no background tasks are spawned, and no traffic is forwarded by construction.
+/// Dropping an `accept` future drops its owned stream and releases its permit.
+pub struct ExperimentalRealityAcceptor {
+    options: ExperimentalRealityOptions,
+    permits: Arc<Semaphore>,
+}
+
+impl ExperimentalRealityAcceptor {
+    pub fn new(options: ExperimentalRealityOptions) -> Result<Self, RealityAcceptError> {
+        options.validate()?;
+        let permits = Arc::new(Semaphore::new(options.max_concurrent_handshakes));
+        Ok(Self { options, permits })
+    }
+
+    /// Authenticate a classic-X25519 ClientHello and complete the TLS 1.3
+    /// handshake. This is transport authentication, NOT VLESS user authentication.
+    /// PSK/0-RTT are rejected. Errors/cancellation drop the supplied owned stream;
+    /// there is no plaintext, ordinary-TLS, or camouflage fallback.
+    pub async fn accept<S>(
+        &self,
+        stream: S,
+    ) -> Result<AuthenticatedRealityStream<S>, RealityAcceptError>
+    where
+        S: AsyncRead + AsyncWrite + Unpin + Send,
+    {
+        let _permit = self
+            .permits
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| RealityAcceptError::Busy)?;
+        tokio::time::timeout(self.options.handshake_timeout, self.accept_inner(stream))
+            .await
+            .map_err(|_| RealityAcceptError::TimedOut)?
+    }
+
+    async fn accept_inner<S>(
+        &self,
+        mut stream: S,
+    ) -> Result<AuthenticatedRealityStream<S>, RealityAcceptError>
+    where
+        S: AsyncRead + AsyncWrite + Unpin + Send,
+    {
+        let (records, hello) = read_client_hello(&mut stream).await?;
+        let now = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_err(|_| RealityAcceptError::Internal)?;
+        let auth = authenticate_client_hello(&hello, &self.options, now)?;
+        // Feed byte-identical input to rustls. Never replace the encrypted
+        // session ID with its plaintext or the AAD's zero-filled session ID.
+        let mut acceptor = rustls::server::Acceptor::default();
+        let mut input = io::Cursor::new(records.as_slice());
+        while (input.position() as usize) < records.len() {
+            if acceptor
+                .read_tls(&mut input)
+                .map_err(|_| RealityAcceptError::Rejected)?
+                == 0
+            {
+                return Err(RealityAcceptError::Rejected);
+            }
+        }
+        let accepted = acceptor
+            .accept()
+            .map_err(|_| RealityAcceptError::Rejected)?
+            .ok_or(RealityAcceptError::Rejected)?;
+        if accepted.client_hello().server_name() != Some(auth.server_name.as_str()) {
+            return Err(RealityAcceptError::Rejected);
+        }
+        if !self.options.alpn.is_empty()
+            && !accepted.client_hello().alpn().is_some_and(|mut offered| {
+                offered.any(|name| self.options.alpn.iter().any(|allowed| name == allowed))
+            })
+        {
+            return Err(RealityAcceptError::Rejected);
+        }
+        let config = per_connection_config(&auth.key, &auth.server_name, &self.options.alpn)?;
+        let tls = StartHandshake::from_parts(accepted, stream)
+            .into_stream(Arc::new(config))
+            .await
+            .map_err(|_| RealityAcceptError::Rejected)?;
+        if tls.get_ref().1.protocol_version() != Some(rustls::ProtocolVersion::TLSv1_3)
+            || tls.get_ref().1.is_handshaking()
+        {
+            return Err(RealityAcceptError::Rejected);
+        }
+        Ok(AuthenticatedRealityStream { tls })
+    }
+}
+
+impl fmt::Debug for ExperimentalRealityAcceptor {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ExperimentalRealityAcceptor")
+            .finish_non_exhaustive()
+    }
+}
