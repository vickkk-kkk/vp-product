+/// A completed authenticated TLS stream. Raw-stream detachment is intentionally
+/// absent: this type is NOT suitable for Vision command 2. No success can be
+/// observed until rustls has verified the peer's Finished message.
+pub struct AuthenticatedRealityStream<S> {
+    tls: TlsStream<S>,
+}
+impl<S> AuthenticatedRealityStream<S> {
+    pub fn negotiated_alpn(&self) -> Option<&[u8]> {
+        self.tls.get_ref().1.alpn_protocol()
+    }
+    pub fn server_name(&self) -> Option<&str> {
+        self.tls.get_ref().1.server_name()
+    }
+}
+impl<S: AsyncRead + AsyncWrite + Unpin> AsyncRead for AuthenticatedRealityStream<S> {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().tls).poll_read(cx, buf)
+    }
+}
+impl<S: AsyncRead + AsyncWrite + Unpin> AsyncWrite for AuthenticatedRealityStream<S> {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        Pin::new(&mut self.get_mut().tls).poll_write(cx, buf)
+    }
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().tls).poll_flush(cx)
+    }
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().tls).poll_shutdown(cx)
+    }
+}
