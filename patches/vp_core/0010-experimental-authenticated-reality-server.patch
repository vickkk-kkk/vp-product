+        }
+        assert!(!authentic(&fixture(&opts, payload(), None, true), &opts));
+        // Unknown non-security extension is authenticated as AAD, then left for
+        // rustls to validate; it cannot silently alter authentication policy.
+        assert!(authentic(
+            &fixture(&opts, payload(), Some((12345, &[1, 2])), false),
