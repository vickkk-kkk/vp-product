+#[tokio::test]
+async fn ordinary_tls_client_is_not_authorized_as_reality() {
+    let (options, _) = make_options();
+    let acceptor = ExperimentalRealityAcceptor::new(options).unwrap();
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        assert!(matches!(
+            acceptor.accept(stream).await,
+            Err(RealityAcceptError::Rejected)
+        ));
+    });
+    let config = rustls::ClientConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_protocol_versions(&[&rustls::version::TLS13])
+    .unwrap()
+    .with_root_certificates(rustls::RootCertStore::empty())
+    .with_no_client_auth();
+    let action = async {
+        let tcp = TcpStream::connect(addr).await.unwrap();
+        let name = rustls::pki_types::ServerName::try_from(NAME).unwrap();
+        assert!(
+            tokio_rustls::TlsConnector::from(Arc::new(config))
+                .connect(name, tcp)
+                .await
+                .is_err()
+        );
+        server.await.unwrap();
+    };
+    tokio::time::timeout(Duration::from_secs(5), action)
+        .await
+        .unwrap();
+}
