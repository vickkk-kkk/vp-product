+#[tokio::test]
+async fn stalled_handshake_times_out_and_releases_capacity() {
+    let (mut opts, _) = make_options();
+    opts.handshake_timeout = Duration::from_millis(20);
+    opts.max_concurrent_handshakes = 1;
+    let acceptor = ExperimentalRealityAcceptor::new(opts).unwrap();
+    let (stream, _peer) = tokio::io::duplex(1);
+    assert!(matches!(
+        acceptor.accept(stream).await,
+        Err(RealityAcceptError::TimedOut)
+    ));
+    let (stream, peer) = tokio::io::duplex(1);
+    drop(peer);
+    assert!(matches!(
+        acceptor.accept(stream).await,
+        Err(RealityAcceptError::Io)
+    ));
+}
