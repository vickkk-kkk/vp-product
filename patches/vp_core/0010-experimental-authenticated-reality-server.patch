+
+    #[test]
+    fn duplicate_extensions_psk_early_data_and_low_order_shares_are_rejected() {
+        let opts = options();
+        for extension in [
+            (0, &[][..]),
+            (43, &[2, 3, 4][..]),
+            (51, &[][..]),
+            (41, &[][..]),
+            (42, &[][..]),
+        ] {
+            assert!(!authentic(
+                &fixture(&opts, payload(), Some(extension), false),
