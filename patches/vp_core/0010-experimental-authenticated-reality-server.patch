+struct Reader<'a>(&'a [u8]);
+impl<'a> Reader<'a> {
+    fn take(&mut self, n: usize) -> Result<&'a [u8], RealityAcceptError> {
+        let (head, tail) = self
+            .0
+            .split_at_checked(n)
+            .ok_or(RealityAcceptError::Rejected)?;
+        self.0 = tail;
+        Ok(head)
+    }
+    fn byte(&mut self) -> Result<u8, RealityAcceptError> {
+        Ok(self.take(1)?[0])
+    }
+    fn word(&mut self) -> Result<usize, RealityAcceptError> {
+        let b = self.take(2)?;
+        Ok(u16::from_be_bytes([b[0], b[1]]) as usize)
+    }
+    fn vector(&mut self) -> Result<&'a [u8], RealityAcceptError> {
+        let n = self.word()?;
+        self.take(n)
+    }
+}
+
+struct AuthenticatedHello {
+    key: Zeroizing<[u8; 32]>,
+    server_name: String,
+}
+
+fn authenticate_client_hello(
+    hello: &[u8],
+    options: &ExperimentalRealityOptions,
+    now: Duration,
+) -> Result<AuthenticatedHello, RealityAcceptError> {
+    let rejected = RealityAcceptError::Rejected;
+    if hello.len() > MAX_HELLO_BYTES || hello.len() < 71 || hello[0] != 1 {
+        return Err(rejected);
+    }
+    let declared = ((hello[1] as usize) << 16) | ((hello[2] as usize) << 8) | hello[3] as usize;
+    if declared != hello.len() - 4 {
+        return Err(rejected);
+    }
+    let mut r = Reader(&hello[4..]);
+    if r.take(2)? != [3, 3] {
+        return Err(rejected);
+    }
+    let random = r.take(32)?;
+    if r.byte()? != 32 {
+        return Err(rejected);
+    }
+    let session_id = r.take(32)?;
+    let suites = r.vector()?;
+    if suites.is_empty()
+        || suites.len() % 2 != 0
+        || !suites.chunks_exact(2).any(|s| matches!(s, [0x13, 1..=3]))
+    {
+        return Err(rejected);
+    }
+    if r.byte()? != 1 || r.byte()? != 0 {
+        return Err(rejected);
+    }
+    let mut extensions = Reader(r.vector()?);
+    if !r.0.is_empty() {
+        return Err(rejected);
+    }
+    // All attacker-controlled allocations are bounded by MAX_HELLO_BYTES.
+    let mut seen = std::collections::HashSet::new();
+    let mut sni = None;
+    let mut public = None;
+    let mut tls13 = false;
+    let mut ed25519 = false;
+    let mut x25519_supported = false;
+    while !extensions.0.is_empty() {
+        let ty = extensions.word()?;
+        if !seen.insert(ty) {
+            return Err(rejected);
+        }
+        let data = extensions.vector()?;
+        let mut e = Reader(data);
+        match ty {
+            0 => {
+                let mut names = Reader(e.vector()?);
+                if !e.0.is_empty() || names.byte()? != 0 {
+                    return Err(rejected);
+                }
+                sni = Some(names.vector()?);
+                if !names.0.is_empty() {
+                    return Err(rejected);
+                }
+            }
+            10 | 13 => {
+                let values = e.vector()?;
+                if values.is_empty() || values.len() % 2 != 0 || !e.0.is_empty() {
+                    return Err(rejected);
+                }
+                if ty == 10 {
+                    x25519_supported = values.chunks_exact(2).any(|v| v == [0, 29]);
+                } else {
+                    ed25519 = values.chunks_exact(2).any(|v| v == [8, 7]);
+                }
+            }
+            41 | 42 => return Err(rejected), // no PSK resumption or 0-RTT bypass
+            43 => {
+                let size = e.byte()? as usize;
+                let versions = e.take(size)?;
+                if size == 0 || size % 2 != 0 || !e.0.is_empty() {
+                    return Err(rejected);
+                }
+                tls13 = versions.chunks_exact(2).any(|v| v == [3, 4]);
+            }
+            51 => {
+                let mut shares = Reader(e.vector()?);
+                if !e.0.is_empty() {
+                    return Err(rejected);
+                }
+                let mut groups = std::collections::HashSet::new();
+                while !shares.0.is_empty() {
+                    let group = shares.word()?;
+                    let bytes = shares.vector()?;
+                    if !groups.insert(group) || bytes.is_empty() {
+                        return Err(rejected);
+                    }
+                    if group == 29 {
+                        public = Some(<[u8; 32]>::try_from(bytes).map_err(|_| rejected)?);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    let sni = sni.ok_or(rejected)?;
+    if !tls13
+        || !ed25519
+        || !x25519_supported
+        || !options
+            .server_names
+            .iter()
+            .any(|name| name.as_bytes() == sni)
+    {
+        return Err(rejected);
+    }
+    let shared = options
+        .private_key
+        .diffie_hellman(&PublicKey::from(public.ok_or(rejected)?));
+    if !shared.was_contributory() {
+        return Err(rejected);
+    }
+    struct KeyLength;
+    impl hkdf::KeyType for KeyLength {
+        fn len(&self) -> usize {
+            32
+        }
+    }
+    let prk = hkdf::Salt::new(hkdf::HKDF_SHA256, &random[..20]).extract(shared.as_bytes());
+    let mut key = Zeroizing::new([0; 32]);
+    prk.expand(&[b"REALITY"], KeyLength)
+        .map_err(|_| RealityAcceptError::Internal)?
+        .fill(key.as_mut())
+        .map_err(|_| RealityAcceptError::Internal)?;
+    let mut aad = hello.to_vec();
+    aad[39..71].fill(0);
+    let mut payload = Zeroizing::new(session_id.to_vec());
+    let cipher = aead::LessSafeKey::new(
+        aead::UnboundKey::new(&aead::AES_256_GCM, key.as_ref())
+            .map_err(|_| RealityAcceptError::Internal)?,
+    );
+    let nonce = aead::Nonce::try_assume_unique_for_key(&random[20..]).map_err(|_| rejected)?;
+    let plain = cipher
+        .open_in_place(nonce, aead::Aad::from(aad), &mut payload)
+        .map_err(|_| rejected)?;
+    if plain.len() != 16 || plain[3] != 0 {
+        return Err(rejected);
+    }
+    let version = <[u8; 3]>::try_from(&plain[..3]).map_err(|_| rejected)?;
+    if options.min_client_version.is_some_and(|min| version < min)
+        || options.max_client_version.is_some_and(|max| version > max)
+    {
+        return Err(rejected);
+    }
+    let mut found = Choice::from(0);
+    for short_id in &options.short_ids {
+        found |= short_id.as_slice().ct_eq(&plain[8..]);
+    }
+    if !bool::from(found) {
+        return Err(rejected);
+    }
+    let stamp = u32::from_be_bytes(plain[4..8].try_into().map_err(|_| rejected)?) as u64;
+    // The peer timestamp is whole seconds; retaining the local fraction avoids
+    // accidentally extending the configured freshness window by up to a second.
+    if now.abs_diff(Duration::from_secs(stamp)) > options.max_time_difference {
+        return Err(rejected);
+    }
+    let server_name = std::str::from_utf8(sni).map_err(|_| rejected)?.to_owned();
+    Ok(AuthenticatedHello { key, server_name })
+}
+
+async fn read_client_hello<S: AsyncRead + Unpin>(
+    stream: &mut S,
+) -> Result<(Vec<u8>, Vec<u8>), RealityAcceptError> {
+    let mut records = Vec::new();
+    let mut hello = Vec::new();
+    for _ in 0..MAX_HELLO_RECORDS {
+        let mut header = [0; 5];
+        stream
+            .read_exact(&mut header)
+            .await
+            .map_err(|_| RealityAcceptError::Io)?;
+        let size = u16::from_be_bytes([header[3], header[4]]) as usize;
+        if header[0] != 22
+            || header[1] != 3
+            || !(1..=3).contains(&header[2])
+            || size == 0
+            || size > MAX_HELLO_BYTES
+            || hello.len() + size > MAX_HELLO_BYTES
+        {
+            return Err(RealityAcceptError::Rejected);
+        }
+        let offset = hello.len();
+        hello.resize(offset + size, 0);
+        stream
+            .read_exact(&mut hello[offset..])
+            .await
+            .map_err(|_| RealityAcceptError::Io)?;
+        records.extend_from_slice(&header);
+        records.extend_from_slice(&hello[offset..]);
+        if hello.len() >= 4 {
+            let size = ((hello[1] as usize) << 16) | ((hello[2] as usize) << 8) | hello[3] as usize;
+            if hello[0] != 1 || size + 4 > MAX_HELLO_BYTES {
+                return Err(RealityAcceptError::Rejected);
+            }
+            if hello.len() >= size + 4 {
+                if hello.len() != size + 4 {
+                    return Err(RealityAcceptError::Rejected);
+                }
+                return Ok((records, hello));
+            }
+        }
+    }
+    Err(RealityAcceptError::Rejected)
+}
+
+struct CertificateMac {
+    public: Vec<u8>,
+    signature: Vec<u8>,
+}
+impl RemoteKeyPair for CertificateMac {
+    fn public_key(&self) -> &[u8] {
+        &self.public
+    }
+    fn sign(&self, _: &[u8]) -> Result<Vec<u8>, rcgen::Error> {
+        Ok(self.signature.clone())
+    }
+    fn algorithm(&self) -> &'static SignatureAlgorithm {
+        &rcgen::PKCS_ED25519
+    }
+}
+
+fn per_connection_config(
+    auth: &[u8; 32],
+    name: &str,
+    alpn: &[Vec<u8>],
+) -> Result<rustls::ServerConfig, RealityAcceptError> {
+    let internal = RealityAcceptError::Internal;
+    let pair = KeyPair::generate_for(&rcgen::PKCS_ED25519).map_err(|_| internal)?;
+    let public = pair.public_key_raw().to_vec();
+    let signature = hmac::sign(&hmac::Key::new(hmac::HMAC_SHA512, auth), &public)
+        .as_ref()
+        .to_vec();
+    let cert_key = KeyPair::from_remote(Box::new(CertificateMac { public, signature }))
+        .map_err(|_| internal)?;
+    let cert = CertificateParams::new(vec![name.to_owned()])
+        .map_err(|_| internal)?
+        .self_signed(&cert_key)
+        .map_err(|_| internal)?;
+    let mut config = rustls::ServerConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_protocol_versions(&[&rustls::version::TLS13])
+    .map_err(|_| internal)?
+    .with_no_client_auth()
+    .with_single_cert(
+        vec![cert.der().clone()],
+        PrivatePkcs8KeyDer::from(pair.serialize_der()).into(),
+    )
+    .map_err(|_| internal)?;
+    config.send_tls13_tickets = 0;
+    config.max_early_data_size = 0;
+    config.session_storage = Arc::new(rustls::server::NoServerSessionStorage {});
+    config.alpn_protocols = alpn.to_vec();
+    Ok(config)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::io::AsyncWriteExt;
+
+    const NAME: &str = "reality-test.example.invalid";
+    const NOW: u32 = 1_800_000_000;
+    const SHORT_ID: [u8; 8] = [1, 2, 3, 4, 0, 0, 0, 0];
+
+    fn options() -> ExperimentalRealityOptions {
+        let mut secret = [0; 32];
+        vp_common::rand_bytes(&mut secret);
+        ExperimentalRealityOptions::new(
+            StaticSecret::from(secret),
+            vec![NAME.into()],
+            vec![SHORT_ID],
+        )
+    }
+    fn extension(out: &mut Vec<u8>, ty: u16, bytes: &[u8]) {
+        out.extend_from_slice(&ty.to_be_bytes());
+        out.extend_from_slice(&(bytes.len() as u16).to_be_bytes());
+        out.extend_from_slice(bytes);
+    }
+    fn payload() -> [u8; 16] {
+        let mut result = [0; 16];
+        result[..3].copy_from_slice(&[1, 8, 1]);
+        result[4..8].copy_from_slice(&NOW.to_be_bytes());
+        result[8..].copy_from_slice(&SHORT_ID);
+        result
+    }
+    fn fixture(
+        opts: &ExperimentalRealityOptions,
+        payload: [u8; 16],
+        extra: Option<(u16, &[u8])>,
+        low_order: bool,
+    ) -> Vec<u8> {
+        let mut private = [0; 32];
+        vp_common::rand_bytes(&mut private);
+        let private = StaticSecret::from(private);
+        let public = PublicKey::from(&private);
+        let mut random = [0; 32];
+        vp_common::rand_bytes(&mut random);
+        let mut body = vec![1, 0, 0, 0, 3, 3];
+        body.extend_from_slice(&random);
+        body.push(32);
+        body.extend_from_slice(&[0; 32]);
+        body.extend_from_slice(&[0, 2, 0x13, 1, 1, 0]);
+        let mut extensions = Vec::new();
+        let mut names = ((NAME.len() + 3) as u16).to_be_bytes().to_vec();
+        names.push(0);
+        names.extend_from_slice(&(NAME.len() as u16).to_be_bytes());
+        names.extend_from_slice(NAME.as_bytes());
+        extension(&mut extensions, 0, &names);
+        extension(&mut extensions, 10, &[0, 2, 0, 29]);
+        extension(&mut extensions, 13, &[0, 2, 8, 7]);
+        extension(&mut extensions, 43, &[2, 3, 4]);
+        let mut share = vec![0, 36, 0, 29, 0, 32];
+        share.extend_from_slice(if low_order {
+            &[0; 32]
+        } else {
+            public.as_bytes()
+        });
+        extension(&mut extensions, 51, &share);
+        if let Some((ty, bytes)) = extra {
+            extension(&mut extensions, ty, bytes);
+        }
+        body.extend_from_slice(&(extensions.len() as u16).to_be_bytes());
+        body.extend_from_slice(&extensions);
+        let size = (body.len() - 4) as u32;
+        body[1..4].copy_from_slice(&size.to_be_bytes()[1..]);
+        let shared = private.diffie_hellman(&PublicKey::from(&opts.private_key));
+        let hk = hkdf::Salt::new(hkdf::HKDF_SHA256, &random[..20]).extract(shared.as_bytes());
+        struct Length;
+        impl hkdf::KeyType for Length {
+            fn len(&self) -> usize {
+                32
+            }
+        }
+        let mut key = Zeroizing::new([0; 32]);
+        hk.expand(&[b"REALITY"], Length)
+            .unwrap()
+            .fill(key.as_mut())
+            .unwrap();
+        let cipher = aead::LessSafeKey::new(
+            aead::UnboundKey::new(&aead::AES_256_GCM, key.as_ref()).unwrap(),
+        );
+        let nonce = aead::Nonce::try_assume_unique_for_key(&random[20..]).unwrap();
+        let mut encrypted = payload.to_vec();
+        cipher
+            .seal_in_place_append_tag(nonce, aead::Aad::from(&body), &mut encrypted)
+            .unwrap();
+        body[39..71].copy_from_slice(&encrypted);
+        body
+    }
+    fn authentic(hello: &[u8], opts: &ExperimentalRealityOptions) -> bool {
+        authenticate_client_hello(hello, opts, Duration::from_secs(NOW as u64)).is_ok()
+    }
+
+    #[test]
+    fn strict_authentication_rejects_every_truncation_and_byte_mutation() {
+        let opts = options();
+        let hello = fixture(&opts, payload(), None, false);
+        assert!(authentic(&hello, &opts));
+        for end in 0..hello.len() {
+            assert!(!authentic(&hello[..end], &opts));
+        }
+        for offset in 0..hello.len() {
+            let mut changed = hello.clone();
+            changed[offset] ^= 1;
+            assert!(
+                !authentic(&changed, &opts),
+                "accepted byte mutation {offset}"
+            );
+        }
+    }
+
+    #[test]
+    fn malformed_bounded_corpus_never_panics_or_authenticates() {
+        let opts = options();
+        for length in 0..2048 {
+            let mut bytes = vec![0; length];
+            vp_common::rand_bytes(&mut bytes);
+            assert!(!authentic(&bytes, &opts));
+        }
+        assert!(!authentic(&vec![0; MAX_HELLO_BYTES + 1], &opts));
+    }
+
+    #[test]
+    fn valid_aead_does_not_bypass_policy_or_reserved_fields() {
+        let mut opts = options();
+        let mut plain = payload();
+        plain[3] = 1;
+        assert!(!authentic(&fixture(&opts, plain, None, false), &opts));
+        plain = payload();
+        plain[8] ^= 1;
+        assert!(!authentic(&fixture(&opts, plain, None, false), &opts));
+        for timestamp in [NOW - 31, NOW + 31, 0, u32::MAX] {
+            plain = payload();
+            plain[4..8].copy_from_slice(&timestamp.to_be_bytes());
+            assert!(!authentic(&fixture(&opts, plain, None, false), &opts));
+        }
