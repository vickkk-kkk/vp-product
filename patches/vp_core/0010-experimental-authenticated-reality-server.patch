+//! Experimental authenticated REALITY TLS transport, **not a complete REALITY server**.
+//!
+//! This module is excluded from default builds and is not connected to any App
+//! listener factory. It provides bounded classic-X25519 ClientHello authentication
+//! and resumes the unchanged TLS transcript with rustls and a per-connection
+//! Ed25519 certificate. Its certificate MAC follows the publicly inspectable
+//! REALITY client contract; TLS signatures, key schedule, records and Finished
+//! verification remain entirely within rustls/ring.
+//!
+//! **Do not deploy as an equivalent of REALITY.** Target-handshake mirroring,
+//! unauthenticated camouflage forwarding, hybrid-only ML-KEM ClientHellos,
+//! ML-DSA certificate verification, and Vision raw-stream transitions are absent.
+//! In particular rejection closes the stream rather than disguising this endpoint
+//! as a target website. Independent-client interoperability is not certified.
+//!
+//! Source reference: XTLS/Xray-core
+//! `0afec66085a85191e9dd2a4a6646c7c9a94688d1`,
+//! `transport/internet/reality/reality.go`. Independently authored Rust; no
+//! reference implementation source, TLS engine or GPL code is embedded here.
+
+use std::fmt;
+use std::io;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::task::{Context, Poll};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use rcgen::{CertificateParams, KeyPair, RemoteKeyPair, SignatureAlgorithm};
+use ring::{aead, hkdf, hmac};
+use rustls::pki_types::{PrivatePkcs8KeyDer, ServerName};
+use subtle::{Choice, ConstantTimeEq};
+use tokio::io::{AsyncRead, AsyncReadExt, AsyncWrite, ReadBuf};
+use tokio::sync::Semaphore;
+use tokio_rustls::server::{StartHandshake, TlsStream};
+use x25519_dalek::{PublicKey, StaticSecret};
+use zeroize::Zeroizing;
+
+const MAX_HELLO_BYTES: usize = 16_384;
+const MAX_HELLO_RECORDS: usize = 32;
+const MAX_SERVER_NAMES: usize = 64;
+const MAX_SHORT_IDS: usize = 1_024;
+
+/// Explicit experimental options. Private key bytes are never serialized or
+/// included in Debug. The caller must supply a securely generated static key.
+/// Empty short IDs are represented by an explicitly configured eight-zero array;
+/// an empty *list* never permits arbitrary clients.
+pub struct ExperimentalRealityOptions {
+    pub private_key: StaticSecret,
+    pub server_names: Vec<String>,
+    pub short_ids: Vec<[u8; 8]>,
+    pub alpn: Vec<Vec<u8>>,
+    pub min_client_version: Option<[u8; 3]>,
+    pub max_client_version: Option<[u8; 3]>,
+    /// Mandatory freshness window, greater than zero and at most five minutes.
+    pub max_time_difference: Duration,
+    /// Total ClientHello/authentication/TLS-handshake budget (at most 60 seconds).
+    pub handshake_timeout: Duration,
+    /// No unbounded task spawning or permit queueing occurs in this module.
+    pub max_concurrent_handshakes: usize,
+}
+
+impl ExperimentalRealityOptions {
+    pub fn new(
+        private_key: StaticSecret,
+        server_names: Vec<String>,
+        short_ids: Vec<[u8; 8]>,
+    ) -> Self {
+        Self {
+            private_key,
+            server_names,
+            short_ids,
+            alpn: Vec::new(),
+            min_client_version: None,
+            max_client_version: None,
+            max_time_difference: Duration::from_secs(30),
+            handshake_timeout: Duration::from_secs(5),
+            max_concurrent_handshakes: 64,
+        }
+    }
+
+    fn validate(&self) -> Result<(), RealityAcceptError> {
+        let invalid = RealityAcceptError::InvalidConfiguration;
+        if self.server_names.is_empty()
+            || self.server_names.len() > MAX_SERVER_NAMES
+            || self.short_ids.is_empty()
+            || self.short_ids.len() > MAX_SHORT_IDS
+            || self.alpn.len() > 16
+            || self.max_time_difference < Duration::from_secs(1)
+            || self.max_time_difference > Duration::from_secs(300)
+            || self.handshake_timeout.is_zero()
+            || self.handshake_timeout > Duration::from_secs(60)
+            || !(1..=1024).contains(&self.max_concurrent_handshakes)
+        {
+            return Err(invalid);
+        }
+        if let (Some(min), Some(max)) = (self.min_client_version, self.max_client_version) {
+            if min > max {
+                return Err(invalid);
+            }
+        }
+        for (index, name) in self.server_names.iter().enumerate() {
+            if name.is_empty()
+                || name.len() > 253
+                || !name.is_ascii()
+                || name.ends_with('.')
+                || name != &name.to_ascii_lowercase()
+                || !matches!(
+                    ServerName::try_from(name.as_str()),
+                    Ok(ServerName::DnsName(_))
+                )
+                || self.server_names[..index].contains(name)
+            {
+                return Err(invalid);
+            }
+        }
+        for (index, id) in self.short_ids.iter().enumerate() {
+            if self.short_ids[..index].contains(id) {
+                return Err(invalid);
+            }
+        }
+        for (index, protocol) in self.alpn.iter().enumerate() {
+            if protocol.is_empty() || protocol.len() > 255 || self.alpn[..index].contains(protocol)
+            {
+                return Err(invalid);
+            }
+        }
+        Ok(())
+    }
+}
