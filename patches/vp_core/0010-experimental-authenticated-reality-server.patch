+        opts.server_names = vec!["EXAMPLE.INVALID".into()];
+        assert!(opts.validate().is_err());
+        opts.server_names = vec![NAME.into(), NAME.into()];
+        assert!(opts.validate().is_err());
+        opts.server_names = vec![NAME.into()];
+        opts.short_ids.clear();
+        assert!(opts.validate().is_err());
+        opts.short_ids = vec![SHORT_ID, SHORT_ID];
+        assert!(opts.validate().is_err());
+        opts.short_ids = vec![SHORT_ID];
+        opts.alpn = vec![vec![]];
+        assert!(opts.validate().is_err());
+        opts.alpn = vec![vec![0; 256]];
+        assert!(opts.validate().is_err());
+        opts.alpn.clear();
+        opts.max_time_difference = Duration::ZERO;
+        assert!(opts.validate().is_err());
+        opts.max_time_difference = Duration::from_millis(1);
+        assert!(opts.validate().is_err());
+        opts.max_time_difference = Duration::from_secs(301);
+        assert!(opts.validate().is_err());
+        opts.max_time_difference = Duration::from_secs(30);
+        opts.handshake_timeout = Duration::ZERO;
+        assert!(opts.validate().is_err());
+        opts.handshake_timeout = Duration::from_secs(61);
+        assert!(opts.validate().is_err());
+        opts.handshake_timeout = Duration::from_secs(5);
+        opts.max_concurrent_handshakes = 0;
+        assert!(opts.validate().is_err());
+        opts.max_concurrent_handshakes = 1025;
+        assert!(opts.validate().is_err());
+        opts.max_concurrent_handshakes = 1;
+        opts.min_client_version = Some([2, 0, 0]);
+        opts.max_client_version = Some([1, 0, 0]);
+        assert!(opts.validate().is_err());
+    }
+
+    fn records(hello: &[u8], chunk_size: usize) -> Vec<u8> {
+        let mut encoded = Vec::new();
+        for chunk in hello.chunks(chunk_size) {
+            encoded.extend_from_slice(&[22, 3, 3]);
+            encoded.extend_from_slice(&(chunk.len() as u16).to_be_bytes());
+            encoded.extend_from_slice(chunk);
+        }
+        encoded
+    }
+    async fn read_bytes(encoded: Vec<u8>) -> Result<(Vec<u8>, Vec<u8>), RealityAcceptError> {
+        let (mut writer, mut reader) = tokio::io::duplex(encoded.len() + 1);
+        writer.write_all(&encoded).await.unwrap();
+        drop(writer);
+        read_client_hello(&mut reader).await
+    }
+    #[tokio::test]
+    async fn fragmented_records_preserve_exact_transcript_and_raw_input() {
+        let opts = options();
+        let hello = fixture(&opts, payload(), None, false);
+        for size in [7, 31, hello.len()] {
+            let encoded = records(&hello, size);
+            let (raw, parsed) = read_bytes(encoded.clone()).await.unwrap();
+            assert_eq!(raw, encoded);
+            assert_eq!(parsed, hello);
+        }
+    }
+    #[tokio::test]
+    async fn excessive_fragmentation_oversize_and_trailing_messages_rejected() {
+        let opts = options();
+        let hello = fixture(&opts, payload(), None, false);
+        assert!(matches!(
+            read_bytes(records(&hello, 1)).await,
+            Err(RealityAcceptError::Rejected)
+        ));
+        assert!(matches!(
+            read_bytes(vec![22, 3, 3, 0xff, 0xff]).await,
+            Err(RealityAcceptError::Rejected)
+        ));
+        assert!(matches!(
+            read_bytes(vec![22, 3, 3, 0, 0]).await,
+            Err(RealityAcceptError::Rejected)
+        ));
+        assert!(matches!(
+            read_bytes(vec![23, 3, 3, 0, 1, 0]).await,
+            Err(RealityAcceptError::Rejected)
+        ));
+        let mut extra = hello.clone();
+        extra.extend_from_slice(&[1, 0, 0, 0]);
+        assert!(matches!(
+            read_bytes(records(&extra, extra.len())).await,
+            Err(RealityAcceptError::Rejected)
+        ));
+        assert!(matches!(
+            read_bytes(vec![22, 3]).await,
+            Err(RealityAcceptError::Io)
+        ));
+    }
