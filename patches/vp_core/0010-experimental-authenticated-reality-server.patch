+//! Same-engine loopback checks for the opt-in experimental source. These are not
+//! independent interoperability, a VLESS profile, camouflage, or Vision tests.
+#![cfg(feature = "experimental-reality-server")]
+
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use vp_transport::RealityConfig;
+use vp_transport::reality_server::{
+    ExperimentalRealityAcceptor, ExperimentalRealityOptions, RealityAcceptError,
+};
+use vp_transport::utls::{Fingerprint, UtlsConfig, utls_connect};
+use x25519_dalek::{PublicKey, StaticSecret};
+
+const NAME: &str = "reality-test.example.invalid";
+const SHORT_ID: [u8; 8] = [1, 2, 3, 4, 0, 0, 0, 0];
+fn make_options() -> (ExperimentalRealityOptions, [u8; 32]) {
+    let mut key = [0; 32];
+    vp_common::rand_bytes(&mut key);
+    let private = StaticSecret::from(key);
+    let public = *PublicKey::from(&private).as_bytes();
+    (
+        ExperimentalRealityOptions::new(private, vec![NAME.into()], vec![SHORT_ID]),
+        public,
+    )
+}
+fn client_config(public_key: [u8; 32]) -> UtlsConfig {
+    UtlsConfig {
+        fingerprint: Fingerprint::Chrome,
+        server_name: Some(NAME.into()),
+        alpn: vec![],
+        skip_cert_verify: false,
+        reality: Some(RealityConfig {
+            public_key,
+            short_id: SHORT_ID,
+            spider_x: None,
+        }),
+    }
+}
+
+#[tokio::test]
+async fn experimental_transport_large_loopback_and_clean_shutdown() {
+    tokio::time::timeout(Duration::from_secs(10), async {
+        let (options, public) = make_options();
+        let acceptor = ExperimentalRealityAcceptor::new(options).unwrap();
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await.unwrap();
+            let mut tls = acceptor.accept(stream).await.unwrap();
+            assert_eq!(tls.server_name(), Some(NAME));
+            assert_eq!(tls.negotiated_alpn(), None);
+            let mut payload = vec![0; 300_000];
+            tls.read_exact(&mut payload).await.unwrap();
+            tls.write_all(&payload).await.unwrap();
+            tls.shutdown().await.unwrap();
+        });
+        let tcp = TcpStream::connect(addr).await.unwrap();
+        let mut client = utls_connect(tcp, NAME, &client_config(public))
+            .await
+            .unwrap();
+        let mut sent: Vec<u8> = (0..300_000).map(|index| (index % 251) as u8).collect();
+        // Real application zeros at TLS-record boundaries are not padding.
+        for chunk in sent.chunks_mut(16_384) {
+            *chunk.last_mut().unwrap() = 0;
+        }
+        client.write_all(&sent).await.unwrap();
+        client.flush().await.unwrap();
+        let mut received = vec![0; sent.len()];
+        client.read_exact(&mut received).await.unwrap();
+        assert_eq!(sent, received);
+        let mut tail = [0];
+        assert_eq!(client.read(&mut tail).await.unwrap(), 0);
+        server.await.unwrap();
+    })
+    .await
+    .unwrap();
+}
+
+#[derive(Clone, Copy)]
+enum Rejection {
+    Key,
+    ShortId,
+    Sni,
+    ClientVersion,
+    Alpn,
+}
+async fn rejected(case: Rejection) {
+    let (mut options, public) = make_options();
+    let mut cfg = client_config(public);
+    match case {
+        Rejection::Key => cfg.reality.as_mut().unwrap().public_key = make_options().1,
+        Rejection::ShortId => cfg.reality.as_mut().unwrap().short_id[0] ^= 1,
+        Rejection::Sni => cfg.server_name = Some("wrong.example.invalid".into()),
+        Rejection::ClientVersion => options.min_client_version = Some([255, 0, 0]),
+        Rejection::Alpn => {
+            options.alpn = vec![b"h2".to_vec()];
+            cfg.alpn = vec!["http/1.1".into()];
+        }
+    }
+    let acceptor = ExperimentalRealityAcceptor::new(options).unwrap();
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        assert!(matches!(
+            acceptor.accept(stream).await,
+            Err(RealityAcceptError::Rejected)
+        ));
+    });
+    let client = async {
+        let tcp = TcpStream::connect(addr).await.unwrap();
+        assert!(utls_connect(tcp, NAME, &cfg).await.is_err());
+        server.await.unwrap();
+    };
+    tokio::time::timeout(Duration::from_secs(5), client)
+        .await
+        .unwrap();
+}
+#[tokio::test]
+async fn wrong_key_never_yields_authenticated_stream() {
+    rejected(Rejection::Key).await;
+}
+#[tokio::test]
+async fn wrong_short_id_never_yields_authenticated_stream() {
+    rejected(Rejection::ShortId).await;
+}
+#[tokio::test]
+async fn wrong_sni_never_yields_authenticated_stream() {
+    rejected(Rejection::Sni).await;
+}
+#[tokio::test]
+async fn disallowed_client_version_never_yields_authenticated_stream() {
+    rejected(Rejection::ClientVersion).await;
+}
+#[tokio::test]
+async fn wrong_alpn_never_yields_authenticated_stream() {
+    rejected(Rejection::Alpn).await;
+}
+
+#[tokio::test]
+async fn h2_frames_over_authenticated_transport_not_vless_profile() {
+    tokio::time::timeout(Duration::from_secs(5), async {
+        let (mut options, public) = make_options();
+        options.alpn = vec![b"h2".to_vec()];
+        let acceptor = ExperimentalRealityAcceptor::new(options).unwrap();
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let (stop, mut stopped) = tokio::sync::oneshot::channel();
+        let server = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await.unwrap();
+            let tls = acceptor.accept(stream).await.unwrap();
+            assert_eq!(tls.negotiated_alpn(), Some(b"h2".as_slice()));
+            let mut connection = h2::server::handshake(tls).await.unwrap();
+            let (request, mut responder) = connection.accept().await.unwrap().unwrap();
+            assert_eq!(request.uri().path(), "/transport-check");
+            let response = http::Response::builder().status(200).body(()).unwrap();
+            let mut body = responder.send_response(response, false).unwrap();
+            body.send_data(
+                bytes::Bytes::from_static(b"h2 over authenticated TLS"),
+                true,
+            )
+            .unwrap();
+            drop(body);
+            drop(responder);
+            drop(request);
+            // This test establishes H2 frame exchange, not H2 drain policy.
+            // Retain/drive the connection until the client confirms the body;
+            // then explicitly cancel both harness drivers.
+            tokio::select! {
+                biased;
+                _ = &mut stopped => {},
+                next = connection.accept() => {
+                    let _ = next.expect("H2 closed before body confirmation").expect("H2 failed before body confirmation");
+                    panic!("unexpected second request");
+                }
+            }
+        });
+        let tcp = TcpStream::connect(addr).await.unwrap();
+        let mut cfg = client_config(public);
+        cfg.alpn = vec!["h2".into()];
+        let tls = utls_connect(tcp, NAME, &cfg).await.unwrap();
+        let (sender, connection) = h2::client::handshake(tls).await.unwrap();
+        let driver = tokio::spawn(connection);
+        let mut sender = sender.ready().await.unwrap();
+        let request = http::Request::builder()
+            .uri(format!("https://{NAME}/transport-check"))
+            .body(())
+            .unwrap();
+        let (response, _) = sender.send_request(request, true).unwrap();
+        let mut response = response.await.unwrap();
+        assert_eq!(response.status(), 200);
+        assert_eq!(
+            response.body_mut().data().await.unwrap().unwrap(),
+            b"h2 over authenticated TLS"[..]
+        );
+        assert!(response.body_mut().data().await.is_none());
+        drop(response);
+        stop.send(()).unwrap();
+        driver.abort();
+        assert!(matches!(driver.await, Err(error) if error.is_cancelled()));
+        drop(sender);
+        server.await.unwrap();
+    })
+    .await
+    .unwrap();
+}
+
+#[tokio::test]
+async fn accept_cancellation_releases_capacity_without_spawned_work() {
+    let (mut opts, _) = make_options();
+    opts.max_concurrent_handshakes = 1;
+    let acceptor = Arc::new(ExperimentalRealityAcceptor::new(opts).unwrap());
+    let (stream, mut peer) = tokio::io::duplex(1);
+    let acceptor2 = acceptor.clone();
+    let task = tokio::spawn(async move { acceptor2.accept(stream).await });
+    // Completion of a two-byte write through a one-byte duplex proves the first
+    // accept has acquired its permit and is awaiting the rest of the header.
+    peer.write_all(&[22, 3]).await.unwrap();
+    let (stream, _peer) = tokio::io::duplex(1);
+    assert!(matches!(
+        acceptor.accept(stream).await,
+        Err(RealityAcceptError::Busy)
+    ));
+    task.abort();
+    assert!(matches!(task.await, Err(error) if error.is_cancelled()));
+    let (stream, peer) = tokio::io::duplex(1);
+    drop(peer);
+    assert!(matches!(
+        acceptor.accept(stream).await,
+        Err(RealityAcceptError::Io)
+    ));
+}
