+    // Listener validation runs before App can perform IO or start any listener.
+    // This is a source-reachable capability gate, NOT interoperability certification.
+    let mut listener_names: HashSet<&str> = HashSet::new();
+    for (i, listener) in cfg.listeners.iter().enumerate() {
+        let field = format!("listeners[{i}]");
+        if listener.name.trim().is_empty() || !listener_names.insert(&listener.name) {
+            errs.push(format!("{field}.name must be non-empty and unique"));
+        }
+        if matches!(listener.name.as_str(), "mixed" | "http" | "socks5" | "redir" | "tproxy" | "tun") {
+            errs.push(format!("{field}.name is reserved for a built-in inbound"));
+        }
+        if !matches!(listener.kind.as_str(), "trojan" | "vmess" | "vless" | "anytls" | "mieru" | "brook" | "snell" | "naive" | "ss") {
+            errs.push(format!("{field}.type is unsupported by this listener factory"));
+        }
+        // Port 0 remains explicitly supported for isolated ephemeral-port tests.
+        if listener.port != 0 {
+            if ports.iter().any(|(port, _)| *port == listener.port) {
+                errs.push(format!("{field}.port conflicts with another inbound"));
+            }
