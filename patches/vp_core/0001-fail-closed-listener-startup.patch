@@ -0,0 +1,113 @@
+//! P01 source tests. Not executed until the toolchain/core execution gate is granted.
+use super::*;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+fn parse_listener(extra: &str) -> vp_config::Config {
+    vp_config::parse(
+        &format!("listeners:\n  - name: test\n    type: vless\n    port: 0\n    users: [00000000-0000-0000-0000-000000000001]\n{extra}"),
+        Format::Yaml,
+    ).unwrap()
+}
+
+#[test]
+fn ignored_security_and_transport_fields_are_rejected() {
+    for field in ["transport: ws", "network: h2", "reality: {}", "unknown-flag: true"] {
+        let text = format!("listeners:\n  - name: test\n    type: vless\n    port: 443\n    users: [secret-placeholder]\n    {field}\n");
+        assert!(vp_config::parse(&text, Format::Yaml).is_err(), "{field}");
+    }
+}
+
+#[test]
+fn listener_port_does_not_use_lossy_number_conversion() {
+    for port in ["-1", "65536", "4.5", "not-a-port", "null"] {
+        let text = format!("listeners:\n  - name: test\n    type: vless\n    port: {port}\n    users: [placeholder]\n");
+        assert!(vp_config::parse(&text, Format::Yaml).is_err(), "{port}");
+    }
+}
+
+#[test]
+fn tls_cannot_be_accepted_then_silently_discarded() {
+    for extra in ["    cert: cert.pem\n", "    key: key.pem\n", "    cert: cert.pem\n    key: key.pem\n"] {
+        let cfg = parse_listener(extra);
+        let errors = vp_config::validate::validate(&cfg).unwrap_err();
+        assert!(errors.iter().any(|e| e.contains("cert/key")));
+    }
+}
+
+#[test]
+fn unsupported_type_empty_credentials_and_irrelevant_cipher_fail() {
+    let mut cfg = parse_listener("");
+    cfg.listeners[0].kind = "tuic".to_string();
+    assert!(vp_config::validate::validate(&cfg).is_err());
+    cfg.listeners[0].kind = "vless".to_string();
+    cfg.listeners[0].users = vec![String::new()];
+    assert!(vp_config::validate::validate(&cfg).is_err());
+    cfg.listeners[0].users = vec!["00000000-0000-0000-0000-000000000001".to_string()];
+    cfg.listeners[0].cipher = Some("aes-128-gcm".to_string());
+    assert!(vp_config::validate::validate(&cfg).is_err());
+}
+
+#[test]
+fn duplicate_names_and_top_level_port_conflicts_fail() {
+    let mut cfg = parse_listener("");
+    cfg.listeners.push(cfg.listeners[0].clone());
+    assert!(vp_config::validate::validate(&cfg).is_err());
+    cfg.listeners.pop();
+    cfg.listeners[0].port = 30001;
+    cfg.mixed_port = Some(30001);
+    assert!(vp_config::validate::validate(&cfg).is_err());
+}
+
+#[test]
+fn malformed_uuid_fails_construction_without_bind() {
+    let mut cfg = parse_listener("");
+    cfg.listeners[0].users = vec!["not-a-uuid".to_string()];
+    assert!(build_listener(&cfg.listeners[0], "127.0.0.1").is_err());
+}
+
+struct NoForward;
+#[async_trait]
+impl Router for NoForward {
+    async fn pick(&self, _session: &Session) -> Resolution {
+        panic!("negative startup tests must not forward traffic")
+    }
+}
+fn context() -> InboundCtx {
+    InboundCtx {
+        router: Arc::new(NoForward),
+        stats: Arc::new(Stats::default()),
+        conns: Arc::new(ConnTable::new()),
+    }
+}
+
+#[tokio::test]
+async fn occupied_loopback_port_does_not_report_success() {
+    let occupied = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let mut cfg = parse_listener("");
+    cfg.listeners[0].port = occupied.local_addr().unwrap().port();
+    let listener = build_listener(&cfg.listeners[0], "127.0.0.1").unwrap();
+    assert!(start_protocol_listeners(vec![listener], context()).await.is_err());
+}
+
+struct ScriptedInbound {
+    calls: Arc<AtomicUsize>,
+    fail: bool,
+}
+#[async_trait]
+impl vp_core::Inbound for ScriptedInbound {
+    fn tag(&self) -> &str { "scripted" }
+    async fn start(self: Arc<Self>, _ctx: InboundCtx) -> Result<u16> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        if self.fail { Err(Error::Unsupported("injected startup failure".into())) } else { Ok(1234) }
+    }
+}
+#[tokio::test]
+async fn partial_start_is_an_error_and_later_listeners_are_not_started() {
+    let calls = Arc::new(AtomicUsize::new(0));
+    let listeners: Vec<Arc<dyn vp_core::Inbound>> = [false, true, false].iter().map(|fail| {
+        Arc::new(ScriptedInbound { calls: calls.clone(), fail: *fail }) as Arc<dyn vp_core::Inbound>
+    }).collect();
+    assert!(start_protocol_listeners(listeners, context()).await.is_err());
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    // Intentionally does NOT assert rollback: Inbound has no cancellation handle yet.
+}
