+/// Successful return means every requested start returned a bound port, not that
+/// protocol handshakes, task liveness, stop/drain or interoperability are certified.
+async fn start_protocol_listeners(
+    listeners: Vec<Arc<dyn vp_core::Inbound>>,
+    ctx: InboundCtx,
+) -> Result<Vec<(String, u16)>> {
+    let mut bound = Vec::with_capacity(listeners.len());
+    for listener in listeners {
+        let tag = listener.tag().to_string();
+        let port = listener.start(ctx.clone()).await?;
+        bound.push((tag, port));
+    }
+    Ok(bound)
