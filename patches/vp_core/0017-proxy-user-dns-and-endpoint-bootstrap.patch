+                    }
+                }
+                assert_eq!(target.count.load(Ordering::SeqCst), 4);
+                for name in ["bad-id.fixture.invalid", "bad-question.fixture.invalid"] {
+                    let query = vp_dns::wire::build_query(7, name, vp_dns::QType::A);
+                    assert!(
+                        dns.exchange(&query, false, "test".into(), source)
+                            .await
+                            .is_err()
+                    );
+                }
+                // Bad credentials cannot cause target traffic or protected/direct fallback.
+                let before = target.count.load(Ordering::SeqCst);
+                let bad = UserDns::selected_proxy(
+                    outbound(port, "00000000-0000-0000-0000-000000000001"),
+                    vec![target.addr],
+                )
+                .unwrap();
+                assert!(
+                    bad.exchange(
+                        &vp_dns::wire::build_query(9, "auth.fixture.invalid", vp_dns::QType::A),
+                        false,
+                        "test".into(),
+                        source
+                    )
+                    .await
+                    .is_err()
+                );
+                assert_eq!(target.count.load(Ordering::SeqCst), before);
+            }
+            // Actual packet-device UDP interception preserves original source/destination
+            // and question for IPv4 and IPv6, even though configured upstream differs.
+            let dns = Arc::new(UserDns::selected_proxy(proxy.clone(), vec![user4.addr]).unwrap());
+            let (mut app, device) = tokio::io::duplex(32768);
+            let tun = vp_core::task_scope::spawn(vp_tun::run_with_device_proxy_dns(
+                vp_tun::TunConfig::default(),
+                "test-tun".into(),
+                ctx(),
+                dns,
+                device,
+            ));
+            for (v6, large) in [(false, false), (true, false), (false, true), (true, true)] {
+                let q = vp_dns::wire::build_query(
+                    0x77,
+                    if large {
+                        "large.fixture.invalid"
+                    } else {
+                        "tun.fixture.invalid"
+                    },
+                    if v6 {
+                        vp_dns::QType::Aaaa
+                    } else {
+                        vp_dns::QType::A
+                    },
+                );
+                let mut packet = Vec::new();
+                if v6 {
+                    etherparse::PacketBuilder::ipv6(
+                        "fd00::2".parse::<std::net::Ipv6Addr>().unwrap().octets(),
+                        "fd00::53".parse::<std::net::Ipv6Addr>().unwrap().octets(),
+                        64,
+                    )
+                    .udp(45678, 53)
+                    .write(&mut packet, &q)
+                    .unwrap();
+                } else {
+                    etherparse::PacketBuilder::ipv4([10, 0, 0, 2], [10, 0, 0, 53], 64)
+                        .udp(45678, 53)
+                        .write(&mut packet, &q)
+                        .unwrap();
+                }
+                app.write_all(&packet).await.unwrap();
+                let mut out = [0; 8192];
+                let header = if v6 { 40 } else { 20 };
+                timeout(Duration::from_secs(6), app.read_exact(&mut out[..header]))
+                    .await
+                    .unwrap()
+                    .unwrap();
+                let n = if v6 {
+                    40 + u16::from_be_bytes([out[4], out[5]]) as usize
+                } else {
+                    u16::from_be_bytes([out[2], out[3]]) as usize
+                };
+                assert!((header + 8..=8192).contains(&n));
+                timeout(Duration::from_secs(6), app.read_exact(&mut out[header..n]))
+                    .await
+                    .unwrap()
+                    .unwrap();
+                assert_eq!(&out[header..header + 4], &[0, 53, 0xb2, 0x6e]);
+                assert!(vp_dns::wire::response_matches_query(
+                    &q,
+                    &out[header + 8..n]
+                ));
+                assert_eq!(out[header + 8 + 2] & 2 != 0, large);
+                if large {
+                    assert!(n - header - 8 <= 512);
+                    let dns = UserDns::selected_proxy(proxy.clone(), vec![user4.addr]).unwrap();
+                    let full = dns
+                        .exchange(&q, true, "tcp-retry".into(), source)
+                        .await
+                        .unwrap();
+                    assert!(full.len() > 512);
+                    assert_eq!(full[2] & 2, 0);
+                }
+                if v6 {
+                    assert_eq!(&out[8..24], &packet[24..40]);
+                    assert_eq!(&out[24..40], &packet[8..24]);
+                } else {
+                    assert_eq!(&out[12..16], &packet[16..20]);
+                    assert_eq!(&out[16..20], &packet[12..16]);
+                }
+            }
+            tun.abort();
+            let _ = tun.await;
+            // Cancel an actually forwarded unanswered query and drain generation tasks.
+            let dns = Arc::new(UserDns::selected_proxy(proxy.clone(), vec![user4.addr]).unwrap());
+            let before = user4.count.load(Ordering::SeqCst);
+            let pending = vp_core::task_scope::spawn(async move {
+                dns.exchange(
+                    &vp_dns::wire::build_query(11, "silent.fixture.invalid", vp_dns::QType::A),
+                    false,
+                    "test".into(),
+                    source,
+                )
+                .await
+            });
+            timeout(Duration::from_secs(3), async {
+                while user4.count.load(Ordering::SeqCst) == before {
+                    tokio::time::sleep(Duration::from_millis(5)).await;
+                }
+            })
+            .await
+            .unwrap();
+            pending.abort();
+            assert!(pending.await.unwrap_err().is_cancelled());
+        })
+        .await;
+    let report = scope.shutdown(Duration::ZERO, Duration::from_secs(2)).await;
+    assert_eq!(report.remaining_tasks, 0);
+    assert_eq!(report.panics, 0);
+    assert_eq!(host.denied.load(Ordering::SeqCst), 0);
+    assert!(boot.count.load(Ordering::SeqCst) > 0);
+    assert!(
+        host.calls
+            .lock()
+            .unwrap()
+            .iter()
+            .all(|(p, d)| (*p == Purpose::Bootstrap && *d == boot.addr)
+                || (*p == Purpose::Proxy && *d == host.proxy))
+    );
+    eprintln!(
+        "PASS official authenticated VMess: bootstrap={} user4={} user6={} hook_denials=0 remaining_tasks=0 user4_hashes={:?} user6_hashes={:?}",
+        boot.count.load(Ordering::SeqCst),
+        user4.count.load(Ordering::SeqCst),
+        user6.count.load(Ordering::SeqCst),
+        user4.hashes.lock().unwrap(),
+        user6.hashes.lock().unwrap()
+    );
+}
