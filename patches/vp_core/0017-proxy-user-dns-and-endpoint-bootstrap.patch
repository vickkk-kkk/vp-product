diff --git a/crates/vp-tun/src/user_dns.rs b/crates/vp-tun/src/user_dns.rs
new file mode 100644
index 0000000..2f3dbd3
--- /dev/null
+++ b/crates/vp-tun/src/user_dns.rs
@@ -0,0 +1,451 @@
+//! Mobile user DNS: selected proxy only, never a protected-direct socket.
+//!
+//! Each query owns a fresh proxy session and validates the exact upstream source,
+//! ID and question. Numeric DNS destinations avoid recursive endpoint lookup.
+//! UDP53 and framed TCP53 are intercepted consistently; no fake IPs are produced.
+use std::{
+    net::SocketAddr,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt},
+    sync::{OwnedSemaphorePermit, Semaphore},
+    time::timeout,
+};
+use vp_common::{DstAddr, Error, Result};
+use vp_core::{Outbound, Session, UdpPacket};
+
+pub const MAX_MESSAGE: usize = 4096;
+pub const MAX_SESSIONS: usize = 64;
+pub const QUERY_TIMEOUT: Duration = Duration::from_secs(5);
+const IDLE_TIMEOUT: Duration = Duration::from_secs(10);
+const MAX_QUERIES_PER_FLOW: usize = 256;
+
+pub struct UserDns {
+    outbound: Arc<dyn Outbound>,
+    servers: Vec<SocketAddr>,
+    next: AtomicUsize,
+    sessions: Arc<Semaphore>,
+    exchanges: Semaphore,
+}
+impl UserDns {
+    /// Caller supplies the exact selected proxy object, not a route selector that
+    /// might choose DIRECT. There is deliberately no direct policy constructor.
+    pub fn selected_proxy(outbound: Arc<dyn Outbound>, servers: Vec<SocketAddr>) -> Result<Self> {
+        if servers.is_empty()
+            || servers.len() > 4
+            || servers.iter().any(|s| {
+                s.port() == 0
+                    || s.ip().is_unspecified()
+                    || s.ip().is_multicast()
+                    || matches!(s, SocketAddr::V6(v6) if v6.scope_id() != 0 || v6.flowinfo() != 0)
+            })
+        {
+            return Err(Error::Config(
+                "user DNS requires 1..4 numeric endpoints".into(),
+            ));
+        }
+        if !outbound.support_udp() {
+            return Err(Error::Unsupported(
+                "selected proxy does not support user DNS UDP".into(),
+            ));
+        }
+        Ok(Self {
+            outbound,
+            servers,
+            next: AtomicUsize::new(0),
+            sessions: Arc::new(Semaphore::new(MAX_SESSIONS)),
+            exchanges: Semaphore::new(MAX_SESSIONS),
+        })
+    }
+    pub(crate) fn acquire_session(&self) -> Option<OwnedSemaphorePermit> {
+        self.sessions.clone().try_acquire_owned().ok()
+    }
+    /// One attempt, one configured upstream, no retry to direct/system/public
+    /// resolvers on auth errors, malformed answers, timeouts or cancellation.
+    pub async fn exchange(
+        &self,
+        query: &[u8],
+        tcp: bool,
+        inbound: Arc<str>,
+        source: SocketAddr,
+    ) -> Result<Vec<u8>> {
+        if !vp_dns::wire::valid_forward_query(query) {
+            return Err(Error::Proto("invalid or oversized DNS query"));
+        }
+        let _permit = self
+            .exchanges
+            .try_acquire()
+            .map_err(|_| Error::Other("DNS concurrency limit".into()))?;
+        let server = self.servers[self.next.fetch_add(1, Ordering::Relaxed) % self.servers.len()];
+        let dst = DstAddr::ip(server.ip(), server.port());
+        vp_core::task_scope::check_destination(&dst)?;
+        let operation = async {
+            let response = if tcp {
+                let sess = Session::new_tcp(inbound, Some(source), dst.clone());
+                let mut conn = self.outbound.connect_stream(&sess, &dst).await?;
+                conn.write_u16(query.len() as u16).await?;
+                conn.write_all(query).await?;
+                conn.flush().await?;
+                let len = conn.read_u16().await? as usize;
+                if !(12..=MAX_MESSAGE).contains(&len) {
+                    return Err(Error::Proto("DNS TCP response exceeds bounds"));
+                }
+                let mut response = vec![0; len];
+                conn.read_exact(&mut response).await?;
+                response
+            } else {
+                let sess = Session::new_udp(inbound, Some(source), dst.clone());
+                let mut conn = self.outbound.connect_packet(&sess, &dst).await?;
+                conn.send(&UdpPacket {
+                    src: source,
+                    dst: server,
+                    data: query.to_vec().into(),
+                })
+                .await?;
+                let response = conn.recv().await?;
+                if response.src != server {
+                    return Err(Error::Proto("DNS response source mismatch"));
+                }
+                if response.data.len() > MAX_MESSAGE {
+                    return Err(Error::Proto("DNS UDP response exceeds bounds"));
+                }
+                response.data.to_vec()
+            };
+            if !vp_dns::wire::response_matches_query(query, &response) {
+                return Err(Error::Proto("DNS response ID/question/framing mismatch"));
+            }
+            Ok(response)
+        };
+        timeout(QUERY_TIMEOUT, operation).await.map_err(|_| {
+            Error::Io(std::io::Error::new(
+                std::io::ErrorKind::TimedOut,
+                "proxy DNS timeout",
+            ))
+        })?
+    }
+    pub(crate) async fn serve<S>(
+        &self,
+        mut stream: S,
+        tcp: bool,
+        inbound: Arc<str>,
+        source: SocketAddr,
+        mtu: usize,
+    ) where
+        S: AsyncRead + AsyncWrite + Unpin,
+    {
+        let mut buf = vec![0; MAX_MESSAGE + 1];
+        for _ in 0..MAX_QUERIES_PER_FLOW {
+            let read = async {
+                if tcp {
+                    let len = stream.read_u16().await? as usize;
+                    if !(12..=MAX_MESSAGE).contains(&len) {
+                        return Err(std::io::Error::other("DNS frame exceeds bounds"));
+                    }
+                    stream.read_exact(&mut buf[..len]).await?;
+                    Ok(len)
+                } else {
+                    stream.read(&mut buf).await
+                }
+            };
+            let len = match timeout(IDLE_TIMEOUT, read).await {
+                Ok(Ok(n)) if n > 0 && n <= MAX_MESSAGE => n,
+                _ => break,
+            };
+            let query = &buf[..len];
+            let mut response = match self.exchange(query, tcp, inbound.clone(), source).await {
+                Ok(response) => response,
+                Err(_) => match vp_dns::wire::build_servfail(query) {
+                    Some(response) => response,
+                    None => continue,
+                },
+            };
+            if !tcp {
+                // ipstack truncates writes to MTU and write_all would emit the
+                // tail as another UDP datagram. Return one valid DNS TC reply
+                // instead; never split a DNS response into corrupt datagrams.
+                let budget = mtu
+                    .saturating_sub(if source.is_ipv6() { 48 } else { 28 })
+                    .min(vp_dns::wire::udp_response_limit(query).unwrap_or(512));
+                if response.len() > budget {
+                    let Some(truncated) = vp_dns::wire::build_truncated_response(query) else {
+                        break;
+                    };
+                    if truncated.len() > budget {
+                        break;
+                    }
+                    response = truncated;
+                }
+            }
+            let write = async {
+                if tcp {
+                    stream.write_u16(response.len() as u16).await?;
+                    stream.write_all(&response).await?;
+                } else if stream.write(&response).await? != response.len() {
+                    return Err(std::io::Error::other("partial DNS datagram write"));
+                }
+                stream.flush().await
+            };
+            if !matches!(timeout(QUERY_TIMEOUT, write).await, Ok(Ok(()))) {
+                break;
+            }
+        }
+    }
+}
