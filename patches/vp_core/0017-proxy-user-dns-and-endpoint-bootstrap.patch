diff --git a/crates/vp-dns/src/wire.rs b/crates/vp-dns/src/wire.rs
index 0559dd4..bec02e7 100644
--- a/crates/vp-dns/src/wire.rs
+++ b/crates/vp-dns/src/wire.rs
@@ -487,3 +487,209 @@ mod tests {
         assert_eq!(extract_cname(&msg), Some("b.com".to_string()));
     }
 }
+
+/// A bounded, single-question DNS message used at the mobile trust boundary.
+/// Names are canonical wire labels (ASCII folded), not lossy UTF-8 strings.
+#[derive(Debug, PartialEq, Eq)]
+struct Question {
+    name: Vec<u8>,
+    kind: u16,
+    class: u16,
+    end: usize,
+}
+fn bounded_name(buf: &[u8], cursor: &mut usize) -> Option<Vec<u8>> {
+    let mut pos = *cursor;
+    let mut jumped = false;
+    let mut hops = 0;
+    let mut name = Vec::new();
+    loop {
+        let len = *buf.get(pos)?;
+        if len & 0xc0 == 0xc0 {
+            let next = *buf.get(pos + 1)?;
+            let target = ((len as usize & 63) << 8) | next as usize;
+            // Backward-only pointers exclude cycles and out-of-message aliases.
+            if target >= pos || target < 12 || hops >= 16 {
+                return None;
+            }
+            if !jumped {
+                *cursor = pos + 2;
+                jumped = true;
+            }
+            pos = target;
+            hops += 1;
+            continue;
+        }
+        if len > 63 {
+            return None;
+        }
+        pos += 1;
+        name.push(len);
+        if len == 0 {
+            if !jumped {
+                *cursor = pos;
+            }
+            return Some(name);
+        }
+        let label = buf.get(pos..pos.checked_add(len as usize)?)?;
+        name.extend(label.iter().map(u8::to_ascii_lowercase));
+        if name.len() >= 255 {
+            return None;
+        }
+        pos += len as usize;
+    }
+}
+fn bounded_question(buf: &[u8], response: bool) -> Option<Question> {
+    if !(12..=4096).contains(&buf.len())
+        || (buf[2] & 0x80 != 0) != response
+        || buf[2] & 0x78 != 0
+        || buf[4..6] != [0, 1]
+    {
+        return None;
+    }
+    let mut pos = 12;
+    let name = bounded_name(buf, &mut pos)?;
+    let kind = u16::from_be_bytes(buf.get(pos..pos + 2)?.try_into().ok()?);
+    let class = u16::from_be_bytes(buf.get(pos + 2..pos + 4)?.try_into().ok()?);
+    let end = pos + 4;
+    pos = end;
+    let count = [6, 8, 10]
+        .into_iter()
+        .map(|n| u16::from_be_bytes([buf[n], buf[n + 1]]) as usize)
+        .sum::<usize>();
+    if count > 128 {
+        return None;
+    }
+    for _ in 0..count {
+        bounded_name(buf, &mut pos)?;
+        let header = buf.get(pos..pos + 10)?;
+        let size = u16::from_be_bytes([header[8], header[9]]) as usize;
+        pos = pos.checked_add(10 + size)?;
+        if pos > buf.len() {
+            return None;
+        }
+    }
+    if pos != buf.len() {
+        return None;
+    }
+    Some(Question {
+        name,
+        kind,
+        class,
+        end,
+    })
+}
+/// Validate supported standard queries without network activity. One question,
+/// maximum 4096 bytes, bounded labels, records and compression traversal.
+pub fn valid_forward_query(query: &[u8]) -> bool {
+    bounded_question(query, false).is_some()
+}
+/// Never rewrite a received ID to make an unrelated response look associated.
+/// Require ID, QR/opcode, canonical question name, type, class and valid framing.
+pub fn response_matches_query(query: &[u8], response: &[u8]) -> bool {
+    let (Some(q), Some(r)) = (
+        bounded_question(query, false),
+        bounded_question(response, true),
+    ) else {
+        return false;
+    };
+    query[..2] == response[..2] && q.name == r.name && q.kind == r.kind && q.class == r.class
+}
+/// A local forwarding error is SERVFAIL, never a fabricated successful empty
+/// answer. Malformed input receives no answer. Question/source association stays
+/// with the caller's per-flow packet/stream; no synthetic address is allocated.
+pub fn build_servfail(query: &[u8]) -> Option<Vec<u8>> {
+    let q = bounded_question(query, false)?;
+    let mut out = query[..q.end].to_vec();
+    out[2] = 0x80 | (query[2] & 1);
+    out[3] = 0x82;
+    out[6..12].fill(0);
+    Some(out)
+}
+
+#[cfg(test)]
+mod forward_validation_tests {
+    use super::*;
+    #[test]
+    fn association_rejects_id_question_type_class_flags_size_and_bad_records() {
+        let query = build_query(42, "application.fixture.invalid", QType::A);
+        let response = build_a_response(&query, [127, 0, 0, 8].into());
+        assert!(response_matches_query(&query, &response));
+        for (offset, mask) in [
+            (0, 1),
+            (2, 128),
+            (13, 1),
+            (query.len() - 3, 1),
+            (query.len() - 1, 1),
+        ] {
+            let mut bad = response.clone();
+            bad[offset] ^= mask;
+            assert!(!response_matches_query(&query, &bad), "offset {offset}");
+        }
+        let mut bad = response.clone();
+        bad.pop();
+        assert!(!response_matches_query(&query, &bad));
+        let mut bad = response.clone();
+        bad.extend(vec![0; 4096]);
+        assert!(!response_matches_query(&query, &bad));
+        let mut bad = response.clone();
+        bad[4..6].copy_from_slice(&2u16.to_be_bytes());
+        assert!(!response_matches_query(&query, &bad));
+        let mut bad = query.clone();
+        bad[12] = 0xc0;
+        bad[13] = 12;
+        assert!(!valid_forward_query(&bad));
+        assert!(build_servfail(&[0; 8]).is_none());
+        let failed = build_servfail(&query).unwrap();
+        assert_eq!(failed[3] & 15, 2);
+        assert!(response_matches_query(&query, &failed));
+    }
+}
+
+/// UDP response budget advertised by EDNS(0), clamped to the supported message
+/// limit. Without OPT, RFC 1035's 512-byte limit applies.
+pub fn udp_response_limit(query: &[u8]) -> Option<usize> {
+    let question = bounded_question(query, false)?;
+    let mut pos = question.end;
+    let before_additional = u16::from_be_bytes([query[6], query[7]]) as usize
+        + u16::from_be_bytes([query[8], query[9]]) as usize;
+    let additional = u16::from_be_bytes([query[10], query[11]]) as usize;
+    let mut limit = 512;
+    for index in 0..before_additional + additional {
+        bounded_name(query, &mut pos)?;
+        let header = query.get(pos..pos + 10)?;
+        let kind = u16::from_be_bytes([header[0], header[1]]);
+        let class = u16::from_be_bytes([header[2], header[3]]) as usize;
+        let len = u16::from_be_bytes([header[8], header[9]]) as usize;
+        if index >= before_additional && kind == 41 {
+            limit = class.clamp(512, 4096);
+        }
+        pos += 10 + len;
+    }
+    Some(limit)
+}
+/// Truncate at DNS record boundaries, not IP-stack write boundaries. A client
+/// may retry over TCP, which uses the same selected-proxy policy.
+pub fn build_truncated_response(query: &[u8]) -> Option<Vec<u8>> {
+    let mut response = build_servfail(query)?;
+    response[2] |= 2;
+    response[3] = 0x80;
+    Some(response)
+}
+
+#[cfg(test)]
+mod truncate_tests {
+    use super::*;
+    #[test]
+    fn edns_budget_and_valid_truncation_preserve_question() {
+        let mut q = build_query(82, "size.fixture.invalid", QType::A);
+        assert_eq!(udp_response_limit(&q), Some(512));
+        q[10..12].copy_from_slice(&1u16.to_be_bytes());
+        q.extend_from_slice(&[0, 0, 41, 0x10, 0, 0, 0, 0, 0, 0, 0]);
+        assert_eq!(udp_response_limit(&q), Some(4096));
+        let truncated = build_truncated_response(&q).unwrap();
+        assert!(response_matches_query(&q, &truncated));
+        assert_ne!(truncated[2] & 2, 0);
+        assert_eq!(truncated[3] & 15, 0);
+        assert_eq!(&truncated[6..12], &[0; 6]);
+    }
+}
