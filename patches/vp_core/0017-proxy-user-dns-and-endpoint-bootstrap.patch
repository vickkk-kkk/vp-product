+//! Actual vp_core -> authenticated official sing-vmess peer -> loopback DNS.
+//! No public DNS, routing changes, guest VPN, or syscall tracing is involved.
+use sha2::{Digest, Sha256};
+use std::{
+    io::{BufRead, Write},
+    net::SocketAddr,
+    process::{Child, Command, Stdio},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, UdpSocket},
+    time::timeout,
+};
+use vp_core::{
+    InboundCtx, Outbound, Session,
+    host_network::{HostNetwork, Protocol, Purpose},
+    task_scope::{DestinationPolicy, TaskScope},
+};
+use vp_tun::user_dns::UserDns;
+const ID: &str = "b831381d-6324-4d53-ad4f-8cda48b30811";
+struct Peer(Child);
+impl Drop for Peer {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+fn peer() -> (Peer, u16) {
+    let binary = std::env::var_os("VP_STREAM_REFERENCE")
+        .expect("requires authorized pinned official stream library peer");
+    let mut child = Command::new(binary)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    writeln!(
+        child.stdin.as_mut().unwrap(),
+        "{}",
+        serde_json::json!({"mode":"server","protocol":"vmess","credential":ID})
+    )
+    .unwrap();
+    let mut line = String::new();
+    std::io::BufReader::new(child.stdout.take().unwrap())
+        .read_line(&mut line)
+        .unwrap();
+    let ready: serde_json::Value = serde_json::from_str(&line).expect("official peer readiness");
+    assert_eq!(ready["kind"], "official-protocol-library");
+    (Peer(child), ready["port"].as_u64().unwrap() as u16)
+}
+fn outbound(port: u16, id: &str) -> Arc<dyn Outbound> {
+    let cfg=serde_json::from_value(serde_json::json!({"server":"proxy.fixture.invalid","port":port,"uuid":id,"cipher":"aes-128-gcm","tls":false,"udp":true})).unwrap();
+    Arc::new(vp_protocol::vmess::VmessOutbound::new(&cfg).unwrap())
+}
+struct Host {
+    bootstrap: SocketAddr,
+    proxy: SocketAddr,
+    calls: Mutex<Vec<(Purpose, SocketAddr)>>,
+    denied: AtomicUsize,
+}
+impl HostNetwork for Host {
+    fn before_connect(
+        &self,
+        _: u64,
+        protocol: Protocol,
+        destination: SocketAddr,
+        purpose: Purpose,
+    ) -> std::io::Result<()> {
+        self.calls.lock().unwrap().push((purpose, destination));
+        if (purpose == Purpose::Bootstrap
+            && protocol == Protocol::Udp
+            && destination == self.bootstrap)
+            || (purpose == Purpose::Proxy && protocol == Protocol::Tcp && destination == self.proxy)
+        {
+            Ok(())
+        } else {
+            self.denied.fetch_add(1, Ordering::SeqCst);
+            Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "test forbids direct user DNS",
+            ))
+        }
+    }
+    fn dns_servers(&self) -> Vec<SocketAddr> {
+        vec![self.bootstrap]
+    }
+    fn bootstrap_host(&self) -> Option<String> {
+        Some("proxy.fixture.invalid".into())
+    }
+}
+fn answer(query: &[u8]) -> Vec<u8> {
+    let (_, name, kind) = vp_dns::wire::parse_query(query).unwrap();
+    let mut out = query.to_vec();
+    out[2] = 0x81;
+    out[3] = 0x80;
+    out[6..8].copy_from_slice(&1u16.to_be_bytes());
+    out.extend_from_slice(&[0xc0, 0x0c]);
+    out.extend_from_slice(&kind.to_be_bytes());
+    out.extend_from_slice(&[0, 1, 0, 0, 0, 30]);
+    if kind == 28 {
+        out.extend_from_slice(&16u16.to_be_bytes());
+        out.extend_from_slice(&"::1".parse::<std::net::Ipv6Addr>().unwrap().octets());
+    } else {
+        out.extend_from_slice(&4u16.to_be_bytes());
+        out.extend_from_slice(&[127, 0, 0, 1]);
+    }
+    if name.starts_with("large.") {
+        let rr = out[query.len()..].to_vec();
+        for _ in 1..100 {
+            out.extend_from_slice(&rr);
+        }
+        out[6..8].copy_from_slice(&100u16.to_be_bytes());
+    }
+    if name.starts_with("bad-id.") {
+        out[0] ^= 1;
+    }
+    if name.starts_with("bad-question.") {
+        out[13] ^= 1;
+    }
+    out
+}
+struct DnsTarget {
+    addr: SocketAddr,
+    count: Arc<AtomicUsize>,
+    hashes: Arc<Mutex<Vec<String>>>,
+    tasks: Vec<tokio::task::JoinHandle<()>>,
+}
+impl Drop for DnsTarget {
+    fn drop(&mut self) {
+        for t in &self.tasks {
+            t.abort();
+        }
+    }
+}
+async fn target(ipv6: bool) -> DnsTarget {
+    let tcp = TcpListener::bind(if ipv6 { "[::1]:0" } else { "127.0.0.1:0" })
+        .await
+        .unwrap();
+    let addr = tcp.local_addr().unwrap();
+    let udp = UdpSocket::bind(addr).await.unwrap();
+    let count = Arc::new(AtomicUsize::new(0));
+    let hashes = Arc::new(Mutex::new(Vec::new()));
+    let c = count.clone();
+    let h = hashes.clone();
+    let u = tokio::spawn(async move {
+        loop {
+            let mut buf = [0; 4097];
+            let (n, src) = udp.recv_from(&mut buf).await.unwrap();
+            assert!(src.ip().is_loopback());
+            c.fetch_add(1, Ordering::SeqCst);
+            h.lock()
+                .unwrap()
+                .push(format!("{:x}", Sha256::digest(&buf[..n])));
+            if vp_dns::wire::parse_query(&buf[..n])
+                .unwrap()
+                .1
+                .starts_with("silent.")
+            {
+                continue;
+            }
+            udp.send_to(&answer(&buf[..n]), src).await.unwrap();
+        }
+    });
+    let c = count.clone();
+    let h = hashes.clone();
+    let t = tokio::spawn(async move {
+        loop {
+            let (mut conn, src) = tcp.accept().await.unwrap();
+            assert!(src.ip().is_loopback());
+            let n = conn.read_u16().await.unwrap() as usize;
+            assert!(n <= 4096);
+            let mut q = vec![0; n];
+            conn.read_exact(&mut q).await.unwrap();
+            c.fetch_add(1, Ordering::SeqCst);
+            h.lock().unwrap().push(format!("{:x}", Sha256::digest(&q)));
+            let a = answer(&q);
+            conn.write_u16(a.len() as u16).await.unwrap();
+            conn.write_all(&a).await.unwrap();
+        }
+    });
+    DnsTarget {
+        addr,
+        count,
+        hashes,
+        tasks: vec![u, t],
+    }
+}
+struct NoRouting;
+#[async_trait::async_trait]
+impl vp_core::Router for NoRouting {
+    async fn pick(&self, _: &Session) -> vp_core::Resolution {
+        panic!("DNS must never fall through to router or DIRECT");
+    }
+}
+fn ctx() -> InboundCtx {
+    InboundCtx {
+        router: Arc::new(NoRouting),
+        stats: Arc::default(),
+        conns: Arc::new(vp_core::ConnTable::new()),
+    }
+}
