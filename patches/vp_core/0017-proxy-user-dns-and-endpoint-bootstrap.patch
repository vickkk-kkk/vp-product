+#[cfg(test)]
+mod dns_policy_tests {
+    use super::*;
+    use crate::task_scope::{DestinationPolicy, TaskScope};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    struct Host {
+        dns: SocketAddr,
+        calls: AtomicUsize,
+    }
+    impl HostNetwork for Host {
+        fn before_connect(&self, _: u64, _: Protocol, _: SocketAddr, _: Purpose) -> io::Result<()> {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        }
+        fn dns_servers(&self) -> Vec<SocketAddr> {
+            vec![self.dns]
+        }
+        fn bootstrap_host(&self) -> Option<String> {
+            Some("proxy.fixture.invalid".into())
+        }
+    }
+    #[tokio::test]
+    async fn explicit_policy_denies_direct_user_dns_and_unlisted_bootstrap_before_platform_hook() {
+        let listener = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let host = Arc::new(Host {
+            dns: listener.local_addr().unwrap(),
+            calls: AtomicUsize::new(0),
+        });
+        let scope =
+            TaskScope::with_host_network(DestinationPolicy::LoopbackIpOnly, Some(host.clone()));
+        scope
+            .run(async {
+                assert!(bind_udp(host.dns, Purpose::Dns).is_err());
+                assert!(bind_udp("127.0.0.1:9".parse().unwrap(), Purpose::Bootstrap).is_err());
+                assert_eq!(host.calls.load(Ordering::SeqCst), 0);
+                drop(bind_udp(host.dns, Purpose::Bootstrap).unwrap());
+                assert_eq!(host.calls.load(Ordering::SeqCst), 1);
+                let mut buf = [0; 512];
+                assert_eq!(
+                    listener.try_recv_from(&mut buf).unwrap_err().kind(),
+                    io::ErrorKind::WouldBlock
+                );
+            })
+            .await;
+        assert_eq!(
+            scope
+                .shutdown(std::time::Duration::ZERO, std::time::Duration::from_secs(1))
+                .await
+                .remaining_tasks,
+            0
+        );
+    }
+}
