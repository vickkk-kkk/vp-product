+
+pub fn install_experimental_process_floor(targets: Arc<crate::experimental_exact_targets::ExactTargets>) -> Result<(), &'static str> {
+    EXPERIMENTAL_PROCESS_FLOOR.set(targets).map_err(|_| "process floor already installed")
+}
+
+pub fn experimental_process_floor() -> Option<Arc<crate::experimental_exact_targets::ExactTargets>> {
