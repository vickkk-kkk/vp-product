+//! Experimental exact numeric-address allowlist; not a general VPN egress policy.
+use std::{collections::BTreeSet, net::{IpAddr, SocketAddr}};
+
+// Conservative IPv4-only prototype. Unsupported address families fail closed.
+fn permitted_public_ip(ip: IpAddr) -> bool {
+    let IpAddr::V4(ip) = ip else { return false };
+    let [a, b, c, _] = ip.octets();
+    !((a == 0) || (a == 10) || (a == 100 && (64..=127).contains(&b))
+        || (a == 127) || (a == 169 && b == 254)
+        || (a == 172 && (16..=31).contains(&b))
+        || (a == 192 && (b == 0 || b == 168))
+        || (a == 192 && b == 88 && c == 99)
+        || (a == 198 && (b == 18 || b == 19 || (b == 51 && c == 100)))
+        || (a == 203 && b == 0 && c == 113) || a >= 224)
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ExactTargets(BTreeSet<SocketAddr>);
+impl ExactTargets {
+    pub fn new(addresses: impl IntoIterator<Item = SocketAddr>) -> Option<Self> {
+        let mut unique = BTreeSet::new();
+        let mut count = 0_usize;
+        for address in addresses {
+            count += 1;
+            if count > 64 || address.port() == 0 || !permitted_public_ip(address.ip()) {
+                return None;
+            }
+            unique.insert(address);
+        }
+        if unique.is_empty() { return None; }
+        let addresses = unique;
+        Some(Self(addresses))
+    }
+    /// Reject the whole answer when any address is not expressly authorized.
+    /// Dial the returned numeric addresses directly, never resolve again.
+    pub fn validate(&self, answer: &[SocketAddr]) -> Option<Vec<SocketAddr>> {
+        if answer.is_empty() || answer.len() > 64 || answer.iter().any(|a| !self.0.contains(a)) {
+            return None;
+        }
+        Some(answer.to_vec())
+    }
+}
