+    fn a(s: &str) -> SocketAddr { s.parse().unwrap() }
+    #[test] fn exact_address_and_port_only() {
+        let p = ExactTargets::new([a("8.8.8.8:443")]).unwrap();
+        assert!(p.validate(&[a("8.8.8.8:443")]).is_some());
+        assert!(p.validate(&[a("8.8.8.8:80")]).is_none());
+        assert!(p.validate(&[a("127.0.0.1:443")]).is_none());
+    }
+    #[test] fn mixed_answers_fail_closed() {
+        let p = ExactTargets::new([a("8.8.8.8:443")]).unwrap();
+        assert!(p.validate(&[a("8.8.8.8:443"), a("10.0.0.1:443")]).is_none());
+        assert!(p.validate(&[]).is_none());
+    }
+    #[test] fn mapped_ipv6_is_not_implicitly_ipv4() {
+        let p = ExactTargets::new([a("8.8.8.8:443")]).unwrap();
+        assert!(p.validate(&[a("[::ffff:8.8.8.8]:443")]).is_none());
+    }
+    #[test] fn private_or_unsupported_addresses_cannot_be_authorized() {
+        for ip in ["127.0.0.1:443", "10.0.0.1:443", "169.254.169.254:443", "100.64.0.1:443", "192.0.2.1:443", "[2001:4860:4860::8888]:443"] {
+            assert!(ExactTargets::new([a(ip)]).is_none(), "{ip}");
+        }
+    }
+    #[test] fn input_count_is_bounded_even_with_duplicates() {
+        assert!(ExactTargets::new(std::iter::repeat(a("8.8.8.8:443")).take(65)).is_none());
+    }
+    #[test] fn empty_and_zero_port_rejected() {
+        assert!(ExactTargets::new([]).is_none());
+        assert!(ExactTargets::new([a("8.8.8.8:0")]).is_none());
+    }
+}
